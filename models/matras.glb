        notice.removeAttribute('data-br-upload-error');
        var dropzone = form.querySelector('.file-dropzone');
        if (dropzone) { dropzone.classList.remove('is-invalid'); }
        var input = form.querySelector('#basrelief_image_input');
        if (input) { input.setAttribute('aria-invalid', 'false'); }
    }
    function validationMessage(reason) {
        if (reason === 'too_large') { return "\u0424\u0430\u0439\u043b \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0431\u043e\u043b\u044c\u0448\u043e\u0439: \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c 9 \u041c\u0411 \u0438 50 \u041c\u043f. \u0423\u043c\u0435\u043d\u044c\u0448\u0438\u0442\u0435 \u0444\u043e\u0442\u043e \u0438 \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u0435 \u0441\u043d\u043e\u0432\u0430."; }
        if (reason === 'format') { return "\u042d\u0442\u043e\u0442 \u0444\u0430\u0439\u043b \u043d\u0435 \u043f\u043e\u0434\u0445\u043e\u0434\u0438\u0442: \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u0435 \u0444\u043e\u0442\u043e \u0432 \u0444\u043e\u0440\u043c\u0430\u0442\u0435 JPEG, PNG \u0438\u043b\u0438 WebP."; }
        if (reason === 'unreadable') { return "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u044c \u0444\u0430\u0439\u043b \u2014 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043e\u043d \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0451\u043d. \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0434\u0440\u0443\u0433\u043e\u0435 \u0444\u043e\u0442\u043e."; }
        return "\u042d\u0442\u0430 \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0430 \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0430\u044f: \u043d\u0443\u0436\u043d\u043e \u043e\u0442 300 px \u043f\u043e \u0431\u043e\u043b\u044c\u0448\u0435\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u0435. \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0444\u0430\u0439\u043b \u043f\u043e\u0431\u043e\u043b\u044c\u0448\u0435.";
    }
    function validateImage(file) {
        if (!file) { return Promise.resolve({ok: false, reason: 'missing'}); }
        if (file.size > MAX_INPUT_BYTES) { return Promise.resolve({ok: false, reason: 'too_large'}); }
        var mime = String(file.type || '').toLowerCase();
        if ((mime && ACCEPTED_IMAGE_TYPES.indexOf(mime) === -1) || (!mime && !ACCEPTED_IMAGE_EXTENSIONS.test(file.name || ''))) {
            return Promise.resolve({ok: false, reason: 'format'});
        }
        return new Promise(function (resolve) {
            if (!window.URL || !window.URL.createObjectURL) { resolve({ok: false, reason: 'unreadable'}); return; }
            var url = URL.createObjectURL(file);
            var probe = new Image();
            probe.onload = function () {
                URL.revokeObjectURL(url);
                var pixels = probe.naturalWidth * probe.naturalHeight;
                if (!probe.naturalWidth || !probe.naturalHeight) { resolve({ok: false, reason: 'unreadable'}); return; }
                if (pixels > MAX_INPUT_PIXELS) { resolve({ok: false, reason: 'too_large'}); return; }
                if (Math.max(probe.naturalWidth, probe.naturalHeight) < MIN_INPUT_SIDE_PX) {
                    resolve({ok: false, reason: 'image_too_small'}); return;
                }
                resolve({ok: true});
            };
            probe.onerror = function () { URL.revokeObjectURL(url); resolve({ok: false, reason: 'unreadable'}); };
            probe.src = url;
        });
