</header>
<script>
/* Keep the header on one row at every width, locale and account state:
   the signed-in row (plan, +25%, +3, «Мои модели», task count) is wider
   than the fixed breakpoints in redesign.css expect, and on 1366–1536px
   laptops it pushed «Мои модели» off screen. Try the steps in order and
   keep the first that fits; ag-fit-* rules sit with the header styles. */
(function () {
    var header = document.querySelector('.ag-header');
    var inner = header && header.querySelector('.ag-header__inner');
    if (!inner) return;
    var KEYS = ['w', 'l', 'p', 't', 'n', 'r', 'c'];
    // w wordmark, l compact language and spacing, p plan (kept as long as
    // possible), t chip texts, n desktop links into the ☰ menu, r +25% chip,
    // c two-line «Мои модели».
    var STEPS = [[], ['w'], ['w', 'l'], ['w', 'l', 'p'], ['w', 'l', 'p', 't'],
        ['n'], ['n', 'w'], ['n', 'w', 'p'], ['n', 'w', 'p', 't'], ['n', 'w', 'p', 't', 'r'], ['n', 'w', 'p', 't', 'r', 'c']];
    var SLOTS = '.ag-header__left > *, .ag-header__nav--desktop > *, .ag-header__actions > *';
    // Within the padding, not just the box: scrollWidth ignores the end
    // padding, so «Мои модели» could sit flush against the screen edge.
    function fits() {
        var box = inner.getBoundingClientRect(), style = getComputedStyle(inner);
        var start = box.left + parseFloat(style.paddingLeft) - 1, end = box.right - parseFloat(style.paddingRight) + 1;
        var nodes = inner.querySelectorAll(SLOTS);
        for (var i = 0; i < nodes.length; i++) {
            var rect = nodes[i].getBoundingClientRect();
            if (rect.width && (rect.right > end || rect.left < start)) return false;
        }
        return true;
    }
    function fit() {
        for (var i = 0; i < STEPS.length; i++) {
            for (var k = 0; k < KEYS.length; k++) header.classList.toggle('ag-fit-' + KEYS[k], STEPS[i].indexOf(KEYS[k]) !== -1);
            if (fits()) return;
        }
    }
    var queued = false;
    function later() {
        if (queued) return;
        queued = true;
        requestAnimationFrame(function () { queued = false; fit(); });
    }
    fit();
    window.addEventListener('resize', later);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(later);
    var actions = header.querySelector('.ag-header__actions');
    // Credits arrive late and the task count comes and goes.
    if (actions && window.MutationObserver) {
        new MutationObserver(later).observe(actions, {subtree: true, childList: true, characterData: true, attributes: true, attributeFilter: ['hidden']});
    }
})();
</script>



