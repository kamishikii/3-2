                <form method="POST" action="/reset_password_route">
                    <input type="hidden" name="next" value="/">
                    <input type="hidden" name="_csrf_token" value="-gPzKf8lCJcmeWfVZd70ci4PytFx0P_nz8ujlXEmw3w">
                    <div class="form-group">
                        <label for="reset-email">Email:</label>
                        <input type="email" class="form-control" id="reset-email" name="email"
                            autocomplete="email" placeholder="Email" required>
