</div>

<style>
/* Неверный вход: тема и фиолетовый :focus !important из style.css перекрывают
   рамку .is-invalid из Bootstrap, возвращаем её. */
#authAccordion .form-control.is-invalid,
#authAccordion .form-control.is-invalid:focus {
    border-color: var(--destructive) !important;
    box-shadow: 0 0 0 2px color-mix(in oklab, var(--destructive) 25%, transparent) !important;
}
</style>
<script>
// Flip the login/register accordion panes with plain class toggles, NOT
// jQuery(...).collapse(): Bootstrap 4 silently aborts collapse('show') while
// its accordion sibling is mid-transition, so firing hide+show in the same
// tick left the register pane permanently closed. Focus lands after the
// drawer/sidebar open animation settles.
window.aiprintgenAuthPanelActivate = function (mode) {
    var showRegister = mode === 'register';
    var showReset = mode === 'reset';
    var showLogin = !showRegister && !showReset;
    var loginCollapse = document.getElementById('collapseLogin');
    var registerCollapse = document.getElementById('collapseRegister');
    var resetCollapse = document.getElementById('collapseReset');
    if (!loginCollapse || !registerCollapse) {
        return;
    }
    var loginToggle = document.querySelector('[data-target="#collapseLogin"]');
    var registerToggle = document.getElementById('register_btn');
    var resetToggle = document.querySelector('[data-target="#collapseReset"]');
    loginCollapse.classList.toggle('show', showLogin);
    registerCollapse.classList.toggle('show', showRegister);
    if (resetCollapse) {
        resetCollapse.classList.toggle('show', showReset);
    }
    if (loginToggle) {
        loginToggle.classList.toggle('collapsed', !showLogin);
        loginToggle.setAttribute('aria-expanded', showLogin ? 'true' : 'false');
    }
    if (registerToggle) {
        registerToggle.classList.toggle('collapsed', !showRegister);
        registerToggle.setAttribute('aria-expanded', showRegister ? 'true' : 'false');
    }
    if (resetToggle) {
        resetToggle.classList.toggle('collapsed', !showReset);
        resetToggle.setAttribute('aria-expanded', showReset ? 'true' : 'false');
    }
    window.setTimeout(function () {
        var focusTarget = document.getElementById(
            showReset ? 'reset-email' : (showRegister ? 'register-email' : 'login-email')
        );
        if (focusTarget && typeof focusTarget.focus === 'function') {
            focusTarget.focus();
        }
    }, 220);
};

document.addEventListener('DOMContentLoaded', function () {
    // «Показать/Скрыть» у полей пароля: опечатку в единственном поле регистрации
    // иначе не заметить, а потом вход по нему отказывает.
    document.querySelectorAll('[data-password-toggle]').forEach(function (button) {
        button.addEventListener('click', function () {
            var input = document.getElementById(button.getAttribute('data-password-toggle'));
            if (!input) { return; }
            var reveal = input.type === 'password';
            input.type = reveal ? 'text' : 'password';
            button.setAttribute('aria-pressed', reveal ? 'true' : 'false');
            button.textContent = button.getAttribute(reveal ? 'data-label-hide' : 'data-label-show');
        });
    });
    // «Забыли пароль?» под полем входа: открывает восстановление и переносит
    // уже набранную почту, чтобы не вводить её второй раз.
    document.querySelectorAll('[data-auth-forgot]').forEach(function (link) {
        link.addEventListener('click', function (event) {
            event.preventDefault();
            var loginEmail = document.getElementById('login-email');
            var resetEmail = document.getElementById('reset-email');
            if (resetEmail && loginEmail && loginEmail.value && !resetEmail.value) {
                resetEmail.value = loginEmail.value;
            }
            window.aiprintgenAuthPanelActivate('reset');
        });
    });
    async function prepareAuthNavigation(control) {
        if (control.dataset.authSaving === '1') { return false; }
        control.dataset.authSaving = '1';
        try {
            if (!window.AiprintgenDraft) { return true; }
            var saved = await window.AiprintgenDraft.beforeAuth();
            return saved || window.confirm(window.aiprintgenDraftI18n.failed + '\n' + window.aiprintgenDraftI18n.continue);
        } finally { delete control.dataset.authSaving; }
    }
    // Вход уходит fetch-ем: при неверном пароле панель остаётся открытой,
    // ошибка встаёт над формой, фокус — в поле пароля. Любой другой исход
    // (успех, неподтверждённая почта, блок аккаунта) — переход, как у обычного POST.
    async function submitLoginInline(form) {
        if (form.dataset.authSubmitting === '1') { return; }
        form.dataset.authSubmitting = '1';
        var button = form.querySelector('button[type="submit"]');
        if (button) { button.disabled = true; }
        var payload = null;
        try {
            var response = await fetch(form.action, {
                method: 'POST', body: new FormData(form), credentials: 'same-origin',
                headers: {'X-Auth-Inline': '1', 'Accept': 'application/json'}
            });
            payload = await response.json();
        } catch (error) {
            payload = null;
        }
        if (payload && payload.redirect) {
            window.location.assign(payload.redirect);
            return;
        }
        if (!payload || !payload.error) {
            // Сеть, CSRF или ещё старый сервер на перекате: обычный POST покажет flash.
            HTMLFormElement.prototype.submit.call(form);
            return;
        }
        delete form.dataset.authSubmitting;
        if (button) { button.disabled = false; }
        var box = document.getElementById('login-error');
        if (box) {
            box.textContent = payload.error;
            box.hidden = false;
        }
        var field = document.getElementById(payload.field === 'email' ? 'login-email' : 'login-password');
        if (field) {
            field.classList.add('is-invalid');
            field.setAttribute('aria-invalid', 'true');
            field.setAttribute('aria-describedby', 'login-error');
            field.focus();
            if (typeof field.select === 'function') { field.select(); }
        }
    }
    ['login-email', 'login-password'].forEach(function (id) {
        var field = document.getElementById(id);
        if (!field) { return; }
        field.addEventListener('input', function () {
            field.classList.remove('is-invalid');
            field.removeAttribute('aria-invalid');
        });
    });
    // Возврат «Назад» из bfcache не должен оставить кнопку входа выключенной.
    window.addEventListener('pageshow', function (event) {
        if (!event.persisted) { return; }
        document.querySelectorAll('#authAccordion form[data-auth-submitting]').forEach(function (form) {
            delete form.dataset.authSubmitting;
            var button = form.querySelector('button[type="submit"]');
            if (button) { button.disabled = false; }
        });
    });
    document.querySelectorAll('#authAccordion form').forEach(function (form) {
        form.addEventListener('submit', async function (event) {
            event.preventDefault();
            if (!await prepareAuthNavigation(form)) { return; }
            var next = form.querySelector('input[name="next"]');
            if (next && window.AiprintgenDraft) {
                next.value = window.AiprintgenDraft.safeReturn(window.aiprintgenAuthReturnUrl || next.value) || window.location.pathname;
            }
            if (!/reset_password/.test(form.action) && window.AiprintgenProduct) window.AiprintgenProduct.authStarted(form, 'email');
            if (form.querySelector('#login-password')) { submitLoginInline(form); return; }
            HTMLFormElement.prototype.submit.call(form);
        });
    });
    function bindOauthRedirect(id, url) {
        var el = document.getElementById(id);
        if (el) {
            el.addEventListener('click', async function () {
                if (!await prepareAuthNavigation(el)) { return; }
                var destination = new URL(url, window.location.origin);
                var explicitReturn = String(window.aiprintgenAuthReturnUrl || window.location.pathname + window.location.search + window.location.hash);
                if (window.AiprintgenDraft) { explicitReturn = window.AiprintgenDraft.safeReturn(explicitReturn); }
                if (explicitReturn.charAt(0) === '/' && explicitReturn.slice(0, 2) !== '//' && explicitReturn.indexOf('\\') === -1) {
                    destination.searchParams.set('return_url', explicitReturn);
                }
                if (window.AiprintgenProduct) window.AiprintgenProduct.authStarted(el, id.indexOf('yandex') === 0 ? 'other' : id.split('-')[0], destination);
                window.location.href = destination.toString();
            });
        }
    }
    var googleUrl = "/google_login?return_url=https://aiprintgen.ru/";
    bindOauthRedirect('google-login', googleUrl);
    bindOauthRedirect('google-login-register', googleUrl);
    bindOauthRedirect('yandex-login', "/yandex_login");
    bindOauthRedirect('yandex-login-register', "/yandex_login");
    bindOauthRedirect('vk-login', "/vk_login");
    bindOauthRedirect('vk-login-register', "/vk_login");
    document.querySelectorAll('[data-telegram-login-trigger]').forEach(function (button) {
        button.addEventListener('click', async function () {
            if (!await prepareAuthNavigation(button)) { return; }
            var loginUrl = new URL('/telegram_login', window.location.origin);
            if (window.AiprintgenProduct) window.AiprintgenProduct.authStarted(button, 'telegram', loginUrl);
            var explicitReturn = String(window.aiprintgenAuthReturnUrl || window.location.pathname + window.location.search + window.location.hash);
                if (window.AiprintgenDraft) { explicitReturn = window.AiprintgenDraft.safeReturn(explicitReturn); }
            // Keep only the canonical page path. Query strings previously
            // produced an unbounded crawler fan-out through nested return_url.
            // The only accepted query here is our own opaque catalog flow id,
            // already returned by the same-origin session endpoint.
            loginUrl.searchParams.set(
                'return_url',
                explicitReturn.charAt(0) === '/' && explicitReturn.slice(0, 2) !== '//' && explicitReturn.indexOf('\\') === -1
                    ? window.location.origin + explicitReturn
                    : window.location.origin + window.location.pathname
            );
            window.location.assign(loginUrl.toString());
        });
    });
});
</script>
</div>

        
    </aside>
    

    <div class="flex-grow-1 app-main-column ">
        <!-- Flexbox container to ensure footer is at the bottom -->
        <div class="d-flex flex-column min-vh-100">
            <!-- Flash messages -->
            
            
            

            

            <!-- Main Content (flex-grow to fill remaining space) -->
