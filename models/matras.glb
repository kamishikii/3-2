                        <button type="button" id="photo-refinement-open" class="btn image-offer__action"
                            aria-controls="image-gen" data-short-label="Доработать" data-replace-confirm="Заменить текущий черновик в «Картинка для 3D» этой фотографией?">
                            <svg class="aiprintgen-image-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8" cy="8" r="1.5"/><path d="m21 15-5-5L5 21M3 16l4-4 4 4"/></svg> Изменить картинку перед созданием 3D
                        </button>
                        <p id="photo-refinement-error" class="text-danger" role="alert" hidden>Не удалось перенести фото. Попробуйте ещё раз или загрузите его в «Картинка для 3D».</p>
                    </div>

                    

                    <div id="image-gen-settings"><!-- Generation Settings Panel -->
<style>
    .generation-settings-panel {
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 6px;
        padding: 15px;
        margin-bottom: 20px;
        display: none; /* Hidden by default */
    }
    
    .generation-settings-toggle {
        cursor: pointer;
        margin-bottom: 15px;
        color: #495057;
        display: flex;
        align-items: center;
        user-select: none;
        padding: 5px;
        border: 0;
        background: transparent;
        min-height: 44px;
        text-align: left;
        border-radius: 4px;
    }
    
    .generation-settings-toggle:hover {
        background-color: #e9ecef;
    }
    
    .toggle-arrow {
        display: inline-block;
        margin-right: 10px;
        transition: transform 0.3s;
    }
    
    .toggle-arrow.open {
        transform: rotate(90deg);
    }
    
    .generation-settings-panel h5 {
        color: #495057;
        margin-bottom: 15px;
        font-size: 1.1rem;
        font-weight: 500;
        border-bottom: 1px solid #dee2e6;
        padding-bottom: 8px;
    }
    
    .custom-control-label {
        cursor: pointer;
    }
    
    .custom-range::-webkit-slider-thumb {
        background-color: #007bff;
    }
    
    .custom-range::-moz-range-thumb {
        background-color: #007bff;
    }
    
    .custom-range::-ms-thumb {
        background-color: #007bff;
    }

</style>



<fieldset class="generation-modes" data-generation-modes data-generation-source="image"
    data-generation-submit-error="Сейчас повышенная нагрузка на сервис генерации — это не ошибка в ваших данных. Попробуйте снова через несколько минут."
    data-generation-submit-owner="">
    <input type="hidden" name="generation_submit_id" value="" autocomplete="off">
    <legend>Режим генерации</legend>
    

    <div class="generation-mode-grid">
        
        
        <label class="generation-mode-card" for="generation-mode-image-start">
            <input type="radio" id="generation-mode-image-start" name="generation_mode" value="start" checked autocomplete="off">
            <span><strong>Старт</strong><small>Для первых моделей</small><small class="generation-mode-price" data-generation-mode-price="start"></small></span>
            
        </label>
        
        
        <label class="generation-mode-card" for="generation-mode-image-detail">
            <input type="radio" id="generation-mode-image-detail" name="generation_mode" value="detail"  autocomplete="off">
            <span><strong>Детали</strong><small>Без контент-фильтра</small><small class="generation-mode-price" data-generation-mode-price="detail"></small></span>
            
        </label>
        
        
        <label class="generation-mode-card is-plan-locked" for="generation-mode-image-detail_4m" tabindex="0">
            <input type="radio" id="generation-mode-image-detail_4m" name="generation_mode" value="detail_4m"  disabled data-plan-locked autocomplete="off">
            <span><strong>Детали 4М</strong><small>Плотная сетка · без контент-фильтра</small><small class="generation-mode-price" data-generation-mode-price="detail_4m"></small></span>
            
<span class="plan-lock-coin" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="10.5" fill="#F4C542" stroke="#B7860B" stroke-width="1.5"/><circle cx="12" cy="12" r="6.5" fill="none" stroke="#B7860B" stroke-width="1.5"/></svg></span>
<span class="plan-lock-tip" role="tooltip">Доступно на платных тарифах</span>
        </label>
        
        
        <label class="generation-mode-card is-plan-locked" for="generation-mode-image-balanced" tabindex="0">
            <input type="radio" id="generation-mode-image-balanced" name="generation_mode" value="balanced"  disabled data-plan-locked autocomplete="off">
            <span><strong>Баланс</strong><small>Проработка формы и пропорций</small><small class="generation-mode-price" data-generation-mode-price="balanced"></small></span>
            
<span class="plan-lock-coin" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="10.5" fill="#F4C542" stroke="#B7860B" stroke-width="1.5"/><circle cx="12" cy="12" r="6.5" fill="none" stroke="#B7860B" stroke-width="1.5"/></svg></span>
<span class="plan-lock-tip" role="tooltip">Доступно на платных тарифах</span>
        </label>
        
        
        <label class="generation-mode-card is-plan-locked" for="generation-mode-image-precise" tabindex="0">
            <input type="radio" id="generation-mode-image-precise" name="generation_mode" value="precise"  disabled data-plan-locked autocomplete="off">
            <span><strong>Точность</strong><small>Усиленная проработка сложных форм</small><small class="generation-mode-price" data-generation-mode-price="precise"></small></span>
            
<span class="plan-lock-coin" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="10.5" fill="#F4C542" stroke="#B7860B" stroke-width="1.5"/><circle cx="12" cy="12" r="6.5" fill="none" stroke="#B7860B" stroke-width="1.5"/></svg></span>
<span class="plan-lock-tip" role="tooltip">Доступно на платных тарифах</span>
        </label>
        
    </div>
    <div class="generation-texture-control">
        <label for="generation-texture-image"><input type="checkbox" name="generation_texture" id="generation-texture-image" checked disabled autocomplete="off" aria-describedby="generation-texture-hint-image"> <span data-generation-texture-label data-included-label="Текстура" data-optional-label="Добавить текстуру · +1 кредит">Текстура</span></label>
        <small class="form-text text-muted" id="generation-texture-hint-image" data-generation-texture-hint>Текстура включена в стоимость</small>
    </div>
    <small class="form-text text-muted" data-generation-front-hint hidden>Загрузите вид спереди и ещё хотя бы один ракурс (всего 2–4 изображения).</small>
</fieldset>


<!-- Toggle button for settings -->
<button type="button" class="generation-settings-toggle" onclick="toggleSettingsPanel(this)" aria-expanded="false" aria-controls="generation-settings-image">
    <span class="toggle-arrow">▶</span>
    <span>Настройки генерации</span>
</button>

<div class="generation-settings-panel" id="generation-settings-image">
    <div class="form-group d-none">
        <div class="custom-control custom-checkbox">
            <input type="checkbox" class="custom-control-input" id="detailed_textures_image" name="detailed_textures">
            <label class="custom-control-label" for="detailed_textures_image">Детальные текстуры</label>
        </div>
    </div>

    <div class="form-group">
        <div class="custom-control custom-checkbox">
            <input type="checkbox" class="custom-control-input fast-lowpoly-check" id="fast_lowpoly_image" name="fast_lowpoly">
            <label class="custom-control-label" for="fast_lowpoly_image">Low-poly</label>
        </div>
    </div>

    
    
    <fieldset class="form-group lowpoly-mode-options" hidden>
        <legend>Режим low-poly</legend>
        
        <div class="lowpoly-mode-grid">
            
            
            <label class="lowpoly-mode-card" for="lowpoly_mode_standard_image">
                <input type="radio" id="lowpoly_mode_standard_image" name="lowpoly_mode" value="standard" checked disabled>
                <span><strong>Обычный</strong>
                    <small>Около 10 мин</small>
                    <small>Без доплаты</small>
                    
                </span>
                
            </label>
            
            
            <label class="lowpoly-mode-card is-plan-locked" for="lowpoly_mode_fast_image" tabindex="0">
                <input type="radio" id="lowpoly_mode_fast_image" name="lowpoly_mode" value="fast"  disabled data-plan-locked>
                <span><strong>Быстрый</strong>
                    <small>Около 1 мин</small>
                    <small>+1 кредит за модель</small>
                    <small>Фиксировано: 8 000 полигонов</small>
                </span>
                
<span class="plan-lock-coin" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="10.5" fill="#F4C542" stroke="#B7860B" stroke-width="1.5"/><circle cx="12" cy="12" r="6.5" fill="none" stroke="#B7860B" stroke-width="1.5"/></svg></span>
<span class="plan-lock-tip" role="tooltip">Доступно на платных тарифах</span>
            </label>
            
            
            <label class="lowpoly-mode-card is-plan-locked" for="lowpoly_mode_quality_image" tabindex="0">
                <input type="radio" id="lowpoly_mode_quality_image" name="lowpoly_mode" value="quality"  disabled data-plan-locked>
                <span><strong>Качество</strong>
                    <small>Около 3 мин</small>
                    <small>+3 кредита за модель</small>
                    
                </span>
                
<span class="plan-lock-coin" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="10.5" fill="#F4C542" stroke="#B7860B" stroke-width="1.5"/><circle cx="12" cy="12" r="6.5" fill="none" stroke="#B7860B" stroke-width="1.5"/></svg></span>
<span class="plan-lock-tip" role="tooltip">Доступно на платных тарифах</span>
            </label>
            
        </div>
        
    </fieldset>
    

    <div class="form-group lowpoly-texture-settings" hidden>
        <label for="lowpoly_texture_resolution_image">Разрешение текстур</label>
        <select class="form-control" id="lowpoly_texture_resolution_image" name="lowpoly_texture_resolution" disabled>
            <option value="1024">1K</option>
            <option value="2048" selected>2K</option>
            <option value="4096">4K</option>
        </select>
    </div>

    <div class="form-group">
        <div class="custom-control custom-checkbox">
            <input type="checkbox" class="custom-control-input three-variants-check" id="generate_three_variants_image" name="generate_three_variants">
            <label class="custom-control-label" for="generate_three_variants_image" data-variant-price-template="Сгенерировать 3 варианта ({credits})">Сгенерировать 3 варианта (3 кредита)</label>
        </div>
    </div>

    
    

    <div class="form-group">
        <label class="ag-microlabel" for="purpose_image" style="margin-bottom: 0.4rem;">Оптимизировать для</label>
        <select class="form-control generation-purpose-select" id="purpose_image" name="purpose">
            <option value="3d_print" selected>3D-печать</option>
            <option value="vr_ar">VR/AR</option>
            <option value="gamedev">GameDev</option>
            <option value="cnc">ЧПУ</option>
            <option value="other">Другое</option>
        </select>
    </div>
    <script>
    (function () {
        // Persist the purpose choice like the other generation settings and
        // keep all three tab panels in sync. Default is 3d_print.
        var sel = document.getElementById('purpose_image');
        if (!sel) { return; }
        try {
            var saved = window.localStorage.getItem('aiprintgen.generation_purpose');
            // Пункт «—» убран: он значил то же, что «Другое».
            if (saved === '') { saved = 'other'; }
            if (saved !== null) { sel.value = saved; }
        } catch (e) {}
        sel.addEventListener('change', function () {
            try { window.localStorage.setItem('aiprintgen.generation_purpose', sel.value); } catch (e) {}
            document.querySelectorAll('.generation-purpose-select').forEach(function (other) {
                if (other !== sel) { other.value = sel.value; }
            });
        });
    })();
    </script>

    <div class="form-group mb-0 polygon-settings" hidden>
        <label for="poly_count_slider_image">Количество полигонов:</label>
        <div class="range-number-control">
            <input type="range" class="custom-range flex-grow-1 poly-slider" id="poly_count_slider_image" min="0" max="2000000" value="0" step="500" disabled>
            
            <input type="text" inputmode="numeric" class="form-control form-control-sm poly-input range-number-input" id="poly_count_input_image" name="poly_count" disabled min="0" max="2000000" value="Авто" placeholder="Авто" aria-label="Количество полигонов">
        </div>
    </div>
</div>

<script>
    // The ordinary model has no local compression target. Keep a separate
    // Low-poly choice so old ordinary targets cannot leak into this mode.
    function syncLowPolyTarget(panel) {
        panel = panel.closest('div[id$="-gen-settings"]') || panel;
        const lowPoly = panel.querySelector('.fast-lowpoly-check');
        const input = panel.querySelector('.poly-input');
        const slider = panel.querySelector('.poly-slider');
        if (!input || !slider) { return; }
        const form = panel.closest('form');
        const generationMode = form && form.querySelector('[name="generation_mode"]:checked:not(:disabled)');
        const alternative = generationMode ? generationMode.value === 'detail' : form && form.querySelector('[name="unfiltered_mode"]:checked') && !form.querySelector('[name="max_quality"]:checked');
        const lowPolyEnabled = Boolean(lowPoly && lowPoly.checked && !lowPoly.disabled);
        const selectedMode = panel.querySelector('[name="lowpoly_mode"]:checked');
        const fastMode = lowPolyEnabled && selectedMode && selectedMode.value === 'fast';
        // «Баланс» / «Точность» take a custom face limit (1K–2M, Auto = 0), like the old Tripo form.
        const tripoOption = Boolean(generationMode && (generationMode.value === 'balanced' || generationMode.value === 'precise'));
        const mode = alternative ? 'alternative' : tripoOption ? 'tripo' : lowPolyEnabled ? (fastMode ? 'lowpoly-fast' : 'lowpoly') : 'ordinary';
        const previousMode = input.dataset.targetMode;
        const value = parseInt(input.value, 10);
        if (previousMode === 'lowpoly') {
            panel.dataset.lowPolyTarget = String(Number.isFinite(value) && value > 0 ? Math.max(5000, Math.min(20000, value)) : 20000);
        } else if (previousMode === 'alternative') {
            panel.dataset.alternativePolyTarget = String(Number.isFinite(value) && value > 0 ? Math.max(100000, Math.min(2000000, value)) : 0);
        } else if (previousMode === 'tripo') {
            panel.dataset.tripoPolyTarget = String(Number.isFinite(value) && value > 0 ? Math.max(1000, Math.min(2000000, value)) : 0);
        }
        const enabled = mode !== 'ordinary';
        input.dataset.targetMode = mode;
        input.closest('.polygon-settings').hidden = !enabled || fastMode;
        input.disabled = slider.disabled = !enabled;
        input.min = slider.min = lowPolyEnabled ? '5000' : '0';
        input.max = slider.max = lowPolyEnabled ? '20000' : '2000000';
        slider.step = alternative ? '100000' : tripoOption ? '1000' : '500';
        const target = fastMode ? '8000' : mode === 'lowpoly' ? (panel.dataset.lowPolyTarget || '20000') : alternative ? (panel.dataset.alternativePolyTarget || '0') : tripoOption ? (panel.dataset.tripoPolyTarget || '0') : '0';
        slider.value = target;
        input.value = (alternative || tripoOption) && target === '0' ? "Авто" : target;
        input.setAttribute('data-auto', target === '0' ? 'true' : 'false');
    }

    // Global functions for settings persistence
    // Save settings to localStorage
    function saveSettings(panelId, isOpen, detailedTextures, polyCount) {
        try {
            // Create storage key based on panel ID
            const storageKey = 'genSettings_' + panelId;
            
            // Create settings object
            const settingsPanel = document.getElementById(panelId);
            if (settingsPanel) syncLowPolyTarget(settingsPanel);
            const settings = {
                isOpen: isOpen,
                detailedTextures: detailedTextures,
                polyCount: polyCount,
                lowPolyTarget: settingsPanel ? settingsPanel.dataset.lowPolyTarget : "20000",
                alternativePolyTarget: settingsPanel ? settingsPanel.dataset.alternativePolyTarget : "0"
            };
            
            // Save to localStorage
            localStorage.setItem(storageKey, JSON.stringify(settings));
        } catch (e) {
            console.error('Error saving settings:', e);
        }
    }
    
    // Load settings from localStorage
    function loadSettings(panelId) {
        try {
            // Create storage key based on panel ID
            const storageKey = 'genSettings_' + panelId;
            
            // Get settings from localStorage
            const settingsJson = localStorage.getItem(storageKey);
            
            if (settingsJson) {
                return JSON.parse(settingsJson);
            }
        } catch (e) {
            console.error('Error loading settings:', e);
        }
        
        // Return default settings if nothing found or error
        return {
            isOpen: false,
            detailedTextures: false,
            polyCount: "Авто"
        };
    }
    
    // Global function to toggle settings panel
    function toggleSettingsPanel(toggleElement) {
        // Find the panel that follows this toggle
        const settingsPanel = toggleElement.nextElementSibling;
        const toggleArrow = toggleElement.querySelector('.toggle-arrow');
        
        if (settingsPanel && toggleArrow) {
            const isOpen = settingsPanel.style.display === 'none' || settingsPanel.style.display === '';
            
            if (isOpen) {
                settingsPanel.style.display = 'block';
                toggleArrow.textContent = '▼';
            } else {
                settingsPanel.style.display = 'none';
                toggleArrow.textContent = '▶';
            }
            
            toggleElement.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            // Save panel state
            const parentContainer = toggleElement.closest('div[id$="-gen-settings"]');
            if (parentContainer) {
                const panelId = parentContainer.id;
                
                // Find settings elements
                const detailedTexturesCheckbox = parentContainer.querySelector('input[id^="detailed_textures_"]');
                const polyInput = parentContainer.querySelector('input.poly-input');
                
                // Get current values
                const detailedTextures = detailedTexturesCheckbox ? detailedTexturesCheckbox.checked : false;
                const polyCount = polyInput ? polyInput.value : "Авто";
                
                // Save settings
                saveSettings(panelId, isOpen, detailedTextures, polyCount);
            }
        }
    }
    
    document.addEventListener('DOMContentLoaded', function() {
        // Определяем глобальные функции обновления
        
        // Обновление текстового поля на основании значения слайдера
        window.updatePolyDisplay = function(slider, input) {
            if (parseInt(slider.value) === 0) {
                // Отображаем "Авто" вместо 0
                const autoText = "Авто";
                input.value = autoText;
                input.setAttribute('data-auto', 'true');
            } else {
                input.value = slider.value;
                input.setAttribute('data-auto', 'false');
            }
        };
        
        // Обновление слайдера на основании текстового значения
        window.updatePolySlider = function(input, slider, skipValidation) {
            const autoText = "Авто";
            if (input.dataset.targetMode === 'lowpoly') {
                let target = parseInt(input.value, 10);
                target = Number.isFinite(target) ? Math.max(5000, Math.min(20000, target)) : 20000;
                slider.value = String(target);
                input.setAttribute('data-auto', 'false');
                if (!skipValidation) input.value = String(target);
                return;
            }
            
            // Если текст "Авто" или пустая строка - устанавливаем 0
            if (input.value === autoText || input.value === '' || input.value === '0') {
                slider.value = 0;
                input.value = autoText;
                input.setAttribute('data-auto', 'true');
                return;
            }
            
            // Пытаемся преобразовать в число
            let numValue = parseInt(input.value);
            
            // Если не число или отрицательное, устанавливаем "Авто"
            if (isNaN(numValue) || numValue < 0) {
                slider.value = 0;
                input.value = autoText;
                input.setAttribute('data-auto', 'true');
                return;
            }
            
            // Проверка минимального и максимального значения только если не пропускаем валидацию
            if (!skipValidation) {
                // Ограничение максимального значения
                if (numValue > 2000000) {
                    numValue = 2000000;
                    input.value = numValue;
                }

                // Проверка на минимальное значение > 0 и < 500
                const minimum = input.dataset.targetMode === 'alternative' ? 100000 : input.dataset.targetMode === 'tripo' ? 1000 : 500;
                if (numValue > 0 && numValue < minimum) {
                    numValue = minimum;
                    input.value = numValue;
                }
            }
            
            // Устанавливаем значение слайдера
            slider.value = numValue;
            input.setAttribute('data-auto', 'false');
        };
        
        // Save settings function for each panel
        window.saveGenerationSettings = function(panelId, detailedTexturesCheckbox, polyInput) {
            // Get current values
            const detailedTextures = detailedTexturesCheckbox ? detailedTexturesCheckbox.checked : false;
            const polyCount = polyInput ? polyInput.value : "Авто";
            
            // Get panel state
            const panel = document.getElementById(panelId);
            const settingsPanel = panel ? panel.querySelector('.generation-settings-panel') : null;
            const isOpen = settingsPanel ? (settingsPanel.style.display === 'block') : false;
            
            // Save settings
            saveSettings(panelId, isOpen, detailedTextures, polyCount);
        };
        
        // Находим все контейнеры настроек генерации
        const allPanels = document.querySelectorAll('div[id$="-gen-settings"]');
        
        allPanels.forEach(function(panel) {
            if (panel.dataset.polygonSettingsInitialized) return;
            panel.dataset.polygonSettingsInitialized = 'true';
            // Получаем уникальный ID для создания уникальных ID элементов
            const uniqueId = panel.id.replace('-gen-settings', '');
            const panelId = panel.id;
            
            // Находим элементы управления
            const detailedTextures = panel.querySelector('input[id="detailed_textures_' + uniqueId + '"]');
            const polySlider = panel.querySelector('input[id="poly_count_slider_' + uniqueId + '"]');
            const polyInput = panel.querySelector('input[id="poly_count_input_' + uniqueId + '"]');
            
            // Обновляем ID для уникальности
            if (detailedTextures) {
                detailedTextures.id = 'detailed_textures_' + uniqueId;
                const detailedTexturesLabel = panel.querySelector('label[for="detailed_textures"]');
                if (detailedTexturesLabel) {
                    detailedTexturesLabel.setAttribute('for', detailedTextures.id);
                }
            }
            
            if (polySlider) {
                polySlider.id = 'poly_count_slider_' + uniqueId;
                const polySliderLabel = panel.querySelector('label[for="poly_count_slider"]');
                if (polySliderLabel) {
                    polySliderLabel.setAttribute('for', polySlider.id);
                }
            }
            
            if (polyInput) {
                polyInput.id = 'poly_count_input_' + uniqueId;
            }
            
            // Load saved settings
            try {
                const savedSettings = loadSettings(panelId);
                const savedAlternativeTarget = parseInt(savedSettings.alternativePolyTarget ?? savedSettings.polyCount, 10);
                panel.dataset.alternativePolyTarget = String(Number.isFinite(savedAlternativeTarget) && savedAlternativeTarget > 0 ? Math.max(100000, Math.min(2000000, savedAlternativeTarget)) : 0);
                const savedTarget = parseInt(savedSettings.lowPolyTarget, 10);
                panel.dataset.lowPolyTarget = String(Number.isFinite(savedTarget) ? Math.max(5000, Math.min(20000, savedTarget)) : 20000);
                
                // Apply saved state to panel
                const settingsPanel = panel.querySelector('.generation-settings-panel');
                const toggleElement = panel.querySelector('.generation-settings-toggle');
                const toggleArrow = toggleElement ? toggleElement.querySelector('.toggle-arrow') : null;
                
                if (toggleElement) { toggleElement.setAttribute('aria-expanded', savedSettings.isOpen ? 'true' : 'false'); }
                if (settingsPanel && savedSettings.isOpen) {
                    settingsPanel.style.display = 'block';
                    if (toggleArrow) {
                        toggleArrow.textContent = '▼';
                    }
                }
                
                // Apply saved detailed textures
                if (detailedTextures && savedSettings.detailedTextures !== undefined) {
                    detailedTextures.checked = savedSettings.detailedTextures;
                }
                
                // Apply saved polygon count
                if (polySlider && polyInput && savedSettings.polyCount) {
                    const autoText = "Авто";
                    
                    if (savedSettings.polyCount === autoText) {
                        polySlider.value = 0;
                        polyInput.value = autoText;
                        polyInput.setAttribute('data-auto', 'true');
                    } else {
                        // Try to parse as number
                        const numValue = parseInt(savedSettings.polyCount);
                        if (!isNaN(numValue) && numValue > 0) {
                            polySlider.value = numValue;
                            polyInput.value = numValue;
                            polyInput.setAttribute('data-auto', 'false');
                        } else {
                            // If not a valid number, use default
                            polySlider.value = 0;
                            polyInput.value = autoText;
                            polyInput.setAttribute('data-auto', 'true');
                        }
                    }
                }
            } catch (e) {
                console.error('Error applying saved settings:', e);
            }
            
            // Настраиваем синхронизацию слайдера и поля ввода
            if (polySlider && polyInput) {
                // Инициализируем значением из слайдера
                updatePolyDisplay(polySlider, polyInput);
                
                // Добавляем обработчики событий для слайдера
                polySlider.addEventListener('input', function() {
                    updatePolyDisplay(this, polyInput);
                });
                
                polySlider.addEventListener('change', function() {
                    // Save settings when slider value changes and user releases it
                    window.saveGenerationSettings(panelId, detailedTextures, polyInput);
                });
                
                // Добавляем обработчики для поля ввода
                
                // 1. Разрешаем только цифровой ввод, но с проверкой на "Авто"
                polyInput.addEventListener('keypress', function(e) {
                    const autoText = "Авто";
                    // Если текущее значение "Авто" и нажата любая клавиша - очищаем поле
                    if (this.value === autoText) {
                        this.value = '';
                        return;
                    }
                    
                    // Разрешаем только цифры
                    const char = String.fromCharCode(e.which);
                    if (!/[0-9]/.test(char)) {
                        e.preventDefault();
                    }
                });
                
                // 2. Обрабатываем изменение значения без валидации
                polyInput.addEventListener('input', function() {
                    // Пропускаем строгую валидацию при вводе
                    updatePolySlider(this, polySlider, true);
                });
                
                // 3. Обработка фокуса 
                polyInput.addEventListener('focus', function() {
                    const autoText = "Авто";
                    if (this.value === autoText) {
                        this.value = '';
                    }
                });
                
                // 4. Валидация при потере фокуса
                polyInput.addEventListener('blur', function() {
                    const autoText = "Авто";
                    if (this.value === '') {
                        this.value = autoText;
                    }
                    // Полная валидация при потере фокуса
                    updatePolySlider(this, polySlider, false);
                    if (this.dataset.targetMode !== 'alternative' && this.dataset.targetMode !== 'tripo') updatePolyDisplay(polySlider, this);
                    
                    // Save settings when input loses focus
                    window.saveGenerationSettings(panelId, detailedTextures, this);
                });
                
                // 5. Предотвращаем отправку формы клавишей Enter
                polyInput.addEventListener('keydown', function(event) {
                    if (event.key === 'Enter') {
                        event.preventDefault();
                        this.blur();
                        return false;
                    }
                });
                
                // 6. Синхронизируем значения перед отправкой формы
                const parentForm = panel.closest('form');
                if (parentForm) {
                    parentForm.addEventListener('reset', function() {
                        panel.dataset.lowPolyTarget = '20000';
                        panel.dataset.alternativePolyTarget = '0';
                        panel.dataset.tripoPolyTarget = '0';
                        polyInput.dataset.targetMode = 'ordinary';
                        setTimeout(function() { syncLowPolyTarget(panel); }, 0);
                    });
                    window.addEventListener('pageshow', function() { syncLowPolyTarget(panel); });
                    parentForm.addEventListener('submit', function() {
                        syncLowPolyTarget(panel);
                        // Сохраняем состояние чекбокса перед отправкой формы
                        if (detailedTextures) {
                            window.saveGenerationSettings(panelId, detailedTextures, polyInput);
                        }
                        
                        // Полная валидация перед отправкой
                        updatePolySlider(polyInput, polySlider, false);
                        // Если значение "Авто", ставим 0 для отправки
                        if (polyInput.getAttribute('data-auto') === 'true') {
                            polyInput.value = 0;
                        } else if (polyInput.dataset.targetMode !== 'alternative' && polyInput.dataset.targetMode !== 'tripo') {
                            polyInput.value = polySlider.value;
                        }
                    });
                }
            }
            
            // Add event listener for detailed textures checkbox
            if (detailedTextures) {
                detailedTextures.addEventListener('change', function() {
                    // Save settings when checkbox changes
                    window.saveGenerationSettings(panelId, this, polyInput);
                });
            }
        });

        // --- Mutual exclusivity for the experimental options ---
        // Low-poly and "3 variants" cannot segment. Each variant carries
        // its own mode surcharge. Preserve the selected polygon target.
        document.querySelectorAll('.generation-settings-panel').forEach(function(panel) {
            if (panel.dataset.exclusivityInitialized) return;
            panel.dataset.exclusivityInitialized = 'true';
            var lowPoly = panel.querySelector('input[name="fast_lowpoly"]');
            var threeVariants = panel.querySelector('input[name="generate_three_variants"]');
            var segment = panel.querySelector('input[name="segment_model"]');

            function refreshExclusivity() {
                var lowPolyEnabled = lowPoly && lowPoly.checked && !lowPoly.disabled;
                var modes = panel.querySelector('.lowpoly-mode-options');
                if (modes) {
                    if (lowPolyEnabled && panel.dataset.lowPolyEnabled !== 'true') {
                        modes.querySelector('[value="standard"]').checked = true;
                    }
                    modes.hidden = !lowPolyEnabled;
                    modes.querySelectorAll('input').forEach(function (input) { input.disabled = !lowPolyEnabled || input.hasAttribute('data-plan-locked'); });
                }
                panel.dataset.lowPolyEnabled = String(Boolean(lowPolyEnabled));
                syncLowPolyTarget(panel);
                var textureSettings = panel.querySelector('.lowpoly-texture-settings');
                if (textureSettings) {
                    var selectedMode = panel.querySelector('[name="lowpoly_mode"]:checked');
                    var textureChoiceEnabled = lowPolyEnabled && (!selectedMode || selectedMode.value === 'standard');
                    textureSettings.hidden = !textureChoiceEnabled;
                    textureSettings.querySelector('select').disabled = !textureChoiceEnabled;
                }
                var segBlocked = (lowPoly && (lowPoly.checked || lowPoly.disabled)) || (threeVariants && threeVariants.checked);
                if (segment) {
                    if (segBlocked) { segment.checked = false; segment.disabled = true; }
                    else { segment.disabled = false; }
                    var segGroup = segment.closest('.form-group');
                    if (segGroup) { segGroup.style.opacity = segBlocked ? '0.5' : ''; }
                }
            }

            [lowPoly, threeVariants, segment].forEach(function(cb) {
                if (cb) { cb.addEventListener('change', refreshExclusivity); }
            });
            panel.querySelectorAll('[name="lowpoly_mode"]').forEach(function (radio) {
                radio.addEventListener('change', refreshExclusivity);
            });
            var form = panel.closest('form');
            if (form) form.addEventListener('reset', function () { setTimeout(refreshExclusivity, 0); });
            refreshExclusivity();
        });
    });
</script> </div>
                    
                    
                    
                    <div class="form-group mt-3 background-removal-option" id="image-background-removal-option" hidden>
                        <style>
                            .background-removal-step { margin-top: 10px; padding: 10px 12px; border: 1px solid #dee2e6; border-radius: 8px; }
                            .background-removal-choice { display: flex; gap: 12px; margin-top: 8px; }
                            .background-removal-choice__item { flex: 1 1 0; min-width: 0; max-width: 220px; margin: 0; cursor: pointer;
                                border: 2px solid #dee2e6; border-radius: 8px; padding: 6px; text-align: center; }
                            .background-removal-choice__item input { position: absolute; opacity: 0; pointer-events: none; }
                            .background-removal-choice__item:has(input:checked) { border-color: #2e8b57; }
                            .background-removal-choice__item:focus-within { outline: 3px solid #1f7ae0; outline-offset: 2px; }
                            .background-removal-choice__item img { display: block; width: 100%; height: 160px; object-fit: contain;
                                border-radius: 4px; background-color: #fff;
                                background-image: linear-gradient(45deg, #eee 25%, transparent 25%, transparent 75%, #eee 75%),
                                    linear-gradient(45deg, #eee 25%, transparent 25%, transparent 75%, #eee 75%);
                                background-size: 16px 16px; background-position: 0 0, 8px 8px; }
                            .background-removal-step.is-attention { border-color: #dc3545; }
                            .generation-lock-overlay .background-removal-step { width: min(600px, 100%); box-sizing: border-box; margin-top: 0; background: #fff; }
                            .generation-lock-overlay.background-removal-ready .generation-lock-overlay__spinner,
                            .generation-lock-overlay.background-removal-ready .generation-lock-overlay__progress { display: none; }
                        </style>
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" class="custom-control-input" id="image_remove_background" autocomplete="off">
                            <label class="custom-control-label font-weight-bold" for="image_remove_background">
                                Удалить фон перед генерацией
                            </label>
                        </div>
                        <small class="form-text text-muted">Нажмите «Отправить»: уберём фон и покажем обе картинки. Выбор сразу запустит создание 3D. Удаление фона бесплатно.</small>
                        <input type="hidden" name="background_removed" id="image_background_removed" value="0">
                        <div class="background-removal-step" id="image-background-removal-choice" role="group" aria-labelledby="image-background-removal-choice-title" hidden>
                            <strong id="image-background-removal-choice-title">Шаг 2 из 2 · Выберите картинку для создания 3D</strong>
                            <div class="background-removal-choice">
                                <label class="background-removal-choice__item">
                                    <input type="radio" name="background_choice_ui" value="original" form="image-background-removal-none">
                                    <img id="image-background-removal-original" alt="Оригинал">
                                    <span>Оригинал</span>
                                </label>
                                <label class="background-removal-choice__item">
                                    <input type="radio" name="background_choice_ui" value="removed" form="image-background-removal-none">
                                    <img id="image-background-removal-removed" alt="Без фона">
                                    <span>Без фона</span>
                                </label>
                            </div>
                        </div>
                        <div class="small mt-2" id="image-background-removal-status" role="status" aria-live="polite" hidden></div>
                        <button type="button" class="btn btn-sm btn-outline-secondary mt-2" id="image-background-removal-retry" hidden>
                            Попробовать ещё раз
                        </button>
                    </div>
                    <script>
                    (function () {
                        var option = document.getElementById('image-background-removal-option');
                        var toggle = document.getElementById('image_remove_background');
                        var unfiltered = document.getElementById('image_unfiltered_mode');
                        var maxQuality = document.getElementById('image_max_quality_mode');
                        var fileInput = document.getElementById('image_prompt_input');
                        var form = document.getElementById('image-form');
                        var marker = document.getElementById('image_background_removed');
                        var status = document.getElementById('image-background-removal-status');
                        var choice = document.getElementById('image-background-removal-choice');
                        var retry = document.getElementById('image-background-removal-retry');
                        var originalPreview = document.getElementById('image-background-removal-original');
                        var removedPreview = document.getElementById('image-background-removal-removed');
                        if (!option || !toggle || !fileInput || !form) return;
                        var messages = {
                            error: "\u041d\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u043e\u0441\u044c \u0443\u0431\u0440\u0430\u0442\u044c \u0444\u043e\u043d. \u041c\u043e\u0436\u043d\u043e \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b \u0438\u043b\u0438 \u043f\u043e\u043f\u0440\u043e\u0431\u043e\u0432\u0430\u0442\u044c \u0435\u0449\u0451 \u0440\u0430\u0437.",
                            selectFile: "\u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0444\u043e\u0442\u043e.",
                            chooseRequired: "\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0443 \u2014 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 3D \u043d\u0430\u0447\u043d\u0451\u0442\u0441\u044f \u0441\u0440\u0430\u0437\u0443."
                        };
                        var originalFile = null;
                        var removedFile = null;
                        var objectUrls = [];
                        var requestSerial = 0;
                        var processing = false;
                        var continuing = false;
                        var resumedSubmitEvent = null;
                        var resumedSubmitAccepted = false;
                        var progressTimer = null;
                        var progressValue = 0;
                        var backgroundWaitActive = false;
                        var warmed = false;

                        function waitLock() { return window.AiprintgenGenerationLock; }
                        function waitOverlay() { return document.getElementById('generation-lock-overlay'); }
                        function returnChoiceToForm() {
                            if (choice.parentElement !== option) option.insertBefore(choice, status);
                            var overlay = waitOverlay();
                            if (overlay) overlay.classList.remove('background-removal-ready');
                        }
                        function hideWait() {
                            if (!backgroundWaitActive) return;
                            backgroundWaitActive = false;
                            var lock = waitLock();
                            if (lock && typeof lock.hide === 'function') lock.hide();
                        }

                        function setStatus(text, isError) {
                            status.textContent = text || '';
                            status.hidden = !text;
                            status.classList.toggle('text-danger', !!isError);
                        }
                        function revokeUrls() {
                            objectUrls.forEach(function (url) { URL.revokeObjectURL(url); });
                            objectUrls = [];
                        }
                        function updateProgress(value) {
                            progressValue = Math.max(progressValue, Math.min(100, value));
                            var lock = waitLock();
                            if (lock && typeof lock.progress === 'function') lock.progress(progressValue);
                        }
                        function stopProgress(finalValue) {
                            if (progressTimer) window.clearInterval(progressTimer);
                            progressTimer = null;
                            if (finalValue !== undefined) updateProgress(finalValue);
                        }
                        function startProgress() {
                            // No real progress comes back from the service, so
                            // approach 92% on a ~20 s curve and finish on response.
                            var started = Date.now();
                            stopProgress();
                            progressValue = 0;
                            var lock = waitLock();
                            if (lock && typeof lock.show === 'function') lock.show({
                                title: "\u0428\u0430\u0433 1 \u0438\u0437 2 \u00b7 \u0423\u0431\u0438\u0440\u0430\u0435\u043c \u0444\u043e\u043d",
                                body: "\u041e\u0431\u044b\u0447\u043d\u043e 15\u201330 \u0441\u0435\u043a\u0443\u043d\u0434, \u0432 \u043f\u0435\u0440\u0432\u044b\u0439 \u0440\u0430\u0437 \u0434\u043e \u043c\u0438\u043d\u0443\u0442\u044b."
                            });
                            backgroundWaitActive = true;
                            updateProgress(0);
                            progressTimer = window.setInterval(function () {
                                var seconds = (Date.now() - started) / 1000;
                                updateProgress(92 * (1 - Math.exp(-seconds / 20)));
                            }, 250);
                        }
                        function useFile(file) {
                            // Assigning .files does not fire "change", so the
                            // form's reset-on-new-photo logic is not triggered.
                            var transfer = new DataTransfer();
                            transfer.items.add(file);
                            fileInput.files = transfer.files;
                        }
                        function restoreOriginal() {
                            if (originalFile && fileInput.files[0] !== originalFile) {
                                try { useFile(originalFile); } catch (error) { /* keep what is there */ }
                            }
                            marker.value = '0';
                        }
                        function reset() {
                            requestSerial += 1;
                            processing = false;
                            continuing = false;
                            resumedSubmitEvent = null;
                            resumedSubmitAccepted = false;
                            restoreOriginal();
                            originalFile = null;
                            removedFile = null;
                            revokeUrls();
                            stopProgress();
                            returnChoiceToForm();
                            hideWait();
                            choice.hidden = true;
                            choice.classList.remove('is-attention');
                            choice.querySelectorAll('input[name="background_choice_ui"]').forEach(function (radio) { radio.checked = false; });
                            retry.hidden = true;
                            setStatus('');
                            toggle.checked = false;
                        }
                        function pick(value) {
                            if (continuing || (value !== 'original' && value !== 'removed')) return;
                            choice.classList.remove('is-attention');
                            setStatus('');
                            if (value === 'removed') {
                                try {
                                    if (!removedFile) throw new Error('cut-out unavailable');
                                    useFile(removedFile);
                                    marker.value = '1';
                                } catch (error) {
                                    restoreOriginal();
                                    returnChoiceToForm();
                                    hideWait();
                                    choice.hidden = true;
                                    retry.hidden = false;
                                    setStatus(messages.error, true);
                                    return;
                                }
                            } else {
                                restoreOriginal();
                            }
                            choice.hidden = true;
                            returnChoiceToForm();
                            // Keep the shared wait screen visible while the
                            // normal submit guard and durable POST take over.
                            // requestSubmit preserves the clicked button's
                            // explicit_image_submit name/value.
                            continuing = true;
                            resumedSubmitEvent = null;
                            resumedSubmitAccepted = false;
                            try {
                                form.requestSubmit(form.querySelector('#image-submit-button'));
                                // A photo still uploading holds the submit in the
                                // preupload, which runs before this form's listener
                                // and replays the submit when the upload settles.
                                // That is a pending submit, not a rejected one;
                                // `continuing` stays set so the replay is let through.
                                if (form.aiprintgenPreuploadHeld) {
                                    backgroundWaitActive = false;
                                    return;
                                }
                                // The durable submit handler prevents the native
                                // navigation after accepting the POST. Another
                                // guard can prevent it without starting a POST.
                                if (!resumedSubmitEvent ||
                                        (resumedSubmitEvent.defaultPrevented && !resumedSubmitAccepted)) {
                                    throw new Error('submit was not accepted');
                                }
                                backgroundWaitActive = false;
                            } catch (error) {
                                continuing = false;
                                form.dataset.submitting = '0';
                                hideWait();
                                retry.hidden = false;
                                setStatus(messages.error, true);
                            }
                        }
                        function run() {
                            if (processing || continuing) return;
                            var file = originalFile || fileInput.files[0];
                            if (!file) {
                                toggle.checked = false;
                                setStatus(messages.selectFile, true);
                                return;
                            }
                            if (!window.AIprintgenGenerationUploadLimits.validateFiles([file], form, 9000000)) return;
                            originalFile = file;
                            var serial = ++requestSerial;
                            processing = true;
                            returnChoiceToForm();
                            choice.hidden = true;
                            retry.hidden = true;
                            setStatus('');
                            startProgress();
                            var body = new FormData();
                            body.append('image', file, file.name || 'image');
                            fetch('/api/remove-background', { method: 'POST', body: body, credentials: 'same-origin' })
                                .then(function (response) {
                                    if (response.ok) return response.blob();
                                    return response.json().catch(function () { return {}; }).then(function (payload) {
                                        throw new Error((payload && payload.message) || messages.error);
                                    });
                                })
                                .then(function (blob) {
                                    if (serial !== requestSerial) return;
                                    processing = false;
                                    stopProgress(100);
                                    var stem = (file.name || 'image').replace(/\.[^.]+$/, '');
                                    removedFile = new File([blob], stem + '_no_background.png', { type: 'image/png' });
                                    // useFile() sets the input without a "change", so
                                    // the photo preupload never sees this file. Start
                                    // it now, while the user is still looking at the
                                    // two pictures.
                                    if (window.AIprintgenPhotoPreupload) window.AIprintgenPhotoPreupload.start(removedFile, form);
                                    revokeUrls();
                                    var originalUrl = URL.createObjectURL(originalFile);
                                    var removedUrl = URL.createObjectURL(removedFile);
                                    objectUrls.push(originalUrl, removedUrl);
                                    originalPreview.src = originalUrl;
                                    removedPreview.src = removedUrl;
                                    var overlay = waitOverlay();
                                    var slider = document.getElementById('gen-tips');
                                    if (overlay && slider) {
                                        slider.insertAdjacentElement('afterend', choice);
                                        overlay.classList.add('background-removal-ready');
                                    }
                                    choice.hidden = false;
                                    var lock = waitLock();
                                    if (lock && typeof lock.show === 'function') lock.show({
                                        title: "\u0428\u0430\u0433 2 \u0438\u0437 2 \u00b7 \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0443 \u0434\u043b\u044f \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f 3D",
                                        body: "\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0443 \u2014 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 3D \u043d\u0430\u0447\u043d\u0451\u0442\u0441\u044f \u0441\u0440\u0430\u0437\u0443."
                                    });
                                    choice.querySelector('input[name="background_choice_ui"]').focus();
                                })
                                .catch(function (error) {
                                    if (serial !== requestSerial) return;
                                    processing = false;
                                    stopProgress();
                                    returnChoiceToForm();
                                    hideWait();
                                    restoreOriginal();
                                    retry.hidden = false;
                                    setStatus(error && error.message ? error.message : messages.error, true);
                                });
                        }
                        function warmUp() {
                            // A sleeping Cloud Run instance takes a while to
                            // start; wake it while the user is still choosing.
                            if (warmed) return;
                            warmed = true;
                            fetch('/api/remove-background/warmup', { method: 'POST', credentials: 'same-origin' })
                                .catch(function () { /* best effort */ });
                        }
                        function sync() {
                            var selectedMode = form.querySelector('[name="generation_mode"]:checked');
                            var alternative = selectedMode ? true : ((unfiltered && unfiltered.checked) || (maxQuality && maxQuality.checked));
                            option.hidden = !alternative;
                            if (alternative) warmUp();
                            else if (toggle.checked || originalFile) reset();
                        }

                        toggle.addEventListener('change', function () {
                            if (!toggle.checked) reset();
                        });
                        retry.addEventListener('click', function () {
                            toggle.checked = true;
                            run();
                        });
                        choice.addEventListener('change', function (event) {
                            if (event.target && event.target.name === 'background_choice_ui') pick(event.target.value);
                        });
                        if (unfiltered) unfiltered.addEventListener('change', sync);
                        if (maxQuality) maxQuality.addEventListener('change', sync);
                        form.querySelectorAll('[name="generation_mode"]').forEach(function (radio) { radio.addEventListener('change', sync); });
                        // A new photo invalidates the cut-out; the form script
                        // above also clears both alternative checkboxes here.
                        fileInput.addEventListener('change', function () {
                            originalFile = null;
                            reset();
                            sync();
                        });
                        window.addEventListener('pageshow', function () {
                            reset();
                            sync();
                        });
                        // The first Submit starts the free cut-out. Only the
                        // image choice resumes the paid 3D generation.
                        form.addEventListener('submit', function (event) {
                            if (continuing) {
                                resumedSubmitEvent = event;
                                return;
                            }
                            if (!toggle.checked) return;
                            event.preventDefault();
                            event.stopImmediatePropagation();
                            if (!processing && choice.hidden) {
                                run();
                            } else if (!choice.hidden) {
                                choice.classList.add('is-attention');
                                setStatus(messages.chooseRequired, true);
                            }
                        }, true);
                        form.addEventListener('aiprintgen:image-submit-accepted', function () {
                            if (continuing) resumedSubmitAccepted = true;
                        });
                        sync();
                    }());
                    </script>
                    
                    
                    
                    
