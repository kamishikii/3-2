                var options = init ? Object.assign({}, init) : {};
                var requestMethod = options.method;
                if (!requestMethod && input && typeof input === 'object' && typeof input.method === 'string') {
                    requestMethod = input.method;
                }
                var method = String(requestMethod || 'GET').toUpperCase();
                var requestUrl = '';
                if (typeof input === 'string') {
                    requestUrl = input;
                } else if (input && typeof input.url === 'string') {
                    requestUrl = input.url;
                } else if (input && typeof input.href === 'string') {
                    // URL object: the VK/Mail.ru pixel posts fetch(new URL(...)),
                    // and our token header broke its CORS preflight.
                    requestUrl = input.href;
                }
