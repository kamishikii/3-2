    .generation-settings-toggle {
        cursor: pointer;
        margin-bottom: 15px;
        color: #495057;
        display: flex;
        align-items: center;
        user-select: none;
        padding: 5px;
        border: 0;
        background: transparent;
        min-height: 44px;
        text-align: left;
        border-radius: 4px;
    }
    
    .generation-settings-toggle:hover {
        background-color: #e9ecef;
    }
    
    .toggle-arrow {
        display: inline-block;
        margin-right: 10px;
        transition: transform 0.3s;
    }
    
    .toggle-arrow.open {
        transform: rotate(90deg);
