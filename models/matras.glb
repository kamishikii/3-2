        <label for="generation-texture-text"><input type="checkbox" name="generation_texture" id="generation-texture-text" checked disabled autocomplete="off" aria-describedby="generation-texture-hint-text"> <span data-generation-texture-label data-included-label="Текстура" data-optional-label="Добавить текстуру · +1 кредит">Текстура</span></label>
        <small class="form-text text-muted" id="generation-texture-hint-text" data-generation-texture-hint>Текстура включена в стоимость</small>
