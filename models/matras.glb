    data-i18n='{"bbjs_anon_save_hint": "\u0424\u0430\u0439\u043b \u0441\u043a\u0430\u0447\u0430\u043d. \u0417\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u0443\u0439\u0442\u0435\u0441\u044c, \u0447\u0442\u043e\u0431\u044b \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u043f\u0440\u043e\u0435\u043a\u0442 \u0432 \u00ab\u041c\u043e\u0438 \u043c\u043e\u0434\u0435\u043b\u0438\u00bb \u0438 \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u043a \u043d\u0435\u043c\u0443 \u043f\u043e\u0437\u0436\u0435.", "bbjs_base_diameter": "\u0414\u0418\u0410\u041c\u0415\u0422\u0420 \u041e\u0421\u041d\u041e\u0412\u0410\u041d\u0418\u042f", "bbjs_base_length": "\u0414\u041b\u0418\u041d\u0410 \u041e\u0421\u041d\u041e\u0412\u0410\u041d\u0418\u042f", "bbjs_boot_failed": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c 3D-\u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u043e\u0440: \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442 Three.js \u0438\u043b\u0438 canvas.", "bbjs_building_glb": "\u0413\u043e\u0442\u043e\u0432\u0438\u043c GLB\u2026", "bbjs_building_stl": "\u0413\u043e\u0442\u043e\u0432\u0438\u043c STL\u2026", "bbjs_camera_reset": "\u041a\u0430\u043c\u0435\u0440\u0430 \u0441\u0431\u0440\u043e\u0448\u0435\u043d\u0430.", "bbjs_create_account": "\u0421\u041e\u0417\u0414\u0410\u0422\u042c \u0410\u041a\u041a\u0410\u0423\u041d\u0422", "bbjs_cyrillic": "\u043a\u0438\u0440\u0438\u043b\u043b\u0438\u0446\u0443", "bbjs_cyrillic_greek": "\u043a\u0438\u0440\u0438\u043b\u043b\u0438\u0446\u0443 \u0438 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0439", "bbjs_cyrillic_greek_text": "\u043a\u0438\u0440\u0438\u043b\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0438 \u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0442\u0435\u043a\u0441\u0442\u0430", "bbjs_cyrillic_text": "\u043a\u0438\u0440\u0438\u043b\u043b\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0442\u0435\u043a\u0441\u0442\u0430", "bbjs_dim_base": "\u041e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 ", "bbjs_dim_model": "\u041c\u043e\u0434\u0435\u043b\u044c ", "bbjs_dim_plate": "\u0422\u0430\u0431\u043b\u0438\u0447\u043a\u0430 ", "bbjs_dim_surface": "\u0420\u0435\u043b\u044c\u0435\u0444 +", "bbjs_dim_total": "\u0418\u0442\u043e\u0433 ", "bbjs_discard_draft": "\u0423\u0414\u0410\u041b\u0418\u0422\u042c \u0427\u0415\u0420\u041d\u041e\u0412\u0418\u041a", "bbjs_draft_discarded": "\u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a \u0443\u0434\u0430\u043b\u0451\u043d.", "bbjs_draft_ready": "\u041f\u0440\u043e\u0435\u043a\u0442 \u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d \u0432 \u044d\u0442\u043e\u043c \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0435. \u0412\u043e\u0439\u0434\u0438\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u0437\u0430 1 \u043a\u0440\u0435\u0434\u0438\u0442.", "bbjs_draft_restored": "\u041f\u0440\u043e\u0435\u043a\u0442, \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u043d\u044b\u0439 \u0434\u043e \u0432\u0445\u043e\u0434\u0430, \u0433\u043e\u0442\u043e\u0432 \u043a \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044e \u0437\u0430 1 \u043a\u0440\u0435\u0434\u0438\u0442.", "bbjs_draft_store_failed": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u043f\u0440\u043e\u0435\u043a\u0442 \u0434\u043b\u044f \u0432\u0445\u043e\u0434\u0430. \u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u0441\u043a\u0430\u0447\u0430\u0439\u0442\u0435 STL \u0438\u043b\u0438 GLB \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e.", "bbjs_export_timeout": "\u044d\u043a\u0441\u043f\u043e\u0440\u0442 GLB \u043d\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b\u0441\u044f \u0437\u0430 60 \u0441\u0435\u043a\u0443\u043d\u0434", "bbjs_external_gltf": "\u0412\u043d\u0435\u0448\u043d\u0438\u0435 \u0444\u0430\u0439\u043b\u044b GLTF \u043d\u0435 \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u044e\u0442\u0441\u044f. \u0412\u0441\u0442\u0440\u043e\u0439\u0442\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044b \u043a\u0430\u043a data URI \u0438\u043b\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0441\u0430\u043c\u043e\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u044b\u0439 GLB.", "bbjs_finish_save": "\u0417\u0410\u0412\u0415\u0420\u0428\u0418\u0422\u042c \u0421\u041e\u0425\u0420\u0410\u041d\u0415\u041d\u0418\u0415 \u00b7 1 \u041a\u0420\u0415\u0414\u0418\u0422", "bbjs_font_filter_count": "\u0414\u043b\u044f {label} \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u044b {shown} \u0438\u0437 {total} \u0448\u0440\u0438\u0444\u0442\u043e\u0432 \u0441 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u043c\u0438 \u0433\u043b\u0438\u0444\u0430\u043c\u0438. \u041d\u0435\u0441\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u043c\u044b\u0435 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b \u0441\u043a\u0440\u044b\u0442\u044b.", "bbjs_font_switched": "{previous} \u043d\u0435 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 {support} \u2014 \u0432\u044b\u0431\u0440\u0430\u043d {replacement}. {count}", "bbjs_glb_downloaded": "GLB \u0441\u043a\u0430\u0447\u0430\u043d.", "bbjs_glb_error": "\u041e\u0448\u0438\u0431\u043a\u0430 GLB: ", "bbjs_glb_failed": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u044d\u043a\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c GLB: ", "bbjs_glb_no_scene": "\u0412 GLB \u043d\u0435\u0442 JSON-\u0441\u0446\u0435\u043d\u044b.", "bbjs_gltf_error": "\u041e\u0448\u0438\u0431\u043a\u0430 GLTF/GLB: ", "bbjs_gltf_loaded_note": "GLTF \u0437\u0430\u0433\u0440\u0443\u0436\u0435\u043d. \u0412\u043d\u0435\u0448\u043d\u0438\u0435 \u0444\u0430\u0439\u043b\u044b \u0442\u0435\u043a\u0441\u0442\u0443\u0440/\u0431\u0443\u0444\u0435\u0440\u043e\u0432 \u043d\u0435 \u0447\u0438\u0442\u0430\u044e\u0442\u0441\u044f; \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0432\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u044b\u0435 data URI \u0438\u043b\u0438 GLB.", "bbjs_greek": "\u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0439", "bbjs_greek_text": "\u0433\u0440\u0435\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0442\u0435\u043a\u0441\u0442\u0430", "bbjs_invalid_glb": "\u041d\u0435\u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u044b\u0439 GLB-\u0444\u0430\u0439\u043b.", "bbjs_invalid_glb_header": "\u041d\u0435\u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u044b\u0439 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a GLB.", "bbjs_list_failed": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u0441\u043f\u0438\u0441\u043e\u043a: ", "bbjs_list_unavailable": "\u0421\u043f\u0438\u0441\u043e\u043a \u043c\u043e\u0434\u0435\u043b\u0435\u0439 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d.", "bbjs_load_failed": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u043c\u043e\u0434\u0435\u043b\u044c: ", "bbjs_loading_list": "\u0417\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u043c \u0441\u043f\u0438\u0441\u043e\u043a\u2026", "bbjs_loading_model": "\u0417\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u043c \u043c\u043e\u0434\u0435\u043b\u044c\u2026", "bbjs_loading_typeface": "\u0417\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u043c \u0448\u0440\u0438\u0444\u0442\u2026", "bbjs_missing_components": "\u041d\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u043e\u0432 Three.js: ", "bbjs_missing_loader": "\u041d\u0435 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0451\u043d \u0437\u0430\u0433\u0440\u0443\u0437\u0447\u0438\u043a ", "bbjs_model_centered": "\u041c\u043e\u0434\u0435\u043b\u044c \u043e\u0442\u0446\u0435\u043d\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0430.", "bbjs_model_from_library": "\u043c\u043e\u0434\u0435\u043b\u044c \u0438\u0437 \u00ab\u041c\u043e\u0438\u0445 \u043c\u043e\u0434\u0435\u043b\u0435\u0439\u00bb", "bbjs_model_loaded": "\u041c\u043e\u0434\u0435\u043b\u044c \u0437\u0430\u0433\u0440\u0443\u0436\u0435\u043d\u0430: ", "bbjs_model_moved": "\u041c\u043e\u0434\u0435\u043b\u044c \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0435\u043d\u0430.", "bbjs_model_not_found": "\u041c\u043e\u0434\u0435\u043b\u044c \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u0430 \u0438\u043b\u0438 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430.", "bbjs_model_removed": "\u0417\u0430\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u0430\u044f \u043c\u043e\u0434\u0435\u043b\u044c \u0443\u0434\u0430\u043b\u0435\u043d\u0430.", "bbjs_model_saved": "\u041c\u043e\u0434\u0435\u043b\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0430.", "bbjs_model_turned": "\u041c\u043e\u0434\u0435\u043b\u044c \u043f\u043e\u0432\u0451\u0440\u043d\u0443\u0442\u0430.", "bbjs_model_unavailable": "\u041c\u043e\u0434\u0435\u043b\u044c \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u0434\u043b\u044f \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0438.", "bbjs_my_models": "\u041c\u041e\u0418 \u041c\u041e\u0414\u0415\u041b\u0418", "bbjs_no_access": "\u041d\u0435\u0442 \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u043a \u044d\u0442\u043e\u0439 \u043c\u043e\u0434\u0435\u043b\u0438 \u2014 \u0432\u043e\u0439\u0434\u0438\u0442\u0435 \u0432 \u0430\u043a\u043a\u0430\u0443\u043d\u0442.", "bbjs_no_geometry": "\u041d\u0435\u0442 \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u0438 \u0434\u043b\u044f \u044d\u043a\u0441\u043f\u043e\u0440\u0442\u0430.", "bbjs_no_gltf_exporter": "\u041d\u0435 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0451\u043d THREE.GLTFExporter.", "bbjs_no_saved_models": "\u0423 \u0432\u0430\u0441 \u043f\u043e\u043a\u0430 \u043d\u0435\u0442 \u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u0445 \u043c\u043e\u0434\u0435\u043b\u0435\u0439. \u0421\u0433\u0435\u043d\u0435\u0440\u0438\u0440\u0443\u0439\u0442\u0435 \u043c\u043e\u0434\u0435\u043b\u044c \u043d\u0430 \u0433\u043b\u0430\u0432\u043d\u043e\u0439 \u2014 \u0438 \u043e\u043d\u0430 \u043f\u043e\u044f\u0432\u0438\u0442\u0441\u044f \u0437\u0434\u0435\u0441\u044c.", "bbjs_no_stl_exporter": "\u041d\u0435 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0451\u043d THREE.STLExporter.", "bbjs_no_webgl": "WebGL \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d. \u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0430\u043f\u043f\u0430\u0440\u0430\u0442\u043d\u043e\u0433\u043e \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u044f \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0430.", "bbjs_open_failed": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043e\u0442\u043a\u0440\u044b\u0442\u044c \u043c\u043e\u0434\u0435\u043b\u044c: ", "bbjs_open_model": "\u041e\u0422\u041a\u0420\u042b\u0422\u042c \u041c\u041e\u0414\u0415\u041b\u042c", "bbjs_preparing_login_save": "\u0413\u043e\u0442\u043e\u0432\u0438\u043c \u043f\u0440\u043e\u0435\u043a\u0442 \u0434\u043b\u044f \u0432\u0445\u043e\u0434\u0430\u2026", "bbjs_read_failed": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u044c \u0444\u0430\u0439\u043b.", "bbjs_reading": "\u0427\u0438\u0442\u0430\u0435\u043c ", "bbjs_save_busy": "\u0421\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u0443\u0436\u0435 \u0438\u0434\u0451\u0442, \u043f\u043e\u0434\u043e\u0436\u0434\u0438\u0442\u0435 \u043f\u0430\u0440\u0443 \u0441\u0435\u043a\u0443\u043d\u0434.", "bbjs_save_failed": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c: ", "bbjs_save_failed_code": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c (", "bbjs_save_invalid_glb": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0441\u043e\u0431\u0440\u0430\u0442\u044c \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u044b\u0439 GLB.", "bbjs_save_no_credits": "\u041d\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u043e\u0434\u043d\u043e\u0433\u043e \u043a\u0440\u0435\u0434\u0438\u0442\u0430 \u0434\u043b\u044f \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u0432 \u00ab\u041c\u043e\u0438 \u043c\u043e\u0434\u0435\u043b\u0438\u00bb.", "bbjs_save_retry": "\u041f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0430\u044f \u043f\u043e\u043f\u044b\u0442\u043a\u0430 \u0431\u044b\u043b\u0430 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0430. \u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u00ab\u0421\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c\u00bb \u0435\u0449\u0451 \u0440\u0430\u0437.", "bbjs_save_too_large": "\u041c\u043e\u0434\u0435\u043b\u044c \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0431\u043e\u043b\u044c\u0448\u0430\u044f \u0434\u043b\u044f \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f (\u043b\u0438\u043c\u0438\u0442 190 \u041c\u0411).", "bbjs_saved": "\u0421\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u043e \u0432 \u00ab\u041c\u043e\u0438 \u043c\u043e\u0434\u0435\u043b\u0438\u00bb.", "bbjs_saved_public": " \u041c\u043e\u0434\u0435\u043b\u044c \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u043f\u043e \u0441\u0441\u044b\u043b\u043a\u0435 (\u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u044b\u0439 \u0442\u0430\u0440\u0438\u0444).", "bbjs_saving": "\u0421\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u043c \u0432 \u00ab\u041c\u043e\u0438 \u043c\u043e\u0434\u0435\u043b\u0438\u00bb\u2026", "bbjs_settings_reset": "\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0441\u0431\u0440\u043e\u0448\u0435\u043d\u044b.", "bbjs_shell_notice": "STL \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442 \u043f\u0435\u0440\u0435\u0441\u0435\u043a\u0430\u044e\u0449\u0438\u0435\u0441\u044f \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u044b\u0435 \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0438; \u043f\u0440\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u0431\u044a\u0435\u0434\u0438\u043d\u0438\u0442\u0435/\u043f\u043e\u0447\u0438\u043d\u0438\u0442\u0435 \u0438\u0445 \u0432 \u0441\u043b\u0430\u0439\u0441\u0435\u0440\u0435.", "bbjs_show_all_models": "\u041f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0432\u0441\u0435 \u043c\u043e\u0434\u0435\u043b\u0438", "bbjs_sign_in": "\u0412\u041e\u0419\u0422\u0418", "bbjs_sign_in_account": "\u0412\u041e\u0419\u0422\u0418 \u0412 \u0410\u041a\u041a\u0410\u0423\u041d\u0422", "bbjs_sign_in_to_pick": "\u0412\u043e\u0439\u0434\u0438\u0442\u0435 \u0432 \u0430\u043a\u043a\u0430\u0443\u043d\u0442, \u0447\u0442\u043e\u0431\u044b \u0432\u044b\u0431\u0440\u0430\u0442\u044c \u043e\u0434\u043d\u0443 \u0438\u0437 \u0441\u0432\u043e\u0438\u0445 \u043c\u043e\u0434\u0435\u043b\u0435\u0439.", "bbjs_sign_in_to_save": "\u0427\u0442\u043e\u0431\u044b \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0442\u044c \u0432 \u00ab\u041c\u043e\u0438 \u043c\u043e\u0434\u0435\u043b\u0438\u00bb, \u0432\u043e\u0439\u0434\u0438\u0442\u0435 \u0432 \u0430\u043a\u043a\u0430\u0443\u043d\u0442.", "bbjs_signin_required": "\u041d\u0443\u0436\u0435\u043d \u0432\u0445\u043e\u0434 \u0432 \u0430\u043a\u043a\u0430\u0443\u043d\u0442.", "bbjs_stl_downloaded": "STL \u0441\u043a\u0430\u0447\u0430\u043d.", "bbjs_stl_failed": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u044d\u043a\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c STL: ", "bbjs_supported_formats": "\u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e\u0442\u0441\u044f STL, OBJ, GLB \u0438 GLTF.", "bbjs_surface_busy": "\u0421\u0435\u0440\u0432\u0438\u0441 \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0438 \u0437\u0430\u043d\u044f\u0442, \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0447\u0435\u0440\u0435\u0437 \u043c\u0438\u043d\u0443\u0442\u0443.", "bbjs_surface_centered": "\u041f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c \u043e\u0442\u0446\u0435\u043d\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0430.", "bbjs_surface_failed": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c.", "bbjs_surface_failed_refunded": "\u0413\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044f \u043d\u0435 \u0443\u0434\u0430\u043b\u0430\u0441\u044c, \u043a\u0440\u0435\u0434\u0438\u0442\u044b \u0432\u0435\u0440\u043d\u0443\u043b\u0438\u0441\u044c \u043d\u0430 \u0441\u0447\u0451\u0442.", "bbjs_surface_generate_failed": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0441\u0433\u0435\u043d\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c.", "bbjs_surface_generated": "\u041f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c \u0433\u043e\u0442\u043e\u0432\u0430.", "bbjs_surface_loading": "\u0417\u0430\u0433\u0440\u0443\u0436\u0430\u044e \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c\u2026", "bbjs_surface_login": "\u0412\u043e\u0439\u0434\u0438\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u0433\u0435\u043d\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0441\u0432\u043e\u0438 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438.", "bbjs_surface_moved": "\u041f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0435\u043d\u0430.", "bbjs_surface_no_credits": "\u041d\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u043a\u0440\u0435\u0434\u0438\u0442\u043e\u0432 \u043d\u0430 \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044e \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438.", "bbjs_surface_progress": "\u0413\u0435\u043d\u0435\u0440\u0438\u0440\u0443\u044e \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c\u2026 {percent}%", "bbjs_surface_prompt_required": "\u041e\u043f\u0438\u0448\u0438\u0442\u0435 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c \u2014 \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 \u00ab\u043c\u043e\u043a\u0440\u0430\u044f \u0431\u0440\u0443\u0441\u0447\u0430\u0442\u043a\u0430 \u0441\u043e \u043c\u0445\u043e\u043c\u00bb.", "bbjs_surface_ready": "\u041f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c: {name}.", "bbjs_surface_removed": "\u041f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c \u0441\u043d\u044f\u0442\u0430.", "bbjs_surface_session_item": "\u0412\u0430\u0440\u0438\u0430\u043d\u0442 {n}", "bbjs_surface_submitting": "\u041e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u044e \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435\u2026", "bbjs_title_base": "\u041f\u043e\u0434\u0441\u0442\u0430\u0432\u043a\u0430", "bbjs_title_model_on_base": "{model} \u043d\u0430 \u043f\u043e\u0434\u0441\u0442\u0430\u0432\u043a\u0435 \u00ab{text}\u00bb", "bbjs_title_model_on_base_plain": "{model} \u043d\u0430 \u043f\u043e\u0434\u0441\u0442\u0430\u0432\u043a\u0435", "bbjs_title_nameplate": "\u0422\u0430\u0431\u043b\u0438\u0447\u043a\u0430", "bbjs_typeface_failed": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u0448\u0440\u0438\u0444\u0442. ", "bbjs_wait_typeface": "\u041f\u043e\u0434\u043e\u0436\u0434\u0438\u0442\u0435, \u043f\u043e\u043a\u0430 \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u0441\u044f \u0448\u0440\u0438\u0444\u0442.", "mesh_resize_invalid": "\u0423\u043a\u0430\u0436\u0438\u0442\u0435 \u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c\u044b\u0439 \u0440\u0430\u0437\u043c\u0435\u0440 \u043c\u043e\u0434\u0435\u043b\u0438 \u0432 \u043c\u0438\u043b\u043b\u0438\u043c\u0435\u0442\u0440\u0430\u0445."}'
    data-models-api-url="/api/base-builder/my-models"
    data-glb-url-template="/models/__PUBLIC_ID__/glb"
    data-my-models-url="/my-models"
    data-login-url="/login"
    data-signup-url="/signup"
    
    data-auth-return-url="/miniature-base-generator"
>
    
    <section
            id="builder-viewer"
            class="bb-viewer"
            aria-label="Интерактивный предпросмотр 3D-модели"
            aria-describedby="builder-status builder-dimensions"
            
        >
            <canvas id="builder-canvas" tabindex="0">
                Ваш браузер не поддерживает Canvas.
            </canvas>

            <div class="bb-model-upload-entry" id="builder-model-upload-entry">
                <strong>Перетащите модель сюда</strong>
                <span class="bb-model-upload-hint">Нажмите здесь, перетащите 3D-файл или вставьте его через Ctrl+V (⌘V на Mac).</span>
                <button class="bb-model-upload-choose" type="button" data-base-file-choose>Выбрать файл</button>
                <span class="bb-model-upload-formats">STL · OBJ · GLB · GLTF</span>
                <span id="builder-model-upload-error" role="alert" hidden
                      data-error-one="Выберите один файл модели."
                      data-error-format="Выберите файл поддерживаемого формата."></span>
            </div>
            <input id="model-upload" class="bb-file-input" type="file" accept=".stl,.obj,.glb,.gltf" tabindex="-1" aria-label="Загрузить STL, OBJ, GLB или GLTF">

            <div class="bb-viewer__toolbar bb-viewer__toolbar--left">
                <button class="bb-icon-button bb-model-upload-replace" type="button" data-base-file-choose aria-label="Открыть другой файл">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M5 14v5h14v-5"/></svg>
                    <span>Открыть другой файл</span>
                </button>
                <button id="reset-camera" class="bb-icon-button" type="button" aria-label="Сбросить вид">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4v6h6M20 20v-6h-6M5.6 16A8 8 0 0 0 19 9M18.4 8A8 8 0 0 0 5 15"/></svg>
                    <span>СБРОС ВИДА</span>
                </button>
                <button id="toggle-fullscreen" class="bb-icon-button" type="button"
                        data-expand="ПОЛНЫЙ ЭКРАН"
                        data-collapse="СВЕРНУТЬ"
                        aria-pressed="false">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>
                    <span data-fullscreen-label>ПОЛНЫЙ ЭКРАН</span>
                </button>
                
                <button id="builder-clay-toggle" class="bb-icon-button bb-clay-toggle"
                        type="button" aria-pressed="false"
                        title="Матовая глина">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M9.5 9.5a3.5 3.5 0 0 1 5 0"/></svg>
                    <span>Матовая глина</span>
                </button>
            </div>

            <div id="builder-status" class="bb-viewer__status" data-tone="progress" role="status" aria-live="polite" aria-atomic="true">
                <span class="bb-spinner" aria-hidden="true"></span>
                <span>Подготовка 3D-сцены…</span>
            </div>
            <output id="builder-dimensions" class="bb-viewer__dimensions" aria-live="polite">
                ГАБАРИТЫ · — × — × — MM
            </output>
            <div class="bb-viewer__gesture-hint" aria-hidden="true">
                мышь: камера · тянуть модель: сдвиг · зажать + колесо: поворот
            </div>
        </section>

    <section id="builder-controls" class="bb-controls" aria-label="Настройки конструктора"
             >
            <div class="bb-config-bar">
