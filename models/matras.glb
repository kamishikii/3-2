<script>window.AIprintgenPromptEnhancer = {"text": {"failed": "\u041d\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u043e\u0441\u044c \u0443\u043b\u0443\u0447\u0448\u0438\u0442\u044c \u0437\u0430\u043f\u0440\u043e\u0441 \u2014 \u0432\u0430\u0448 \u0442\u0435\u043a\u0441\u0442 \u043e\u0441\u0442\u0430\u043b\u0441\u044f \u0431\u0435\u0437 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439.", "limited": "\u0423\u043b\u0443\u0447\u0448\u0430\u0442\u044c \u043c\u043e\u0436\u043d\u043e {limit} \u0440\u0430\u0437 \u0432 \u0447\u0430\u0441. \u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0447\u0435\u0440\u0435\u0437 {minutes} \u043c\u0438\u043d.", "login": "\u0412\u043e\u0439\u0434\u0438\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u0443\u043b\u0443\u0447\u0448\u0430\u0442\u044c \u0437\u0430\u043f\u0440\u043e\u0441\u044b.", "refs": "\u0421 \u0437\u0430\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u044b\u043c\u0438 \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0430\u043c\u0438 \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u0435 \u043f\u043e\u043a\u0430 \u043d\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u2014 \u0443\u0431\u0435\u0440\u0438\u0442\u0435 \u0438\u0445 \u0438\u043b\u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u044c\u0442\u0435 \u0437\u0430\u043f\u0440\u043e\u0441 \u043a\u0430\u043a \u0435\u0441\u0442\u044c.", "tooShort": "\u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u043e\u043f\u0438\u0448\u0438\u0442\u0435, \u0447\u0442\u043e \u0445\u043e\u0442\u0438\u0442\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c.", "unchanged": "\u0417\u0430\u043f\u0440\u043e\u0441 \u0443\u0436\u0435 \u0445\u043e\u0440\u043e\u0448\u043e \u0441\u0444\u043e\u0440\u043c\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u043d \u2014 \u043c\u0435\u043d\u044f\u0442\u044c \u043d\u0435\u0447\u0435\u0433\u043e.", "undo": "\u0412\u0435\u0440\u043d\u0443\u0442\u044c \u043a\u0430\u043a \u0431\u044b\u043b\u043e", "working": "\u0423\u043b\u0443\u0447\u0448\u0430\u044e\u2026"