        <div id="tripo-high-load-banner" class="alert alert-warning ag-highload-banner" role="status"
             data-degraded-seconds="0"
             style="display:none;">
            <span aria-hidden="true">⚠️</span>
            <span>Повышенная нагрузка на сервер — возможны перебои с генерацией. Если попытка не удаётся, кредит возвращается автоматически.</span>
            <span class="ag-highload-banner__wait" data-wait-tmpl="Кнопка генерации снова активна через {n} с"></span>
        </div>
        <script>
        (function () {
            var PAUSE_MAX = 25; // seconds — long enough to break rapid-fire, short enough not to feel broken
            var banner = document.getElementById('tripo-high-load-banner');
            if (!banner) { return; }
            var waitEl = banner.querySelector('.ag-highload-banner__wait');
            var waitTmpl = (waitEl && waitEl.getAttribute('data-wait-tmpl')) || '';
            var pauseTimer = null;

            function genButtons() {
                return Array.prototype.slice.call(
                    document.querySelectorAll('#modelGenerationTabContent form button[type="submit"]'));
            }
            function setPaused(on) {
                genButtons().forEach(function (b) {
                    if (on) {
                        if (!b.hasAttribute('data-hl-was-disabled')) {
                            b.setAttribute('data-hl-was-disabled', b.disabled ? '1' : '0');
                        }
                        b.disabled = true;
                        b.classList.add('is-highload-paused');
                    } else {
                        b.disabled = (b.getAttribute('data-hl-was-disabled') === '1');
                        b.removeAttribute('data-hl-was-disabled');
                        b.classList.remove('is-highload-paused');
                    }
                });
            }
            function startPause(seconds) {
                if (pauseTimer) { return; } // already counting down
                seconds = Math.max(1, Math.min(PAUSE_MAX, Math.round(seconds) || PAUSE_MAX));
                setPaused(true);
                var remaining = seconds;
                function paint() {
                    if (waitEl) {
                        waitEl.textContent = remaining > 0 ? ' ' + waitTmpl.replace('{n}', remaining) : '';
                    }
                }
                paint();
                pauseTimer = setInterval(function () {
                    remaining -= 1;
                    if (remaining <= 0) {
                        clearInterval(pauseTimer);
                        pauseTimer = null;
                        setPaused(false);
                        if (waitEl) { waitEl.textContent = ''; }
                    } else {
                        paint();
                    }
                }, 1000);
            }
            // Called from the progress poll when a live tick reports degradation.
            window.AiprintgenHighLoad = {
                raise: function (seconds) {
                    banner.style.display = '';
                    startPause(seconds || PAUSE_MAX);
                }
            };

            function init() {
                var secs = parseInt(banner.getAttribute('data-degraded-seconds'), 10) || 0;
                if (secs > 0) { startPause(secs); }
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
        })();
        </script>
        
        
        <p class="home-quick-start-link text-center small mb-3">
