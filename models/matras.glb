        try { payload = xhr.responseText ? JSON.parse(xhr.responseText) : {}; } catch (error) {}
        var responseUrl = String(xhr.responseURL || '');
        var actionUrl = new URL(form.action, window.location.href).href;
        var redirected = responseUrl && responseUrl !== actionUrl;
        return {response: {ok: xhr.status >= 200 && xhr.status < 300, status: xhr.status, redirected: redirected, url: responseUrl}, payload: payload};
    }
    function postBasreliefForm(formData) {
        if (!window.AIprintgenGenerationUploadLimits.validateFormData(formData, form, 9000000)) {
            return Promise.reject(new Error('upload_limit'));
        }
        if (window.AiprintgenProduct) window.AiprintgenProduct.generation(form, formData, {active_tool: 'bas-relief-generator'});
        if (typeof XMLHttpRequest !== 'function') {
            return window.fetch(form.action, {
                method: 'POST', credentials: 'same-origin',
                headers: {'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest',
                    'X-Generation-Submit': 'fetch'}, body: formData
            }).then(function (response) {
                if (response.redirected && response.url) { return {redirected: response.url}; }
                return response.json().catch(function () { return {}; }).then(function (payload) { return {response: response, payload: payload}; });
            });
        }
        return new Promise(function (resolve, reject) {
            var xhr = new XMLHttpRequest();
            xhr.open('POST', form.action, true);
            xhr.setRequestHeader('Accept', 'application/json');
            xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
            // Server answers redirects as {redirect_url}: following a 302
            // here would eat the out-of-credits modal before the real reload.
