<script type="application/json" id="home-customization-config">{"accountError": "\u0410\u043a\u043a\u0430\u0443\u043d\u0442 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0441\u044f \u0438\u043b\u0438 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d. \u041e\u0431\u043d\u043e\u0432\u0438\u0442\u0435 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443 \u0438 \u0432\u043e\u0439\u0434\u0438\u0442\u0435 \u0437\u0430\u043d\u043e\u0432\u043e.", "autoNote": "\u0421\u0435\u0439\u0447\u0430\u0441 \u0433\u043b\u0430\u0432\u043d\u0430\u044f \u043f\u043e\u0434\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u0434 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438 \u0432\u044b \u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0435\u0441\u044c. \u0415\u0441\u043b\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u0435 \u0441\u0432\u043e\u0439 \u0432\u044b\u0431\u043e\u0440, \u043e\u043d \u0437\u0430\u043c\u0435\u043d\u0438\u0442 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0443\u044e \u043f\u043e\u0434\u0431\u043e\u0440\u043a\u0443.", "conflict": "\u041d\u0430\u0431\u043e\u0440 \u0438\u0437\u043c\u0435\u043d\u0451\u043d \u0432 \u0434\u0440\u0443\u0433\u043e\u0439 \u0441\u0435\u0441\u0441\u0438\u0438. \u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u0439 \u043d\u0430\u0431\u043e\u0440 \u0438 \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0437\u0430\u043d\u043e\u0432\u043e: \u044d\u0442\u043e \u0437\u0430\u043c\u0435\u043d\u0438\u0442 \u043d\u0435\u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u0439 \u0432\u044b\u0431\u043e\u0440 \u0432 \u043e\u043a\u043d\u0435.", "initial": {}, "loadError": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u0430. \u0421\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e \u0434\u043e \u0443\u0441\u043f\u0435\u0448\u043d\u043e\u0439 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0438.", "lockedExtras": [{"icon": "fa-screwdriver-wrench", "id": "tool-repair-model", "reason": "login", "title": "\u041f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c \u0438 \u0438\u0441\u043f\u0440\u0430\u0432\u0438\u0442\u044c 3D-\u043c\u043e\u0434\u0435\u043b\u044c"}, {"icon": "fa-puzzle-piece", "id": "tool-character-split", "reason": "login", "title": "\u0420\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0430 \u0434\u043b\u044f \u043f\u0435\u0447\u0430\u0442\u0438"}, {"icon": "fa-palette", "id": "tool-multicolor-model", "reason": "login", "title": "\u0420\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043f\u043e \u0446\u0432\u0435\u0442\u0430\u043c"}, {"icon": "fa-ring", "id": "tool-hollow-model", "reason": "login", "title": "\u0421\u0434\u0435\u043b\u0430\u0442\u044c \u043c\u043e\u0434\u0435\u043b\u044c \u043f\u043e\u043b\u043e\u0439"}, {"icon": "fa-border-all", "id": "tool-retopology", "reason": "login", "title": "\u0420\u0435\u0442\u043e\u043f\u043e\u043b\u043e\u0433\u0438\u044f"}, {"icon": "fa-scissors", "id": "tool-cut-model", "reason": "login", "title": "\u0420\u0430\u0437\u0440\u0435\u0437\u0430\u0442\u044c \u043c\u043e\u0434\u0435\u043b\u044c"}, {"icon": "fa-link", "id": "tool-articulated-figure", "reason": "login", "title": "\u0428\u0430\u0440\u043d\u0438\u0440\u043d\u0430\u044f \u0444\u0438\u0433\u0443\u0440\u043a\u0430"}, {"icon": "fa-chess-rook", "id": "tool-bust", "reason": "login", "title": "\u0421\u043e\u0437\u0434\u0430\u0442\u044c \u0431\u044e\u0441\u0442"}, {"icon": "fa-link", "id": "tool-flexi-toy", "reason": "login", "title": "\u0413\u0438\u0431\u043a\u0438\u0435 \u0438\u0433\u0440\u0443\u0448\u043a\u0438"}, {"icon": "fa-paint-brush", "id": "tool-model-decoration", "reason": "login", "title": "\u0414\u0435\u043a\u043e\u0440 \u043d\u0430 \u043c\u043e\u0434\u0435\u043b\u0438"}, {"icon": "fa-mountain", "id": "tool-relief-editor", "reason": "login", "title": "\u0420\u0435\u0434\u0430\u043a\u0442\u043e\u0440 \u0431\u0430\u0440\u0435\u043b\u044c\u0435\u0444\u043e\u0432"}, {"icon": "fa-mountain", "id": "tool-relief-from-model", "reason": "login", "title": "\u0421\u043e\u0437\u0434\u0430\u0442\u044c \u0431\u0430\u0440\u0435\u043b\u044c\u0435\u0444 \u0438\u0437 3D-\u043c\u043e\u0434\u0435\u043b\u0438"}, {"icon": "fa-box-open", "id": "tool-silicone-mold-box", "reason": "login", "title": "\u041e\u043f\u0430\u043b\u0443\u0431\u043a\u0430 \u0434\u043b\u044f \u0441\u0438\u043b\u0438\u043a\u043e\u043d\u043e\u0432\u043e\u0439 \u0444\u043e\u0440\u043c\u044b"}, {"icon": "fa-cubes", "id": "tool-split-mold", "reason": "login", "title": "\u0424\u043e\u0440\u043c\u0430 \u0434\u043b\u044f \u043b\u0438\u0442\u044c\u044f"}, {"icon": "fa-qrcode", "id": "tool-qr-code-3d", "reason": "login", "title": "3D QR-\u043a\u043e\u0434"}, {"icon": "fa-key", "id": "tool-keychain-maker", "reason": "login", "title": "\u0411\u0440\u0435\u043b\u043e\u043a\u0438 \u0438 \u043c\u0430\u0433\u043d\u0438\u0442\u0438\u043a\u0438"}, {"icon": "fa-cookie-bite", "id": "tool-cookie-cutter", "reason": "login", "title": "\u0412\u044b\u0440\u0443\u0431\u043a\u0430 \u0438 \u0448\u0442\u0430\u043c\u043f \u0434\u043b\u044f \u043f\u0435\u0447\u0435\u043d\u044c\u044f"}, {"icon": "fa-box", "id": "tool-enclosure-maker", "reason": "login", "title": "\u041a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u043e\u0440 \u043a\u043e\u0440\u043f\u0443\u0441\u043e\u0432 \u0434\u043b\u044f \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u0438\u043a\u0438"}, {"icon": "fa-wine-bottle", "id": "tool-vase-maker", "reason": "login", "title": "\u041a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u043e\u0440 \u0432\u0430\u0437"}, {"icon": "fa-palette", "id": "tool-color-image-3d", "reason": "login", "title": "\u0426\u0432\u0435\u0442\u043d\u0430\u044f \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0430 \u0432 3D"}, {"icon": "fa-puzzle-piece", "id": "tool-puzzle-maker", "reason": "login", "title": "\u041f\u0430\u0437\u043b \u0438\u0437 \u0431\u0430\u0440\u0435\u043b\u044c\u0435\u0444\u0430"}, {"icon": "fa-keyboard", "id": "tool-clicker-maker", "reason": "login", "title": "\u041a\u043b\u0438\u043a\u0435\u0440 \u043f\u043e \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0435"}, {"icon": "fa-mountain", "id": "tool-terrain-puzzle", "reason": "login", "title": "\u041f\u0430\u0437\u043b \u043f\u043e \u043a\u0430\u0440\u0442\u0435"}, {"icon": "fa-shapes", "id": "tool-kumiko-mosaic", "reason": "login", "title": "\u041c\u043e\u0437\u0430\u0438\u043a\u0430 \u043a\u0443\u043c\u0438\u043a\u043e \u0438\u0437 \u0444\u043e\u0442\u043e"}, {"icon": "fa-palette", "id": "tool-stained-glass", "reason": "login", "title": "\u0412\u0438\u0442\u0440\u0430\u0436 \u0438\u0437 \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0438"}, {"icon": "fa-border-all", "id": "tool-gridfinity", "reason": "login", "title": "\u041b\u043e\u0436\u0435\u043c\u0435\u043d\u0442\u044b Gridfinity"}, {"icon": "fa-puzzle-piece", "id": "tool-solid-puzzle", "reason": "login", "title": "\u041e\u0431\u044a\u0451\u043c\u043d\u044b\u0439 3D-\u043f\u0430\u0437\u043b"}, {"icon": "fa-wave-square", "id": "tool-parametric-panel", "reason": "login", "title": "\u041f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0430\u043d\u0435\u043b\u0438 \u0438 \u043f\u043e\u043b\u043a\u0438"}], "move": "\u041f\u0435\u0440\u0435\u043c\u0435\u0441\u0442\u0438\u0442\u044c: {tool}", "position": "{tool}: \u043f\u043e\u0437\u0438\u0446\u0438\u044f {position} \u0438\u0437 {total}", "reasons": {"login": "\u0412\u043e\u0439\u0434\u0438\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u0432\u044b\u0431\u0440\u0430\u0442\u044c", "plan": "\u0414\u043e\u0441\u0442\u0443\u043f\u043d\u043e \u043d\u0430 \u0442\u0430\u0440\u0438\u0444\u0435"}, "saveError": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435. \u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u0439 \u043d\u0430\u0431\u043e\u0440 \u043f\u0435\u0440\u0435\u0434 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u043c\u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f\u043c\u0438.", "suggested": "\u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435", "unavailable": ["basrelief-tab", "cad-tab", "lozhement-tab"], "unavailableTitle": "\u041f\u043e\u043a\u0430 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e", "waitBody": "\u0417\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u043c \u0438\u043b\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u043c \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u044b\u0435 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b.", "waitTitle": "\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0433\u043b\u0430\u0432\u043d\u043e\u0439"}</script>
