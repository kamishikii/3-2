<script>function getSidebarElement() {
    return document.querySelector('.bg-light.sidebar');
}

// v2 (03.10.2026): opening the drawer to sign in used to persist "expanded",
// so after login the account panel stayed open over the left 300 px of every
// page (it covered «Скачать» on the 3D result). Those stored values can't be
// told apart from deliberate opens, so everyone starts collapsed once more.
const DESKTOP_SIDEBAR_COLLAPSED_STORAGE_KEY = 'aiprintgen.sidebar.desktopCollapsed.v2';

function getSidebarLayoutElement() {
    return document.querySelector('.app-layout');
}

function getSidebarToggleButton() {
    return document.getElementById('sidebar-toggle-btn');
}

function readDesktopSidebarCollapsedPreference() {
    // ARTFUL redesign: the sidebar is an overlay drawer, collapsed by default
    // (only an explicit '0' — user opened it and we persisted that — expands).
    try {
        return window.localStorage.getItem(DESKTOP_SIDEBAR_COLLAPSED_STORAGE_KEY) !== '0';
    } catch (_error) {
        return true;
    }
}

function writeDesktopSidebarCollapsedPreference(isCollapsed) {
    try {
        window.localStorage.setItem(DESKTOP_SIDEBAR_COLLAPSED_STORAGE_KEY, isCollapsed ? '1' : '0');
    } catch (_error) {
        // Ignore storage errors.
    }
}

function isMobileSidebarViewport() {
    return window.innerWidth <= 768;
}

function isSidebarVisible() {
    const sidebar = getSidebarElement();
    const layout = getSidebarLayoutElement();
    if (!sidebar) {
        return false;
    }
    if (!isMobileSidebarViewport()) {
        return !(layout && layout.classList.contains('sidebar-collapsed'));
    }
    return window.getComputedStyle(sidebar).display !== 'none';
}

function updateSidebarToggleState() {
    const toggleButton = getSidebarToggleButton();
    if (!toggleButton) {
        return;
    }
    const isExpanded = isSidebarVisible();
    toggleButton.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
    toggleButton.classList.toggle('is-collapsed', !isExpanded);
    const sidebar = getSidebarElement();
    if (sidebar) {
        sidebar.inert = !isExpanded;
        sidebar.setAttribute('aria-hidden', isExpanded ? 'false' : 'true');
    }
}

// Keep keyboard navigation inside an opened drawer and return to its opener.
// The account and anonymous auth drawer share this behavior on every page.
let activeSidebarFocus = null;
window.aiprintgenPositionDrawers = function () {
    var header = document.querySelector('.ag-header');
    if (!header) return;
    var top = Math.max(0, header.getBoundingClientRect().bottom);
    document.querySelectorAll('#account-sidebar, #ag-auth-drawer').forEach(function (drawer) {
        drawer.style.top = top + 'px';
        drawer.style.height = 'calc(100dvh - ' + top + 'px)';
    });
};
window.addEventListener('scroll', window.aiprintgenPositionDrawers, {passive: true});
window.addEventListener('resize', window.aiprintgenPositionDrawers);
window.aiprintgenFocusDrawer = function (drawer, close) {
    if (!activeSidebarFocus || activeSidebarFocus.drawer !== drawer) {
        activeSidebarFocus = {drawer: drawer, close: close, opener: document.activeElement};
    }
    var first = drawer.querySelector('button, a[href], input, select, [tabindex="0"]');
    window.requestAnimationFrame(function () {
        if (first && activeSidebarFocus && activeSidebarFocus.drawer === drawer && drawer.getAttribute('aria-hidden') !== 'true') first.focus({preventScroll: true});
    });
};
window.aiprintgenReleaseDrawerFocus = function (drawer) {
    if (!activeSidebarFocus || activeSidebarFocus.drawer !== drawer) return;
    var opener = activeSidebarFocus.opener;
    activeSidebarFocus = null;
    if (opener && opener.isConnected) opener.focus({preventScroll: true});
};
document.addEventListener('keydown', function (event) {
    var state = activeSidebarFocus;
    if (!state || document.querySelector('.modal.show, dialog[open], #generation-lock-overlay[aria-hidden="false"]')
        || (event.target.closest && event.target.closest('.modal, dialog, .generation-lock-overlay'))) return;
    if (!state.drawer.getClientRects().length || state.drawer.inert) {
        window.aiprintgenReleaseDrawerFocus(state.drawer);
        return;
    }
    if (event.key === 'Escape') {
        event.preventDefault();
        state.close();
    } else if (event.key === 'Tab') {
        var controls = Array.from(state.drawer.querySelectorAll('button:not([disabled]), a[href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex="0"]')).filter(function (node) {
            return node.getClientRects().length && !node.closest('[hidden], [inert]');
        });
        var first = controls[0], last = controls[controls.length - 1];
        if (!first) { event.preventDefault(); return; }
        if (event.shiftKey && (document.activeElement === first || !state.drawer.contains(document.activeElement))) {
            event.preventDefault(); last.focus();
        } else if (!event.shiftKey && (document.activeElement === last || !state.drawer.contains(document.activeElement))) {
            event.preventDefault(); first.focus();
        }
    }
});

// Open for this page only (sign-in): the stored preference stays collapsed,
// so a later sync (load, resize) must not fold the drawer back under the user.
let sidebarOpenForThisPage = false;

function syncSidebarViewportState() {
    window.aiprintgenPositionDrawers();
    const sidebar = getSidebarElement();
    const layout = getSidebarLayoutElement();
    if (!sidebar) {
        return;
    }
    if (!isMobileSidebarViewport()) {
        sidebar.style.display = '';
        if (layout) {
            layout.classList.toggle('sidebar-collapsed', readDesktopSidebarCollapsedPreference() && !sidebarOpenForThisPage);
        }
    }
    updateSidebarToggleState();
    if (!isSidebarVisible()) window.aiprintgenReleaseDrawerFocus(sidebar);
}

// Only the user's own toggle is remembered; opening it for sign-in
// (index.html revealAuthEntry) passes {persist: false}.
function openSidebar(options) {
    window.aiprintgenPositionDrawers();
    const persist = !(options && options.persist === false);
    const sidebar = getSidebarElement();
    const layout = getSidebarLayoutElement();
    if (!sidebar) {
        return;
    }
    if (isMobileSidebarViewport()) {
        sidebar.style.display = 'block';
    } else if (layout) {
        layout.classList.remove('sidebar-collapsed');
        if (persist) {
            writeDesktopSidebarCollapsedPreference(false);
        } else {
            sidebarOpenForThisPage = true;
        }
    }
    updateSidebarToggleState();
    window.aiprintgenFocusDrawer(sidebar, closeSidebar);
}

function closeSidebar() {
    const sidebar = getSidebarElement();
    const layout = getSidebarLayoutElement();
    sidebarOpenForThisPage = false;
    if (!sidebar) {
        return;
    }
    if (isMobileSidebarViewport()) {
        sidebar.style.display = 'none';
    } else if (layout) {
        layout.classList.add('sidebar-collapsed');
        writeDesktopSidebarCollapsedPreference(true);
    }
    updateSidebarToggleState();
    window.aiprintgenReleaseDrawerFocus(sidebar);
}

function toggleSidebar() {
    if (isSidebarVisible()) {
        closeSidebar();
    } else {
        openSidebar();
    }
}

window.toggleSidebar = toggleSidebar;
window.aiprintgenOpenSidebar = openSidebar;
window.aiprintgenCloseSidebar = closeSidebar;
window.addEventListener('resize', syncSidebarViewportState);

/* Проверяем размер экрана при загрузке и изменении размера окна */
    document.addEventListener('DOMContentLoaded', function () {
        const sidebarToggleButton = getSidebarToggleButton();
        function closeMobileHeaderMenu() {
            document.querySelectorAll('.ag-header__mobile-menu[open]').forEach(function (d) {
                d.removeAttribute('open');
            });
        }
        if (sidebarToggleButton) {
            sidebarToggleButton.addEventListener('click', function (event) {
                event.preventDefault();
                // The mobile nav panel sits above the drawer — never keep both open.
                closeMobileHeaderMenu();
                if (window.aiprintgenAuthDrawerMode && window.aiprintgenRevealAuthEntry) {
                    var authDrawer = document.getElementById('ag-auth-drawer');
                    if (authDrawer && authDrawer.classList.contains('is-open')) window.aiprintgenCloseAuthDrawer();
                    else window.aiprintgenRevealAuthEntry('login');
                } else {
                    toggleSidebar();
                }
            });
        }
        // Close the mobile nav panel on outside click (native <details> keeps
        // itself open otherwise, covering content beneath).
        document.addEventListener('click', function (event) {
            if (!event.target.closest('.ag-header__mobile-menu')) {
                closeMobileHeaderMenu();
            }
        });

        // Header «Вход»/«Регистрация» (and in-content links to the homepage
        // auth anchors) are plain links to /#headingLogin. Wherever the page
        // can reveal an auth panel in place — the homepage sidebar or the
        // global auth drawer below — open it instead of navigating away.
        // Without JS the links keep working as ordinary navigation.
        document.querySelectorAll(
            '.ag-header__login-link, .ag-header__register-link, a[href*="#headingLogin"], a[href*="#headingRegister"]'
        ).forEach(function (link) {
            link.addEventListener('click', function (event) {
                if (typeof window.aiprintgenRevealAuthEntry !== 'function') {
                    return;
                }
                event.preventDefault();
                closeMobileHeaderMenu();
                var href = link.getAttribute('href') || '';
                var mode = (link.classList.contains('ag-header__register-link') || href.indexOf('#headingRegister') !== -1)
                    ? 'register' : 'login';
                window.aiprintgenRevealAuthEntry(mode);
                // Homepage keeps its deep-linkable /?auth=… URL in the bar; on
                // drawer pages the URL stays put (a reload must not go home).
                if (!window.aiprintgenAuthDrawerMode && window.history && window.history.replaceState) {
                    window.history.replaceState(null, '', href);
                }
            });
        });

        syncSidebarViewportState();

    });
document.addEventListener('DOMContentLoaded', function () {
    var languageSwitchInProgress = false;

    function switchLanguage() {
        if (languageSwitchInProgress) {
            return;
        }
        var selectedLanguage = this.value;
        var targetUrl = (window.appLanguageSwitchUrls || {})[selectedLanguage];
        try {
            window.localStorage.setItem('preferred_ui_locale', selectedLanguage);
        } catch (error) {}
        document.cookie = 'preferred_ui_locale=' + encodeURIComponent(selectedLanguage) + '; Max-Age=31536000; path=/; SameSite=Lax';

        // Localized URLs already encode both the locale and its owning host
        // (Russian → aiprintgen.ru). Going there directly avoids an unnecessary
        // cross-host 302, which some mobile select implementations can lose
        // while dismissing their native picker.
        languageSwitchInProgress = true;
        if (targetUrl) {
            window.location.assign(targetUrl);
            return;
        }

        var nextPath = window.location.pathname + window.location.search + window.location.hash;
        var redirectUrl = "/set_language/" + encodeURIComponent(selectedLanguage) + "?next=" + encodeURIComponent(nextPath);
        window.location.assign(redirectUrl);
    }

    document.querySelectorAll('[data-language-select]').forEach(function (languageSelect) {
        languageSelect.addEventListener('change', switchLanguage);
        if (languageSelect.id === 'language-select-mobile') {
            // iOS/Android native pickers are not fully consistent about when
            // they emit `change`; `input` fires as soon as the option commits.
            languageSelect.addEventListener('input', switchLanguage);
        }
    });
});

document.addEventListener('DOMContentLoaded', function () {
    var headerMenu = document.querySelector('.header-controls-menu');
    if (!headerMenu) {
        return;
    }

    function syncHeaderMenuState() {
        if (window.innerWidth <= 768) {
            headerMenu.removeAttribute('open');
        } else {
            headerMenu.setAttribute('open', 'open');
        }
    }

    syncHeaderMenuState();
    window.addEventListener('resize', syncHeaderMenuState);
});

document.addEventListener('DOMContentLoaded', function () {
    // Remove the old click handler for the banner text
    /*
    const specOfferText = document.getElementById('spec-offer-text');
    const registerButton = document.getElementById('register_btn');

    if (specOfferText && registerButton) {
        specOfferText.addEventListener('click', function () {
            // Если кнопка "Регистрация" существует, симулируем клик
            registerButton.click();
        });
    }
    */
});


</script>
</body>
</html>