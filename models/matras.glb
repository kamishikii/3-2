        <div id="collapseLogin" class="collapse show" aria-labelledby="headingLogin" data-parent="#authAccordion">
            <div class="card-body">
                <div class="alert alert-danger" id="login-error" role="alert" hidden></div>
                <form method="POST" action="/login">
                    <input type="hidden" name="_csrf_token" value="-gPzKf8lCJcmeWfVZd70ci4PytFx0P_nz8ujlXEmw3w">
                    <input type="hidden" name="next" value="/">
                    <div class="form-group">
                        <label for="login-email">Email:</label>
                        <input type="email" class="form-control" id="login-email" name="email"
                            autocomplete="email" placeholder="Email" value="" required>
                    </div>
                    <div class="form-group">
                        <label for="login-password">Пароль:</label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="login-password" name="password" autocomplete="current-password"
                                placeholder="Пароль"  required>
                            <div class="input-group-append">
                                <button type="button" class="btn btn-outline-secondary" data-password-toggle="login-password"
                                    aria-controls="login-password" aria-pressed="false"
                                    data-label-show="Показать" data-label-hide="Скрыть">Показать</button>
                            </div>
                        </div>
                        <a href="#collapseReset" class="small d-inline-block mt-1" data-auth-forgot>Забыли пароль?</a>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block">Вход</button>
                    
                    
                    <button type="button" class="btn btn-outline-primary btn-block mb-3 oauth-icon-button" data-telegram-login-trigger aria-label="Telegram">
                        <img src="/static/images/telegram.svg" alt="Telegram"
                            width="24" height="24">
                    </button>
                    
                    
                    <button type="button" class="btn btn-outline-primary btn-block mb-3 oauth-icon-button" id="yandex-login" aria-label="Yandex">
                        <img src="/static/images/yandex.svg" alt="Yandex"
                            width="24" height="24">
                    </button>
                    
                    
                    <button type="button" class="btn btn-outline-primary btn-block mb-3 oauth-icon-button" id="vk-login" aria-label="VK">
                        <img src="/static/images/vk.svg" alt="VK"
                            width="24" height="24">
                    </button>
                    
                </form>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header" id="headingRegister">
            <h5 class="mb-0">
                <button id="register_btn" class="btn btn-link btn-block text-left collapsed" type="button" data-toggle="collapse"
                    data-target="#collapseRegister" aria-expanded="false" aria-controls="collapseRegister">
                    Регистрация
                </button>
            </h5>
        </div>
        <div id="collapseRegister" class="collapse" aria-labelledby="headingRegister" data-parent="#authAccordion">
            <div class="card-body">
                <p class="text-muted small">3 бесплатных генерации любым инструментом после регистрации.</p>
                
                <form method="POST" action="/signup">
                    <input type="hidden" name="_csrf_token" value="-gPzKf8lCJcmeWfVZd70ci4PytFx0P_nz8ujlXEmw3w">
                    <input type="hidden" name="next" value="/">
                    <div class="form-group">
                        <label for="register-email">Email:</label>
                        <input type="email" class="form-control" id="register-email" name="email"
                            autocomplete="email" placeholder="Email" required>

                    </div>
                    <div class="form-group">
                        <label for="register-password">Пароль:</label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="register-password" name="password" autocomplete="new-password"
                                placeholder="Пароль" required>
                            <div class="input-group-append">
                                <button type="button" class="btn btn-outline-secondary" data-password-toggle="register-password"
                                    aria-controls="register-password" aria-pressed="false"
                                    data-label-show="Показать" data-label-hide="Скрыть">Показать</button>
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label for="register-referral-code">Код приглашения или промокод (необязательно):</label>
                        <input type="text" class="form-control" id="register-referral-code" name="referral_code"
                            value="" maxlength="24" autocomplete="off">
                    </div>
                    <script>
                    // Введённый код дублируем в cookie: приглашение — в ap_ref, промокод —
                    // в ap_promo. Регистрация через Google/Telegram уходит редиректом и
                    // поле формы не отправляет — без этого код у OAuth-регистраций терялся бы.
                    (function () {
                        var field = document.getElementById('register-referral-code');
                        if (!field) { return; }
                        var referralEnabled = true;
                        var secure = location.protocol === 'https:' ? '; Secure' : '';
                        field.addEventListener('input', function () {
                            var raw = String(field.value || '').replace(/\s+/g, '');
                            var value = raw.toUpperCase().replace(/[^0-9A-Z]/g, '');
                            var isPromo = /^[0-9A-Za-z]+$/.test(raw) && [9, 10, 12, 20].indexOf(raw.length) !== -1;
                            // Промокод регистр хранит как есть; сутки хватает на OAuth-круг.
                            document.cookie = 'ap_promo=' + (isPromo ? raw : '') + '; path=/; max-age='
                                + (isPromo ? 86400 : 0) + '; SameSite=Lax' + secure;
                            if (!referralEnabled || value.length !== 8) { return; }
                            document.cookie = 'ap_ref=' + value + '; path=/; max-age=7776000; SameSite=Lax' + secure;
                        });
                    })();
                    </script>
                    <button type="submit" class="btn btn-success btn-block">Регистрация</button>
                    
                    
                    <button type="button" class="btn btn-outline-primary btn-block mb-3 oauth-icon-button" data-telegram-login-trigger aria-label="Telegram">
                        <img src="/static/images/telegram.svg" alt="Telegram"
                            width="24" height="24">
                    </button>
                    
                    
                    <button type="button" class="btn btn-outline-primary btn-block mb-3 oauth-icon-button" id="yandex-login-register" aria-label="Yandex">
                        <img src="/static/images/yandex.svg" alt="Yandex"
                            width="24" height="24">
                    </button>
                    
                    
                    <button type="button" class="btn btn-outline-primary btn-block mb-3 oauth-icon-button" id="vk-login-register" aria-label="VK">
                        <img src="/static/images/vk.svg" alt="VK"
                            width="24" height="24">
                    </button>
                    
                </form>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header" id="headingReset">
            <h5 class="mb-0">
                <button class="btn btn-link btn-block text-left collapsed" type="button" data-toggle="collapse"
                    data-target="#collapseReset" aria-expanded="false" aria-controls="collapseReset">
