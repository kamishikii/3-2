            <div
                class="support-chat"
                id="support-chat-widget"
                data-authenticated="0"
                data-contact-required="1"
                data-email-required="1"
            >
                <section
                    class="support-chat__panel"
                    id="support-chat-panel"
                    aria-labelledby="support-chat-title"
                    hidden
                >
                    <div class="support-chat__header">
                        <div>
                            <h2 id="support-chat-title">Чем помочь?</h2>
                        </div>
                        <button
                            type="button"
                            class="support-chat__close"
                            id="support-chat-close"
                            aria-label="Закрыть"
                            title="Закрыть"
                        >
                            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                        </button>
                    </div>
                    <form id="support-chat-form" class="support-chat__form">
                        <div class="form-group">
                            <label for="support-category">Тип</label>
                            <select id="support-category" class="form-control" name="category">
                                <option value="question">Вопрос</option>
                                <option value="problem">Проблема</option>
                                <option value="complaint">Жалоба</option>
                                <option value="idea">Идея</option>
                                <option value="other">Другое</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="support-message">Сообщение</label>
                            <textarea
                                id="support-message"
                                class="form-control"
                                name="message"
                                rows="5"
                                maxlength="3000"
                                required
                            ></textarea>
                        </div>
                        <div class="form-group" id="support-contact-group">
                            <label for="support-contact">Почта (обязательно)</label>
                            <input
                                type="email"
                                class="form-control"
                                id="support-contact"
                                name="contact_email"
                                value=""
                                autocomplete="email"
                                dir="ltr"
                                maxlength="254"
                                required
                            >
                        </div>
                        <div class="form-group">
                            <label for="support-phone">Телефон (необязательно)</label>
                            <input type="tel" class="form-control" id="support-phone" name="contact_phone" autocomplete="tel" dir="ltr" maxlength="40">
                        </div>
                        <input
                            type="text"
                            class="support-chat__honeypot"
                            id="support-company"
                            name="company"
                            tabindex="-1"
                            autocomplete="off"
                            aria-hidden="true"
                        >
                        <div class="support-chat__status" id="support-chat-status" role="status" aria-live="polite"></div>
                        <button type="submit" class="support-chat__submit">
                            <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
                            <span class="support-chat__submit-label">Отправить</span>
                        </button>
                    </form>
                </section>
                <button
                    type="button"
                    class="support-chat__button"
                    id="support-chat-toggle"
                    aria-controls="support-chat-panel"
                    aria-expanded="false"
                >
                    <i class="fa-solid fa-comment-dots" aria-hidden="true"></i>
                    <span>Помощь</span>
                </button>
            </div>
            

            
            

            

            

            
<style>
    .ag-tool-access[hidden]{display:none!important}
    .ag-tool-access{position:fixed;inset:0;z-index:1070;display:flex;align-items:center;justify-content:center;overflow-y:auto;padding:20px;background:rgba(19,17,31,.64);backdrop-filter:blur(3px)}
    .ag-tool-access__dialog{position:relative;width:min(100%,480px);max-height:calc(100vh - 40px);overflow-y:auto;padding:32px;border:1px solid rgba(127,69,246,.22);border-radius:24px;background:#fff;color:#1d1d2b;box-shadow:0 24px 80px rgba(24,18,45,.28);text-align:center}
    .ag-tool-access__icon{display:inline-flex;align-items:center;justify-content:center;width:58px;height:58px;margin-bottom:16px;border-radius:18px;background:rgba(127,69,246,.1);color:#6f37f1;font-size:25px}
    .ag-tool-access__title{margin:0 32px 10px;font-size:26px;font-weight:800;line-height:1.2}
    .ag-tool-access__text{margin:0 0 24px;color:#65697d;font-size:16px;line-height:1.55}
    .ag-tool-access__close{position:absolute;inset-block-start:14px;inset-inline-end:14px;display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;padding:0;border:0;border-radius:12px;background:transparent;color:#707386;font-size:27px;line-height:1;cursor:pointer}
    .ag-tool-access__close:hover,.ag-tool-access__close:focus{background:#f2effa;color:#34245c;outline:none}
    .ag-tool-access__cta{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 24px;border:1px solid #6f37f1;border-radius:15px;background:linear-gradient(135deg,#7f45f6,#6f37f1);color:#fff;font-size:16px;font-weight:700;text-decoration:none;box-shadow:0 12px 24px rgba(111,55,241,.2)}
    .ag-tool-access__cta:hover,.ag-tool-access__cta:focus{color:#fff;text-decoration:none;background:linear-gradient(135deg,#7740eb,#602bd8)}
    body.ag-tool-access-open{overflow:hidden}
    /* Optional per-tool context (only the bas-relief form passes it): the
       visitor's own file and what happens to it, at the decision moment. */
    .ag-tool-access__context{display:flex;align-items:center;gap:14px;margin:0 0 16px;padding:12px;border:1px solid #e4ddd2;border-radius:16px;background:#fbf8f2;text-align:start}
    .ag-tool-access__thumb{flex:0 0 auto;width:64px;height:64px;border-radius:12px;background:#fff;object-fit:contain}
    .ag-tool-access__thumb[hidden]{display:none}
    .ag-tool-access__context-copy{flex:1 1 auto;min-width:0}
    .ag-tool-access__file{display:block;overflow:hidden;color:#24211d;font-size:14px;font-weight:700;text-overflow:ellipsis;white-space:nowrap}
    .ag-tool-access__saved{margin:4px 0 0;color:#4f4a44;font-size:14px;line-height:1.45}
    .ag-tool-access__actions{display:flex;flex-direction:column;align-items:center;gap:10px}
    .ag-tool-access__terms{margin:16px 0 0;color:#65697d;font-size:14px;line-height:1.5}
    .ag-tool-access__terms a{color:#4f44c0;font-weight:700;text-decoration:underline;text-underline-offset:3px}
    .ag-tool-access--page .ag-tool-access__dialog{border-color:rgba(36,33,29,.12);background:#fffdf9}
    .ag-tool-access--page .ag-tool-access__icon{display:none}
    .ag-tool-access--page .ag-tool-access__cta{border:0;border-radius:999px;background:#24211d;box-shadow:none}
    .ag-tool-access--page .ag-tool-access__cta:hover,.ag-tool-access--page .ag-tool-access__cta:focus{background:#3a352f}
    .ag-tool-access--page .ag-tool-access__cta--signup{display:flex;width:100%}
    .ag-tool-access--page .ag-tool-access__cta--login{min-height:auto;padding:6px 12px;background:transparent;color:#4f4a44;font-size:14px;box-shadow:none}
    .ag-tool-access--page .ag-tool-access__cta--login:hover,.ag-tool-access--page .ag-tool-access__cta--login:focus{background:#f2ede5;color:#24211d}
    @media(max-width:520px){.ag-tool-access{padding:12px}.ag-tool-access__dialog{max-height:calc(100vh - 24px);padding:28px 20px 24px;border-radius:20px}.ag-tool-access__title{font-size:22px}.ag-tool-access__text{font-size:15px}}
</style>

<div
    class="ag-tool-access"
    id="tool-access-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="tool-access-modal-title"
    aria-describedby="tool-access-modal-text"
    hidden
>
    <div class="ag-tool-access__dialog" role="document">
        <button class="ag-tool-access__close" type="button" data-tool-access-close aria-label="Закрыть">&times;</button>
        <div class="ag-tool-access__icon" aria-hidden="true"><i class="fas fa-lock"></i></div>
        <h2 class="ag-tool-access__title" id="tool-access-modal-title"></h2>
        <div class="ag-tool-access__context" data-tool-access-context hidden>
            <img class="ag-tool-access__thumb" data-tool-access-thumb alt="" hidden>
            <div class="ag-tool-access__context-copy">
                <span class="ag-tool-access__file" data-tool-access-file></span>
                <p class="ag-tool-access__saved" data-tool-access-saved hidden></p>
            </div>
        </div>
        <p class="ag-tool-access__text" id="tool-access-modal-text"></p>
        <div class="ag-tool-access__actions">
            <a
                class="ag-tool-access__cta ag-tool-access__cta--signup"
                data-tool-access-register
                href="/?auth=register#headingRegister"
                hidden
            >Зарегистрироваться</a>
            <a
                class="ag-tool-access__cta ag-tool-access__cta--login"
                data-tool-access-login
                href="/#headingLogin"
                hidden
            >Войти</a>
            <a
                class="ag-tool-access__cta"
                data-tool-access-pricing
                href="/pricing"
                hidden
            >Посмотреть тарифы</a>
            
            <a
                class="ag-tool-access__cta"
                data-tool-access-trial
                href="/pricing"
                hidden
            >Посмотреть месячные тарифы</a>
        </div>
        <p class="ag-tool-access__terms" data-tool-access-terms hidden><span data-tool-access-terms-text></span> <a data-tool-access-terms-link href="/pricing"></a></p>
    </div>
</div>

<script>
(function () {
    var modal = document.getElementById('tool-access-modal');
    if (!modal) { return; }

    var dialog = modal.querySelector('.ag-tool-access__dialog');
    var title = document.getElementById('tool-access-modal-title');
    var message = document.getElementById('tool-access-modal-text');
    var registerCta = modal.querySelector('[data-tool-access-register]');
    var loginCta = modal.querySelector('[data-tool-access-login]');
    var pricingCta = modal.querySelector('[data-tool-access-pricing]');
    var trialCta = modal.querySelector('[data-tool-access-trial]');
    var closeButton = modal.querySelector('[data-tool-access-close]');
    var contextBox = modal.querySelector('[data-tool-access-context]');
    var contextThumb = modal.querySelector('[data-tool-access-thumb]');
    var contextFile = modal.querySelector('[data-tool-access-file]');
    var contextSaved = modal.querySelector('[data-tool-access-saved]');
    var termsBox = modal.querySelector('[data-tool-access-terms]');
    var termsText = modal.querySelector('[data-tool-access-terms-text]');
    var termsLink = modal.querySelector('[data-tool-access-terms-link]');
    var defaultTermsHref = termsLink.getAttribute('href');
    var previousFocus = null;
    var activeOpenEpoch = 0;
    var copy = {
        anonymousTitle: "\u0412\u043e\u0439\u0434\u0438\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442",
        anonymousText: "\u0412\u043e\u0439\u0434\u0438\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u00ab{feature}\u00bb. \u041f\u0440\u043e\u0431\u043d\u044b\u0439 \u0434\u043e\u0441\u0442\u0443\u043f \u0440\u0430\u0441\u0445\u043e\u0434\u0443\u0435\u0442 \u043a\u0440\u0435\u0434\u0438\u0442\u044b; \u043f\u0435\u0440\u0435\u0434 \u0437\u0430\u043f\u0443\u0441\u043a\u043e\u043c \u043f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u043e\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044f \u043f\u0440\u043e\u0431\u044b, \u0431\u0430\u043b\u0430\u043d\u0441 \u0438 \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438.",
        planTitle: "\u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u043d\u0435 \u0432\u0445\u043e\u0434\u0438\u0442 \u0432 \u0432\u0430\u0448 \u0442\u0430\u0440\u0438\u0444",
        planText: "\u00ab{feature}\u00bb \u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d \u043d\u0430 \u0442\u0430\u0440\u0438\u0444\u0430\u0445 \u0432\u044b\u0448\u0435. \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0438\u0439 \u0442\u0430\u0440\u0438\u0444, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c.",
        trialTitle: "\u041f\u0440\u043e\u0431\u043d\u044b\u0435 \u0437\u0430\u043f\u0443\u0441\u043a\u0438 \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u043b\u0438\u0441\u044c",
        trialText: "\u0412\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043b\u0438 \u0432\u0441\u0435 \u043f\u0440\u043e\u0431\u043d\u044b\u0435 \u0437\u0430\u043f\u0443\u0441\u043a\u0438 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432. \u0427\u0442\u043e\u0431\u044b \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u00ab{feature}\u00bb \u0434\u0430\u043b\u044c\u0448\u0435, \u043f\u043e\u0434\u043e\u0439\u0434\u0451\u0442 \u043b\u044e\u0431\u043e\u0439 \u043c\u0435\u0441\u044f\u0447\u043d\u044b\u0439 \u0438\u043b\u0438 \u0433\u043e\u0434\u043e\u0432\u043e\u0439 \u0442\u0430\u0440\u0438\u0444 \u2014 \u0432 \u0440\u0430\u0437\u043e\u0432\u044b\u0435 \u043f\u0430\u043a\u0435\u0442\u044b \u043a\u0440\u0435\u0434\u0438\u0442\u043e\u0432 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b \u043d\u0435 \u0432\u0445\u043e\u0434\u044f\u0442.",
        defaultFeature: "\u044d\u0442\u043e\u0442 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442",
        features: {
            basrelief: "\u0411\u0430\u0440\u0435\u043b\u044c\u0435\u0444",
            lozhement: "\u041b\u043e\u0436\u0435\u043c\u0435\u043d\u0442",
            cad: "CAD",
            base_builder: "\u041a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u043e\u0440 \u043f\u043e\u0434\u0441\u0442\u0430\u0432\u043e\u043a"
        }
    };

    function withFeature(template, feature) {
        return String(template || '').replace(/\{feature\}/g, feature);
    }

    function close() {
        if (modal.hidden) { return; }
        activeOpenEpoch += 1;
        modal.hidden = true;
        document.body.classList.remove('ag-tool-access-open');
        if (previousFocus && typeof previousFocus.focus === 'function') {
            previousFocus.focus();
        }
        previousFocus = null;
    }

    function open(options) {
        var openEpoch = ++activeOpenEpoch;
        var settings = options || {};
        var reason = String(settings.reason || 'plan_required').toLowerCase();
        if (reason === 'ok' || reason === 'admin') { return false; }
        var featureKey = String(settings.feature || '').trim().toLowerCase();
        var featureLabel = copy.features[featureKey] || copy.defaultFeature;
        var isAnonymous = reason === 'anonymous';
        var isTrialExhausted = reason === 'trial_exhausted';

        if (isAnonymous) {
            title.textContent = copy.anonymousTitle;
            message.textContent = withFeature(copy.anonymousText, featureLabel);
        } else if (isTrialExhausted) {
            title.textContent = copy.trialTitle;
            message.textContent = withFeature(copy.trialText, featureLabel);
        } else {
            title.textContent = copy.planTitle;
            message.textContent = withFeature(copy.planText, featureLabel);
        }
        // Context is opt-in per call and reset on every open, so a tool that
        // passes none gets exactly the generic dialog.
        var context = settings.context || null;
        modal.classList.toggle('ag-tool-access--page', !!context);
        var hasFile = !!(context && (context.imageUrl || context.fileName));
        contextBox.hidden = !hasFile;
        contextThumb.hidden = !(context && context.imageUrl);
        if (context && context.imageUrl) { contextThumb.src = context.imageUrl; } else { contextThumb.removeAttribute('src'); }
        contextFile.textContent = (context && context.fileName) || '';
        var hasSavedPromise = !!(context && context.savedPromise &&
            typeof context.savedPromise.then === 'function');
        contextSaved.hidden = !(context && context.savedText && isAnonymous && !hasSavedPromise);
        contextSaved.textContent = (context && isAnonymous && context.savedText && !hasSavedPromise) || '';
        if (context && context.text) { message.textContent = context.text; }
        termsBox.hidden = !(context && context.termsLabel);
        termsText.textContent = (context && context.termsText) || '';
        termsLink.textContent = (context && context.termsLabel) || '';
        termsLink.setAttribute('href', (context && context.termsHref) || defaultTermsHref);
        registerCta.hidden = !(isAnonymous && !!context);
        loginCta.hidden = !isAnonymous;
        pricingCta.hidden = isAnonymous || isTrialExhausted;
        trialCta.hidden = !isTrialExhausted;
        previousFocus = document.activeElement;
        modal.hidden = false;
        if (window.AiprintgenProduct) window.AiprintgenProduct.paywall(modal, {paywall_reason: isAnonymous ? 'authentication' : isTrialExhausted ? 'quota' : 'plan_entitlement', access_decision: 'denied', entitlement_source: 'unknown', entitlement_family: 'paid_tool'});
        document.body.classList.add('ag-tool-access-open');
        (isAnonymous ? (registerCta.hidden ? loginCta : registerCta) : (isTrialExhausted ? trialCta : pricingCta)).focus();
        if (hasSavedPromise && isAnonymous && context.savedText) {
            Promise.resolve(context.savedPromise).then(function (saved) {
                if (saved && activeOpenEpoch === openEpoch && !modal.hidden) {
                    contextSaved.textContent = context.savedText;
                    contextSaved.hidden = false;
                }
            }).catch(function () {});
        }
        return true;
    }

    closeButton.addEventListener('click', close);
    modal.addEventListener('click', function (event) {
        if (event.target === modal) { close(); }
    });
    loginCta.addEventListener('click', function (event) {
        if (typeof window.aiprintgenRevealAuthEntry !== 'function') { return; }
        event.preventDefault();
        close();
        window.aiprintgenRevealAuthEntry('login');
    });
    registerCta.addEventListener('click', function (event) {
        if (typeof window.aiprintgenRevealAuthEntry !== 'function') { return; }
        event.preventDefault();
        close();
        window.aiprintgenRevealAuthEntry('register');
    });
    document.addEventListener('keydown', function (event) {
        if (modal.hidden) { return; }
        if (event.key === 'Escape') {
            event.preventDefault();
            close();
            return;
        }
        if (event.key === 'Tab') {
            var focusable = Array.prototype.filter.call(
                dialog.querySelectorAll('button:not([hidden]),a:not([hidden])'),
                function (element) { return !element.disabled && !element.closest('[hidden]'); }
            );
            if (!focusable.length) { return; }
            var first = focusable[0];
            var last = focusable[focusable.length - 1];
            if (event.shiftKey && document.activeElement === first) {
                event.preventDefault(); last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault(); first.focus();
            }
        }
    });

    window.AIprintgenToolAccess = { open: open, close: close };
})();
</script>

