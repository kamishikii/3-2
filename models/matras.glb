    function showValidationFailure(result, focus) {
        if (result.reason === 'image_too_small') { showTooSmall(focus); return; }
        showUploadError(validationMessage(result.reason), result.reason, focus);
    }
    function announceValidatedUpload(file) {
        if (window.AiprintgenProduct) window.AiprintgenProduct.acceptHandoff(file, window.AiprintgenProduct.inputFields(form));
        if (!file || announcedValidatedFile === file) { return; }
        announcedValidatedFile = file;
        var validatedEvent;
        var eventDetail = { fileType: String(file.type || '').slice(0, 40) };
        if (typeof window.CustomEvent === 'function') {
            validatedEvent = new CustomEvent('basrelief:upload-validated', { bubbles: true, detail: eventDetail });
        } else {
            validatedEvent = document.createEvent('CustomEvent');
            validatedEvent.initCustomEvent('basrelief:upload-validated', true, false, eventDetail);
        }
        form.dispatchEvent(validatedEvent);
    }
    function enterSubmittingState() {
        var startEvent;
        if (typeof window.CustomEvent === 'function') {
            startEvent = new CustomEvent('basrelief:generation-start', { bubbles: true });
        } else {
            startEvent = document.createEvent('Event');
            startEvent.initEvent('basrelief:generation-start', true, false);
        }
        form.dispatchEvent(startEvent);
        showBasreliefUploadLock();
        var btn = form.querySelector('.basrelief-submit-btn');
        if (btn) { btn.disabled = true; }
    }
    function showBasreliefUploadLock() {
        if (!window.AiprintgenGenerationLock) { return; }
        // Until the POST returns a durable gen_id this is an upload. The
        // percentage below comes only from XMLHttpRequest upload bytes.
        window.AiprintgenGenerationLock.show({
            title: form.getAttribute('data-br-upload-title') || "\u0413\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044f \u0438\u0434\u0435\u0442",
            body: form.getAttribute('data-br-upload-body') || "\u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u0434\u043e\u0436\u0434\u0438\u0442\u0435\u0441\u044c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430 \u043d\u0430 \u044d\u0442\u043e\u0439 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0435. \u041e\u043d \u043e\u0442\u043a\u0440\u043e\u0435\u0442\u0441\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438."
        });
        window.AiprintgenGenerationLock.progress(0);
    }
    function leaveSubmittingState() {
        if (window.AiprintgenGenerationLock) {
            window.AiprintgenGenerationLock.hide();
        }
        var btn = form.querySelector('.basrelief-submit-btn');
        if (btn) { btn.disabled = false; }
    }
    function showSubmissionFailure(message) {
        var node = form.querySelector('.basrelief-submit-error');
        if (!node) {
            node = document.createElement('p');
            node.className = 'basrelief-submit-error text-danger small text-center mt-2 mb-0';
            node.setAttribute('role', 'alert');
            var button = form.querySelector('.basrelief-submit-btn');
            if (button && button.parentNode) { button.parentNode.insertBefore(node, button.nextSibling); }
        }
        node.textContent = message || "\u0427\u0442\u043e-\u0442\u043e \u043f\u043e\u0448\u043b\u043e \u043d\u0435 \u0442\u0430\u043a, \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0441\u043d\u043e\u0432\u0430.";
    }
    var basreliefRequestInFlight = false;
    function navigateAfterBasreliefSubmit(responseUrl) {
        var destination = new URL(responseUrl, window.location.href);
        if (destination.origin === window.location.origin && destination.searchParams.get('gen_id')) {
            window.AiprintgenDraft?.submitted(form);
        }
        var generationLock = window.AiprintgenGenerationLock;
        if (generationLock && typeof generationLock.allowServerNavigation === 'function') {
            generationLock.allowServerNavigation();
        }
        window.location.assign(responseUrl);
    }
    function updateUploadProgress(event) {
        if (!event || !event.lengthComputable || !event.total) { return; }
        if (window.AiprintgenGenerationLock) {
            window.AiprintgenGenerationLock.progress((event.loaded / event.total) * 100);
        }
    }
    function waitForBasreliefServerConfirmation() {
        if (!window.AiprintgenGenerationLock) { return; }
        window.AiprintgenGenerationLock.show({
            title: form.getAttribute('data-br-starting-title') || "\u0413\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044f \u0438\u0434\u0435\u0442",
            body: form.getAttribute('data-br-starting-body') || "\u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u0434\u043e\u0436\u0434\u0438\u0442\u0435\u0441\u044c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430 \u043d\u0430 \u044d\u0442\u043e\u0439 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0435. \u041e\u043d \u043e\u0442\u043a\u0440\u043e\u0435\u0442\u0441\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438."
