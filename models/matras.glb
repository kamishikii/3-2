            var csrfTokenPromise = null;

            function csrfTokenReady() {
                if (window.appCsrfToken) {
                    return Promise.resolve(window.appCsrfToken);
                }
                if (!csrfTokenPromise) {
                    csrfTokenPromise = nativeFetch('/api/csrf_token', {
                        credentials: 'same-origin',
                        headers: { 'Accept': 'application/json' }
                    }).then(function(response) {
                        return response.ok ? response.json() : {};
