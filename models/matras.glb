                        );
                        return window.appCsrfToken;
                    }).catch(function() {
                        return '';
                    }).finally(function() {
                        csrfTokenPromise = null;
                    });
                }
                return csrfTokenPromise;
            }

            window.aiprintgenCsrfToken = csrfTokenReady;

            // Heavy tool POSTs may be accepted as a background job (202 with
            // X-Tool-Job-Ticket, functions/tool_jobs.py): the edge drops a
            // request after ~50 s. The caller still gets one Response - the
            // tool's own - after the job finishes, so tool scripts stay as is.
            function abortError() {
                try { return new DOMException('Aborted', 'AbortError'); } catch (error) {
                    var fallback = new Error('Aborted');
                    fallback.name = 'AbortError';
                    return fallback;
                }
            }
            function sleep(ms, signal) {
                return new Promise(function(resolve, reject) {
                    if (signal && signal.aborted) { reject(abortError()); return; }
                    function onAbort() { clearTimeout(timer); reject(abortError()); }
                    var timer = setTimeout(function() {
                        if (signal) { signal.removeEventListener('abort', onAbort); }
                        resolve();
                    }, ms);
                    if (signal) { signal.addEventListener('abort', onAbort, { once: true }); }
                });
            }
            function waitToolJob(response, signal) {
                return response.json().then(function(ticket) {
                    var delay = 500, failures = 0;
                    var get = { credentials: 'same-origin', cache: 'no-store', signal: signal };
                    function poll() {
                        return sleep(delay, signal).then(function() {
                            delay = Math.min(delay + 300, 2500);
                            return nativeFetch(ticket.status_url, get);
                        }).then(function(statusResponse) {
                            if (!statusResponse.ok) { return { status: 'gone' }; }
                            return statusResponse.json();
                        }).then(function(state) {
                            failures = 0;
                            if (state && (state.status === 'queued' || state.status === 'running')) { return poll(); }
                            return nativeFetch(ticket.result_url, get);
                        }).catch(function(error) {
                            if ((error && error.name === 'AbortError') || ++failures > 20) { throw error; }
                            return poll();
                        });
                    }
                    return poll();
                });
            }
