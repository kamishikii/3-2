0434\u0435\u043d\u044b.&#34;, &#34;cadjs_not_watertight&#34;: &#34;\u043d\u0435 \u0437\u0430\u043c\u043a\u043d\u0443\u0442\u0430\u044f&#34;, &#34;cadjs_open_in_library&#34;: &#34;\u041e\u0442\u043a\u0440\u044b\u0442\u044c \u0432 \u043c\u043e\u0438\u0445 \u043c\u043e\u0434\u0435\u043b\u044f\u0445&#34;, &#34;cadjs_orientation&#34;: &#34;\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u043c\u044b\u0439 \u043f\u043e\u0432\u043e\u0440\u043e\u0442: X {x}\u00b0, Y {y}\u00b0, Z {z}\u00b0&#34;, &#34;cadjs_overhangs&#34;: &#34;\u041f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c \u043d\u0430\u0432\u0438\u0441\u0430\u043d\u0438\u0439: {percent}%&#34;, &#34;cadjs_partial_checks&#34;: &#34;\u0427\u0430\u0441\u0442\u044c \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u0439 \u043d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044c.&#34;, &#34;cadjs_print_advisory&#34;: &#34;\u041e\u0446\u0435\u043d\u043a\u0438 \u043f\u0435\u0447\u0430\u0442\u0438 \u0441\u043f\u0440\u0430\u0432\u043e\u0447\u043d\u044b\u0435. \u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u043c\u043e\u0434\u0435\u043b\u044c \u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0432 \u0441\u043b\u0430\u0439\u0441\u0435\u0440\u0435.&#34;, &#34;cadjs_project&#34;: &#34;\u041f\u0440\u043e\u0435\u043a\u0442 ZIP&#34;, &#34;cadjs_quality&#34;: &#34;\u0418\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f \u0438 \u043e\u0446\u0435\u043d\u043a\u0430 \u043f\u0435\u0447\u0430\u0442\u0438&#34;, &#34;cadjs_report&#34;: &#34;\u041e\u0442\u0447\u0451\u0442 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438&#34;, &#34;cadjs_save&#34;: &#34;\u0421\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0432 \u043c\u043e\u0438 \u043c\u043e\u0434\u0435\u043b\u0438&#34;, &#34;cadjs_save_failed&#34;: &#34;\u041d\u0435 \u043f\u043e\u043f\u0430\u043b\u043e \u0432 \u00ab\u041c\u043e\u0438 \u043c\u043e\u0434\u0435\u043b\u0438\u00bb \u2014 \u0441\u043a\u0430\u0447\u0430\u0439\u0442\u0435 \u0444\u0430\u0439\u043b\u044b&#34;, &#34;cadjs_saving&#34;: &#34;\u0421\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u043c\u2026&#34;, &#34;cadjs_search&#34;: &#34;\u041d\u0430\u0439\u0442\u0438&#34;, &#34;cadjs_show&#34;: &#34;\u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c&#34;, &#34;cadjs_size_assumed&#34;: &#34;\u0440\u0430\u0437\u043c\u0435\u0440 \u043f\u043e\u0434\u043e\u0431\u0440\u0430\u043d \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438&#34;, &#34;cadjs_source&#34;: &#34;\u0438\u0441\u0445\u043e\u0434\u043d\u0438\u043a&#34;, &#34;cadjs_stage_aborted&#34;: &#34;\u0417\u0430\u0434\u0430\u043d\u0438\u0435 \u043f\u0440\u0435\u0440\u0432\u0430\u043d\u043e&#34;, &#34;cadjs_stage_analyzing&#34;: &#34;\u0410\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u0435\u043c \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0438 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f&#34;, &#34;cadjs_stage_building&#34;: &#34;{label}: \u0441\u0442\u0440\u043e\u0438\u043c \u043c\u043e\u0434\u0435\u043b\u044c&#34;, &#34;cadjs_stage_checking&#34;: &#34;{label}: \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u043c \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e&#34;, &#34;cadjs_stage_clarify_expired&#34;: &#34;\u0412\u0440\u0435\u043c\u044f \u043e\u0436\u0438\u0434\u0430\u043d\u0438\u044f \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u044f \u0438\u0441\u0442\u0435\u043a\u043b\u043e&#34;, &#34;cadjs_stage_clarify_needed&#34;: &#34;\u041d\u0443\u0436\u043d\u043e \u043e\u0434\u043d\u043e \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u0435&#34;, &#34;cadjs_stage_clarify_received&#34;: &#34;\u0423\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u0435 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043e&#34;, &#34;cadjs_stage_done&#34;: &#34;\u0413\u043e\u0442\u043e\u0432\u043e \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432: {done} \u0438\u0437 {total}&#34;, &#34;cadjs_stage_failed&#34;: &#34;\u041e\u0448\u0438\u0431\u043a\u0430 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438&#34;, &#34;cadjs_stage_fixing&#34;: &#34;{label}: \u0438\u0441\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u043c \u043e\u0448\u0438\u0431\u043a\u0443&#34;, &#34;cadjs_stage_method&#34;: &#34;\u041c\u0435\u0442\u043e\u0434 {method}&#34;, &#34;cadjs_stage_method_boosted&#34;: &#34;\u041c\u0435\u0442\u043e\u0434 {method} \u00b7 \u0443\u0441\u0438\u043b\u0435\u043d\u043d\u044b\u0439&#34;, &#34;cadjs_stage_none_built&#34;: &#34;\u041d\u0438 \u043e\u0434\u0438\u043d \u0432\u0430\u0440\u0438\u0430\u043d\u0442 \u043d\u0435 \u0441\u043e\u0431\u0440\u0430\u043b\u0441\u044f&#34;, &#34;cadjs_stage_queued&#34;: &#34;\u0412 \u043e\u0447\u0435\u0440\u0435\u0434\u0438&#34;, &#34;cadjs_stage_spec_unresolved&#34;: &#34;\u0422\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f \u043a \u043c\u043e\u0434\u0435\u043b\u0438 \u043d\u0443\u0436\u043d\u043e \u0443\u0442\u043e\u0447\u043d\u0438\u0442\u044c&#34;, &#34;cadjs_status_complete&#34;: &#34;\u0413\u043e\u0442\u043e\u0432\u043e&#34;, &#34;cadjs_status_executing&#34;: &#34;\u0421\u043e\u0431\u0438\u0440\u0430\u0435\u043c \u0434\u0435\u0442\u0430\u043b\u044c&#34;, &#34;cadjs_status_expired&#34;: &#34;\u0412\u0440\u0435\u043c\u044f \u0432\u044b\u0448\u043b\u043e&#34;, &#34;cadjs_status_failed&#34;: &#34;\u041e\u0448\u0438\u0431\u043a\u0430&#34;, &#34;cadjs_status_generating&#34;: &#34;\u0421\u0442\u0440\u043e\u0438\u043c \u043c\u043e\u0434\u0435\u043b\u044c&#34;, &#34;cadjs_status_needs_input&#34;: &#34;\u041d\u0443\u0436\u043d\u043e \u0443\u0442\u043e\u0447\u043d\u0435\u043d\u0438\u0435&#34;, &#34;cadjs_status_planning&#34;: &#34;\u0420\u0430\u0437\u0431\u0438\u0440\u0430\u0435\u043c \u0437\u0430\u0434\u0430\u0447\u0443&#34;, &#34;cadjs_status_queued&#34;: &#34;\u0412 \u043e\u0447\u0435\u0440\u0435\u0434\u0438&#34;, &#34;cadjs_status_repairing&#34;: &#34;\u0418\u0441\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u043c \u043e\u0448\u0438\u0431\u043a\u0443&#34;, &#34;cadjs_status_validating&#34;: &#34;\u041f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u043c \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044e&#34;, &#34;cadjs_submit_busy&#34;: &#34;\u0417\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u043c\u2026&#34;, &#34;cadjs_unverified&#34;: &#34;\u041d\u0435 \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u043e&#34;, &#34;cadjs_unverified_note&#34;: &#34;\u041f\u043e\u043f\u044b\u0442\u043a\u0438 \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u043b\u0438\u0441\u044c \u2014 \u044d\u0442\u043e \u043b\u0443\u0447\u0448\u0435\u0435, \u0447\u0442\u043e \u043f\u043e\u043b\u0443\u0447\u0438\u043b\u043e\u0441\u044c. \u0421\u043a\u043e\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043e, \u0434\u0435\u0442\u0430\u043b\u044c \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0441\u043b\u043e\u0436\u043d\u0430\u044f: \u043f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0435\u0451 \u043f\u0435\u0440\u0435\u0434 \u043f\u0435\u0447\u0430\u0442\u044c\u044e.&#34;, &#34;cadjs_use_component&#34;: &#34;\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0432 \u0437\u0430\u043f\u0440\u043e\u0441&#34;, &#34;cadjs_variants&#34;: &#34;\u0412\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432: {n} \u00b7 \u043a\u0440\u0435\u0434\u0438\u0442\u043e\u0432: {c}&#34;, &#34;cadjs_viewer_failed&#34;: &#34;\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u043c\u043e\u0434\u0435\u043b\u044c \u2014 \u0441\u043a\u0430\u0447\u0430\u0439\u0442\u0435 STL&#34;, &#34;cadjs_visual_unverified&#34;: &#34;\u0412\u0438\u0437\u0443\u0430\u043b\u044c\u043d\u043e\u0435 \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u043d\u0435 \u0434\u0430\u043b\u043e \u043e\u0434\u043d\u043e\u0437\u043d\u0430\u0447\u043d\u043e\u0433\u043e \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430.&#34;, &#34;cadjs_wall_sample&#34;: &#34;\u0422\u043e\u043b\u0449\u0438\u043d\u0430 \u0441\u0442\u0435\u043d\u043e\u043a \u043f\u043e \u0432\u044b\u0431\u043e\u0440\u043a\u0435 (5-\u0439 \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u0438\u043b\u044c): {mm} \u043c\u043c&#34;, &#34;cadjs_watertight&#34;: &#34;\u0437\u0430\u043c\u043a\u043d\u0443\u0442\u0430\u044f&#34;}"
    data-image-preview-label="Предпросмотр выбранной фотографии"
    data-locked="1"
    data-tool-access-allowed="0"
    data-tool-access-reason="anonymous"
