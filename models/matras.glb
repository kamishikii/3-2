        { key: 'mesh_optimizer', img: "/static/images/gen_tip_mesh_optimizer.webp?v=20261014",
          badge: "\u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0433\u0435\u043d\u0435\u0440\u0430\u0442\u043e\u0440\u0430",
          title: "\u0424\u0430\u0439\u043b \u043c\u043e\u0434\u0435\u043b\u0438 \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0442\u044f\u0436\u0451\u043b\u044b\u0439?",
          text: "\u0423\u043c\u0435\u043d\u044c\u0448\u0438\u0442\u0435 \u0447\u0438\u0441\u043b\u043e \u043f\u043e\u043b\u0438\u0433\u043e\u043d\u043e\u0432 \u0438 \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435, \u043a\u0430\u043a \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0430\u0441\u044c \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c. \u0412\u0441\u0451 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u0432 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0435.",
          cta: "\u041e\u0431\u043b\u0435\u0433\u0447\u0438\u0442\u044c \u043c\u043e\u0434\u0435\u043b\u044c",
