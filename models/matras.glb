<script id="generation-upload-limits-i18n" type="application/json">{"anyTooLarge": "\u0412\u044b\u0431\u0440\u0430\u043d\u043d\u044b\u0435 \u0444\u0430\u0439\u043b\u044b \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0431\u043e\u043b\u044c\u0448\u0438\u0435. \u0418\u0445 \u043e\u0431\u0449\u0438\u0439 \u0440\u0430\u0437\u043c\u0435\u0440 \u043d\u0435 \u0434\u043e\u043b\u0436\u0435\u043d \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0442\u044c {limit} \u041c\u0411.", "limits": {"imageMaxBytes": 9000000, "maxFileBytes": 190000000, "maxRequestBytes": 195000000}, "preuploadBody": "\u0413\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044f \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0441\u044f, \u043a\u0430\u043a \u0442\u043e\u043b\u044c\u043a\u043e \u0444\u043e\u0442\u043e \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u0441\u044f. \u0415\u0441\u043b\u0438 \u0441\u0432\u044f\u0437\u044c \u043e\u0431\u043e\u0440\u0432\u0451\u0442\u0441\u044f, \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u043c \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0443 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438.", "preuploadFailed": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u0444\u043e\u0442\u043e. \u0424\u0430\u0439\u043b\u044b \u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u044b. \u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0435 \u0438 \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451 \u0440\u0430\u0437. \u0413\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044f \u043d\u0435 \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u0430.", "preuploadTitle": "\u0417\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u043c \u0444\u043e\u0442\u043e", "preuploadUrl": "/uploads/photo", "requestTooLarge": "\u0417\u0430\u0433\u0440\u0443\u0437\u043a\u0430 \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0431\u043e\u043b\u044c\u0448\u0430\u044f. \u0423\u043c\u0435\u043d\u044c\u0448\u0438\u0442\u0435 \u0440\u0430\u0437\u043c\u0435\u0440 \u0444\u0430\u0439\u043b\u043e\u0432 \u0438\u043b\u0438 \u0434\u0430\u043d\u043d\u044b\u0445 \u0438 \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0435.", "tooLarge": "\u041e\u0431\u0449\u0438\u0439 \u0440\u0430\u0437\u043c\u0435\u0440 \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u044b\u0445 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0439 \u0431\u043e\u043b\u044c\u0448\u0435 9 \u041c\u0411. \u0423\u043c\u0435\u043d\u044c\u0448\u0438\u0442\u0435 \u0444\u0430\u0439\u043b\u044b \u0438 \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0438\u0445 \u0441\u043d\u043e\u0432\u0430. \u0413\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044f \u043d\u0435 \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u0430, \u043a\u0440\u0435\u0434\u0438\u0442 \u043d\u0435 \u0441\u043f\u0438\u0441\u0430\u043d."}</script>
