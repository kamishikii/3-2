    // Фото с телефона (4–9 МБ) по мобильной сети грузится минуту и дольше, и
    // обрыв посреди тела доходит до сервера пустой формой (400 «CSRF token is
    // missing»), а сюда — сетевой ошибкой: stakasha88 02.10 грузил 250 с и
    // дважды упал так. Пайплайн всё равно работает с 2048 px по длинной
    // стороне (Hi3D — профиль 2048quality, локальные ветки делают thumbnail
    // 2048), поэтому крупное фото ужимаем ещё в браузере: байт в 5–10 раз
    // меньше, окно для обрыва во столько же короче. Любая осечка (нет canvas,
    // не декодировалось, вышло не легче) — уходит оригинал.
    var UPLOAD_MAX_SIDE_PX = 2048;
    var UPLOAD_SHRINK_MIN_BYTES = 1500000;
    var UPLOAD_JPEG_QUALITY = 0.92;
    var UPLOAD_SHRINK_TIMEOUT_MS = 10000;
    function shrinkBasreliefUpload(formData) {
        var file = typeof formData.get === 'function' ? formData.get('basrelief_image') : null;
        var mime = file && typeof file !== 'string' ? String(file.type || '').toLowerCase() : '';
        if (!mime || ACCEPTED_IMAGE_TYPES.indexOf(mime) === -1 || file.size < UPLOAD_SHRINK_MIN_BYTES ||
                typeof formData.set !== 'function' || !window.URL || !window.URL.createObjectURL) {
            return Promise.resolve(formData);
        }
        return new Promise(function (resolve) {
            var url = URL.createObjectURL(file);
            var probe = new Image();
            var settled = false;
            // Не дождались декодера или toBlob — оверлей не должен висеть.
            var timer = setTimeout(function () { finish(null); }, UPLOAD_SHRINK_TIMEOUT_MS);
            function finish(blob) {
                if (settled) { return; }
                settled = true;
                clearTimeout(timer);
                URL.revokeObjectURL(url);
                if (blob && blob.size && blob.size < file.size) {
                    formData.set('basrelief_image', blob, file.name || 'photo');
                }
                resolve(formData);
            }
            probe.onerror = function () { finish(null); };
            probe.onload = function () {
                try {
                    var longSide = Math.max(probe.naturalWidth, probe.naturalHeight);
                    if (!longSide || longSide <= UPLOAD_MAX_SIDE_PX) { finish(null); return; }
                    var scale = UPLOAD_MAX_SIDE_PX / longSide;
                    var canvas = document.createElement('canvas');
                    canvas.width = Math.max(1, Math.round(probe.naturalWidth * scale));
                    canvas.height = Math.max(1, Math.round(probe.naturalHeight * scale));
                    var context = canvas.getContext && canvas.getContext('2d');
                    if (!context || typeof canvas.toBlob !== 'function') { finish(null); return; }
                    context.imageSmoothingEnabled = true;
                    context.imageSmoothingQuality = 'high';
                    context.drawImage(probe, 0, 0, canvas.width, canvas.height);
                    // Формат сохраняем: PNG/WebP могут нести прозрачность
                    // (уже вырезанный фон), JPEG-фото остаётся JPEG.
                    canvas.toBlob(finish, mime, UPLOAD_JPEG_QUALITY);
                } catch (error) {
                    finish(null);
                }
            };
            probe.src = url;
        });
    }
    // Один тихий повтор после обрыва связи. Тот же FormData несёт тот же
    // basrelief_tab_session_id: если первый запрос всё-таки дошёл, сервер
    // переподключит к той же резервации, а не спишет второй кредит.
    var BASRELIEF_NETWORK_RETRY_DELAY_MS = 1500;
    function postBasreliefWithRetry(formData) {
        return postBasreliefForm(formData).catch(function (error) {
            if (!error || error.message !== 'network') { throw error; }
            return new Promise(function (resolve) {
                setTimeout(resolve, BASRELIEF_NETWORK_RETRY_DELAY_MS);
            }).then(function () {
                showBasreliefUploadLock();
                return postBasreliefForm(formData);
            });
        });
    }
    function submitBasrelief() {
        if (basreliefRequestInFlight) { return; }
        var submitScope = ensureBasreliefSubmitScope();
        var formData = new FormData(form);
        if (!window.AIprintgenGenerationUploadLimits.validateFormData(formData, form, 9000000)) { return; }
        basreliefRequestInFlight = true;
        rememberBasreliefSubmit(submitScope);
        var oldError = form.querySelector('.basrelief-submit-error');
        if (oldError) { oldError.textContent = ''; }
        enterSubmittingState();
        shrinkBasreliefUpload(formData).then(postBasreliefWithRetry).then(function (result) {
            if (result && result.redirected) {
                navigateAfterBasreliefSubmit(result.redirected);
                return null;
            }
            if (!result) { return; }
            var response = result.response;
            if (response.redirected && response.url) {
                navigateAfterBasreliefSubmit(response.url);
                return;
            }
            var reason = responseAccessReason(response, result.payload);
            if (reason) {
                basreliefRequestInFlight = false;
                leaveSubmittingState();
                openToolAccess(reason);
                return;
            }
            var redirectUrl = result.payload &&
                (result.payload.redirect_url || result.payload.location);
            if (result.response.ok && redirectUrl) {
                navigateAfterBasreliefSubmit(redirectUrl);
