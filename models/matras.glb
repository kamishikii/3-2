        { key: 'basrelief', img: "/static/images/gen_tip_basrelief.webp",
          badge: "\u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0433\u0435\u043d\u0435\u0440\u0430\u0442\u043e\u0440\u0430",
          title: "\u0411\u0430\u0440\u0435\u043b\u044c\u0435\u0444 \u0438\u043b\u0438 \u0443\u0433\u043b\u0443\u0431\u043b\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u0444\u043e\u0440\u043c\u044b?",
          text: "\u0421\u0440\u0430\u0432\u043d\u0438\u0442\u0435 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043c\u0435\u0442\u043e\u0434\u043e\u0432. \u0420\u0435\u043b\u044c\u0435\u0444 \u043c\u043e\u0436\u043d\u043e \u0438\u043d\u0432\u0435\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0432 \u0443\u0433\u043b\u0443\u0431\u043b\u0435\u043d\u0438\u0435 \u2014 \u043e\u0441\u043d\u043e\u0432\u0443 \u0434\u043b\u044f \u0444\u043e\u0440\u043c\u044b, \u043c\u0430\u0442\u0440\u0438\u0446\u044b \u0438\u043b\u0438 \u0448\u0442\u0430\u043c\u043f\u0430.",
          cta: "\u0421\u043e\u0437\u0434\u0430\u0442\u044c \u0440\u0435\u043b\u044c\u0435\u0444 \u0438\u043b\u0438 \u0443\u0433\u043b\u0443\u0431\u043b\u0435\u043d\u0438\u0435",
          href: "/bas-relief-generator" + '?from=gen_slider_basrelief', target: '_blank' },
        { key: 'parallel', img: "/static/images/parallel_gen.webp",
