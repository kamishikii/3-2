<script src="/static/js/basrelief_settings.js"></script>
<script>
window.BasreliefSettings && window.BasreliefSettings.initializeAll(document);
</script>
<script>
(function () {
    var form = document.currentScript.previousElementSibling;
    while (form && (!form.classList || !form.classList.contains('basrelief-form'))) {
        form = form.previousElementSibling;
    }
    if (!form || !form.classList || !form.classList.contains('basrelief-form')) { return; }
    var basreliefSubmitScopeStorageKey = 'aiprintgenBasreliefTabSessionId';
    var basreliefSubmitPendingStorageKey = 'aiprintgenBasreliefSubmitPendingV1';
    var basreliefClearedPreviewStorageKey = 'aiprintgenBasreliefClearedServerPreviewV1';
    var basreliefScopeInput = form.querySelector('.basrelief-tab-session-id');

    function serverPreviewIdentity(preview) {
        var source = preview && preview.getAttribute('data-server-preview-url');
        if (!source) { return ''; }
        try {
            var parsed = new URL(source, window.location.href);
            // Ignore only the cache-busting version, not the generation that
            // owns the source: a later job can reuse the same local filename.
            return parsed.pathname + '?gen_id=' + (parsed.searchParams.get('gen_id') || '');
        } catch (error) { return ''; }
    }
    function rememberClearedServerPreview(preview) {
        var identity = serverPreviewIdentity(preview);
        if (!identity) { return; }
        try { window.sessionStorage.setItem(basreliefClearedPreviewStorageKey, identity); } catch (error) {}
    }
    function suppressClearedServerPreview() {
        var preview = form.querySelector('[data-upload-preview-container]');
        var identity = serverPreviewIdentity(preview);
        var cleared = '';
        try { cleared = window.sessionStorage.getItem(basreliefClearedPreviewStorageKey) || ''; } catch (error) {}
        if (!identity || !cleared) { return; }
        if (identity !== cleared) {
            try { window.sessionStorage.removeItem(basreliefClearedPreviewStorageKey); } catch (error) {}
            return;
        }
        var image = preview.querySelector('[data-upload-preview-image]');
        if (image) { image.removeAttribute('src'); }
        preview.style.display = 'none';
        preview.removeAttribute('data-server-preview-url');
        preview.removeAttribute('data-server-preview-name');
    }
    suppressClearedServerPreview();

    function createBasreliefSubmitScope() {
        if (window.crypto && typeof window.crypto.randomUUID === 'function') {
            return window.crypto.randomUUID();
        }
        return 'basrelief_' + Date.now().toString(36) + '_' +
            Math.random().toString(36).slice(2, 12);
    }
    function validBasreliefSubmitScope(value) {
        return /^[A-Za-z0-9_-]{16,120}$/.test(String(value || '').trim());
    }
    function readBasreliefSubmitScope() {
        try {
            var stored = String(
                window.sessionStorage.getItem(basreliefSubmitScopeStorageKey) || ''
            ).trim();
            return validBasreliefSubmitScope(stored) ? stored : '';
        } catch (error) {
            return '';
        }
    }
    function getOrCreateBasreliefSubmitScope() {
        try {
            var stored = readBasreliefSubmitScope();
            if (stored) { return stored; }
            var created = createBasreliefSubmitScope();
            window.sessionStorage.setItem(basreliefSubmitScopeStorageKey, created);
            return created;
        } catch (error) {
            // Privacy modes can block sessionStorage.  ensure() then falls
            // back to the scope rendered with the staged server preview.
            return '';
        }
    }
    function storeBasreliefSubmitScope(scope) {
        try {
            window.sessionStorage.setItem(basreliefSubmitScopeStorageKey, scope);
        } catch (error) {}
    }
    function readBasreliefSubmitPending(scope) {
        try {
            var raw = window.sessionStorage.getItem(basreliefSubmitPendingStorageKey);
            if (!raw) { return null; }
            var pending = JSON.parse(raw);
            if (!pending || !validBasreliefSubmitScope(pending.scope)) { return null; }
            if (scope && String(pending.scope) !== String(scope)) { return null; }
            return pending;
        } catch (error) {
            return null;
        }
    }
    function rememberBasreliefSubmit(scope) {
        if (!validBasreliefSubmitScope(scope)) { return; }
        try {
            window.sessionStorage.setItem(
                basreliefSubmitPendingStorageKey,
                JSON.stringify({scope: scope, submittedAt: Date.now()})
            );
        } catch (error) {}
    }
    function clearBasreliefSubmitPending() {
        try {
            window.sessionStorage.removeItem(basreliefSubmitPendingStorageKey);
        } catch (error) {}
    }
    function rotateBasreliefSubmitScope(forcedScope) {
        var normalizedForced = String(forcedScope || '').trim();
        var nextScope = validBasreliefSubmitScope(normalizedForced)
            ? normalizedForced
            : createBasreliefSubmitScope();
        storeBasreliefSubmitScope(nextScope);
        if (basreliefScopeInput) { basreliefScopeInput.value = nextScope; }
        form.setAttribute('data-server-tab-session-id', normalizedForced || '');
        clearBasreliefSubmitPending();
        return nextScope;
    }
    function ensureBasreliefSubmitScope() {
        var current = basreliefScopeInput
            ? String(basreliefScopeInput.value || '').trim()
            : '';
        // A real sessionStorage is per tab.  Create its value before looking
        // at the server fallback, otherwise a newly opened tab would inherit
        // the previous tab's completed paid intent from the Flask session.
        var clientScope = getOrCreateBasreliefSubmitScope();
        var serverScope = String(
            form.getAttribute('data-server-tab-session-id') || ''
        ).trim();
        var resolved = clientScope ||
            (validBasreliefSubmitScope(current) ? current : '') ||
            (validBasreliefSubmitScope(serverScope) ? serverScope : '') ||
            createBasreliefSubmitScope();
        storeBasreliefSubmitScope(resolved);
        if (basreliefScopeInput) { basreliefScopeInput.value = resolved; }
        return resolved;
    }
    function setupBasreliefSubmitScope() {
        var forcedScope = '';
        var terminalUrl = false;
        try {
            var params = new URLSearchParams(window.location.search);
            forcedScope = String(
                params.get('reset_basrelief_submit') || ''
            ).trim();
            terminalUrl = params.has('completed') || params.has('error');
        } catch (error) {}
        if (forcedScope) {
            rotateBasreliefSubmitScope(forcedScope);
        } else if (terminalUrl) {
            rotateBasreliefSubmitScope();
        } else {
            ensureBasreliefSubmitScope();
        }
    }
    setupBasreliefSubmitScope();
    window.__basreliefSubmitScopeTest = {
        ensure: ensureBasreliefSubmitScope,
        readPending: readBasreliefSubmitPending,
        remember: rememberBasreliefSubmit,
        rotate: rotateBasreliefSubmitScope
    };
    function normalizedAccessReason(value) {
        var reason = String(value || '').trim().toLowerCase();
        // 'trial' — это разрешение, в модалку оно не идёт; 'trial_exhausted'
        // идёт и показывает свой текст про месячные тарифы.
        return reason === 'anonymous' || reason === 'plan_required' ||
            reason === 'trial_exhausted' ? reason : '';
    }
    function openToolAccess(reason) {
        var resolved = normalizedAccessReason(reason) || 'plan_required';
        form.setAttribute('data-tool-access-allowed', '0');
        form.setAttribute('data-tool-access-reason', resolved);
        updateSubmitLabel();
        if (window.AIprintgenToolAccess &&
                typeof window.AIprintgenToolAccess.open === 'function') {
            window.AIprintgenToolAccess.open({
                reason: resolved, feature: 'basrelief', context: basreliefAccessContext(resolved)
            });
        }
    }
    function updateSubmitLabel() {
        var button = form.querySelector('.basrelief-submit-btn');
        if (!button || !button.hasAttribute('data-br-submit-allowed-label')) { return; }
        var allowed = form.getAttribute('data-tool-access-allowed') === '1';
        var reason = String(form.getAttribute('data-tool-access-reason') || '').toLowerCase();
        var label = allowed || reason === 'ok' || reason === 'admin' || reason === 'trial'
            ? button.getAttribute('data-br-submit-allowed-label')
            : (reason === 'anonymous'
                ? button.getAttribute('data-br-submit-guest-label')
                : button.getAttribute('data-br-submit-access-label'));
        if (label) {
            var labelNode = button.querySelector('[data-br-submit-label]');
            if (labelNode) { labelNode.textContent = label; } else { button.textContent = label; }
        }
    }
    updateSubmitLabel();
    // Landing only: show the visitor their own file. The modal waits for an
    // actual IndexedDB save result before claiming that the draft is saved.
    function basreliefAccessContext(reason) {
        var saved = form.getAttribute('data-br-modal-saved');
        if (saved === null) { return null; }
        var input = form.querySelector('#basrelief_image_input');
        var file = input && input.files && input.files[0];
        var preview = form.querySelector('[data-upload-preview-image]');
        var draftSave = null;
        if (reason === 'anonymous' && file && window.AiprintgenDraft &&
                typeof window.AiprintgenDraft.save === 'function') {
            try { draftSave = window.AiprintgenDraft.save(); } catch (error) { draftSave = Promise.resolve(false); }
        }
        var anonymousText = form.getAttribute('data-br-modal-anonymous') || '';
        var trialText = form.getAttribute('data-br-modal-trials') || '';
        return {
            imageUrl: preview && preview.getAttribute('src') || '',
            fileName: file ? file.name : (form.querySelector('[data-br-file-name]') || {}).textContent || '',
            savedText: draftSave ? saved : '',
            savedPromise: draftSave,
            text: reason === 'anonymous' ? [trialText, anonymousText].filter(Boolean).join('. ') : '',
            termsText: '',
            termsLabel: form.getAttribute('data-br-modal-terms-label') || '',
            termsHref: form.getAttribute('data-br-modal-terms-href') || ''
        };
    }
    function toolActionDenied() {
        if (form.getAttribute('data-tool-access-allowed') === '1') { return false; }
        var reason = String(form.getAttribute('data-tool-access-reason') || '').toLowerCase();
        if (reason === 'ok' || reason === 'admin') { return false; }
        openToolAccess(reason);
        return true;
    }
    function responseAccessReason(response, payload) {
        if (!response || (response.status !== 401 && response.status !== 403)) { return ''; }
        var reason = normalizedAccessReason(payload && (payload.reason || payload.code));
        return reason || (response.status === 401 ? 'anonymous' : '');
    }
    // Фоллбэк-инициализация дропзоны для отдельной страницы
    // /bas-relief-generator: полная механика (initSingleFileDropzone) живёт в
    // index.html и вешает на элемент _assignDroppedFile; если её нет —
    // добавляем минимум: клик/клавиатура/dnd + превью и имя файла.
    document.addEventListener('DOMContentLoaded', function () {
        var dropzone = form.querySelector('.file-dropzone[data-dropzone-for]');
        var input = form.querySelector('#basrelief_image_input');
        if (!dropzone || !input) { return; }
        var previewObjectUrl = '';
        function refreshPreview() {
            var nameNode = dropzone.querySelector('[data-dropzone-filename]');
            var previewContainer = form.querySelector('[data-upload-preview-container]');
            var previewImage = previewContainer ? previewContainer.querySelector('[data-upload-preview-image]') : null;
            var file = input.files && input.files[0];
            if (nameNode) {
                nameNode.textContent = file ? file.name : (nameNode.getAttribute('data-empty-text') || '');
            }
            dropzone.classList.remove('is-invalid');
            dropzone.classList.toggle('has-file', !!file);
            if (previewContainer && previewImage) {
                if (previewObjectUrl) {
                    URL.revokeObjectURL(previewObjectUrl);
                    previewObjectUrl = '';
                }
                if (file) {
                    previewObjectUrl = URL.createObjectURL(file);
                    previewImage.src = previewObjectUrl;
                    previewContainer.style.display = 'flex';
                } else {
                    previewImage.removeAttribute('src');
                    previewContainer.style.display = 'none';
                }
            }
        }
        if (!window.AIprintgenIndexOwnsFileDropzones) {
            input.addEventListener('change', refreshPreview);
        }
        setTimeout(function () {
            if (typeof dropzone._assignDroppedFile === 'function') { return; }
            dropzone.addEventListener('click', function () { input.click(); });
            dropzone.addEventListener('keydown', function (event) {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    input.click();
                }
            });
            ['dragenter', 'dragover'].forEach(function (type) {
                dropzone.addEventListener(type, function (event) {
                    event.preventDefault();
                    dropzone.classList.add('is-dragover');
                });
            });
            ['dragleave', 'drop'].forEach(function (type) {
                dropzone.addEventListener(type, function (event) {
                    event.preventDefault();
                    dropzone.classList.remove('is-dragover');
                });
            });
            dropzone.addEventListener('drop', function (event) {
                if (event.dataTransfer && event.dataTransfer.files && event.dataTransfer.files.length) {
                    input.files = event.dataTransfer.files;
                    var changeEvent;
                    if (typeof window.Event === 'function') {
                        changeEvent = new Event('change', { bubbles: true });
                    } else {
                        changeEvent = document.createEvent('Event');
                        changeEvent.initEvent('change', true, false);
                    }
                    input.dispatchEvent(changeEvent);
                }
            });
        }, 0);
    });
    // Мелкая картинка отсеивается ДО отправки: раньше файл ехал на сервер
    // (16-19с у пользователя с интервью 28.07), там резервировался кредит,
    // валидация роняла генерацию и кредит возвращался — с точки зрения
    // человека «списали два кредита ни за что». Порог тот же, что на сервере
    // (MIN_INPUT_SIDE_PX в functions/basrelief.py).
    var MIN_INPUT_SIDE_PX = 300;
    var MAX_INPUT_BYTES = 9000000;
    var MAX_INPUT_PIXELS = 50000000;
    var ACCEPTED_IMAGE_TYPES = ['image/jpeg', 'image/png', 'image/webp'];
    var ACCEPTED_IMAGE_EXTENSIONS = /\.(?:jpe?g|png|webp)$/i;
    var sizeVerdict = null; // {file, result}
    var announcedValidatedFile = null;
    function sizeNotice() {
        var node = form.querySelector('.basrelief-size-error');
        if (!node) {
            node = document.createElement('p');
            node.id = 'basrelief-size-error';
            node.className = 'basrelief-size-error text-danger small mt-2 mb-0';
            node.setAttribute('role', 'alert');
            node.setAttribute('aria-live', 'assertive');
            var dropzone = form.querySelector('.file-dropzone-with-preview');
            if (dropzone && dropzone.parentNode) { dropzone.parentNode.appendChild(node); }
        }
        return node;
    }
    function showUploadError(message, reason, focus) {
        var notice = sizeNotice();
        notice.textContent = message;
        notice.setAttribute('data-br-upload-error', reason);
        var dropzone = form.querySelector('.file-dropzone');
        if (dropzone) { dropzone.classList.add('is-invalid'); }
        var input = form.querySelector('#basrelief_image_input');
        if (input) { input.setAttribute('aria-invalid', 'true'); }
        if (focus) {
            var target = input && input.files.length ? form.querySelector('[data-br-replace-file]') : dropzone;
            if (target) { target.focus(); }
        }
    }
    function showTooSmall(focus) {
        showUploadError("\u042d\u0442\u0430 \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0430 \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0430\u044f: \u043d\u0443\u0436\u043d\u043e \u043e\u0442 300 px \u043f\u043e \u0431\u043e\u043b\u044c\u0448\u0435\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u0435. \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0444\u0430\u0439\u043b \u043f\u043e\u0431\u043e\u043b\u044c\u0448\u0435.", 'image_too_small', focus);
    }
    function clearUploadError() {
