          text: "\u0412\u0435\u0440\u0441\u0438\u044f 2026 \u0433\u043e\u0434\u0430 \u0438 \u043d\u043e\u0432\u044b\u0439 \u0443\u0440\u043e\u043a \u043f\u043e Riggable. \u041f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u043c \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f\u043c \u2014 \u0441\u043a\u0438\u0434\u043a\u0430 15% \u043f\u043e \u043f\u0440\u043e\u043c\u043e\u043a\u043e\u0434\u0443 aiprintgen.",
          cta: "\u0421\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443",
          href: 'https://edu.aiprintgen.ru/?utm_source=main_website&utm_medium=gen_waiting_slider&utm_campaign=course2026_inapp&utm_content=gen_slider_course', target: '_blank' },
        { key: 'webinar', img: "/static/images/webinar.webp",
          badge: "\u041f\u043e\u043b\u0435\u0437\u043d\u044b\u0439 \u0441\u043e\u0432\u0435\u0442",
          title: "\u0425\u043e\u0442\u0438\u0442\u0435 \u043b\u0443\u0447\u0448\u0435 \u0440\u0430\u0437\u043e\u0431\u0440\u0430\u0442\u044c\u0441\u044f \u0432\u043e \u0432\u0441\u0435\u0445 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044f\u0445 \u0441\u0435\u0440\u0432\u0438\u0441\u0430?",
          text: "\u041f\u043e\u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u044b\u0439 \u0432\u0438\u0434\u0435\u043e-\u043c\u0430\u0441\u0442\u0435\u0440-\u043a\u043b\u0430\u0441\u0441 \u0438 \u0443\u0437\u043d\u0430\u0439\u0442\u0435, \u043a\u0430\u043a \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c \u0431\u043e\u043b\u0435\u0435 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u0432 AIPRINTGEN.",
          cta: "\u0421\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u043c\u0430\u0441\u0442\u0435\u0440-\u043a\u043b\u0430\u0441\u0441",
          href: 'https://academy.aiprintgen.ru/class?utm_source=main_website&utm_medium=gen_waiting_slider&utm_campaign=academy_masterclass&utm_content=gen_slider_free_masterclass&utm_term=ai_miniatures', target: '_blank' },
        
        { key: 'catalog', img: "/static/images/3d_catalog.webp",
          badge: "\u0418\u0434\u0435\u044f \u0434\u043b\u044f \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0439 \u043c\u043e\u0434\u0435\u043b\u0438",
          title: "\u0418\u0449\u0435\u0442\u0435 \u0438\u0434\u0435\u044e \u0434\u043b\u044f \u043d\u043e\u0432\u043e\u0439 \u043c\u043e\u0434\u0435\u043b\u0438?",
          text: "\u0417\u0430\u0433\u043b\u044f\u043d\u0438\u0442\u0435 \u0432 \u043a\u0430\u0442\u0430\u043b\u043e\u0433 \u0438 \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435, \u043a\u0430\u043a\u0438\u0435 3D-\u043c\u043e\u0434\u0435\u043b\u0438 \u0443\u0436\u0435 \u0441\u043e\u0437\u0434\u0430\u044e\u0442 \u0434\u0440\u0443\u0433\u0438\u0435 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438.",
          cta: "\u041e\u0442\u043a\u0440\u044b\u0442\u044c \u043a\u0430\u0442\u0430\u043b\u043e\u0433",
          href: "/3d-models/" + '?from=gen_slider_catalog', target: '_blank' }
    ];

    var MAX_SESSION_CARDS = 4;
    var ORDERED = [];
    var dots = [];
    var sessionActive = false;
    window.aiprintgenGenTipsPreviewCardCount = previewAllCards ? GEN_TIPS.length : 0;

    // Each wait session receives a fresh random subset without repeats.
    // The selected four then stay stable until that overlay closes.
    function selectSessionTips() {
        if (previewAllCards) {
            return GEN_TIPS.slice();
        }
        var shuffled = GEN_TIPS.slice();
        for (var i = shuffled.length - 1; i > 0; i--) {
            var j = Math.floor(Math.random() * (i + 1));
            var tmp = shuffled[i]; shuffled[i] = shuffled[j]; shuffled[j] = tmp;
        }
        return shuffled.slice(0, Math.min(MAX_SESSION_CARDS, shuffled.length));
    }

    // Badge icon per card type (falls back to a lightbulb).
    var BADGE_ICON = {
        image_world: 'fa-globe',
        lithophane: 'fa-image',
        riggable: 'fa-wand-magic-sparkles',
        parallel: 'fa-wand-magic-sparkles',
        basrelief: 'fa-wand-magic-sparkles',
        ultragen_four_views: 'fa-wand-magic-sparkles',
        split_joints: 'fa-puzzle-piece',
        multicolor: 'fa-palette',
        unfiltered: 'fa-shield-halved',
        lozhement: 'fa-toolbox',
        browser_tools: 'fa-screwdriver-wrench',
        miniature_bases: 'fa-chess-rook',
        cad: 'fa-drafting-compass',
        tools_catalog: 'fa-screwdriver-wrench',
        cut_model: 'fa-scissors',
        hollow_model: 'fa-ring',
        repair_model: 'fa-screwdriver-wrench',
        articulated_figure: 'fa-link',
        bust: 'fa-chess-rook',
        model_decoration: 'fa-paint-brush',
        molds: 'fa-cubes',
        flexi_toy: 'fa-link',
        retopology: 'fa-border-all',
        model_cleanup: 'fa-eraser',
        mesh_optimizer: 'fa-compress',
        relief_from_model: 'fa-mountain',
        relief_editor: 'fa-mountain',
        silicone_mold_box: 'fa-box-open',
        keychain: 'fa-key',
        cookie_cutter: 'fa-cookie-bite',
        vase: 'fa-wine-bottle',
        enclosure: 'fa-box',
        clicker: 'fa-keyboard',
        puzzle_maker: 'fa-puzzle-piece',
        solid_puzzle: 'fa-puzzle-piece',
        terrain_puzzle: 'fa-mountain',
        stained_glass: 'fa-palette',
        kumiko: 'fa-shapes',
        color_image_3d: 'fa-palette',
        catalog: 'fa-lightbulb'
    };

    function cardEl(t) {
        var clickable = !!t.href;
        var el = document.createElement(clickable ? 'a' : 'div');
        el.className = 'gen-tips__card' + (clickable ? ' gen-tips__card--link' : '') + (t.key === 'image_world' ? ' gen-tips__card--image-world' : '');
        if (clickable) {
            el.href = t.href;
            if (t.target) { el.target = t.target; }
            if (t.target === '_blank') { el.rel = 'noopener'; }
            el.addEventListener('click', function () {
                if (window.AiprintgenAnalytics) {
                    window.AiprintgenAnalytics.mirror('gen_slider_click', { card: t.key || '' });
                    var selectedTool = window.AiprintgenAnalytics.tool(t.key);
                    if (selectedTool !== 'unknown') window.AiprintgenAnalytics.track('tool_selected', {active_tool: selectedTool, interaction_source: 'navigation'});
                }
            });
        }
        var media = t.img
            ? '<div class="gen-tips__media"><img src="' + t.img + '" alt="" draggable="false"></div>'
            : '<div class="gen-tips__media gen-tips__media--icon"><i class="fas ' + (t.icon || 'fa-lightbulb') + '"></i></div>';
        var cta = (clickable && t.cta) ? '<span class="gen-tips__cta"></span>' : '';
        el.dataset.genTipCard = t.key || '';
        var bicon = BADGE_ICON[t.key] || 'fa-lightbulb';
        el.innerHTML = media +
            '<div class="gen-tips__text">' +
                '<span class="gen-tips__badge"><i class="fas ' + bicon + '" aria-hidden="true"></i><span class="gen-tips__badge-text"></span></span>' +
                '<div class="gen-tips__card-title"></div>' +
                '<div class="gen-tips__card-desc"></div>' +
                cta +
            '</div>';
        // Assign text via textContent so user copy can't inject markup.
        el.querySelector('.gen-tips__badge-text').textContent = t.badge || '';
        el.querySelector('.gen-tips__card-title').textContent = t.title || '';
        el.querySelector('.gen-tips__card-desc').textContent = t.text || '';
        if (cta) { el.querySelector('.gen-tips__cta').textContent = t.cta; }
        return el;
    }

    var prev = root.querySelector('.gen-tips__nav--prev');
    var next = root.querySelector('.gen-tips__nav--next');

    function step() {
        var first = track.children[0];
        if (!first) { return track.clientWidth; }
        var cs = window.getComputedStyle(track);
        var gap = parseFloat(cs.columnGap || cs.gap || '0') || 0;
        return first.getBoundingClientRect().width + gap;
    }
    function currentIndex() {
        var w = step();
        return w ? Math.round(Math.abs(track.scrollLeft) / w) : 0;
    }
    function scrollToIndex(i, instant) {
        var n = track.children.length;
        if (!n) { return; }
        i = Math.max(0, Math.min(n - 1, i));
        var sign = window.getComputedStyle(track).direction === 'rtl' ? -1 : 1;
        track.scrollTo({ left: sign * i * step(), behavior: instant ? 'auto' : 'smooth' });
    }
    // Circular navigation: past the last card loops back to the first (and the
    // reverse). The wrap jump is instant so it reads as a loop, not a long
    // rewind across the whole track.
    function go(dir) {
        var n = track.children.length;
        if (!n) { return; }
        var i = currentIndex() + dir;
        if (i < 0) { scrollToIndex(n - 1, true); }
        else if (i > n - 1) { scrollToIndex(0, true); }
        else { scrollToIndex(i, false); }
    }
    function goAndRestart(dir) {
        go(dir);
        startAuto();
    }
    if (prev) { prev.addEventListener('click', function () { goAndRestart(-1); }); }
    if (next) { next.addEventListener('click', function () { goAndRestart(1); }); }

    function syncDots() {
        if (!dots.length) { return; }
        var i = currentIndex();
        dots.forEach(function (d, di) { d.classList.toggle('is-active', di === i); });
    }
    var raf = false;
    track.addEventListener('scroll', function () {
        if (raf) { return; }
        raf = true;
        window.requestAnimationFrame(function () { raf = false; syncDots(); });
    });

    // index.html renders the cards inside the submit handler of a native form
    // POST. Firefox cancels the page's in-flight requests as soon as that
    // navigation starts, so the card images end up complete with no pixels and
    // no error event, and the first card stays blank for the whole POST
    // (25.10.2026). The page keeps showing until the response arrives, so
    // request such images again once the navigation has started.
    // gen-tips-image-retry:start
    var IMAGE_RETRY_DELAYS_MS = [300, 1500];
    var imageRetryTimers = [];
    function retryAbortedTipImages() {
        Array.prototype.forEach.call(track.querySelectorAll('.gen-tips__media img'), function (img) {
            // Reassigning the same src starts a new request.
            if (img.complete && !img.naturalWidth) { img.src = img.getAttribute('src'); }
        });
    }
    function scheduleTipImageRetries() {
        cancelTipImageRetries();
        IMAGE_RETRY_DELAYS_MS.forEach(function (delay) {
            imageRetryTimers.push(window.setTimeout(retryAbortedTipImages, delay));
        });
    }
    function cancelTipImageRetries() {
        imageRetryTimers.forEach(function (id) { window.clearTimeout(id); });
        imageRetryTimers = [];
    }
    // gen-tips-image-retry:end

    function renderSessionTips() {
        stopAuto();
        sessionActive = true;
        ORDERED = selectSessionTips();
        track.textContent = '';
        if (dotsWrap) { dotsWrap.textContent = ''; }
        dots = [];

        ORDERED.forEach(function (tip) {
            track.appendChild(cardEl(tip));
        });
        if (dotsWrap) {
            ORDERED.forEach(function (_, index) {
                var dot = document.createElement('button');
                dot.type = 'button';
                dot.className = 'gen-tips__dot';
                dot.tabIndex = -1;
                dot.setAttribute('aria-label', String(index + 1));
                dot.addEventListener('click', function () {
                    scrollToIndex(index);
                    startAuto();
                });
                dotsWrap.appendChild(dot);
                dots.push(dot);
            });
        }
        root.dataset.cardKeys = ORDERED.map(function (tip) { return tip.key || ''; }).join(',');
        track.scrollLeft = 0;
        syncDots();
        startAuto();
        scheduleTipImageRetries();
    }

    function stopSessionTips() {
        sessionActive = false;
        stopAuto();
        cancelTipImageRetries();
    }

    // The shared generation-lock lifecycle calls these once when a new
    // blocking wait starts and once when it ends.
    window.aiprintgenStartGenTipsSession = renderSessionTips;
    window.aiprintgenStopGenTipsSession = stopSessionTips;

    // Mouse drag-to-scroll (touch scrolls natively). Suppress the click that
    // follows a real drag so a link card doesn't open after you swipe it.
    var down = false, moved = false, startX = 0, startScroll = 0;
    track.addEventListener('mousedown', function (e) {
        stopAuto();
        down = true; moved = false; startX = e.pageX; startScroll = track.scrollLeft;
        track.classList.add('is-grabbing');
    });
    window.addEventListener('mousemove', function (e) {
        if (!down) { return; }
        var dx = e.pageX - startX;
        if (Math.abs(dx) > 4) { moved = true; }
        track.scrollLeft = startScroll - dx;
    });
    window.addEventListener('mouseup', function () {
        if (!down) { return; }
        down = false;
        track.classList.remove('is-grabbing');
        if (moved) { scrollToIndex(currentIndex()); }
        startAuto();
    });
    track.addEventListener('click', function (e) {
        if (moved) { e.preventDefault(); e.stopPropagation(); }
    }, true);

    // Auto-advance every 5s. A resting pointer must not pause it: the
    // overlay can appear directly under the cursor and would otherwise
    // stop before its first tick. Pause only during an active drag/touch
    // and while the tab is hidden; every resume starts a fresh countdown.
    // gen-tips-autoplay:start
    var AUTO_MS = 5000;
    var autoTimer = null;
    function startAuto() {
        stopAuto();
        if (document.hidden) { return; }
        if (sessionActive && ORDERED.length > 1) {
            autoTimer = window.setInterval(function () { go(1); }, AUTO_MS);
        }
    }
    function stopAuto() {
        if (autoTimer) { window.clearInterval(autoTimer); autoTimer = null; }
    }
    track.addEventListener('touchstart', stopAuto, { passive: true });
    track.addEventListener('touchend', startAuto, { passive: true });
    track.addEventListener('touchcancel', startAuto, { passive: true });
    document.addEventListener('visibilitychange', function () {
        if (document.hidden) { stopAuto(); } else { startAuto(); }
    });
    // gen-tips-autoplay:end

    // Tool pages, the catalog hand-off and the base builder run their own lock
    // object and never call the hooks above. Every one of them toggles the
    // shared body class, so a session follows it: same pool, fresh sample per
    // wait. index.html starts its session explicitly before adding the class,
    // which makes the observer a no-op there.
    function syncWithLockClass() {
        var locked = document.body.classList.contains('generation-lock-active');
        if (locked && !sessionActive) { renderSessionTips(); }
        else if (!locked && sessionActive) { stopSessionTips(); }
    }
    if (window.MutationObserver) {
        new MutationObserver(syncWithLockClass).observe(document.body, { attributes: true, attributeFilter: ['class'] });
    }
    syncWithLockClass();
})();
</script>
            </div>
        </div>
        <script>
        (function () {
            var promptEl = document.getElementById('gen-notify-prompt');
            var btn = document.getElementById('gen-notify-btn');
            var doneEl = document.getElementById('gen-notify-done');
            var blockedEl = document.getElementById('gen-notify-blocked');
            if (!promptEl || !btn) { return; }
            var P = window.AiprintgenPush;
            var boxes = [promptEl, doneEl, blockedEl];
            function only(el) {
                boxes.forEach(function (b) { if (b) { b.classList.add('d-none'); } });
                if (el) { el.classList.remove('d-none'); }
            }
            if (!P || !P.supported || !P.supported() || !('Notification' in window)) { only(null); return; }

            // Single source of truth — recomputes which of button / done / blocked to
            // show from the LIVE state, so it never ends up blank. Exposed so the
            // overlay-show hook (and a sidebar toggle) can re-sync without a reload.
            function sync() {
                if (Notification.permission === 'denied') { only(blockedEl); return; }
                Promise.resolve(P.isSubscribed ? P.isSubscribed() : false).then(function (subbed) {
                    if (subbed) { only(doneEl); } else { btn.disabled = false; only(promptEl); }
                }, function () { btn.disabled = false; only(promptEl); });
            }
            window.syncGenNotifyOptIn = sync;

            btn.addEventListener('click', function () {
                btn.disabled = true;
                // Re-sync after enabling so the RESULT is reflected: subscribed -> done;
                // denied -> blocked hint; dismissed -> button again. Never a blank.
                // Also nudge the sidebar bell so both stay consistent.
                function done() { sync(); if (window.syncSidebarNotifyBtn) { window.syncSidebarNotifyBtn(); } }
                Promise.resolve(P.enable()).then(done, done);
            });
            sync();
        })();
        </script>

        <div id="output-section" class="mt-4">
            
            <div class="alert alert-warning">
                Войдите в систему, чтобы использовать форму генерации 3D моделей.
            </div>
            
            

            
        </div>
        
    </div>
</div>




<section class="ag-section ag-cases" id="cases">
    <h2 class="ag-kicker">Кейсы</h2>
    <div class="ag-cases__list">
        <article class="ag-case ag-card">
            <div class="ag-case__strip ag-case__strip--4">
                <div class="ag-case__img">
                    <img src="/static/images/redesign/gnome-prompt.webp" alt="Промпт" loading="lazy">
                    <span class="ag-imgpill">Промпт</span>
                </div>
                <div class="ag-case__img">
                    <img src="/static/images/redesign/gnome-ref.webp" alt="2D-референс" loading="lazy">
                    <span class="ag-imgpill">2D-референс</span>
                </div>
                <div class="ag-case__img">
                    <img src="/static/images/redesign/gnome-print.webp" alt="3D-модель" loading="lazy">
                    <span class="ag-imgpill">3D-модель</span>
                </div>
                <div class="ag-case__img">
                    <img src="/static/images/redesign/gnome-painted.webp" alt="Покрас" loading="lazy">
                    <span class="ag-imgpill">Покрас</span>
                </div>
            </div>
            <div class="ag-case__body">
                <div class="ag-case__head"><span class="ag-case__num">01</span><h3 class="ag-heading ag-heading--sm">Кейс — Гном</h3></div>
                <p class="font-serif-display ag-case__flow">Картинка для 3D → 2D-референс → 3D-модель → Покрас</p>
                <p class="ag-case__desc">Из текстового описания получаем 2D-референс, а по нему — 3D-модель. После проверки сетки и подготовки к печати в этом кейсе получилась миниатюра с ручным покрасом.</p>
            </div>
        </article>
        <article class="ag-case ag-card">
            <div class="ag-case__strip ag-case__strip--5">
                <div class="ag-case__img">
                    <img src="/static/images/redesign/teacher-new-ref.webp" alt="2D-референс" loading="lazy">
                    <span class="ag-imgpill">2D-референс</span>
                </div>
                <div class="ag-case__img">
                    <img src="/static/images/redesign/teacher-prompt.webp" alt="Промпт" loading="lazy">
                    <span class="ag-imgpill">Промпт</span>
                </div>
                <div class="ag-case__img">
                    <img src="/static/images/redesign/teacher-print.webp" alt="3D-модель" loading="lazy">
                    <span class="ag-imgpill">3D-модель</span>
                </div>
                <div class="ag-case__img ag-case__img--wide">
                    <img src="/static/images/redesign/teacher-painted.webp" alt="Покрас" loading="lazy">
                    <span class="ag-imgpill">Покрас</span>
                </div>
            </div>
            <div class="ag-case__body">
                <div class="ag-case__head"><span class="ag-case__num">02</span><h3 class="ag-heading ag-heading--sm">Кейс — Учительница</h3></div>
                <p class="font-serif-display ag-case__flow">2D-референс + Промпт → 3D-модель → Покрас</p>
                <p class="ag-case__desc">Персональный сувенир: фото-референс и текстовый промпт превращаются в стилизованную Bobblehead-фигурку, печать и ручной покрас с надписью на подставке.</p>
            </div>
        </article>
        <article class="ag-case ag-card">
            <div class="ag-case__strip ag-case__strip--3">
                <div class="ag-case__img">
                    <img src="/static/images/redesign/karate-ref.webp" alt="2D-референс" loading="lazy">
                    <span class="ag-imgpill">2D-референс</span>
                </div>
                <div class="ag-case__img">
                    <img src="/static/images/redesign/karate-print.webp" alt="3D-модель" loading="lazy">
                    <span class="ag-imgpill">3D-модель</span>
                </div>
                <div class="ag-case__img">
                    <img src="/static/images/redesign/karate-painted.webp" alt="Покрас" loading="lazy">
                    <span class="ag-imgpill">Покрас</span>
                </div>
            </div>
            <div class="ag-case__body">
