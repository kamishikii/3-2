        }).catch(function () {
            basreliefRequestInFlight = false;
            leaveSubmittingState();
            // На вкладке data-br-network-error нет (он из копирайта лендинга),
            // и обрыв связи раньше читался общим «Что-то пошло не так».
            showSubmissionFailure(form.getAttribute('data-br-network-error') ||
                "\u0421\u0432\u044f\u0437\u044c \u043e\u0431\u043e\u0440\u0432\u0430\u043b\u0430\u0441\u044c, \u043f\u043e\u043a\u0430 \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u043b\u043e\u0441\u044c \u0444\u043e\u0442\u043e. \u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442 \u0438 \u043d\u0430\u0436\u043c\u0438\u0442\u0435 \u043a\u043d\u043e\u043f\u043a\u0443 \u0435\u0449\u0451 \u0440\u0430\u0437: \u043f\u043e\u0432\u0442\u043e\u0440 \u0441 \u0442\u0435\u043c \u0436\u0435 \u0444\u0430\u0439\u043b\u043e\u043c \u043d\u0435 \u0441\u043f\u0438\u0448\u0435\u0442 \u043a\u0440\u0435\u0434\u0438\u0442 \u0434\u0432\u0430\u0436\u0434\u044b.");
        });
    }
    var sizeInput = form.querySelector('#basrelief_image_input');
    if (sizeInput) {
        sizeInput.addEventListener('change', function () {
            var file = sizeInput.files && sizeInput.files[0];
            var currentScope = ensureBasreliefSubmitScope();
            // A file selected after a real POST is a new paid intent.  A
            // fetch retry without a file change deliberately keeps the old
            // scope, so the backend reconnects to the same reservation.
            if (file && readBasreliefSubmitPending(currentScope)) {
                rotateBasreliefSubmitScope();
            }
            sizeVerdict = null;
            clearUploadError();
            if (!file) { return; }
            validateImage(file).then(function (result) {
                if (!sizeInput.files || sizeInput.files[0] !== file) { return; }
                sizeVerdict = { file: file, result: result };
                if (!result.ok) {
                    showValidationFailure(result);
                    return;
                }
                announceValidatedUpload(file);
            });
        });
    }
    var removeFileButton = form.querySelector('[data-br-remove-file]');
    if (removeFileButton && sizeInput) {
        removeFileButton.addEventListener('click', function () {
            sizeVerdict = null;
            announcedValidatedFile = null;
            sizeInput.value = '';
            var previewContainer = form.querySelector('[data-upload-preview-container]');
            var previewImage = previewContainer && previewContainer.querySelector('[data-upload-preview-image]');
            if (previewImage) { previewImage.removeAttribute('src'); }
            if (previewContainer) {
                rememberClearedServerPreview(previewContainer);
                previewContainer.style.display = 'none';
                previewContainer.removeAttribute('data-server-preview-url');
                previewContainer.removeAttribute('data-server-preview-name');
            }
            var nameNode = form.querySelector('[data-dropzone-filename]');
            if (nameNode) { nameNode.textContent = nameNode.getAttribute('data-empty-text') || ''; }
            var fileName = form.querySelector('[data-br-file-name]');
            if (fileName) { fileName.textContent = ''; }
            var dropzone = form.querySelector('.file-dropzone');
            if (dropzone) { dropzone.classList.remove('has-file'); }
            clearUploadError();
            var settings = form.querySelector('[data-br-settings]');
            if (settings) { settings.hidden = true; }
            var status = form.querySelector('[data-br-form-status]');
            if (status) { status.textContent = form.getAttribute('data-br-removed-notice') || ''; }
            sizeInput.dispatchEvent(new Event('change', {bubbles: true}));
            if (dropzone) { dropzone.focus(); }
            if (window.AiprintgenDraft && typeof window.AiprintgenDraft.save === 'function') {
                window.AiprintgenDraft.save();
            }
        });
    }
    form.addEventListener('submit', function (event) {
        event.preventDefault();
        var input = form.querySelector('#basrelief_image_input');
        var serverPreview = form.querySelector('[data-upload-preview-container]');
        var hasServerPreview = serverPreview && serverPreview.getAttribute('data-server-preview-url');
        // Ask for the image before any access wall: a visitor who has not
        // chosen a file yet should be told that, not sent to sign in.
        if (input && input.files.length === 0 && !hasServerPreview) {
            showUploadError("\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0444\u0430\u0439\u043b", 'image_missing', true);
            return;
        }
        var file = input && input.files && input.files[0];
        if (file) {
            if (sizeVerdict && sizeVerdict.file === file) {
                if (!sizeVerdict.result.ok) {
                    event.preventDefault();
                    showValidationFailure(sizeVerdict.result, true);
                    return;
                }
            } else {
                // Файл пришёл мимо change (drag&drop через общую дропзону) —
                // измеряем сейчас и досылаем форму сами.
                validateImage(file).then(function (result) {
                    if (!input.files || input.files[0] !== file) { return; }
                    sizeVerdict = { file: file, result: result };
                    if (!result.ok) { showValidationFailure(result, true); return; }
                    announceValidatedUpload(file);
                    if (toolActionDenied()) { return; }
                    submitBasrelief();
                });
                return;
            }
        }
        if (toolActionDenied()) { return; }
        submitBasrelief();
    });
})();
</script>
            </div>

