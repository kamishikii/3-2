44\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438&#34;, &#34;lozjs_error_no_objects&#34;: &#34;\u041d\u0430 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438 \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u043e \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u043e\u0432&#34;, &#34;lozjs_error_no_pockets&#34;: &#34;\u041d\u0435 \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c \u043a\u0430\u0440\u043c\u0430\u043d\u043e\u0432 \u0434\u043b\u044f \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f&#34;, &#34;lozjs_error_notch_clearance&#34;: &#34;\u0421\u044e\u0434\u0430 \u0432\u044b\u0435\u043c\u043a\u0443 \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u043d\u0435\u043b\u044c\u0437\u044f: \u043d\u0435 \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u0437\u0430\u0437\u043e\u0440\u0430 \u0434\u043e \u043a\u0440\u0430\u044f \u043f\u043b\u0438\u0442\u044b, &#34;, &#34;lozjs_error_notch_clearance_tail&#34;: &#34;\u0441\u043e\u0441\u0435\u0434\u043d\u0435\u0433\u043e \u043a\u0430\u0440\u043c\u0430\u043d\u0430 \u0438\u043b\u0438 \u0432\u0442\u043e\u0440\u043e\u0439 \u0432\u044b\u0435\u043c\u043a\u0438. \u0421\u0434\u0432\u0438\u043d\u044c\u0442\u0435 \u0435\u0451 \u0432\u0434\u043e\u043b\u044c \u043a\u043e\u043d\u0442\u0443\u0440\u0430&#34;, &#34;lozjs_error_notch_half&#34;: &#34;\u0421\u044e\u0434\u0430 \u0432\u044b\u0435\u043c\u043a\u0443 \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u043d\u0435\u043b\u044c\u0437\u044f: \u043e\u043d\u0430 \u0441\u044a\u0435\u0441\u0442 \u0431\u043e\u043b\u044c\u0448\u0435 \u043f\u043e\u043b\u043e\u0432\u0438\u043d\u044b \u043a\u0430\u0440\u043c\u0430\u043d\u0430. &#34;, &#34;lozjs_error_notch_half_tail&#34;: &#34;\u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u043c\u0435\u0441\u0442\u043e \u0431\u043b\u0438\u0436\u0435 \u043a \u043a\u0440\u0430\u044e \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430&#34;, &#34;lozjs_error_notch_pair&#34;: &#34;\u0412\u044b\u0435\u043c\u043a\u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u043f\u0430\u0440\u043e\u0439 \u0441 \u043f\u0440\u043e\u0442\u0438\u0432\u043e\u043f\u043e\u043b\u043e\u0436\u043d\u044b\u0445 \u0441\u0442\u043e\u0440\u043e\u043d \u2014 \u0432\u0442\u043e\u0440\u0443\u044e \u043d\u0435\u043b\u044c\u0437\u044f &#34;, &#34;lozjs_error_notch_pair_tail&#34;: &#34;\u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u0442\u044c \u043d\u0430 \u0442\u0443 \u0436\u0435 \u0441\u0442\u043e\u0440\u043e\u043d\u0443&#34;, &#34;lozjs_error_numbers&#34;: &#34;\u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0447\u0438\u0441\u043b\u043e\u0432\u044b\u0435 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b&#34;, &#34;lozjs_error_offline&#34;: &#34;\u041b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u0441\u0435\u0440\u0432\u0438\u0441 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d&#34;, &#34;lozjs_error_points_close&#34;: &#34;\u0422\u043e\u0447\u043a\u0438 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0430 \u0441\u0442\u043e\u044f\u0442 \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0431\u043b\u0438\u0437\u043a\u043e \u0434\u0440\u0443\u0433 \u043a \u0434\u0440\u0443\u0433\u0443&#34;, &#34;lozjs_error_points_outside&#34;: &#34;\u0422\u043e\u0447\u043a\u0438 \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0430 \u0434\u043e\u043b\u0436\u043d\u044b \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u0432\u043d\u0443\u0442\u0440\u0438 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u0438&#34;, &#34;lozjs_error_request&#34;: &#34;\u041e\u0448\u0438\u0431\u043a\u0430 \u0437\u0430\u043f\u0440\u043e\u0441\u0430&#34;, &#34;lozjs_error_save&#34;: &#34;\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u043f\u0440\u0430\u0432\u043a\u0443: &#34;, &#34;lozjs_error_scale&#34;: &#34;\u041f\u043e\u043b\u0443\u0447\u0438\u043b\u0441\u044f \u043d\u0435\u043f\u0440\u0430\u0432\u0434\u043e\u043f\u043e\u0434\u043e\u0431\u043d\u044b\u0439 \u043c\u0430\u0441\u0448\u0442\u0430\u0431 \u2014 \u043f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u0435&#34;, &#34;lozjs_error_too_large&#34;: &#34;\u0424\u0430\u0439\u043b \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0431\u043e\u043b\u044c\u0448\u043e\u0439&#34;, &#34;lozjs_error_unknown&#34;: &#34;\u041d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0430\u044f \u043e\u0448\u0438\u0431\u043a\u0430&#34;, &#34;lozjs_error_unreadable&#34;: &#34;\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u044c \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435&#34;, &#34;lozjs_find_objects&#34;: &#34;\u041d\u0430\u0439\u0442\u0438 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b \u003cspan\u003e\u2192\u003c/span\u003e&#34;, &#34;lozjs_format_unavailable&#34;: &#34;\u0424\u043e\u0440\u043c\u0430\u0442 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d&#34;, &#34;lozjs_format_unavailable_hint&#34;: &#34;\u042d\u0442\u043e\u0442 \u0444\u043e\u0440\u043c\u0430\u0442 \u043f\u043e\u043a\u0430 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d&#34;, &#34;lozjs_fullscreen&#34;: &#34;\u26f6 \u041d\u0430 \u0432\u0435\u0441\u044c \u044d\u043a\u0440\u0430\u043d&#34;, &#34;lozjs_fullscreen_exit&#34;: &#34;\u2199 \u0421\u0432\u0435\u0440\u043d\u0443\u0442\u044c&#34;, &#34;lozjs_gridfinity_checking&#34;: &#34;\u041f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u043c \u0441\u0435\u0442\u043a\u0443 Gridfinity \u0438 \u0437\u0430\u0437\u043e\u0440\u044b \u043a\u0430\u0440\u043c\u0430\u043d\u043e\u0432\u2026&#34;, &#34;lozjs_gridfinity_layout_text&#34;: &#34;\u0414\u0432\u0438\u0433\u0430\u0439\u0442\u0435 \u0438 \u043c\u0435\u043d\u044f\u0439\u0442\u0435 \u0440\u0430\u0437\u043c\u0435\u0440 \u043a\u0430\u0440\u043c\u0430\u043d\u043e\u0432. \u041e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d\u043e \u043a \u0446\u0435\u043b\u044b\u043c \u044f\u0447\u0435\u0439\u043a\u0430\u043c Gridfinity 42 \u043c\u043c; \u043a\u0430\u0436\u0434\u0443\u044e \u043a\u0440\u0443\u0433\u043b\u0443\u044e \u0432\u044b\u0435\u043c\u043a\u0443 \u043c\u043e\u0436\u043d\u043e \u0434\u0432\u0438\u0433\u0430\u0442\u044c \u043f\u043e \u043a\u043e\u043d\u0442\u0443\u0440\u0443.&#34;, &#34;lozjs_gridfinity_safe&#34;: &#34;\u041a\u0430\u0440\u043c\u0430\u043d\u044b \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e \u043f\u043e\u043c\u0435\u0449\u0430\u044e\u0442\u0441\u044f \u0432 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 Gridfinity.&#34;, &#34;lozjs_gridfinity_unit&#34;: &#34;\u044f\u0447.&#34;, &#34;lozjs_layout_check&#34;: &#34;\u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u043c\u0430\u043a\u0435\u0442: &#34;, &#34;lozjs_layout_checking&#34;: &#34;\u041f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u043c \u0432\u044b\u0435\u043c\u043a\u0438 \u0438 \u043f\u0435\u0440\u0435\u043c\u044b\u0447\u043a\u0438\u2026&#34;, &#34;lozjs_layout_release_notch&#34;: &#34;\u041e\u0442\u043f\u0443\u0441\u0442\u0438\u0442\u0435 \u043a\u0440\u0443\u0433 \u2014 \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u043c \u043d\u043e\u0432\u043e\u0435 \u043c\u0435\u0441\u0442\u043e \u044d\u0442\u043e\u0439 \u0432\u044b\u0435\u043c\u043a\u0438.&#34;, &#34;lozjs_layout_release_object&#34;: &#34;\u041e\u0442\u043f\u0443\u0441\u0442\u0438\u0442\u0435 \u043f\u0440\u0435\u0434\u043c\u0435\u0442 \u2014 \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u043c \u0437\u0430\u0437\u043e\u0440\u044b \u0437\u0430\u043d\u043e\u0432\u043e.&#34;, &#34;lozjs_layout_release_plate&#34;: &#34;\u041e\u0442\u043f\u0443\u0441\u0442\u0438\u0442\u0435 \u0443\u0433\u043e\u043b \u043f\u043b\u0438\u0442\u044b \u2014 \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u043c \u043a\u0440\u0430\u044f \u0438 \u043f\u0435\u0440\u0435\u043c\u044b\u0447\u043a\u0438.&#34;, &#34;lozjs_layout_unsafe&#34;: &#34;\u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u0438\u0441\u043f\u0440\u0430\u0432\u044c\u0442\u0435 \u043c\u0430\u043a\u0435\u0442 \u2014 \u043f\u043b\u0438\u0442\u0430 \u0438\u043b\u0438 \u043f\u0435\u0440\u0435\u043c\u044b\u0447\u043a\u0438 \u043d\u0435\u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u044b&#34;, &#34;lozjs_move_notch&#34;: &#34;\u041f\u0435\u0440\u0435\u043c\u0435\u0441\u0442\u0438\u0442\u044c \u0432\u044b\u0435\u043c\u043a\u0443 \u043f\u043e \u043a\u043e\u043d\u0442\u0443\u0440\u0443&#34;, &#34;lozjs_need_object&#34;: &#34;\u0414\u043e\u0431\u0430\u0432\u044c\u0442\u0435 \u0445\u043e\u0442\u044f \u0431\u044b \u043e\u0434\u0438\u043d \u043f\u0440\u0435\u0434\u043c\u0435\u0442&#34;, &#34;lozjs_need_pocket&#34;: &#34;\u0414\u043e\u0431\u0430\u0432\u044c\u0442\u0435 \u0445\u043e\u0442\u044f \u0431\u044b \u043e\u0434\u0438\u043d \u043a\u0430\u0440\u043c\u0430\u043d&#34;, &#34;lozjs_not_selected&#34;: &#34;\u043d\u0435 \u0432\u044b\u0431\u0440\u0430\u043d&#34;, &#34;lozjs_notch_drag_hint&#34;: &#34;\u041a\u0430\u0436\u0434\u044b\u0439 \u043a\u0440\u0443\u0433 \u043c\u043e\u0436\u043d\u043e \u0434\u0432\u0438\u0433\u0430\u0442\u044c \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e \u2014 \u043e\u043d \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f &#34;, &#34;lozjs_notch_drag_hint_tail&#34;: &#34;\u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u043c \u043a \u043a\u043e\u043d\u0442\u0443\u0440\u0443 \u043a\u0430\u0440\u043c\u0430\u043d\u0430.&#34;, &#34;lozjs_notches_narrow&#34;: &#34;\u0412\u044b\u0435\u043c\u043a\u0438 \u043d\u0435 \u0441\u0442\u0430\u0432\u044f\u0442\u0441\u044f: \u0441\u0430\u043c\u044b\u0439 \u0443\u0437\u043a\u0438\u0439 \u043f\u0440\u0435\u0434\u043c\u0435\u0442 &#34;, &#34;lozjs_notches_narrow_tail&#34;: &#34; \u043c\u043c, \u043f\u0430\u0440\u0430 \u0432\u044b\u0435\u043c\u043e\u043a \u043d\u0435 \u043e\u0441\u0442\u0430\u0432\u0438\u0442 \u043f\u0435\u0440\u0435\u043c\u044b\u0447\u043a\u0438.&#34;, &#34;lozjs_notches_none&#34;: &#34;\u0412\u044b\u0435\u043c\u043a\u0438 \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u044b \u0438\u043b\u0438 \u0434\u043b\u044f \u043d\u0438\u0445 \u043d\u0435\u0442 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0433\u043e \u043c\u0435\u0441\u0442\u0430.&#34;, &#34;lozjs_notches_safe&#34;: &#34;\u0412\u044b\u0435\u043c\u043a\u0438 \u0440\u0430\u0441\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u044b \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e. \u0417\u0430\u0437\u043e\u0440\u044b \u0434\u043e \u043a\u0440\u0430\u044f, &#34;, &#34;lozjs_notches_safe_tail&#34;: &#34;\u043a\u0430\u0440\u043c\u0430\u043d\u043e\u0432 \u0438 \u0441\u043e\u0441\u0435\u0434\u043d\u0438\u0445 \u0432\u044b\u0435\u043c\u043e\u043a \u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u044b. &#34;, &#34;lozjs_notches_shallow&#34;: &#34;\u0412\u044b\u0435\u043c\u043a\u0438 \u043d\u0435 \u0441\u0442\u0430\u0432\u044f\u0442\u0441\u044f: \u043a\u0430\u0440\u043c\u0430\u043d \u043c\u0435\u043b\u044c\u0447\u0435 &#34;, &#34;lozjs_notches_shallow_tail&#34;: &#34; \u043c\u043c \u2014 \u043f\u0440\u0435\u0434\u043c\u0435\u0442 \u0434\u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437 \u043a\u0440\u0430\u0439.&#34;, &#34;lozjs_object_prefix&#34;: &#34;\u041f\u0440\u0435\u0434\u043c\u0435\u0442 &#34;, &#34;lozjs_of&#34;: &#34; \u0438\u0437 &#34;, &#34;lozjs_open_card&#34;: &#34;\u041e\u0442\u043a\u0440\u044b\u0442\u044c \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0443&#34;, &#34;lozjs_pick_photo&#34;: &#34;\u0412\u044b\u0431\u0440\u0430\u0442\u044c \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u044e&#34;, &#34;lozjs_pick_photo_error&#34;: &#34;\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u044e&#34;, &#34;lozjs_queue_many&#34;: &#34;\u0437\u0430\u0434\u0430\u043d\u0438\u0439&#34;, &#34;lozjs_queue_one&#34;: &#34;\u0437\u0430\u0434\u0430\u043d\u0438\u0435&#34;, &#34;lozjs_queue_prefix&#34;: &#34;\u041e\u0447\u0435\u0440\u0435\u0434\u044c: \u043f\u0435\u0440\u0435\u0434 \u0432\u0430\u043c\u0438 &#34;, &#34;lozjs_queue_running&#34;: &#34;\u041e\u0431\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0435\u043c \u043d\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0435\u2026&#34;, &#34;lozjs_queue_slow&#34;: &#34;\u041e\u043f\u0435\u0440\u0430\u0446\u0438\u044f \u0438\u0434\u0451\u0442 \u0434\u043e\u043b\u044c\u0448\u0435 \u043e\u0431\u044b\u0447\u043d\u043e\u0433\u043e. \u041e\u0431\u043d\u043e\u0432\u0438\u0442\u0435 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443 \u2014 &#34;, &#34;lozjs_queue_slow_tail&#34;: &#34;\u0437\u0430\u0434\u0430\u043d\u0438\u0435 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0442\u044c\u0441\u044f&#34;, &#34;lozjs_rebuilds_done&#34;: &#34;\u0411\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u044b\u0435 \u043f\u0435\u0440\u0435\u0441\u0431\u043e\u0440\u043a\u0438 \u044d\u0442\u043e\u0433\u043e \u0444\u043e\u0442\u043e \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u043b\u0438\u0441\u044c: \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0430\u044f \u0441\u0431\u043e\u0440\u043a\u0430 \u0441\u043d\u043e\u0432\u0430 \u0441\u043f\u0438\u0448\u0435\u0442 \u043a\u0440\u0435\u0434\u0438\u0442\u044b.&#34;, &#34;lozjs_rebuilds_left&#34;: &#34;\u0411\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u044b\u0445 \u043f\u0435\u0440\u0435\u0441\u0431\u043e\u0440\u043e\u043a \u044d\u0442\u043e\u0433\u043e \u0444\u043e\u0442\u043e \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c: &#34;, &#34;lozjs_rebuilds_left_tail&#34;: &#34;. \u041f\u0440\u0430\u0432\u044c\u0442\u0435 \u043a\u043e\u043d\u0442\u0443\u0440\u044b \u0438 \u043c\u0430\u043a\u0435\u0442 \u2014 \u043a\u0440\u0435\u0434\u0438\u0442\u044b \u043d\u0435 \u0441\u043f\u0438\u0448\u0443\u0442\u0441\u044f.&#34;, &#34;lozjs_resize_plate&#34;: &#34;\u0418\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0440\u0430\u0437\u043c\u0435\u0440 \u043f\u043b\u0438\u0442\u044b&#34;, &#34;lozjs_rings_none&#34;: &#34;\u0423 \u044d\u0442\u043e\u0433\u043e \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0430 \u0432\u044b\u0440\u0435\u0437\u043e\u0432 \u043d\u0435\u0442&#34;, &#34;lozjs_rings_pick&#34;: &#34;\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043f\u0440\u0435\u0434\u043c\u0435\u0442 \u0441 \u0432\u044b\u0440\u0435\u0437\u043e\u043c&#34;, &#34;lozjs_rings_remove&#34;: &#34;\u0423\u0431\u0440\u0430\u0442\u044c \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0435 \u0432\u044b\u0440\u0435\u0437\u044b&#34;, &#34;lozjs_rings_restore&#34;: &#34;\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0435 \u0432\u044b\u0440\u0435\u0437\u044b&#34;, &#34;lozjs_saved_to_library&#34;: &#34;\u041c\u043e\u0434\u0435\u043b\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0430 \u0432 \u00ab\u041c\u043e\u0438 \u043c\u043e\u0434\u0435\u043b\u0438\u00bb \u0441\u043e \u0432\u0441\u0435\u043c\u0438 \u0444\u043e\u0440\u043c\u0430\u0442\u0430\u043c\u0438. &#34;, &#34;lozjs_stage_build&#34;: &#34;\u0421\u0442\u0440\u043e\u0438\u043c 3D-\u043c\u043e\u0434\u0435\u043b\u044c&#34;, &#34;lozjs_stage_build_gridfinity&#34;: &#34;\u0421\u0442\u0440\u043e\u0438\u043c \u043b\u043e\u0436\u0435\u043c\u0435\u043d\u0442 Gridfinity\u2026&#34;, &#34;lozjs_stage_build_gridfinity_help&#34;: &#34;\u0421\u043e\u0437\u0434\u0430\u0451\u043c \u0441\u0442\u0443\u043f\u0435\u043d\u0447\u0430\u0442\u043e\u0435 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435, \u043a\u0430\u0440\u043c\u0430\u043d\u044b \u0438 \u0441\u0435\u0442\u043a\u0443 \u0434\u043b\u044f \u043f\u0435\u0447\u0430\u0442\u0438.&#34;, &#34;lozjs_stage_build_help&#34;: &#34;\u041f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u043c \u0440\u0430\u0441\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u0441\u0442\u0430\u0432\u0438\u043c \u0432\u044b\u0435\u043c\u043a\u0438 \u0438 \u0437\u0430\u043c\u044b\u043a\u0430\u0435\u043c \u0441\u0435\u0442\u043a\u0443.&#34;, &#34;lozjs_stage_manual_scale&#34;: &#34;\u0421\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u043c \u043c\u0430\u0441\u0448\u0442\u0430\u0431&#34;, &#34;lozjs_stage_manual_scale_help&#34;: &#34;\u041f\u0440\u0438\u0432\u044f\u0437\u044b\u0432\u0430\u0435\u043c \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u044b\u0439 \u043e\u0442\u0440\u0435\u0437\u043e\u043a \u043a \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u0440\u0430\u0437\u043c\u0435\u0440\u0443.&#34;, &#34;lozjs_stage_resume&#34;: &#34;\u0421\u0442\u0440\u043e\u0438\u043c 3D&#34;, &#34;lozjs_stage_resume_gridfinity&#34;: &#34;\u041b\u043e\u0436\u0435\u043c\u0435\u043d\u0442 Gridfinity \u0435\u0449\u0451 \u0441\u0442\u0440\u043e\u0438\u0442\u0441\u044f&#34;, &#34;lozjs_stage_resume_gridfinity_help&#34;: &#34;\u0417\u0430\u0434\u0430\u043d\u0438\u0435 \u0438\u0437 \u043e\u0447\u0435\u0440\u0435\u0434\u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442\u0441\u044f \u043d\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0435.&#34;, &#34;lozjs_stage_resume_help&#34;: &#34;\u0417\u0430\u0434\u0430\u043d\u0438\u0435 \u0443\u0436\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442\u0441\u044f \u2014 \u043c\u043e\u0436\u043d\u043e \u043d\u0435 \u0434\u0435\u0440\u0436\u0430\u0442\u044c \u0432\u043a\u043b\u0430\u0434\u043a\u0443 \u043e\u0442\u043a\u0440\u044b\u0442\u043e\u0439.&#34;, &#34;lozjs_stage_scale&#34;: &#34;\u0421\u0447\u0438\u0442\u0430\u0435\u043c \u043c\u0430\u0441\u0448\u0442\u0430\u0431&#34;, &#34;lozjs_stage_scale_help&#34;: &#34;\u0412\u044b\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u0435\u043c \u043b\u0438\u0441\u0442 A4 \u0438 \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0438\u043c \u043f\u0438\u043a\u0441\u0435\u043b\u0438 \u0432 \u043c\u0438\u043b\u043b\u0438\u043c\u0435\u0442\u0440\u044b.&#34;, &#34;lozjs_stage_trace&#34;: &#34;\u0418\u0449\u0435\u043c \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b&#34;, &#34;lozjs_stage_trace_help&#34;: &#34;\u041d\u0435\u0439\u0440\u043e\u0441\u0435\u0442\u044c \u0432\u044b\u0434\u0435\u043b\u044f\u0435\u0442 \u0441\u0438\u043b\u0443\u044d\u0442\u044b, \u0437\u0430\u0442\u0435\u043c \u0433\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u043b\u0438\u0448\u043d\u0438\u0435 \u0442\u043e\u0447\u043a\u0438.&#34;, &#34;lozjs_stage_upload&#34;: &#34;\u0417\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u043c \u0444\u043e\u0442\u043e\u0433\u0440\u0430\u0444\u0438\u044e&#34;, &#34;lozjs_stage_upload_help&#34;: &#34;\u041f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u043c \u0444\u0430\u0439\u043b \u0438 \u0438\u0449\u0435\u043c \u0433\u0440\u0430\u043d\u0438\u0446\u044b \u043b\u0438\u0441\u0442\u0430.&#34;, &#34;lozjs_stage_upload_help_manual&#34;: &#34;\u041f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u043c \u0444\u0430\u0439\u043b. \u041c\u0430\u0441\u0448\u0442\u0430\u0431 \u0437\u0430\u0434\u0430\u0434\u0438\u0442\u0435 \u0434\u0432\u0443\u043c\u044f \u0442\u043e\u0447\u043a\u0430\u043c\u0438.&#34;, &#34;lozjs_unit_mm&#34;: &#34; \u043c\u043c&#34;, &#34;lozjs_vertex_count&#34;: &#34;\u0442\u043e\u0447\u0435\u043a: &#34;, &#34;lozjs_viewer_failed&#34;: &#34;\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c 3D, STL \u0433\u043e\u0442\u043e\u0432 \u043a \u0441\u043a\u0430\u0447\u0438\u0432\u0430\u043d\u0438\u044e&#34;, &#34;lozjs_viewer_loading&#34;: &#34;\u0417\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u043c 3D\u2026&#34;, &#34;lozjs_viewer_ready&#34;: &#34;\u0422\u0430\u0449\u0438\u0442\u0435 \u043c\u044b\u0448\u044c\u044e \u00b7 \u043a\u043e\u043b\u0435\u0441\u043e \u2014 \u043c\u0430\u0441\u0448\u0442\u0430\u0431&#34;, &#34;lozjs_viewer_unavailable&#34;: &#34;3D-\u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d, STL \u043c\u043e\u0436\u043d\u043e \u0441\u043a\u0430\u0447\u0430\u0442\u044c&#34;}">
    <div class="shell">
        <header class="lozhement-head">
            <span class="microlabel">ЛОЖЕМЕНТ · эксперимент</span>
            <h2>Ложемент по фотографии</h2>
            <p>Разложите инструменты на плоскости и снимите сверху. Сервис найдёт предметы, вы поправите контуры и макет — на выходе плита с карманами: STL, 3MF, DXF и SVG.</p>
            <p class="lozhement-price">Построение модели — 1 кредит. Следующие 5 пересборок этого фото — бесплатно.
                <span class="lozhement-limit">Ложемент — до 1200 × 1200 мм.</span></p>
        </header>

        <p class="small text-muted generation-visibility-notice">3D-модели на бесплатном и разовых тарифах публичны. Приватная генерация — на месячных и годовых тарифах. 2D-картинки всегда приватны.</p>
        
        <div class="lozhement-gate" role="status">
            <span class="lozhement-gate__icon" aria-hidden="true">🔒</span>
            <div>
                
                <strong>Войдите, чтобы открыть ложемент</strong>
                <p>Генератор работает для вошедших аккаунтов с подходящим тарифом.</p>
                
                <a class="lozhement-gate__cta" href="/#headingLogin">Войти</a>
                
            </div>
        </div>
        

