                <label class="drop" for="photo"
                       data-image-upload-for="photo"
                       data-image-upload-paste-label="Вставить"
                       data-image-upload-paste-empty="В буфере нет изображения: скопируйте картинку (Копировать изображение), а не файл"
                       data-image-upload-paste-denied="Браузер запретил доступ к буферу: разрешите в подсказке у адресной строки или нажмите Ctrl+V"
                       data-image-upload-bad-format="Формат не поддерживается (нужен PNG, JPEG или WebP)"
                       tabindex="0" role="button" aria-controls="photo">
                    <strong id="drop-title">Выбрать фотографию</strong>
                    <span>JPG, PNG, WebP или HEIC; крупные фото уменьшим сами</span>
                    <input id="photo" name="photo" type="file" accept="image/*" required
                           >
                    <img id="photo-preview" alt="Предпросмотр загруженной фотографии" hidden>
                </label>

                <div class="step-title section-title">
                    <span>2</span>
                    <div><strong>Масштаб</strong><small>Как перевести пиксели в миллиметры</small></div>
                </div>
                <div class="segmented" role="radiogroup" aria-label="Способ задания масштаба">
                    <label>
                        <input type="radio" name="scale-mode" value="a4" checked>
                        <span><strong>По листу A4</strong><small>автоматически</small></span>
                    </label>
                    <label>
                        <input type="radio" name="scale-mode" value="manual">
                        <span><strong>По известному размеру</strong><small>две точки</small></span>
                    </label>
                </div>

                <div class="step-title section-title">
                    <span>3</span>
                    <div><strong>Параметры</strong><small>Только самое необходимое</small></div>
                </div>
                <div class="output-mode-field">
                    <span class="field-label" id="output-mode-label">Тип модели</span>
                    <div class="segmented output-mode-selector" role="radiogroup" aria-labelledby="output-mode-label">
                        <label>
                            <input id="output-mode-flat" type="radio" name="output-mode" value="flat"
                                   checked>
                            <span><strong>Ложемент для упаковки</strong><small>Свободный размер для коробки, ящика или кейса</small></span>
                        </label>
                        <label>
                            <input id="output-mode-gridfinity" type="radio" name="output-mode" value="gridfinity"
                                   >
                            <span><strong>Основание Gridfinity</strong><small>Ячейка 42 мм; от 1 × 1 до 10 × 10 (печатный размер 41,5–419,5 мм по каждой оси). До края и между карманами — не меньше 3 мм материала; глубина от 5 мм, высота до 20 ед.</small></span>
                        </label>
                    </div>
                </div>
                <div class="essentials">
                    <label>Глубина кармана
                        <span><input id="depth" type="number" data-live-range min="1" max="150" step="0.5" value="18"> мм</span>
                    </label>
                    <label>Посадка предмета
                        <select id="fit">
                            <option value="0.4">Плотная</option>
                            <option value="0.8" selected>Обычная</option>
                            <option value="1.2">Свободная</option>
                        </select>
                    </label>
                </div>

                <div id="flat-options">
                    <label class="toggle">
                        <input id="auto-notches" type="checkbox" checked>
                        <span>
                            <strong>Выемки для пальцев</strong>
                            <small>С противоположных сторон, только где безопасно</small>
                        </span>
                    </label>
                </div>

                <div id="gridfinity-options" class="gridfinity-options" hidden>
                    <div id="gridfinity-limits" class="gridfinity-limits" role="note">
                        Ячейка 42 мм; от 1 × 1 до 10 × 10 (печатный размер 41,5–419,5 мм по каждой оси). До края и между карманами — не меньше 3 мм материала; глубина от 5 мм, высота до 20 ед.
                    </div>
                    <label class="gridfinity-height">Высота
                        <span><input id="gridfinity-height-units" type="number" data-live-range min="2" max="20" step="1" value="5"> ед.</span>
                        <small>Одна единица — 7 мм; увеличьте высоту для глубоких карманов</small>
                    </label>
                    <label class="toggle">
                        <input id="gridfinity-magnets" type="checkbox" checked>
                        <span>
                            <strong>Отверстия под магниты</strong>
                            <small>Стандартные отверстия 6 × 2,4 мм в ячейках основания</small>
                        </span>
                    </label>
                    <label class="toggle">
                        <input id="gridfinity-stacking-lip" type="checkbox" checked>
                        <span>
                            <strong>Бортик для штабелирования</strong>
                            <small>Стандартный верхний профиль Gridfinity</small>
                        </span>
                    </label>
                </div>

                <details id="flat-advanced" class="details">
                    <summary>Дополнительные параметры</summary>
                    <div class="advanced-grid">
                        <label>Поле вокруг
                            <span><input id="margin" type="number" data-live-range min="2" max="100" step="0.5" value="10"> мм</span>
                        </label>
                        <label>Толщина дна
                            <span><input id="floor" type="number" data-live-range min="0.8" max="30" step="0.1" value="3"> мм</span>
                        </label>
                        <label id="corner-radius-label">Скругление плиты
                            <span><input id="corner-radius" type="number" data-live-range min="0" max="50" step="0.5" value="4"> мм</span>
                        </label>
                        <span id="notch-radius-row" aria-hidden="true" hidden>
                            <input id="notch-radius" type="hidden" value="10">
                        </span>
                    </div>
                </details>

                
<p class="text-muted small text-center mt-2 mb-2 generation-background-note">
    Задача выполняется в фоновом режиме. Необязательно ждать здесь: готовый результат появится в разделе «Мои модели».
</p>
                <button id="start-button" class="primary-button wide" type="submit"
                        >Найти предметы <span>→</span></button>
                <div id="error" class="error" role="alert"></div>
            </form>

            <section class="panel workspace">
                <div id="empty" class="empty">
                    <div class="empty-art" aria-hidden="true">
                        <span></span><span></span><span></span>
                    </div>
                    <span class="microlabel">ШАГ 1</span>
                    <h2>Начните с фотографии</h2>
                    <p>Сначала проверим масштаб и контуры. 3D-модель не будет строиться вслепую.</p>
                </div>

                <div id="progress" class="progress" hidden>
                    <div class="spinner" aria-hidden="true"></div>
                    <strong id="stage">Загружаем фотографию</strong>
                    <p id="stage-help">Первое распознавание на CPU может занять до минуты.</p>
                    <div class="progress-bar"><span id="progress-bar"></span></div>
                </div>

                <section id="calibration" class="calibration" hidden>
                    <div class="workspace-head">
                        <div>
                            <span class="microlabel">МАСШТАБ</span>
                            <h2>Отметьте известный размер</h2>
                            <p id="calibration-message">Поставьте две точки на отрезке, длину которого вы знаете.</p>
                        </div>
                    </div>
                    <div class="canvas-frame calibration-frame">
                        <svg id="calibration-svg" aria-label="Разметка известного размера"></svg>
                    </div>
                    <div class="calibration-controls">
                        <label>Расстояние между точками
                            <span><input id="known-distance" type="number" min="1" max="5000" step="0.1" value="100"> мм</span>
                        </label>
                        <button id="reset-calibration" class="secondary-button" type="button">Поставить заново</button>
                        <button id="apply-calibration" class="primary-button" type="button" disabled>Продолжить →</button>
                    </div>
                </section>

                <section id="review" class="review" hidden>
                    <div class="workspace-head review-head">
                        <div>
                            <span class="microlabel">ШАГ 2 · КОНТУРЫ</span>
                            <h2><span id="object-count">0</span> предметов найдено</h2>
                            <p id="editor-help">Контуры автоматически упрощены. Выберите предмет, чтобы поправить оставшиеся точки.</p>
                        </div>
                        <div class="review-actions">
                            <button id="toggle-contour-fullscreen" class="secondary-button" type="button">⛶ На весь экран</button>
                            <button id="toggle-interior-rings" class="secondary-button" type="button" aria-pressed="false" hidden>Добавить внутренние вырезы</button>
                            <button id="add-object" class="secondary-button" type="button">+ Добавить</button>
                            <button id="delete-object" class="danger-button" type="button" disabled>Удалить</button>
                        </div>
                    </div>

                    <div id="contour-detail-control" class="contour-detail-control" hidden>
                        <div class="contour-detail-copy">
                            <label for="contour-detail">Детализация выбранного контура</label>
                            <output id="contour-detail-status" for="contour-detail" aria-live="polite">Выберите предмет</output>
                        </div>
                        <div class="contour-detail-slider">
                            <div class="range-number-control">
                                <input id="contour-detail" type="range" step="1" disabled data-number-input="contour-detail-number"
                                       aria-describedby="contour-detail-scale contour-detail-status">
                                <input id="contour-detail-number" class="range-number-input" type="number" step="1" disabled inputmode="numeric"
                                       aria-label="Детализация выбранного контура">
                            </div>
                            <div id="contour-detail-scale" class="contour-detail-scale" aria-hidden="true">
                                <span>Прямоугольник</span>
                                <span>Все точки</span>
                            </div>
                        </div>
                    </div>

                    <div class="canvas-frame editor-frame">
                        <svg id="editor-svg" aria-label="Редактор контуров предметов"></svg>
                    </div>

                    <div id="draw-actions" class="draw-actions" hidden>
                        <span>Щёлкайте по границе пропущенного предмета — достаточно 6–12 точек.</span>
                        <button id="cancel-object" class="secondary-button" type="button">Отмена</button>
                        <button id="finish-object" class="primary-button" type="button" disabled>Готово</button>
                    </div>

                    <div class="review-footer">
                        <div class="legend">
                            <span><i class="legend-contour"></i> контур</span>
                            <span id="vertex-summary">точек: 0</span>
                        </div>
                        <button id="open-layout" class="primary-button" type="button">Настроить макет →</button>
                    </div>
                </section>

                <section id="layout-editor" class="layout-editor" hidden>
                    <div class="workspace-head review-head">
                        <div>
                            <span class="microlabel">ШАГ 3 · МАКЕТ</span>
                            <h2 id="layout-title">Расположите карманы</h2>
                            <p id="layout-copy">Перетаскивайте предмет целиком, квадратные уголки меняют его размер. Круглые метки — выемки под пальцы: их тоже можно двигать, каждую отдельно вдоль контура кармана.</p>
                        </div>
                        <div class="review-actions">
                            <button id="reset-layout" class="secondary-button" type="button">Сбросить</button>
                            <button id="layout-delete-object" class="danger-button" type="button" disabled>Удалить</button>
                        </div>
                    </div>

                    <div class="canvas-frame layout-frame">
                        <svg id="layout-svg" aria-label="Макет ложемента"></svg>
                    </div>

                    <div id="layout-status" class="layout-status" role="status">
                        Проверяем выемки и перемычки…
                    </div>
                    <div class="layout-info">
                        <span>Плита: <strong id="layout-dimensions">—</strong></span>
                        <span>Выбранный карман: <strong id="selected-dimensions">не выбран</strong></span>
                    </div>
                    <div id="flat-plate-controls" class="plate-controls">
                        <label class="plate-lock">
                            <input id="plate-fixed" type="checkbox">
                            <span>
                                <strong>Задать размер заготовки</strong>
                                <small>Включите галочку, чтобы ввести нужные размеры плиты. Не больше 1200 × 1200 мм</small>
                            </span>
                        </label>
                        <label>
                            <span>Ширина плиты</span>
                            <span class="input-with-unit">
                                <input id="plate-width" type="number" data-live-range min="20" max="1200" step="0.1">
                                <span>мм</span>
                            </span>
                        </label>
                        <label>
                            <span>Длина плиты</span>
                            <span class="input-with-unit">
                                <input id="plate-depth" type="number" data-live-range min="20" max="1200" step="0.1">
                                <span>мм</span>
                            </span>
                        </label>
                    </div>
                    <div id="gridfinity-plate-controls" class="plate-controls plate-controls--grid" hidden>
                        <label class="plate-lock">
                            <input id="gridfinity-auto-grid" type="checkbox" checked>
                            <span>
                                <strong>Подобрать сетку автоматически</strong>
                                <small>Минимальный размер в целых ячейках для всех карманов</small>
                            </span>
                        </label>
                        <label>
                            <span>Ширина сетки</span>
                            <span class="input-with-unit">
                                <input id="gridfinity-grid-x" type="number" data-live-range min="1" max="10" step="1" value="2" disabled>
                                <span>ед.</span>
                            </span>
                        </label>
                        <label>
                            <span>Глубина сетки</span>
                            <span class="input-with-unit">
                                <input id="gridfinity-grid-y" type="number" data-live-range min="1" max="10" step="1" value="2" disabled>
                                <span>ед.</span>
                            </span>
                        </label>
                    </div>
                    <div class="layout-footer">
                        <button id="back-to-contours" class="secondary-button" type="button">← Контуры</button>
                        <div class="legend">
                            <span><i class="legend-pocket"></i> карман</span>
                            <span id="legend-notch-item"><i class="legend-notch"></i> выемка</span>
                            <span id="legend-grid-item" hidden><i class="legend-grid"></i> сетка 42 мм</span>
                        </div>
                        <div>
                            
<p class="text-muted small text-center mt-2 mb-2 generation-background-note">
    Задача выполняется в фоновом режиме. Необязательно ждать здесь: готовый результат появится в разделе «Мои модели».
</p>
                            <button id="build-model" class="primary-button" type="button" aria-describedby="layout-status">Построить 3D · 1 кредит →</button>
                        </div>
                    </div>
                </section>

                <section id="ready" class="ready" hidden>
                    <div class="workspace-head">
                        <div>
                            <span class="microlabel">ШАГ 4 · 3D</span>
                            <h2>Ложемент готов</h2>
                            <p>Потяните модель мышью, чтобы повернуть. Колесо меняет масштаб.</p>
                        </div>
                        <span class="success-pill">✓ сетка замкнута</span>
                    </div>

                    <div class="viewer-frame">
                        <canvas id="stl-canvas" aria-label="Интерактивная 3D-модель ложемента"></canvas>
                        <div id="viewer-status" class="viewer-status">Загружаем 3D…</div>
                    </div>

                    <div class="summary">
                        <div><span>Габариты</span><strong id="dimensions"></strong></div>
                        <div><span>Предметы</span><strong id="polygon-count"></strong></div>
                    </div>
                    <div id="warnings" class="warnings" hidden></div>
                    
                    <p id="lozhement-library" class="lozhement-library" role="status" hidden></p>
                    <p id="lozhement-rebuilds" class="lozhement-rebuilds" role="status" hidden></p>
                    <div class="downloads">
                        <label class="download-format">
                            <span>Формат файла</span>
                            <select id="download-format">
                                <option value="3mf">3MF — 3D-печать, рекомендуется</option>
                                <option value="stl">STL — совместимость, размер в мм</option>
                                <option value="dxf">DXF — CNC, лазер, водоструй</option>
                                <option value="svg">SVG — лазер и хоббийный CNC</option>
                            </select>
                        </label>
                        <div class="download-actions">
                            <button id="download-file" class="download-primary" type="button">Скачать файл</button>
                            <button id="back-to-layout" class="secondary-button" type="button">← Изменить макет</button>
                        </div>
                        <span id="download-status" class="download-status" role="status"></span>
                    </div>
                </section>
            </section>
        </section>
    </div>
</div>
            </div>
            
        </div>
        </div><!-- /.ag-gen-card -->
        <script>
        // Конструктор подставок: аддоны three.js тяжёлые, грузим лениво —
        // при первом открытии вкладки (или сразу, если страница отрендерена
        // с активной вкладкой по deep-link'у). Сам three r128 + GLTFLoader +
        // OrbitControls страница уже грузит (defer, вьювер результата) —
        // present()-проверки не дают втащить дубли.
        (function () {
            var STEPS = [
                { src: 'https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js',
                  present: function () { return !!window.THREE; } },
                { src: "/static/js/free_orbit_controls.js?v=20261001-free-orbit",
                  present: function () { return window.THREE && !!window.THREE.FreeOrbitControls; } },
                { src: 'https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/FontLoader.js',
                  present: function () { return window.THREE && !!window.THREE.FontLoader; } },
                { src: 'https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/geometries/TextGeometry.js',
                  present: function () { return window.THREE && !!window.THREE.TextGeometry; } },
                { src: 'https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/STLLoader.js',
                  present: function () { return window.THREE && !!window.THREE.STLLoader; } },
                { src: 'https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/OBJLoader.js',
                  present: function () { return window.THREE && !!window.THREE.OBJLoader; } },
                { src: 'https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js',
                  present: function () { return window.THREE && !!window.THREE.GLTFLoader; } },
                { src: 'https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/exporters/STLExporter.js',
                  present: function () { return window.THREE && !!window.THREE.STLExporter; } },
                { src: 'https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/exporters/GLTFExporter.js',
                  present: function () { return window.THREE && !!window.THREE.GLTFExporter; } },
                { src: 'https://cdn.jsdelivr.net/npm/meshoptimizer@0.20.0/meshopt_decoder.js',
                  present: function () { return !!window.MeshoptDecoder; } },
                { src: "/static/js/viewer_quality.js?v=20261001-full-first",
                  present: function () { return !!window.AIprintgenViewerQuality; } },
                { src: "/static/js/viewer_standard.js?v=20261018-theme1",
                  present: function () { return !!(window.AIprintgenViewerStandard && window.AIprintgenViewerStandard.waitForLightweightViewer); } },
                { src: "/static/base_builder/base_builder.js?v=1793916133-theme1",
                  present: function () { return false; } }
            ];
            var started = false;
            function loadStep(index, waited) {
                if (index >= STEPS.length) { return; }
                var step = STEPS[index];
                if (step.present()) { loadStep(index + 1, 0); return; }
                if (index === 0 && (waited || 0) < 40) {
                    // three.min.js уже стоит в defer-очереди страницы —
                    // подождём его вместо загрузки второй копии.
                    window.setTimeout(function () { loadStep(0, (waited || 0) + 1); }, 250);
                    return;
                }
                var script = document.createElement('script');
                script.src = step.src;
                script.onload = function () { loadStep(index + 1, 0); };
                document.head.appendChild(script);
            }
            function bootBaseBuilder() {
                if (started) { return; }
                started = true;
                loadStep(0, 0);
            }
            var builderTab = document.getElementById('base-builder-tab');
            if (builderTab) {
                builderTab.addEventListener('click', bootBaseBuilder);
                if (window.jQuery) {
                    window.jQuery(builderTab).on('shown.bs.tab', bootBaseBuilder);
                }
            }
            var builderPane = document.getElementById('base-builder');
            if (builderPane && builderPane.classList.contains('active')) {
                bootBaseBuilder();
            }
            var hasPendingAuthSaveDraft = false;
            try {
                hasPendingAuthSaveDraft = !!window.sessionStorage.getItem(
                    'aiprintgen.base-builder.pending-auth-save.v1'
                );
            } catch (storageError) {
                // Storage may be disabled; normal lazy loading still works.
            }
            // A stale base-builder save draft must not steal a fresh catalog
            // Create Similar destination. Keep the draft intact so it can be
            // resumed later from an ordinary generator page.
            var hasCatalogActionDestination = !!document.querySelector(
                '#text-form input[name="action_session_id"]'
            );
            // A completed/in-flight generation owns this page too. In
            // particular, Split returns to `/?gen_id=...`; restoring an old
            // base-builder auth draft there used to put the Base tab above a
            // perfectly valid split result.
            var hasExplicitGenerationDestination = false;
            if (hasPendingAuthSaveDraft
                    && builderPane
                    && !hasCatalogActionDestination
                    && !hasExplicitGenerationDestination) {
                bootBaseBuilder();
                if (builderTab && window.jQuery && jQuery.fn && jQuery.fn.tab) {
                    jQuery(builderTab).tab('show');
                } else {
                    // The inline loader can run before Bootstrap's tab plugin.
                    // Reveal the pending builder without waiting for a click.
                    if (builderTab) {
                        var activeLinks = builderTab.parentNode.parentNode.querySelectorAll('.nav-link.active');
                        Array.prototype.forEach.call(activeLinks, function (link) {
                            link.classList.remove('active');
                            link.setAttribute('aria-selected', 'false');
                        });
                        builderTab.classList.add('active');
                        builderTab.setAttribute('aria-selected', 'true');
                    }
                    var siblingPanes = builderPane.parentNode.querySelectorAll('.tab-pane.active');
                    Array.prototype.forEach.call(siblingPanes, function (pane) {
                        pane.classList.remove('show', 'active');
                    });
                    builderPane.classList.add('show', 'active');
                }
                if (typeof builderPane.scrollIntoView === 'function') {
                    builderPane.scrollIntoView({ behavior: 'auto', block: 'start' });
                }
            }
            // «Сделать подставку» под свежим результатом. Билдер — соседняя
            // вкладка этой же страницы, поэтому вместо перехода по href
            // переключаем вкладку и просим билдер подгрузить только что
            // сгенерированную модель: результат генерации остаётся на месте,
            // страница не перерисовывается. Если jQuery/вкладки недоступны —
            // не мешаем браузеру пойти по настоящему href.
            var makeBaseButton = document.getElementById('make-base-btn');
            if (makeBaseButton && builderTab) {
                makeBaseButton.addEventListener('click', function (event) {
                    var publicId = makeBaseButton.getAttribute('data-public-id') || '';
                    var modelTitle = makeBaseButton.getAttribute('data-model-title') || '';
                    if (!publicId || !(window.jQuery && jQuery.fn && jQuery.fn.tab)) {
                        return;
                    }
                    if (event.metaKey || event.ctrlKey || event.shiftKey || event.button) {
                        return;  // «открыть в новой вкладке» оставляем браузеру
                    }
                    event.preventDefault();
                    var builderApi = window.AIprintgenBaseBuilder;
                    if (builderApi && typeof builderApi.loadOwnModel === 'function') {
                        builderApi.loadOwnModel(publicId, modelTitle);
                    } else {
                        // Аддоны three.js ещё грузятся — билдер заберёт заявку сам.
                        window.AIprintgenBaseBuilderRequest = {
                            publicId: publicId, title: modelTitle, from: 'generator'
                        };
                    }
                    bootBaseBuilder();
                    jQuery(builderTab).tab('show');
                    if (builderPane && typeof builderPane.scrollIntoView === 'function') {
                        builderPane.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                });
            }
        })();
        
        // Вкладка CAD живёт на главной, а индексируемый продуктовый материал —
        // отдельно на /ai-cad-generator. Скрипт формы грузим только при открытии.
        (function () {
            var started = false;
            function bootCad() {
                if (started || !document.getElementById('cad-lab')) { return; }
                started = true;
                var script = document.createElement('script');
                script.src = "/static/js/cad_generator.js?v=sha256-1e5dfb88a0e1a6ae";
                document.head.appendChild(script);
            }
            var cadTab = document.getElementById('cad-tab');
            if (cadTab) {
                cadTab.addEventListener('click', bootCad);
                if (window.jQuery) { window.jQuery(cadTab).on('shown.bs.tab', bootCad); }
            }
            var cadPane = document.getElementById('cad');
            if (cadPane && cadPane.classList.contains('active')) { bootCad(); }
        })();
        
        
        // Вкладка «Ложемент»: стили и три скрипта прототипа весят под 170 КБ.
        // Грузим их при первом открытии вкладки и строго по очереди — flat.js
        // на старте требует уже загруженные contour_tools и stl_viewer.
        (function () {
            var started = false;
            var ASSETS = [
                "/static/lozhement/contour_tools.js?v=16",
                "/static/lozhement/stl_viewer.js?v=17",
                "/static/lozhement/flat.js?v=sha256-4df37c95e987d17f"
            ];
            function loadScript(index) {
                if (index >= ASSETS.length) { return; }
                var script = document.createElement('script');
                script.src = ASSETS[index];
                script.onload = function () { loadScript(index + 1); };
                document.head.appendChild(script);
            }
            function bootLozhement() {
                if (started || !document.getElementById('lozhement-app')) { return; }
                started = true;
                var styles = document.createElement('link');
                styles.rel = 'stylesheet';
                styles.href = "/static/lozhement/flat.css?v=20";
                document.head.appendChild(styles);
                loadScript(0);
            }
            var lozhementTab = document.getElementById('lozhement-tab');
            if (lozhementTab) {
                lozhementTab.addEventListener('click', bootLozhement);
                if (window.jQuery) { window.jQuery(lozhementTab).on('shown.bs.tab', bootLozhement); }
            }
            var lozhementPane = document.getElementById('lozhement');
            if (lozhementPane && lozhementPane.classList.contains('active')) { bootLozhement(); }
        })();
        
        // Deep-linkable generator tabs: reflect the active tab in the address
        // bar (its own /gen_* route) so a specific generation type can be
        // shared/bookmarked/targeted by ads. replaceState only — no history
        // spam, and the server already renders the right tab for /gen_* hits.
        document.addEventListener('DOMContentLoaded', function () {
            if (!(window.jQuery && jQuery.fn && jQuery.fn.tab)) { return; }
            jQuery('#modelGenerationTabs a[data-tab-url], #modelGenerationTabsPro a[data-tab-url]').on('shown.bs.tab', function () {
                var url = this.getAttribute('data-tab-url');
                if (url && window.history && window.history.replaceState) {
                    // Keep current query params (gen_id etc. are per-URL anyway;
                    // a manual tab switch starts a fresh context) but preserve
                    // nothing else — the /gen_* path IS the state.
                    window.history.replaceState(null, '', url);
                }
            });
        });
        </script>

        
        

        
        

        
        

        
        

