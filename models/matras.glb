<script>
document.addEventListener('DOMContentLoaded', function () {
    // Keep legacy #how-it-works-block links useful and open the localized
    // quick-start fallback whether navigation happened before or after load.
    function openQuickStartFromHash() {
        if (window.location.hash !== '#how-it-works-block' && window.location.hash !== '#quick-start') {
            return;
        }
        var d = document.querySelector('.ag-hiw');
        if (d) {
            d.open = true;
            d.scrollIntoView({behavior: 'smooth', block: 'start'});
        }
    }
    openQuickStartFromHash();
    window.addEventListener('hashchange', openQuickStartFromHash);
    // Lazy: on first expand, load the model-viewer component (~200KB) and
    // materialize the <model-viewer> tags — the homepage never pays for it
    // while the block stays collapsed.
    var hiw = document.querySelector('.ag-hiw');
    function mountHiwViewers() {
        if (!hiw || hiw.dataset.viewersMounted === '1') { return; }
        hiw.dataset.viewersMounted = '1';
        if (!document.querySelector('script[data-model-viewer]')) {
            var s = document.createElement('script');
            s.type = 'module';
            s.src = 'https://unpkg.com/@google/model-viewer@3.5.0/dist/model-viewer.min.js';
            s.setAttribute('data-model-viewer', '1');
            document.head.appendChild(s);
        }
        document.querySelectorAll('.ag-hiw__viewer-slot[data-glb]').forEach(function (slot) {
            var mv = document.createElement('model-viewer');
            mv.setAttribute('src', slot.getAttribute('data-glb'));
            mv.setAttribute('alt', slot.getAttribute('data-alt') || '');
            mv.setAttribute('auto-rotate', '');
            mv.setAttribute('camera-controls', '');
            mv.setAttribute('disable-zoom', '');
            mv.setAttribute('interaction-prompt', 'none');
            mv.setAttribute('rotation-per-second', '30deg');
            mv.setAttribute('shadow-intensity', '1');
            mv.className = 'ag-hiw__mv';
            slot.insertBefore(mv, slot.firstChild);
        });
    }
    if (hiw) {
        hiw.addEventListener('toggle', function () { if (hiw.open) { mountHiwViewers(); } });
        if (hiw.open) { mountHiwViewers(); }
    }
});
</script>


<section class="ag-section ag-faq-section" id="faq">
    <p class="ag-kicker">FAQ</p>
    <ul class="ag-faq">
        
        <li class="open">
            <button type="button" class="ag-faq__q" aria-expanded="true">
                <span>Можно ли создать 3D модель для 3D принтера онлайн?</span>
                <span class="ag-faq__toggle"><i class="fas fa-plus" aria-hidden="true"></i></span>
            </button>
            <div class="ag-faq__a">Да. В AIPRINTGEN можно создать 3D модель для 3D принтера онлайн по фото, картинке или текстовому описанию. После генерации модель можно скачать и подготовить к печати в слайсере.</div>
        </li>
        
        <li >
            <button type="button" class="ag-faq__q" aria-expanded="false">
                <span>Что такое генератор 3D моделей для 3D печати?</span>
                <span class="ag-faq__toggle"><i class="fas fa-plus" aria-hidden="true"></i></span>
            </button>
            <div class="ag-faq__a">Это AI-сервис, который превращает фото, картинку или текстовое описание в загружаемую 3D-сетку. Проверьте результат и используйте доступный формат экспорта, а перед печатью подготовьте модель в слайсере или 3D-редакторе.
                <br><a href="/3d-model-generator">Подробнее: генератор 3D-моделей для 3D-печати →</a>
                <br><a href="/text-to-3d-generator">3D по тексту →</a>
                <br><a href="/multiview-to-3d-generator">3D по 2–4 ракурсам →</a></div>
        </li>
        
        <li >
            <button type="button" class="ag-faq__q" aria-expanded="false">
                <span>Возможно ли создание 3D модели по фото для печати?</span>
                <span class="ag-faq__toggle"><i class="fas fa-plus" aria-hidden="true"></i></span>
            </button>
            <div class="ag-faq__a">Да. Загрузите одну фотографию объекта — нейросеть восстановит его форму и текстуру. Для большей точности можно загрузить 4 ракурса (спереди, слева, сзади, справа).
                <br><a href="/sozdat-3d-model-po-foto-dlya-pechati">Подробнее: создание 3D-модели по фото для печати →</a></div>
        </li>
        
        <li >
            <button type="button" class="ag-faq__q" aria-expanded="false">
                <span>Что значит генерация 3D моделей для печати?</span>
                <span class="ag-faq__toggle"><i class="fas fa-plus" aria-hidden="true"></i></span>
            </button>
            <div class="ag-faq__a">Нейросеть строит 3D-сетку и оптимизирует количество полигонов. Перед FDM- или фотополимерной печатью проверьте в слайсере масштаб, толщину стенок, замкнутость и поддержки; иногда геометрии нужен ремонт или доработка.</div>
        </li>
        
        <li >
            <button type="button" class="ag-faq__q" aria-expanded="false">
                <span>Можно ли получить ИИ 3D модель для принтера без навыков моделирования?</span>
                <span class="ag-faq__toggle"><i class="fas fa-plus" aria-hidden="true"></i></span>
            </button>
            <div class="ag-faq__a">Да — сервис именно для этого. Опыт работы в CAD или скульптинге не нужен. Опишите объект или загрузите фото и настройте простые параметры вроде количества полигонов.</div>
        </li>
        
        <li >
            <button type="button" class="ag-faq__q" aria-expanded="false">
                <span>Как сделать 3D модель для печати по фото?</span>
                <span class="ag-faq__toggle"><i class="fas fa-plus" aria-hidden="true"></i></span>
            </button>
            <div class="ag-faq__a">Зарегистрируйтесь, откройте вкладку «По фото», загрузите фото в JPG или PNG (крупные уменьшим сами), выберите настройки и нажмите «Сгенерировать». Время зависит от режима, очереди и сложности; после обработки проверьте модель во вьювере и слайсере перед печатью.</div>
        </li>
        
        <li >
            <button type="button" class="ag-faq__q" aria-expanded="false">
                <span>Какие объекты лучше всего подходят для генерации?</span>
                <span class="ag-faq__toggle"><i class="fas fa-plus" aria-hidden="true"></i></span>
            </button>
            <div class="ag-faq__a">Отлично получаются фигурки, персонажи, игрушки, сувениры, предметы быта и декор. Лучший результат дают чёткие фото объекта на нейтральном фоне.</div>
        </li>
        
        <li >
            <button type="button" class="ag-faq__q" aria-expanded="false">
                <span>Можно ли сразу отправить модель на 3D-принтер?</span>
                <span class="ag-faq__toggle"><i class="fas fa-plus" aria-hidden="true"></i></span>
            </button>
            <div class="ag-faq__a">Скачайте доступный STL или OBJ и проверьте масштаб, стенки и замкнутость в Cura, PrusaSlicer или Orca. При необходимости отремонтируйте сетку, затем выберите настройки печати. У нас можно заказать проверку и печать модели.</div>
        </li>
        
        <li >
            <button type="button" class="ag-faq__q" aria-expanded="false">
                <span>Какие форматы можно использовать для 3D-печати?</span>
                <span class="ag-faq__toggle"><i class="fas fa-plus" aria-hidden="true"></i></span>
            </button>
            <div class="ag-faq__a">STL и OBJ используют в печатных сценариях, GLB сохраняет материалы для просмотра и игр, FBX подходит для анимации. Набор зависит от модели и режима обработки: созданные файлы показаны в меню скачивания.</div>
        </li>
        
        <li >
            <button type="button" class="ag-faq__q" aria-expanded="false">
                <span>Подходит ли AIPRINTGEN для профессиональной 3D-печати?</span>
                <span class="ag-faq__toggle"><i class="fas fa-plus" aria-hidden="true"></i></span>
            </button>
            <div class="ag-faq__a">Да. Вы управляете количеством полигонов до 1 млн, генерируете варианты, сегментируете модель на части и дорабатываете геометрию — сервисом пользуются студии и мейкеры для коммерческих задач.</div>
        </li>
        
    </ul>
</section>
<script>
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.ag-faq__q').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var li = btn.closest('li');
            var isOpen = li.classList.toggle('open');
            btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
    });
});
</script>


<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('[data-home-event="print_service_click"]').forEach(function (link) {
            link.addEventListener('click', function () {
                var eventName = link.getAttribute('data-home-event');
                var params = {
                    source_page: 'homepage',
                    source_block: link.getAttribute('data-source-block') || '',
                    item_name: '3d_print_service',
                    page_path: window.location.pathname || '',
                    device: window.matchMedia && window.matchMedia('(max-width: 720px)').matches ? 'mobile' : 'desktop'
                };
                if (typeof window.aiprintgenTrackGa4Event === 'function') {
                    window.aiprintgenTrackGa4Event(eventName, params);
                }
                if (typeof window.aiprintgenReachMetrikaGoal === 'function') {
                    window.aiprintgenReachMetrikaGoal(eventName, params);
                }
            });
        });

        // OAuth-button bindings + accordion mechanics live in _auth_sidebar.html
        // (shared with the global auth drawer on non-homepage pages).
        const authMode = new URLSearchParams(window.location.search).get('auth');
        function safeAuthReturnUrl(candidate) {
            candidate = String(candidate || '');
            return candidate.charAt(0) === '/'
                && candidate.slice(0, 2) !== '//'
                && candidate.indexOf('\\') === -1
                ? candidate
                : '';
        }
        const globalAuthReveal = window.aiprintgenAuthDrawerMode ? window.aiprintgenRevealAuthEntry : null;
        function revealAuthEntry(mode, returnUrl) {
            if (globalAuthReveal) return globalAuthReveal(mode, returnUrl);
            const explicitReturn = safeAuthReturnUrl(returnUrl);
            if (explicitReturn) {
                window.aiprintgenAuthReturnUrl = explicitReturn;
                document.querySelectorAll('#authAccordion form input[name="next"]').forEach(function(input) {
                    input.value = explicitReturn;
                });
            }
            // Open the drawer FIRST: Bootstrap's collapse animation relies on
            // height measurement + transitionend, which never fire inside a
            // display:none parent — with the sidebar now collapsed by default
            // the accordion would get stuck in .collapsing and never open.
            if (typeof window.aiprintgenOpenSidebar === 'function') {
                // Not remembered: after sign-in the reload starts collapsed
                // instead of leaving the account panel over the page.
                window.aiprintgenOpenSidebar({persist: false});
            }
            if (typeof window.aiprintgenAuthPanelActivate === 'function') {
                window.aiprintgenAuthPanelActivate(mode);
            }
        }

        window.aiprintgenRevealAuthEntry = revealAuthEntry;

        // Keep an anonymous visitor's edits in this tab while auth performs a
        // full-page round trip. The prompt never enters the URL, cookies or
        // analytics; the opaque action id only namespaces sessionStorage.
        const catalogActionInput = document.querySelector('#text-form input[name="action_session_id"]');
        const catalogActionPrompt = document.getElementById('prompt');
        const catalogActionGuest = false;
        const catalogActionReturnUrl = safeAuthReturnUrl("");
        if (catalogActionInput && catalogActionReturnUrl) {
            // Header auth links and every OAuth provider inherit the same
            // per-tab action id even before the in-form CTA is clicked.
            window.aiprintgenAuthReturnUrl = catalogActionReturnUrl;
        }
        if (catalogActionInput && catalogActionPrompt) {
            const catalogPromptStorageKey = 'catalog-action-prompt:' + catalogActionInput.value;
            try {
                const storedPrompt = window.sessionStorage.getItem(catalogPromptStorageKey);
                if (storedPrompt && storedPrompt.length >= 6 && storedPrompt.length <= 1023) {
                    catalogActionPrompt.value = storedPrompt;
                }
                catalogActionPrompt.addEventListener('input', function() {
                    window.sessionStorage.setItem(catalogPromptStorageKey, catalogActionPrompt.value.slice(0, 1023));
                });
            } catch (_catalogPromptStorageError) {}
            if (catalogActionGuest) {
                const catalogTextForm = document.getElementById('text-form');
                if (catalogTextForm) {
                    catalogTextForm.addEventListener('submit', function(event) {
                        event.preventDefault();
                    });
                }
            }
        }

        if (authMode === 'register' || window.location.hash === '#headingRegister') {
            revealAuthEntry('register');
        } else if (authMode === 'login' || window.location.hash === '#headingLogin') {
            revealAuthEntry('login');
        }

        // Same-page anchor navigation to the auth headings (e.g. in-content
        // links) only fires hashchange — re-run the reveal so the drawer
        // opens without a reload. Header buttons are intercepted in base.html.
        window.addEventListener('hashchange', function () {
            if (window.location.hash === '#headingRegister') {
                revealAuthEntry('register');
            } else if (window.location.hash === '#headingLogin') {
                revealAuthEntry('login');
            }
        });

        document.querySelectorAll('.js-register-first-cta').forEach(function(button) {
            button.addEventListener('click', function() {
                revealAuthEntry('register');
                if (window.history && window.history.replaceState) {
                    window.history.replaceState(null, '', "/?auth=register#headingRegister");
                }
            });
        });

        document.querySelectorAll('[data-catalog-action-auth-mode]').forEach(function(button) {
            button.addEventListener('click', function() {
                const mode = button.getAttribute('data-catalog-action-auth-mode') === 'login'
                    ? 'login'
                    : 'register';
                if (catalogActionInput) {
                    try {
                        fetch("/api/catalog/events", {
                            method: 'POST',
                            credentials: 'same-origin',
                            keepalive: true,
                            headers: {'Content-Type': 'application/json'},
                            body: JSON.stringify({
                                event: 'catalog_create_similar_auth_open',
                                flow_id: catalogActionInput.value,
                                event_id: 'auth-open:' + catalogActionInput.value
                            })
                        }).catch(function() {});
                    } catch (_catalogAuthEventError) {}
                }
                revealAuthEntry(mode, button.getAttribute('data-auth-return-url') || '');
            });
        });

        const textPrompt = document.getElementById('prompt');
        const textForm = document.getElementById('text-form');
        var generationGuardFormIds = ['text-form', 'image-form', 'advanced-image-form', 'advanced-image-alternative-form', 'three-image-form', 'generated-image-to-3d-form'];
        var handoffGuardFormIds = ['generated-multiview-to-3d-form'];
        var generationLockOverlay = document.getElementById('generation-lock-overlay');
        var generationLockProgress = document.getElementById('generation-lock-progress');
        var generationInteractionLocked = false;
        var generationSurveyResumeSource = "";
        var generationNavigationAllowed = false;
        // «Задача ушла в фон»: 30 s into a submitted task's wait the screen
        // offers to hide. The page keeps polling (fast delivery), stops
        // guarding navigation and never jumps to the result on its own — the
        // task tray and the account drawer carry it from there. Remembered
        // per tab and gen_id, so a reload does not bring the screen back.
        var waitBackgroundGenId = new URLSearchParams(window.location.search).get('gen_id') || '';
        var waitHiddenKey = waitBackgroundGenId ? 'aiprintgen.waitHidden:' + waitBackgroundGenId : '';
        var generationWaitHidden = false;
        var waitBackgroundTimer = null;
        try { generationWaitHidden = Boolean(waitHiddenKey) && window.sessionStorage.getItem(waitHiddenKey) === '1'; } catch (_waitHiddenError) {}
        if (generationWaitHidden) {
            document.body.classList.add('generation-wait-hidden');
            generationNavigationAllowed = true;
        }
        var generationContinuesWithoutTab = false && Boolean(document.getElementById('main-spinner'));

        function isVisibleElement(element) {
            if (!element) {
                return false;
            }
            var style = window.getComputedStyle ? window.getComputedStyle(element) : null;
            return (!style || (style.display !== 'none' && style.visibility !== 'hidden')) && element.offsetParent !== null;
        }

        function isGenerationSpinnerVisible() {
            return isVisibleElement(document.getElementById('main-spinner')) || isVisibleElement(document.getElementById('rig-spinner'));
        }

        function hasSubmittingGenerationForm() {
            for (var index = 0; index < generationGuardFormIds.length; index += 1) {
                var form = document.getElementById(generationGuardFormIds[index]);
                if (form && form.dataset.submitting === '1') {
                    return true;
                }
            }
            return false;
        }

        function isGenerationTaskActive() {
            return generationInteractionLocked || isGenerationSpinnerVisible() || hasSubmittingGenerationForm();
        }

        function updateGenerationLockProgress(progress) {
            if (!generationLockProgress) {
                return;
            }
            var numericProgress = Number(progress);
            if (!Number.isFinite(numericProgress) || numericProgress < 0) {
                generationLockProgress.textContent = '0%';
                return;
            }
            generationLockProgress.textContent = Math.min(100, Math.max(0, Math.round(numericProgress))) + '%';
        }

        function updateGenerationLockCreditStatus(refundPending) {
            var creditStatus = document.getElementById('generation-lock-credit-status');
            if (creditStatus) creditStatus.hidden = refundPending !== true;
        }

        var waitBackgroundDue = false;
        // Offered after 15 s, and only once a shown survey question is
        // answered or closed — the owner does not want it skipped by hiding.
        function revealWaitBackground() {
            var box = document.getElementById('generation-lock-background');
            var survey = window.AiprintgenGenerationSurvey;
            if (!box || !waitBackgroundDue || !generationInteractionLocked || !isGenerationSpinnerVisible()) return;
            if (survey && survey.blocking && survey.blocking()) return;
            box.hidden = false;
        }
        document.addEventListener('aiprintgen:surveysettled', revealWaitBackground);

        function armWaitBackground() {
            var box = document.getElementById('generation-lock-background');
            if (!box || waitBackgroundTimer || !waitBackgroundGenId || !isGenerationSpinnerVisible()) return;
            waitBackgroundTimer = setTimeout(function () {
                waitBackgroundDue = true;
                revealWaitBackground();
            }, 15000);
        }

        function disarmWaitBackground() {
            clearTimeout(waitBackgroundTimer);
            waitBackgroundTimer = null;
            waitBackgroundDue = false;
            var box = document.getElementById('generation-lock-background');
            if (box) box.hidden = true;
        }

        function hideGenerationWaitScreen() {
            generationWaitHidden = true;
            generationNavigationAllowed = true;
            try { if (waitHiddenKey) window.sessionStorage.setItem(waitHiddenKey, '1'); } catch (_waitHiddenError) {}
            document.body.classList.add('generation-wait-hidden');
            deactivateGenerationInteractionLock();
            if (window.aiprintgenTaskTray && window.aiprintgenTaskTray.release) window.aiprintgenTaskTray.release();
        }

        var generationLockHideButton = document.getElementById('generation-lock-hide');
        if (generationLockHideButton) generationLockHideButton.addEventListener('click', hideGenerationWaitScreen);

        function activateGenerationInteractionLock(surveySource) {
            var startsNewWaitSession = !generationInteractionLocked;
            generationInteractionLocked = true;
            // Sample before the overlay becomes visible so its four cards do not
            // visibly rebuild. Repeated show/progress calls keep the same set.
            if (startsNewWaitSession && window.aiprintgenStartGenTipsSession) {
                try {
                    window.aiprintgenStartGenTipsSession();
                } catch (tipsError) {
                    console.warn('Could not prepare generation tips', tipsError);
                }
            }
            if (startsNewWaitSession) updateGenerationLockCreditStatus(false);
            document.body.classList.add('generation-lock-active');
            if (generationLockOverlay) {
                generationLockOverlay.setAttribute('aria-hidden', 'false');
            }
            document.dispatchEvent(new CustomEvent('aiprintgen:generationlockchange'));
            armWaitBackground();
            // Re-sync the in-overlay notify opt-in to the live state each time the
            // modal is shown (subscription may have changed since page load).
            if (window.syncGenNotifyOptIn) { window.syncGenNotifyOptIn(); }
            if (window.AiprintgenGenerationSurvey) {
                window.AiprintgenGenerationSurvey.start(surveySource);
            }
        }

        function deactivateGenerationInteractionLock() {
            disarmWaitBackground();
            if (window.AiprintgenGenerationSurvey) window.AiprintgenGenerationSurvey.stop();
            var endsWaitSession = generationInteractionLocked;
            generationInteractionLocked = false;
            if (endsWaitSession && window.aiprintgenStopGenTipsSession) {
                try {
                    window.aiprintgenStopGenTipsSession();
                } catch (tipsError) {
                    console.warn('Could not stop generation tips', tipsError);
                }
            }
            document.body.classList.remove('generation-lock-active');
            if (generationLockOverlay) {
                generationLockOverlay.setAttribute('aria-hidden', 'true');
            }
            document.dispatchEvent(new CustomEvent('aiprintgen:generationlockchange'));
        }

        // Экран ожидания — общий. Вкладки со своими долгими шагами (ложемент,
        // поверхность в конструкторе подставок) показывают его через этот хук,
        // а не рисуют собственный: пользователь видит один и тот же блокирующий
        // экран со слайдером возможностей, где бы он ни ждал. Функции живут в
        // этом IIFE, поэтому наружу отдаётся узкий фасад.
        window.AiprintgenGenerationLock = {
            show: function (options) {
                var settings = options || {};
                var titleEl = document.getElementById('generation-lock-title');
                var bodyEl = document.getElementById('generation-lock-body');
                if (titleEl) {
                    if (!titleEl.dataset.defaultText) {
                        titleEl.dataset.defaultText = titleEl.textContent;
                    }
                    titleEl.textContent = settings.title || titleEl.dataset.defaultText;
                }
                if (bodyEl) {
                    if (!bodyEl.dataset.defaultText) {
                        bodyEl.dataset.defaultText = bodyEl.textContent;
                    }
                    bodyEl.textContent = settings.body || bodyEl.dataset.defaultText;
                }
                activateGenerationInteractionLock(settings.surveySource);
            },
            hide: function () {
                deactivateGenerationInteractionLock();
                ['generation-lock-title', 'generation-lock-body'].forEach(function (id) {
                    var element = document.getElementById(id);
                    if (element && element.dataset.defaultText) {
                        element.textContent = element.dataset.defaultText;
                    }
                });
            },
            complete: function () {
                var hide = function () { window.AiprintgenGenerationLock.hide(); };
                if (window.AiprintgenGenerationSurvey) return window.AiprintgenGenerationSurvey.finish(hide);
                hide();
                return false;
            },
            progress: function (value) {
                updateGenerationLockProgress(value);
            },
            allowServerNavigation: function () {
                // A long-running submit is protected until the server gives
                // us a destination.  From that point the next page either
                // reconnects to the durable job or renders the terminal
                // submit response, so our own navigation must not trigger
                // the leave-page warning or rotate its browser scope.
                preserveScopedGenerationStateForNavigation();
            }
        };

        function showGenerationTipsPreview() {
            window.AiprintgenGenerationLock.show({
                title: "\u0421\u0442\u0435\u043d\u0434 \u043a\u0430\u0440\u0442\u043e\u0447\u0435\u043a \u0441\u043b\u0430\u0439\u0434\u0435\u0440\u0430",
                body: "\u0412\u0441\u0435 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0438 \u0442\u0435\u043a\u0443\u0449\u0435\u0439 \u043b\u043e\u043a\u0430\u043b\u0438. \u041b\u0438\u0441\u0442\u0430\u0439\u0442\u0435 \u0441\u0442\u0440\u0435\u043b\u043a\u0430\u043c\u0438, \u0442\u043e\u0447\u043a\u0430\u043c\u0438 \u0438\u043b\u0438 \u0441\u0432\u0430\u0439\u043f\u043e\u043c."
            });
        }

        function resetGenerationSubmitGuard(formId) {
            var form = document.getElementById(formId);
            if (!form) {
                return;
            }
            form.dataset.submitting = '0';
            var submitButtons = form.querySelectorAll('button[type="submit"]');
            submitButtons.forEach(function(button) {
                var baseDisabled = button.dataset.guardBaseDisabled === '1';
                var lockedByGuard = button.dataset.guardLocked === '1';
                if (lockedByGuard && !baseDisabled) {
                    button.disabled = false;
                }
                button.dataset.guardLocked = '0';
            });
        }

        function bindGenerationSubmitGuard(formId) {
            var form = document.getElementById(formId);
            if (!form) {
                return;
            }
            var pendingSubmitSpinner = document.getElementById('pending-submit-spinner');
            var submitButtons = form.querySelectorAll('button[type="submit"]');
            submitButtons.forEach(function(button) {
                if (!button.dataset.guardBaseDisabled) {
                    button.dataset.guardBaseDisabled = button.disabled ? '1' : '0';
                }
                if (!button.dataset.guardLocked) {
                    button.dataset.guardLocked = '0';
                }
            });
            resetGenerationSubmitGuard(formId);
            form.addEventListener('submit', function(event) {
                if (form.dataset.submitting === '1') {
                    event.preventDefault();
                    return;
                }
                form.dataset.submitting = '1';
                // This submit IS the navigation: the browser is about to POST
                // and render the server's redirect.  The unload guard exists
                // to protect a generation that is already running in THIS tab,
                // so it must not fire on the handoff we start ourselves —
                // otherwise every submit raises the browser's "Leave site?"
                // dialog, the page never navigates, and the lock overlay sits
                // at 0% until the user confirms leaving (regression 2026-08-28,
                // when the guard widened from "spinner visible" to
                // isGenerationTaskActive(), which the line above makes true).
                // Same contract the bas-relief fetch flow gets via
                // AiprintgenGenerationLock.allowServerNavigation().
                preserveScopedGenerationStateForNavigation();
                // Keep the clicked submitter enabled until the browser has
                // serialized the form.  Disabling it synchronously here
                // removes its name/value from the POST body, which makes an
                // explicit image submit look like a legacy programmatic one.
                // The synchronous dataset flag above already rejects a
                // second submit; this deferred change is only visual state.
                window.setTimeout(function() {
                    if (form.dataset.submitting !== '1') {
                        return;
                    }
                    submitButtons.forEach(function(button) {
                        if (button.dataset.guardBaseDisabled === '1') {
                            return;
                        }
                        button.dataset.guardLocked = '1';
                        button.disabled = true;
                    });
                }, 0);
                if (pendingSubmitSpinner && !document.getElementById('main-spinner')) {
                    pendingSubmitSpinner.style.display = 'block';
                }
                updateGenerationLockProgress(0);
                var unfilteredControl = form.querySelector('.unfiltered-mode-checkbox:checked,.max-quality-mode-checkbox:checked');
                var waitMode = unfilteredControl && unfilteredControl.name === 'max_quality'
                    ? 'max-quality' : 'unfiltered';
                var alternativeRetry = form.id === 'advanced-image-alternative-form';
                // Native POSTs may redirect at any time. Offer the survey on
                // the durable polling page, where result navigation can wait
                // for the answer; never consume it during the upload handoff.
                if (alternativeRetry && window.AiprintgenGenerationLock) {
                    window.AiprintgenGenerationLock.show({
                        title: form.getAttribute('data-alternative-wait-title') || '',
                        body: form.getAttribute('data-alternative-wait-body') || ''
                    });
                } else if (unfilteredControl && window.AiprintgenGenerationLock) {
                    window.AiprintgenGenerationLock.show({
                        title: form.getAttribute('data-' + waitMode + '-wait-title') || '',
                        body: form.getAttribute('data-' + waitMode + '-wait-body') || ''
                    });
                } else {
                    activateGenerationInteractionLock();
                }
            });
        }

        function lockGenerationSubmitGuard(formId) {
            var form = document.getElementById(formId);
            if (!form) {
                return;
            }
            form.dataset.submitting = '1';
            var submitButtons = form.querySelectorAll('button[type="submit"]');
            submitButtons.forEach(function(button) {
                if (!button.dataset.guardBaseDisabled) {
                    button.dataset.guardBaseDisabled = button.disabled ? '1' : '0';
                }
                if (button.dataset.guardBaseDisabled === '1') {
                    return;
                }
                button.dataset.guardLocked = '1';
                button.disabled = true;
            });
        }

        generationGuardFormIds.forEach(bindGenerationSubmitGuard);
        handoffGuardFormIds.forEach(function(formId) {
            var form = document.getElementById(formId);
            if (!form) {
                return;
            }
            var submitButtons = form.querySelectorAll('button[type="submit"]');
            form.addEventListener('submit', function(event) {
                if (form.dataset.submitting === '1') {
                    event.preventDefault();
                    return;
                }
                form.dataset.submitting = '1';
                submitButtons.forEach(function(button) {
                    button.disabled = true;
                });
            });
        });
        window.addEventListener('pageshow', function(event) {
            // bfcache restore: the browser brought us back to a cached page
            // (typical back/forward navigation). The cached DOM may not
            // reflect an in-flight generation that the server now knows
            // about — without a fresh request, our pending_generation_for_resume
            // redirect on the server can't run, the interaction lock turns
            // off, and the user can fire another submit while the previous
            // task is still mid-flight on Tripo (orphaning its credit).
            // Force a hard reload so the server gets to redirect us back
            // to /gen_*?gen_id=X if there's still a pending generation.
            if (event.persisted) {
                window.location.reload();
                return;
            }
            generationGuardFormIds.forEach(resetGenerationSubmitGuard);
            handoffGuardFormIds.forEach(function(formId) {
                var form = document.getElementById(formId);
                if (!form) {
                    return;
                }
                form.dataset.submitting = '0';
                form.querySelectorAll('button[type="submit"]').forEach(function(button) {
                    button.disabled = false;
                });
            });
            var pendingSubmitSpinner = document.getElementById('pending-submit-spinner');
            if (pendingSubmitSpinner && !document.getElementById('main-spinner')) {
                pendingSubmitSpinner.style.display = 'none';
            }
            if (window.aiprintgenGenTipsPreviewAll) {
                showGenerationTipsPreview();
                return;
            }
            if (isGenerationSpinnerVisible()) {
                activateGenerationInteractionLock(generationSurveyResumeSource);
            } else {
                deactivateGenerationInteractionLock();
            }
        });
        // Opening this local-only URL provides a zero-credit WYSIWYG stand:
        //   http://localhost:8080/?gen_tips_preview=all
        // All cards are rendered in configured order. The pageshow branch
        // above keeps the stand open after the browser finishes restoring UI.
        if (window.aiprintgenGenTipsPreviewAll) {
            showGenerationTipsPreview();
        } else if (isGenerationSpinnerVisible()) {
            generationGuardFormIds.forEach(lockGenerationSubmitGuard);
            activateGenerationInteractionLock(generationSurveyResumeSource);
        }

        var generatedModelPublicId = "";
        window.aiprintgenPartnerModelId = generatedModelPublicId;
        var generatedModelInChallenge = false;
        var generatedModelSource = "";
        
        
        var generatedModelProvider = "";
        var alternativeProviderPreviewAzimuthDeg = -55;
        var challengeOptinInputs = Array.prototype.slice.call(document.querySelectorAll('input[name="participate_in_challenge"]'));
        var challengeOptinStorageKey = 'challengeOptinCheckedV1';
        var challengeOptinGoalKey = 'challenge_optin_checked_v1';

        function buildChallengeGoalParams(sourceType, extraParams) {
            var params = {
                placement: 'generator',
                source_type: sourceType || 'unknown',
                challenge_slug: "wrong_reality_april_2026"
            };
            if (extraParams && typeof extraParams === 'object') {
                Object.keys(extraParams).forEach(function(key) {
                    params[key] = extraParams[key];
                });
            }
            return params;
        }

        function detectChallengeSourceFromForm(form) {
            if (!form) {
                return 'unknown';
            }
            if (form.id === 'text-form') {
                return 'text';
            }
            if (form.id === 'image-form') {
                return 'image';
            }
            if (form.id === 'three-image-form') {
                return 'multiview';
            }
            return 'unknown';
        }

        function detectChallengeSourceFromInput(input) {
            return detectChallengeSourceFromForm(input ? input.closest('form') : null);
        }

        function formHasChallengeOptin(form) {
            if (!form) {
                return false;
            }
            var input = form.querySelector('input[name="participate_in_challenge"]');
            return !!(input && input.checked);
        }

        function trackChallengeGoal(goal, params) {
            if (window.AiprintgenAnalytics) {
                window.AiprintgenAnalytics.mirror(goal, params);
            }
        }

        function trackChallengeGoalOnce(storageKey, goal, params) {
            if (window.AiprintgenAnalytics) {
                window.AiprintgenAnalytics.mirrorOnce(storageKey, goal, params);
            }
        }

        if (generatedModelInChallenge && generatedModelPublicId) {
            trackChallengeGoalOnce(
                'challenge_entry_created_' + generatedModelPublicId,
                'challenge_entry_created',
                buildChallengeGoalParams(generatedModelSource, {
                    entry_mode: 'new_generation',
                    public_id: generatedModelPublicId
                })
            );
        }

        function setChallengeOptinState(nextChecked) {
            challengeOptinInputs.forEach(function(input) {
                input.checked = !!nextChecked;
            });
        }

        function readPersistedChallengeOptinState() {
            try {
                var localValue = localStorage.getItem(challengeOptinStorageKey);
                if (localValue !== null) {
                    return localValue === '1';
                }
            } catch (error) {}

            try {
                var sessionValue = sessionStorage.getItem(challengeOptinStorageKey);
                if (sessionValue !== null) {
                    try {
                        localStorage.setItem(challengeOptinStorageKey, sessionValue);
                        sessionStorage.removeItem(challengeOptinStorageKey);
                    } catch (migrationError) {}
                    return sessionValue === '1';
                }
            } catch (error) {}

            return null;
        }

        function persistChallengeOptinState(nextChecked) {
            try {
                if (nextChecked) {
                    localStorage.setItem(challengeOptinStorageKey, '1');
                } else {
                    localStorage.removeItem(challengeOptinStorageKey);
                }
            } catch (error) {}

            try {
                sessionStorage.removeItem(challengeOptinStorageKey);
            } catch (error) {}
        }

        if (challengeOptinInputs.length) {
            var initialChallengeOptinState = challengeOptinInputs.some(function(input) { return !!input.checked; });
            var storedChallengeOptinState = readPersistedChallengeOptinState();
            if (storedChallengeOptinState !== null) {
                initialChallengeOptinState = storedChallengeOptinState;
            }
            setChallengeOptinState(initialChallengeOptinState);
            persistChallengeOptinState(initialChallengeOptinState);

            challengeOptinInputs.forEach(function(input) {
                input.addEventListener('change', function() {
                    var nextChecked = !!input.checked;
                    setChallengeOptinState(nextChecked);
                    persistChallengeOptinState(nextChecked);
                    if (nextChecked) {
                        trackChallengeGoalOnce(
                            challengeOptinGoalKey,
                            'challenge_optin_checked',
                            buildChallengeGoalParams(detectChallengeSourceFromInput(input))
                        );
                    }
                });
            });
        }

        generationGuardFormIds.forEach(function(formId) {
            var form = document.getElementById(formId);
            if (!form) {
                return;
            }
            form.addEventListener('submit', function() {
                if (!formHasChallengeOptin(form)) {
                    return;
                }
                trackChallengeGoal(
                    'challenge_generation_submit',
                    buildChallengeGoalParams(detectChallengeSourceFromForm(form), {
                        entry_mode: 'new_generation'
                    })
                );
            });
        });

        if (textPrompt && textForm) {
            textPrompt.addEventListener('keydown', function(event) {
                if (event.isComposing) {
                    return;
                }
                if (event.key === 'Enter' && !event.shiftKey) {
                    event.preventDefault();
                    const submitBtn = document.getElementById('text_submit_btn');
                    if (submitBtn && !submitBtn.disabled) {
                        submitBtn.click();
                    } else if (typeof textForm.requestSubmit === 'function') {
                        textForm.requestSubmit();
                    } else {
                        textForm.submit();
                    }
                }
            });
        }
        var freeModelsStrip = document.getElementById('home-free-models-strip');
        var freeModelsViewport = document.getElementById('home-free-models-viewport');
        var freeModelsTrack = document.getElementById('home-free-models-track');
        var freeModelsPrevBtn = document.getElementById('home-free-models-prev');
        var freeModelsNextBtn = document.getElementById('home-free-models-next');
        var freeModelsEmptyText = "\u041f\u043e\u043a\u0430 \u043d\u0435\u0442 \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u044b\u0445 \u043c\u043e\u0434\u0435\u043b\u0435\u0439. \u041e\u043d\u0438 \u043f\u043e\u044f\u0432\u044f\u0442\u0441\u044f \u0437\u0434\u0435\u0441\u044c \u0441\u043a\u043e\u0440\u043e.";
        var freeModelsLoadingText = "\u0417\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u043c \u043b\u0435\u043d\u0442\u0443 \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u044b\u0445 \u043c\u043e\u0434\u0435\u043b\u0435\u0439...";
        var freeModelsFallbackTitle = "3D \u043c\u043e\u0434\u0435\u043b\u044c";
        var freeModelsDisplayLimit = 28;
        var freeModelsFetchLimit = 32;
        var freeModelsAutoPxPerSec = 100;
        var freeModelsAutoEnabled = false;
        var freeModelsAutoLoopWidth = 0;
        var freeModelsAutoRaf = null;
        var freeModelsAutoLastTs = 0;
        var freeModelsAutoPauseUntil = 0;
        var freeModelsAutoPausedByHover = false;
        var freeModelsInViewport = typeof window.IntersectionObserver !== 'function';

        function canAnimateFreeModels() {
            return freeModelsViewport && freeModelsAutoEnabled && freeModelsAutoLoopWidth > 0 &&
                freeModelsInViewport && !document.hidden &&
                !document.body.classList.contains('generation-lock-active');
        }

        function escapeHtml(value) {
            return String(value || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function setFreeModelsMessage(text) {
            if (!freeModelsTrack) {
                return;
            }
            stopFreeModelsAutoScroll();
            freeModelsAutoEnabled = false;
            freeModelsAutoLoopWidth = 0;
            freeModelsTrack.innerHTML = '<div class="home-free-models-loading">' + escapeHtml(text || freeModelsLoadingText) + '</div>';
            updateFreeModelsNavState();
        }

        function updateFreeModelsNavState() {
            if (!freeModelsViewport || !freeModelsPrevBtn || !freeModelsNextBtn) {
                return;
            }
            if (freeModelsAutoEnabled && freeModelsAutoLoopWidth > 0) {
                freeModelsPrevBtn.disabled = false;
                freeModelsNextBtn.disabled = false;
                return;
            }
            var maxScroll = Math.max(0, freeModelsViewport.scrollWidth - freeModelsViewport.clientWidth);
            var current = Math.max(0, freeModelsViewport.scrollLeft);
            var canScroll = maxScroll > 2;
            freeModelsPrevBtn.disabled = !canScroll || current <= 2;
            freeModelsNextBtn.disabled = !canScroll || current >= (maxScroll - 2);
        }

        function stopFreeModelsAutoScroll() {
            if (freeModelsAutoRaf) {
                window.cancelAnimationFrame(freeModelsAutoRaf);
                freeModelsAutoRaf = null;
            }
            freeModelsAutoLastTs = 0;
        }

        function runFreeModelsAutoScroll(ts) {
            if (!canAnimateFreeModels()) {
                stopFreeModelsAutoScroll();
                return;
            }

            if (freeModelsAutoPausedByHover || Date.now() < freeModelsAutoPauseUntil) {
                freeModelsAutoLastTs = ts;
                freeModelsAutoRaf = window.requestAnimationFrame(runFreeModelsAutoScroll);
                return;
            }

            if (!freeModelsAutoLastTs) {
                freeModelsAutoLastTs = ts;
            }
            var dt = Math.max((ts - freeModelsAutoLastTs) / 1000, 0);
            freeModelsAutoLastTs = ts;
            var step = freeModelsAutoPxPerSec * dt;
            var nextLeft = freeModelsViewport.scrollLeft + step;
            if (nextLeft >= freeModelsAutoLoopWidth) {
                nextLeft = nextLeft % freeModelsAutoLoopWidth;
            }
            freeModelsViewport.scrollLeft = nextLeft;
            freeModelsAutoRaf = window.requestAnimationFrame(runFreeModelsAutoScroll);
        }

        function ensureFreeModelsAutoScroll() {
            if (!canAnimateFreeModels()) {
                stopFreeModelsAutoScroll();
                return;
            }
            if (!freeModelsAutoRaf) {
                freeModelsAutoLastTs = 0;
                freeModelsAutoRaf = window.requestAnimationFrame(runFreeModelsAutoScroll);
            }
        }

        function pauseFreeModelsAutoScroll(ms) {
            var pauseMs = Math.max(Number(ms) || 0, 0);
            freeModelsAutoPauseUntil = Date.now() + pauseMs;
        }

        function scrollFreeModelsBy(offset) {
            if (!freeModelsViewport) {
                return;
            }
            pauseFreeModelsAutoScroll(1800);
            freeModelsViewport.scrollBy({ left: Number(offset) || 0, behavior: 'smooth' });
        }

        function normalizeFreeModels(rawModels) {
            var list = [];
            (rawModels || []).forEach(function(model) {
                if (!model || !model.public_id || !model.detail_url || !model.preview_url) {
                    return;
                }
                list.push({
                    publicId: String(model.public_id),
                    detailUrl: String(model.detail_url),
                    previewUrl: String(model.preview_url),
                    title: String(model.card_title || model.title || freeModelsFallbackTitle || '3D model').trim(),
                });
            });
            return list;
        }

        function renderFreeModels(rawModels) {
            if (!freeModelsTrack || !freeModelsViewport || !freeModelsStrip) {
                return;
            }

            var models = normalizeFreeModels(rawModels);
            if (models.length > freeModelsDisplayLimit) {
                models = models.slice(0, freeModelsDisplayLimit);
            }
            if (!models.length) {
                setFreeModelsMessage(freeModelsEmptyText);
                freeModelsStrip.classList.add('is-empty');
                return;
            }

            freeModelsStrip.classList.remove('is-empty');
            var shouldAutoScroll = models.length >= 8;
            freeModelsAutoEnabled = shouldAutoScroll;
            var renderItems = shouldAutoScroll ? models.concat(models) : models;
            var cardHtml = renderItems.map(function(model) {
                var safeTitle = escapeHtml(model.title);
                var safeDetailUrl = escapeHtml(model.detailUrl);
                var safePreviewUrl = escapeHtml(model.previewUrl);
                return (
                    '<a class="home-free-model-item" href="' + safeDetailUrl + '">' +
                        '<span class="home-free-model-thumb">' +
                            '<img src="' + safePreviewUrl + '" width="640" height="640" alt="' + safeTitle + '" loading="lazy" decoding="async" fetchpriority="low">' +
                        '</span>' +
                    '</a>'
                );
            }).join('');

            freeModelsTrack.innerHTML = cardHtml;
            window.requestAnimationFrame(function() {
                freeModelsViewport.scrollLeft = 0;
                freeModelsAutoLoopWidth = freeModelsAutoEnabled ? Math.max((freeModelsTrack.scrollWidth / 2), 0) : 0;
                updateFreeModelsNavState();
                ensureFreeModelsAutoScroll();
            });
        }

        if (freeModelsStrip && freeModelsViewport && freeModelsTrack) {
            // The full-screen wait blurs the page behind it. Moving that page
            // every frame keeps the compositor busy for the entire generation.
            document.addEventListener('aiprintgen:generationlockchange', ensureFreeModelsAutoScroll);
            document.addEventListener('visibilitychange', ensureFreeModelsAutoScroll);
            if (typeof window.IntersectionObserver === 'function') {
                new IntersectionObserver(function (entries) {
                    freeModelsInViewport = entries[0].isIntersecting;
                    ensureFreeModelsAutoScroll();
                }).observe(freeModelsStrip);
            }
            if (freeModelsPrevBtn) {
                freeModelsPrevBtn.addEventListener('click', function() {
                    scrollFreeModelsBy(-320);
                });
            }
            if (freeModelsNextBtn) {
                freeModelsNextBtn.addEventListener('click', function() {
                    scrollFreeModelsBy(320);
                });
            }
            freeModelsViewport.addEventListener('scroll', function() {
                updateFreeModelsNavState();
            }, { passive: true });
            freeModelsViewport.addEventListener('wheel', function(event) {
                if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) {
                    return;
                }
                var maxScroll = Math.max(0, freeModelsViewport.scrollWidth - freeModelsViewport.clientWidth);
                if (maxScroll <= 1) {
                    return;
                }
                var current = Math.max(0, freeModelsViewport.scrollLeft);
                var delta = Number(event.deltaY) || 0;
                var canScrollForward = delta > 0 && current < (maxScroll - 1);
                var canScrollBack = delta < 0 && current > 1;
                if (!canScrollForward && !canScrollBack) {
                    return;
                }
                event.preventDefault();
                pauseFreeModelsAutoScroll(2200);
                freeModelsViewport.scrollLeft += delta;
            }, { passive: false });
            freeModelsViewport.addEventListener('touchstart', function() {
                pauseFreeModelsAutoScroll(2800);
            }, { passive: true });
            freeModelsViewport.addEventListener('touchend', function() {
                pauseFreeModelsAutoScroll(1800);
            }, { passive: true });
            freeModelsStrip.addEventListener('mouseenter', function() {
                freeModelsAutoPausedByHover = true;
            });
            freeModelsStrip.addEventListener('mouseleave', function() {
                freeModelsAutoPausedByHover = false;
                ensureFreeModelsAutoScroll();
            });
            window.addEventListener('resize', function() {
                window.requestAnimationFrame(function() {
                    if (freeModelsAutoEnabled) {
                        freeModelsAutoLoopWidth = Math.max((freeModelsTrack.scrollWidth / 2), 0);
                    } else {
                        freeModelsAutoLoopWidth = 0;
                    }
                    updateFreeModelsNavState();
                    ensureFreeModelsAutoScroll();
                });
            });

            setFreeModelsMessage(freeModelsLoadingText);

            fetch(
                '/api/home-models?homepage_policy=1&limit=' + encodeURIComponent(String(freeModelsFetchLimit)) + '&random=1&pool_limit=' + encodeURIComponent(String(freeModelsFetchLimit)) + '&locale=' + encodeURIComponent("ru"),
                { cache: 'default' }
            )
                .then(function(response) {
                    if (!response.ok) {
                        throw new Error('Request failed');
                    }
                    return response.json();
                })
                .then(function(data) {
                    if (!data || data.success !== true || !Array.isArray(data.models)) {
                        throw new Error('Unexpected payload');
                    }
                    renderFreeModels(data.models);
                })
                .catch(function() {
                    setFreeModelsMessage(freeModelsEmptyText);
                });
        }

        // --- СКРИПТЫ ДЛЯ ОСНОВНОГО КОНТЕНТА ---
        var viewerShell = document.getElementById('3d-model-shell');
        var container = document.getElementById('3d-model-container');
        if (container && viewerShell) {
            var closeButton = document.getElementById('generator-fullscreen-close');
            var fullscreenButton = document.getElementById('gen-fullscreen-btn');
            var textureCheckbox = document.getElementById('gen-texture-toggle');
            var clayCheckbox = document.getElementById('gen-clay-toggle');
            var initialShellWidthStyle = viewerShell.style.width || '';
            var initialShellHeightStyle = viewerShell.style.height || '';
            var initialShellMaxWidthStyle = viewerShell.style.maxWidth || '';
            var initialContainerWidthStyle = container.style.width || '';
            var initialContainerMaxWidthStyle = container.style.maxWidth || '';
            var initialContainerHeightStyle = container.style.height || '';
            var initialContainerMinHeightStyle = container.style.minHeight || '';

            var scene = new THREE.Scene();
            scene.background = new THREE.Color(0xf5f2eb); // warm-paper-v1: тот же цвет, что подложка превью
            // A portrait relief must stay parallel to the image plane. The
            // ordinary perspective camera can make a face above the plate's
            // centre look as if it were viewed from below.
            var useOrthographicCamera = false;
            var camera = AIprintgenViewerStandard.createCamera({
                orthographic: useOrthographicCamera,
                fov: 75,
                near: 0.1,
                far: 1000
            });
            var renderer = new THREE.WebGLRenderer({ antialias: true });
            AIprintgenViewerStandard.configureRenderer(renderer);
            renderer.setSize(1, 1, false);
            renderer.domElement.style.width = '100%';
            renderer.domElement.style.height = '100%';
            renderer.domElement.style.display = 'block';
            container.appendChild(renderer.domElement);

            var studioLights = AIprintgenViewerStandard.addStudioLights(scene, camera);

            var gltfScene = null;
            var loader = new THREE.GLTFLoader();
            if (typeof MeshoptDecoder !== 'undefined' && typeof loader.setMeshoptDecoder === 'function') {
                loader.setMeshoptDecoder(MeshoptDecoder);
            }
            var controls = new THREE.FreeOrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            controls.dampingFactor = 0.25;
            camera.position.z = 1;

            function updateAppearanceState() {
                var clayEnabled = !!(clayCheckbox && clayCheckbox.checked);
                if (viewerShell) viewerShell.classList.toggle('viewer-clay-active', clayEnabled);
                if (textureCheckbox) {
                    textureCheckbox.disabled = clayEnabled;
                }
                AIprintgenViewerStandard.applyModelAppearance(gltfScene, {
                    texturesEnabled: !textureCheckbox || textureCheckbox.checked,
                    clayEnabled: clayEnabled
                });
                AIprintgenViewerStandard.applySceneAppearance(scene, studioLights, {
                    clayEnabled: clayEnabled
                });
                requestViewerRender();
            }

            function updateViewerSize() {
                var rect = container.getBoundingClientRect();
                var width = Math.max(Math.floor(rect.width || container.clientWidth || 0), 320);
                var height = Math.max(Math.floor(rect.height || container.clientHeight || 0), 240);
                renderer.setSize(width, height, false);
                AIprintgenViewerStandard.updateCameraViewport(camera, width, height);
                requestViewerRender();
            }

            function scheduleViewerSizeUpdate() {
                requestAnimationFrame(function() {
                    requestAnimationFrame(function() {
                        updateViewerSize();
                    });
                });
            }

            function getFullscreenElement() {
                return document.fullscreenElement || document.webkitFullscreenElement || document.msFullscreenElement || document.mozFullScreenElement || null;
            }

            function enterFullscreen() {
                if (viewerShell.requestFullscreen) {
                    viewerShell.requestFullscreen();
                } else if (viewerShell.webkitRequestFullscreen) {
                    viewerShell.webkitRequestFullscreen();
                } else if (viewerShell.msRequestFullscreen) {
                    viewerShell.msRequestFullscreen();
                } else if (viewerShell.mozRequestFullScreen) {
                    viewerShell.mozRequestFullScreen();
                }
            }

            function exitFullscreen() {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                } else if (document.webkitExitFullscreen) {
                    document.webkitExitFullscreen();
                } else if (document.msExitFullscreen) {
                    document.msExitFullscreen();
                } else if (document.mozCancelFullScreen) {
                    document.mozCancelFullScreen();
                }
            }

            function onFullscreenChange() {
                var fsElement = getFullscreenElement();
                var active = fsElement === viewerShell;
                viewerShell.classList.toggle('is-fullscreen', active);
                if (closeButton) {
                    closeButton.style.display = active ? 'flex' : 'none';
                }
                if (active) {
                    viewerShell.style.width = '100vw';
                    viewerShell.style.height = '100vh';
                    viewerShell.style.maxWidth = 'none';
                    container.style.width = '100%';
                    container.style.maxWidth = 'none';
                    container.style.height = '100%';
                    container.style.minHeight = '0';
                } else {
                    viewerShell.style.width = initialShellWidthStyle;
                    viewerShell.style.height = initialShellHeightStyle;
                    viewerShell.style.maxWidth = initialShellMaxWidthStyle;
                    container.style.width = initialContainerWidthStyle;
                    container.style.maxWidth = initialContainerMaxWidthStyle;
                    container.style.height = initialContainerHeightStyle;
                    container.style.minHeight = initialContainerMinHeightStyle;
                }
                scheduleViewerSizeUpdate();
            }

            var viewerFrame = null;
            var viewerInViewport = typeof window.IntersectionObserver !== 'function';
            function canRenderViewer() {
                return viewerInViewport && !document.hidden &&
                    !document.body.classList.contains('generation-lock-active');
            }
            function renderViewerFrame() {
                viewerFrame = null;
                if (!canRenderViewer()) return;
                var moving = controls.update();
                renderer.render(scene, camera);
                if (gltfScene && window.AiprintgenProduct) window.AiprintgenProduct.rendered(container, Object.assign({}, window.aiprintgenAnalyticsContext || {}, {render_proof: 'viewer_first_frame'}));
                if (moving) requestViewerRender();
            }
            function requestViewerRender() {
                if (viewerFrame === null && canRenderViewer()) {
                    viewerFrame = requestAnimationFrame(renderViewerFrame);
                }
            }
            function syncViewerRendering() {
                if (viewerFrame !== null) cancelAnimationFrame(viewerFrame);
                viewerFrame = null;
                requestViewerRender();
            }
            controls.addEventListener('change', requestViewerRender);
            document.addEventListener('visibilitychange', syncViewerRendering);
            document.addEventListener('aiprintgen:generationlockchange', syncViewerRendering);
            AIprintgenViewerStandard.bindSceneTheme(scene, {render: requestViewerRender});
            if (typeof window.IntersectionObserver === 'function') {
                new IntersectionObserver(function (entries) {
                    viewerInViewport = entries[0].isIntersecting;
                    syncViewerRendering();
                }).observe(viewerShell);
            }
            requestViewerRender();

            // warm-paper-v1: снимаем превью из уже загруженной сцены. Ждём
            // idle, чтобы не конкурировать с первым кадром вьювера, и не
            // снимаем в clay-режиме — превью должно быть с текстурами.
            function scheduleWarmPaperPreviewCapture(loadedScene) {
                if (!generatedModelPublicId || !loadedScene) {
                    return;
                }
                // A split keeps the source model's established thumbnail. Its
                // geometry is only separated internally, so a second capture
                // would needlessly replace a familiar preview and can expose
                // a provider-specific axis convention.
                if (generatedModelSource === 'split' || generatedModelSource === 'basrelief') {
                    return;
                }
                if (!window.AIprintgenPreviewCapture || !window.AIprintgenPreviewCapture.isSupported()) {
                    return;
                }
                if (clayCheckbox && clayCheckbox.checked) {
                    return;
                }
                var start = function () {
                    if (loadedScene !== gltfScene) return;
                    window.AIprintgenPreviewCapture.captureAndUpload({
                        scene: scene,
                        object3D: loadedScene,
                        publicId: generatedModelPublicId,
                        csrfToken: "-gPzKf8lCJcmeWfVZd70ci4PytFx0P_nz8ujlXEmw3w",
                        azimuthDeg: generatedModelProvider === 'aiprintgen'
                            ? alternativeProviderPreviewAzimuthDeg : 35
                    });
                };
                if (window.requestIdleCallback) {
                    requestIdleCallback(start, { timeout: 4000 });
                } else {
                    setTimeout(start, 1200);
                }
            }

            
                console.warn('temp_dir not found in session, model will not be loaded');
            

            if (fullscreenButton) {
                fullscreenButton.addEventListener('click', function () {
                    if (getFullscreenElement() === viewerShell) {
                        exitFullscreen();
                    } else {
                        enterFullscreen();
                    }
                });
            }
            if (closeButton) {
                closeButton.addEventListener('click', function() {
                    exitFullscreen();
                });
            }
            if (textureCheckbox) {
                textureCheckbox.addEventListener('change', function () {
                    updateAppearanceState();
                });
            }
            if (clayCheckbox) {
                clayCheckbox.addEventListener('change', function () {
                    updateAppearanceState();
                });
            }

            window.addEventListener('resize', scheduleViewerSizeUpdate);
            document.addEventListener('fullscreenchange', onFullscreenChange);
            document.addEventListener('webkitfullscreenchange', onFullscreenChange);
            document.addEventListener('msfullscreenchange', onFullscreenChange);
            document.addEventListener('mozfullscreenchange', onFullscreenChange);
            scheduleViewerSizeUpdate();
        }
        var downloadBtn = document.getElementById('download-btn');
        // Ползунок миллиметров бессмысленен для GLB (он всегда в исходном
        // масштабе), для текстуры и карты высот — это картинки, а не геометрия.
        function sizelessDownloadFormat(value) {
            var format = (value || '').toLowerCase();
            return format === 'glb' || format === 'texture' || format === 'heightmap';
        }
        // stl/obj/fbx are converted from GLB on the server, which can take
        // minutes for high-poly models. Instead of navigating straight to
        // /download (a silent request the user retries, stacking duplicate
        // conversions), we start a background job via /download_prepare, show
        // ticking progress on the button, poll /download_status, and only
        // navigate once the file is cached and streams instantly.
        // texture тут нет намеренно: картинка достаётся из GLB мгновенно и
        // качается прямой ссылкой, без фоновой джобы и опроса статуса.
        var downloadAsyncFormats = { stl: true, obj: true, objzip: true, fbx: true, '3mf': true, heightmap: true, stlstandard: true };
        var downloadPreparingLabel = "\u0413\u043e\u0442\u043e\u0432\u0438\u043c \u0444\u0430\u0439\u043b\u2026";
        var downloadFailedLabel = "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u0442\u044c \u0444\u0430\u0439\u043b. \u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451 \u0440\u0430\u0437.";
        var downloadReadyLabels = {
            title: "\u0424\u0430\u0439\u043b \u0433\u043e\u0442\u043e\u0432",
            action: "\u0421\u043a\u0430\u0447\u0430\u0442\u044c",
            recovery: "\u0415\u0441\u043b\u0438 \u0444\u0430\u0439\u043b \u043d\u0435 \u0441\u043a\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0438\u043b\u0438 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0430 \u043f\u0440\u0435\u0440\u0432\u0430\u043b\u0430\u0441\u044c, \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0434\u0440\u0443\u0433\u043e\u0439 \u0441\u043f\u043e\u0441\u043e\u0431.",
            recoveryAction: "\u0421\u043a\u0430\u0447\u0430\u0442\u044c \u0434\u0440\u0443\u0433\u0438\u043c \u0441\u043f\u043e\u0441\u043e\u0431\u043e\u043c",
            originStarted: "\u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0438 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0430.",
            close: "\u0417\u0430\u043a\u0440\u044b\u0442\u044c"
        };
        var downloadPrepareActive = false;
        var downloadOriginFallback = document.getElementById('download-origin-fallback');

        function stableStlDownloadUrl(downloadUrl, format, available) {
            if (!available || ['stl', 'objzip', '3mf'].indexOf(format) === -1 || !window.URL) {
                return downloadUrl;
            }
            var parsed = new URL(downloadUrl, window.location.origin);
            if (!parsed.searchParams.has('delivery') && !parsed.searchParams.has('stream')) {
                // Keep the same raw byte representation if a local transfer
                // needs a Range retry, while still allowing a fresh request to
                // use the GCS redirect when the pilot is enabled.
                parsed.searchParams.set('delivery', 'auto');
            }
            return parsed.pathname + parsed.search + parsed.hash;
        }

        function hideOriginDownloadFallback() {
            if (!downloadOriginFallback) { return; }
            downloadOriginFallback.style.display = 'none';
            downloadOriginFallback.removeAttribute('href');
        }

        function showOriginDownloadFallback(downloadUrl, format, available) {
            if (!available || !downloadOriginFallback || ['glb', 'stl', 'objzip', '3mf'].indexOf(format) === -1 || !window.URL) { return; }
            var parsed = new URL(downloadUrl, window.location.origin);
            parsed.searchParams.set('delivery', 'app');
            downloadOriginFallback.href = parsed.pathname + parsed.search + parsed.hash;
            downloadOriginFallback.style.display = 'inline-flex';
        }

        function startPreparedFileDownload(downloadUrl) {
            // Keep the generator page (and its same-origin rescue link) alive
            // if an ISP/DNS failure happens after our 302 to GCS. An attachment
            // response still opens the browser's normal download UI.
            var frame = document.createElement('iframe');
            frame.hidden = true;
            frame.setAttribute('aria-hidden', 'true');
            frame.tabIndex = -1;
            frame.src = downloadUrl;
            document.body.appendChild(frame);
        }

        function handOverPreparedDownload(downloadUrl) {
            // The file became ready after an async wait, outside the click:
            // download_handoff.js decides whether the browser takes it silently.
            var handoff = window.AiprintgenDownloadHandoff;
            if (!handoff) { startPreparedFileDownload(downloadUrl); return; }
            handoff.deliver(downloadUrl, startPreparedFileDownload, downloadReadyLabels);
        }

        if (downloadOriginFallback) {
            downloadOriginFallback.addEventListener('click', function (event) {
                event.preventDefault();
                if (downloadOriginFallback.getAttribute('href')) {
                    if (window.AiprintgenDownloadHandoff) {
                        window.AiprintgenDownloadHandoff.rememberOriginDelivery();
                        window.AiprintgenDownloadHandoff.noteStarted();
                    }
                    startPreparedFileDownload(downloadOriginFallback.href);
                }
            });
        }

        function triggerPreparedDownload(downloadUrl) {
            if (downloadPrepareActive) return;
            var formatMatch = downloadUrl.match(/\/download\/([a-z0-9]+)/i);
            var format = formatMatch ? formatMatch[1].toLowerCase() : '';
            var product = window.AiprintgenProduct, operation = product && product.downloadStart(format === 'objzip' ? 'zip' : format);
            if (product) downloadUrl = product.downloadUrl(downloadUrl, operation);
            var exportSeen = false;
            function acceptedExport(status) {
                if (product && !exportSeen && status && status.export_id) {
                    exportSeen = true;
                    operation.export_id = status.export_id;
                    downloadUrl = product.downloadUrl(downloadUrl, operation);
                    product.track('export_requested', Object.assign({}, operation, {execution_location: 'server'}), operation.delivery_id);
                }
            }
            hideOriginDownloadFallback();
            if (!downloadAsyncFormats[format] || !window.fetch) {
                showOriginDownloadFallback(downloadUrl, format, format === 'glb');
                handOverPreparedDownload(downloadUrl);
                return;
            }
            if (downloadPrepareActive) {
                return;
            }
            downloadPrepareActive = true;
            var originalHtml = downloadBtn.innerHTML;
            var startedAt = Date.now();
            var downloadProgressState = 'preparing';
            var downloadProgressValue = 0;
            var generationLock = window.AiprintgenGenerationLock || null;
            var generationLockShown = false;
            downloadBtn.disabled = true;
            downloadBtn.textContent = downloadPreparingLabel;

            function updateGenerationDownloadProgress(state, serverElapsedSeconds) {
                if (state) { downloadProgressState = state; }
                if (!generationLockShown || !generationLock || typeof generationLock.progress !== 'function') {
                    return;
                }
                var clientElapsedSeconds = Math.max(0, (Date.now() - startedAt) / 1000);
                var serverElapsed = Number(serverElapsedSeconds);
                var elapsedSeconds = Number.isFinite(serverElapsed)
                    ? Math.max(clientElapsedSeconds, serverElapsed)
                    : clientElapsedSeconds;
                // Download jobs expose a phase and elapsed time, not a true
                // percentage. Keep the standard wait screen moving without
                // claiming completion before the server confirms it.
                var estimated = Math.min(94, 5 + Math.floor(Math.sqrt(elapsedSeconds) * 2.6));
                var phaseFloor = 5;
                if (downloadProgressState === 'queued') { phaseFloor = 8; }
                if (downloadProgressState === 'running') { phaseFloor = 20; }
                if (downloadProgressState === 'committing') { phaseFloor = 92; }
                if (downloadProgressState === 'postprocessing') { phaseFloor = 96; }
                if (downloadProgressState === 'done') { phaseFloor = 100; }
                var nextProgress = downloadProgressState === 'done'
                    ? 100
                    : Math.min(96, Math.max(estimated, phaseFloor));
                downloadProgressValue = Math.max(downloadProgressValue, nextProgress);
                try { generationLock.progress(downloadProgressValue); } catch (e) {}
            }

            function showGenerationDownloadLock() {
                if (!generationLock || typeof generationLock.show !== 'function') { return; }
                generationLockShown = true;
                try {
                    generationLock.show({ title: downloadPreparingLabel });
                    updateGenerationDownloadProgress('preparing');
                } catch (e) {}
            }

            function hideGenerationDownloadLock() {
                if (!generationLockShown || !generationLock) { return; }
                generationLockShown = false;
                if (typeof generationLock.hide === 'function') {
                    try { generationLock.hide(); } catch (e) {}
                }
            }

            showGenerationDownloadLock();
            var labelTimer = setInterval(function () {
                var seconds = Math.round((Date.now() - startedAt) / 1000);
                downloadBtn.textContent = downloadPreparingLabel + ' ' + seconds + 's';
                updateGenerationDownloadProgress();
            }, 1000);
            var pollTimer = 0;
            var pollPending = false;
            var pendingPollCount = 0;
            var statusInFlight = false;
            var prepareInFlight = true;
            var resumeStatusCheckRequired = false;
            var pollFinished = false;
            function clearPollTimer() {
                if (pollTimer) {
                    window.clearTimeout(pollTimer);
                    pollTimer = 0;
                }
            }
            function handlePollVisibilityChange() {
                if (pollFinished) { return; }
                if (document.hidden) {
                    clearPollTimer();
                    pollPending = true;
                    resumeStatusCheckRequired = true;
                    return;
                }
                requestResumeStatusCheck();
            }
            function requestResumeStatusCheck() {
                if (pollFinished) { return; }
                resumeStatusCheckRequired = true;
                pollPending = true;
                clearPollTimer();
                if (document.hidden || prepareInFlight || statusInFlight) { return; }
                resumeStatusCheckRequired = false;
                pollPending = false;
                // The conversion may have completed while the tab was
                // frozen. Observe it once before wall-clock expiry.
                poll(true);
            }
            document.addEventListener('visibilitychange', handlePollVisibilityChange);
            function finish(ok, knownFailure) {
                if (pollFinished) { return; }
                pollFinished = true;
                if (!ok && knownFailure && product) product.track('download_failed', Object.assign({}, operation, {error_code: 'download_preparation_failed', error_stage: 'delivery', retryability: 'unsafe_unknown_outcome'}), operation.delivery_id);
                if (ok) { updateGenerationDownloadProgress('done'); }
                clearInterval(labelTimer);
                clearPollTimer();
                pollPending = false;
                resumeStatusCheckRequired = false;
                document.removeEventListener('visibilitychange', handlePollVisibilityChange);
                downloadBtn.disabled = false;
                downloadBtn.innerHTML = originalHtml;
                downloadPrepareActive = false;
                hideGenerationDownloadLock();
                if (!ok) {
                    alert(downloadFailedLabel);
                }
            }
            var statusUrl = downloadUrl.replace('/download/', '/download_status/');
            function fetchJsonWithTimeout(url) {
                return new Promise(function (resolve, reject) {
                    var controller = typeof window.AbortController === 'function'
                        ? new window.AbortController()
                        : null;
                    var requestOptions = { credentials: 'same-origin' };
                    if (controller) { requestOptions.signal = controller.signal; }
                    var requestTimer = window.setTimeout(function () {
                        if (controller) { controller.abort(); }
                        reject(new Error('download status timeout'));
                    }, 30000);
                    fetch(url, requestOptions)
                        .then(function (response) { return response.json(); })
                        .then(function (payload) {
                            window.clearTimeout(requestTimer);
                            resolve(payload);
                        }, function (error) {
                            window.clearTimeout(requestTimer);
                            reject(error);
                        });
                });
            }
            // Mirrors AsyncDownload.showPrintCheckNote (async_download.js is not
            // loaded on the generator page — this poll loop is its inline twin).
            // Upgrades the static under-viewer note (rendered only for
            // purpose=3d_print generations) to the verified verdict in place.
            function showPrintCheck(status) {
                var pc = status.print_check;
                var note = document.getElementById('print-check-note');
                if (!pc || !pc.line || !note) { return; }
                note.style.color = pc.status === 'warn' ? '#9a6700' : '#2e7d32';
                note.textContent = pc.line;
            }
            function nextPollDelay() {
                pendingPollCount += 1;
                if (pendingPollCount <= 3) { return 2500; }
                if (pendingPollCount <= 6) { return 5000; }
                return 10000;
            }
            function schedulePoll(immediate) {
                if (pollFinished) { return; }
                pollPending = true;
                clearPollTimer();
                if (document.hidden) { return; }
                var delay = immediate ? 0 : nextPollDelay();
                pollTimer = window.setTimeout(function () {
                    pollTimer = 0;
                    if (pollFinished || document.hidden) { return; }
                    pollPending = false;
                    poll(false);
                }, delay);
            }
            function poll(forceStatusCheck) {
                if (pollFinished) { return; }
                if (document.hidden) {
                    pollPending = true;
                    resumeStatusCheckRequired = true;
                    return;
                }
                if (statusInFlight) {
                    if (forceStatusCheck) { resumeStatusCheckRequired = true; }
                    return;
                }
                function deadlineExceeded() {
                    return Date.now() - startedAt > 20 * 60 * 1000;
                }
                if (!forceStatusCheck && deadlineExceeded()) {
                    finish(false);
                    return;
                }
                statusInFlight = true;
                updateGenerationDownloadProgress('running');
                fetchJsonWithTimeout(statusUrl)
                    .then(function (status) {
                        statusInFlight = false;
                        if (pollFinished) { return; }
                        acceptedExport(status);
                        updateGenerationDownloadProgress(status.state, status.elapsed_s);
                        if (status.state === 'done') {
                            finish(true);
                            showPrintCheck(status);
                            var finalDownloadUrl = stableStlDownloadUrl(
                                downloadUrl, format, status.origin_fallback_available === true
                            );
                            showOriginDownloadFallback(
                                finalDownloadUrl, format, status.origin_fallback_available === true
                            );
                            handOverPreparedDownload(finalDownloadUrl);
                        } else if (status.state === 'error') {
                            finish(false, true);
                        } else if (resumeStatusCheckRequired) {
                            // Visibility only invalidates a non-terminal state;
                            // an authoritative done/error needs no extra poll.
                            requestResumeStatusCheck();
                        } else if (deadlineExceeded()) {
                            finish(false);
                        } else {
                            schedulePoll(false);
                        }
                    })
                    .catch(function () {
                        statusInFlight = false;
                        if (pollFinished) { return; }
                        if (resumeStatusCheckRequired) {
                            requestResumeStatusCheck();
                            return;
                        }
                        if (deadlineExceeded()) {
                            finish(false);
                        } else {
                            schedulePoll(false);
                        }
                    });
            }
            updateGenerationDownloadProgress('queued');
            fetchJsonWithTimeout(downloadUrl.replace('/download/', '/download_prepare/'))
                .then(function (status) {
                    prepareInFlight = false;
                    if (pollFinished) { return; }
                    acceptedExport(status);
                    updateGenerationDownloadProgress(status.state, status.elapsed_s);
                    if (status.ready || status.state === 'done') {
                        finish(true);
                        showPrintCheck(status);
                        var finalDownloadUrl = stableStlDownloadUrl(
                            downloadUrl, format, status.origin_fallback_available === true
                        );
                        showOriginDownloadFallback(
                            finalDownloadUrl, format, status.origin_fallback_available === true
                        );
                        handOverPreparedDownload(finalDownloadUrl);
                    } else if (status.state === 'error') {
                        finish(false, true);
                    } else if (resumeStatusCheckRequired) {
                        requestResumeStatusCheck();
                    } else {
                        schedulePoll(true);
                    }
                })
                .catch(function () {
                    prepareInFlight = false;
                    if (pollFinished) { return; }
                    if (resumeStatusCheckRequired) {
                        requestResumeStatusCheck();
                        return;
                    }
                    finish(false);
                });
        }

        if (downloadBtn) {
            downloadBtn.addEventListener('click', function () {
                var explicitUrl = downloadBtn.getAttribute('data-download-url');
                if (explicitUrl) {
                    var pageGenIdExplicit = new URLSearchParams(window.location.search).get('gen_id');
                    if (pageGenIdExplicit) {
                        var separator = explicitUrl.indexOf('?') === -1 ? '?' : '&';
                        explicitUrl += separator + 'gen_id=' + encodeURIComponent(pageGenIdExplicit);
                    }
                    triggerPreparedDownload(explicitUrl);
                    return;
                }
                var formatSelect = document.getElementById('file_format');
                if (!formatSelect) {
                    return;
                }
                var format = formatSelect.value;
                // Carry the tab-scoped gen_id from the current page URL so
                // /download serves THIS tab's file even when another tab has
                // started a newer generation in the same Flask session.
                var pageParams = new URLSearchParams(window.location.search);
                var pageGenId = pageParams.get('gen_id');
                var downloadUrl = "/download/" + format;
                if (pageGenId) {
                    downloadUrl += "?gen_id=" + encodeURIComponent(pageGenId);
                }
                if (format !== 'png' && format !== 'heightmap' && window.aiprintgenOwnSizeControl) {
                    downloadUrl = window.aiprintgenOwnSizeControl.appendScale(downloadUrl);
                }
                triggerPreparedDownload(downloadUrl);
            });
        }
        var subscribeBtn = document.getElementById('subscribe-btn');
        if (subscribeBtn) {
            $('#subscribe-btn').popover({ trigger: 'hover', placement: 'right' });
        }
        const fileButtons = [
            { buttonId: 'file_button_1', inputId: 'image_prompt_1_file' },
            { buttonId: 'file_button_2', inputId: 'image_prompt_2_file' },
            { buttonId: 'file_button_3', inputId: 'image_prompt_3_file' },
            { buttonId: 'file_button_4', inputId: 'image_prompt_4_file' }
        ];
        fileButtons.forEach(function (pair) {
            const button = document.getElementById(pair.buttonId);
            const input = document.getElementById(pair.inputId);
            if (button && input) {
                button.addEventListener('click', function () { input.click(); });
                input.addEventListener('change', function () {
                    button.textContent = this.files.length > 0 ? this.files[0].name : "Выберите файл";
                });
            }
        });
        function createClientTabSessionId(prefix) {
            if (window.crypto && typeof window.crypto.randomUUID === 'function') {
                return window.crypto.randomUUID();
            }
            return String(prefix || 'tab') + '_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 10);
        }

        function getOrCreateClientTabSessionId(storageKey, prefix) {
            var tabSessionId = '';
            if (typeof window.sessionStorage === 'undefined') {
                return tabSessionId;
            }
            try {
                tabSessionId = String(window.sessionStorage.getItem(storageKey) || '').trim();
                if (!tabSessionId) {
                    tabSessionId = createClientTabSessionId(prefix);
                    window.sessionStorage.setItem(storageKey, tabSessionId);
                }
            } catch (error) {
                tabSessionId = '';
            }
            return tabSessionId;
        }

        var imageModelSubmitPendingStorageKey = 'aiprintgenImageModelSubmitPendingV1';
        var imageModelSubmitTerminalStorageKey = 'aiprintgenImageModelSubmitTerminalV1';
        var imageModelSubmitPendingMaxAgeMs = 15 * 60 * 1000;

        function readRecentImageModelSubmit(scope) {
            try {
                var raw = window.sessionStorage.getItem(imageModelSubmitPendingStorageKey);
                if (!raw) {
                    return null;
                }
                var pending = JSON.parse(raw);
                var submittedAt = Number(pending && pending.submittedAt);
                var age = Date.now() - submittedAt;
                if (!pending || !pending.scope || !submittedAt || age < 0
                        || age > imageModelSubmitPendingMaxAgeMs) {
                    window.sessionStorage.removeItem(imageModelSubmitPendingStorageKey);
                    return null;
                }
                if (scope && String(pending.scope) !== String(scope)) {
                    return null;
                }
                return pending;
            } catch (error) {
                return null;
            }
        }

        function rememberImageModelSubmit(scope) {
            var normalizedScope = String(scope || '').trim();
            if (!normalizedScope) {
                return;
            }
            try {
                window.sessionStorage.setItem(
                    imageModelSubmitPendingStorageKey,
                    JSON.stringify({scope: normalizedScope, submittedAt: Date.now()})
                );
            } catch (error) {}
        }

        function clearImageModelSubmitPending() {
            try {
                window.sessionStorage.removeItem(imageModelSubmitPendingStorageKey);
            } catch (error) {}
        }

        function readTerminalImageModelSubmitScope() {
            try {
                return String(
                    window.sessionStorage.getItem(imageModelSubmitTerminalStorageKey)
                    || ''
                ).trim();
            } catch (error) {
                return '';
            }
        }

        function markImageModelSubmitTerminal() {
            var scope = '';
            try {
                scope = String(
                    window.sessionStorage.getItem('aiprintgenImageModelTabSessionId')
                    || ''
                ).trim();
                if (scope) {
                    window.sessionStorage.setItem(
                        imageModelSubmitTerminalStorageKey,
                        scope
                    );
                }
            } catch (error) {}
            clearImageModelSubmitPending();
            return scope;
        }

        function clearImageModelSubmitTerminal() {
            try {
                window.sessionStorage.removeItem(imageModelSubmitTerminalStorageKey);
            } catch (error) {}
        }

        // Intentionally narrower than rotateScopedGenerationTabState(): a
        // File input has already received the user's new selection when its
        // change event fires, so clearing the scoped UI here would erase the
        // file that established the new intent.
        function rotateImageModelSubmitScope(forcedScope) {
            var normalizedForcedScope = String(forcedScope || '').trim();
            var nextScope = /^[A-Za-z0-9_-]{16,120}$/.test(normalizedForcedScope)
                ? normalizedForcedScope
                : createClientTabSessionId('image3d');
            try {
                window.sessionStorage.setItem('aiprintgenImageModelTabSessionId', nextScope);
            } catch (error) {}
            var form = document.getElementById('image-form');
            var hiddenInput = document.getElementById('image_model_tab_session_id');
            if (hiddenInput) {
                hiddenInput.value = nextScope;
            }
            if (form) {
                form.setAttribute('data-server-tab-session-id', normalizedForcedScope || '');
            }
            clearImageModelSubmitPending();
            clearImageModelSubmitTerminal();
            return nextScope;
        }

        function setupImageModelSubmitScope() {
            var form = document.getElementById('image-form');
            var hiddenInput = document.getElementById('image_model_tab_session_id');
            var stagedInput = document.getElementById('image_model_staged_tab_session_id');
            if (!form || !hiddenInput) {
                return;
            }

            try {
                var params = new URLSearchParams(window.location.search);
                var resetScope = String(params.get('reset_image_submit') || '').trim();
                if (resetScope) {
                    rotateImageModelSubmitScope(resetScope);
                }
            } catch (error) {}

            form.addEventListener('submit', function () {
                // Read before the rotation below wipes it: the picture the
                // dropzone is still showing was staged under THIS scope, and a
                // repeat submit after a delivered result carries an empty file
                // input. Posted separately so it can restore the image without
                // ever reviving the finished generation's reservation id.
                var stagedScope = String(
                    form.getAttribute('data-server-tab-session-id') || ''
                ).trim();
                var scope = String(hiddenInput.value || '').trim()
                    || getOrCreateClientTabSessionId(
                        'aiprintgenImageModelTabSessionId',
                        'image3d'
                    );
                if (scope && readTerminalImageModelSubmitScope() === scope) {
                    scope = rotateImageModelSubmitScope();
                }
                hiddenInput.value = scope;
                if (stagedInput) {
                    stagedInput.value = stagedScope;
                }
                rememberImageModelSubmit(scope);
            });

            var fileInput = document.getElementById('image_prompt_input');
            if (fileInput) {
                fileInput.addEventListener('change', function () {
                    if (!fileInput.files || !fileInput.files.length) {
                        return;
                    }
                    var currentScope = String(hiddenInput.value || '').trim();
                    if (!readRecentImageModelSubmit(currentScope)) {
                        rotateImageModelSubmitScope();
                    }
                });
            }
        }

        window.finalizeImageModelSubmitScope = function () {
            return markImageModelSubmitTerminal();
        };
        window.__imageModelSubmitScopeTest = {
            readRecent: readRecentImageModelSubmit,
            remember: rememberImageModelSubmit,
            rotate: rotateImageModelSubmitScope,
            finalize: markImageModelSubmitTerminal,
            setup: setupImageModelSubmitScope
        };
        setupImageModelSubmitScope();
        var serverRenderedTerminalGeneration =
            false
            || false
            || false;
        if (serverRenderedTerminalGeneration) {
            // A result can be rendered directly after refresh/background
            // delivery without this tab ever executing the polling callback.
            // Mark the old paid scope terminal on mount as well.
            markImageModelSubmitTerminal();
        }

        function clearServerPreviewForInput(inputId) {
            var input = document.getElementById(inputId);
            var removedFieldName = input ? input.getAttribute('data-upload-removed-field') : '';
            var removedField = removedFieldName && input.form
                ? input.form.elements.namedItem(removedFieldName)
                : null;
            var dropzone = document.querySelector('.file-dropzone[data-dropzone-for="' + inputId + '"]');
            var filenameEl = dropzone ? dropzone.querySelector('[data-dropzone-filename]') : null;
            var previewContainer = document.querySelector('[data-upload-preview-container="' + inputId + '"]');
            var previewImage = previewContainer ? previewContainer.querySelector('[data-upload-preview-image]') : null;
            if (input) {
                input.value = '';
            }
            if (removedField) {
                removedField.value = '1';
            }
            if (previewImage) {
                previewImage.removeAttribute('src');
            }
            if (previewContainer) {
                previewContainer.setAttribute('data-server-preview-url', '');
                previewContainer.setAttribute('data-server-preview-name', '');
                previewContainer.style.display = 'none';
            }
            if (dropzone) {
                dropzone.classList.remove('has-file');
            }
            if (filenameEl) {
                filenameEl.textContent = filenameEl.getAttribute('data-empty-text') || '';
            }
            if (input && input.dataset.baseRequired === '1') {
                input.required = true;
            }
            if (input) input.dispatchEvent(new Event('aiprintgen:upload-cleared'));
            if (inputId === 'image_prompt_input') {
                // Clearing the picture must drop the server-staged copy too,
                // otherwise the next submit silently restores what the user
                // just removed.
                var imageForm = document.getElementById('image-form');
                if (imageForm) {
                    imageForm.setAttribute('data-server-tab-session-id', '');
                }
                var stagedScopeInput = document.getElementById('image_model_staged_tab_session_id');
                if (stagedScopeInput) {
                    stagedScopeInput.value = '';
                }
            }
        }
        // Shared image handoffs can clear a server reference preview.
        window.aiprintgenClearUploadPreview = clearServerPreviewForInput;

        function sanitizeGenerationResultUrl() {
            try {
                var currentUrl = new URL(window.location.href);
                var changed = false;
                ['completed', 'progress', 'error', 'rig_completed', 'rig_done', 'tab_session_id', 'reset_image_submit', '_ts'].forEach(function(paramName) {
                    if (currentUrl.searchParams.has(paramName)) {
                        currentUrl.searchParams.delete(paramName);
                        changed = true;
                    }
                });
                if (!changed) {
                    return;
                }
                var sanitizedUrl = currentUrl.pathname;
                var search = currentUrl.searchParams.toString();
                if (search) {
                    sanitizedUrl += '?' + search;
                }
                if (currentUrl.hash) {
                    sanitizedUrl += currentUrl.hash;
                }
                window.history.replaceState({}, '', sanitizedUrl);
            } catch (error) {
                // Ignore URL cleanup errors.
            }
        }

        function clearGenerationOutputState() {
            if (isGenerationTaskActive()) {
                activateGenerationInteractionLock();
                return;
            }
            ['generated-result', 'main-spinner', 'pending-submit-spinner', 'rig-spinner'].forEach(function(elementId) {
                var element = document.getElementById(elementId);
                if (element) {
                    element.style.display = 'none';
                }
            });
            // A wait sent to the background keeps polling while the user works
            // in another tab of this page: delivery stays as fast as it was.
            if (!generationWaitHidden && typeof window.stopMainGenerationPolling === 'function') {
                window.stopMainGenerationPolling();
            }
            if (!generationWaitHidden && typeof window.stopRigGenerationPolling === 'function') {
                window.stopRigGenerationPolling();
            }
            sanitizeGenerationResultUrl();
        }

        function clearScopedGenerationTabUi(options) {
            (options.inputIds || []).forEach(clearServerPreviewForInput);
            (options.promptInputIds || []).forEach(function(inputId) {
                var input = document.getElementById(inputId);
                // image editor historically clears both its own prompt and the
                // text-generator prompt when its tab-scoped preview belongs
                // to another browser tab. A catalog Create Similar action,
                // however, owns #prompt independently; clearing it here ran
                // after the trusted server/sessionStorage restore and left
                // the destination visibly empty.
                var isCatalogActionPrompt = inputId === 'prompt' && !!catalogActionInput;
                if (input && !isCatalogActionPrompt) {
                    input.value = '';
                }
            });
            if (options.detailsSelector) {
                var form = document.getElementById(options.formId);
                var detailsNode = form ? form.querySelector(options.detailsSelector) : null;
                if (detailsNode) {
                    if (options.detailsOpenOnReset) {
                        detailsNode.setAttribute('open', '');
                    } else {
                        detailsNode.removeAttribute('open');
                    }
                }
            }
        }

        function rotateScopedGenerationTabState(options) {
            if (isGenerationTaskActive()) {
                activateGenerationInteractionLock();
                return;
            }
            var form = document.getElementById(options.formId);
            var hiddenInput = document.getElementById(options.hiddenInputId);
            var nextTabSessionId = createClientTabSessionId(options.prefix);
            sessionStorage.setItem(options.storageKey, nextTabSessionId);
            if (hiddenInput) {
                hiddenInput.value = nextTabSessionId;
            }
            if (form) {
                form.setAttribute('data-server-tab-session-id', '');
            }
            clearScopedGenerationTabUi(options);
            clearGenerationOutputState();
        }

        function setupFormScopedServerPreviews(options) {
            var form = document.getElementById(options.formId);
            var hiddenInput = document.getElementById(options.hiddenInputId);
            if (!form || !hiddenInput) {
                return;
            }

            function applyCurrentTabSessionId() {
                var clientTabSessionId = getOrCreateClientTabSessionId(options.storageKey, options.prefix);
                var serverTabSessionId = String(form.getAttribute('data-server-tab-session-id') || '').trim();
                // Privacy modes can block sessionStorage. Keep server-staged
                // previews submittable in that case instead of posting an
                // empty id that the route correctly refuses to restore.
                hiddenInput.value = clientTabSessionId || serverTabSessionId;
                return hiddenInput.value;
            }

            var currentTabSessionId = applyCurrentTabSessionId();
            var serverTabSessionId = String(form.getAttribute('data-server-tab-session-id') || '').trim();
            var retrySourceGenId = String(form.getAttribute('data-retry-source-gen-id') || '').trim();
            if (retrySourceGenId || !serverTabSessionId || !currentTabSessionId || serverTabSessionId === currentTabSessionId) {
                form.addEventListener('submit', function () {
                    window.__skipScopedGenerationTabReset = true;
                    applyCurrentTabSessionId();
                });
                return;
            }

            form.setAttribute('data-server-tab-session-id', '');
            clearScopedGenerationTabUi(options);
            // Reload/pagehide can rotate the browser's upload scope while the
            // server restores this exact completed generation by gen_id. Clear
            // stale source inputs without hiding that authoritative result.
            var hasExactTerminalResult = serverRenderedTerminalGeneration
                && new URLSearchParams(window.location.search).get('gen_id')
                && document.getElementById('generated-result');
            if (!hasExactTerminalResult) {
                clearGenerationOutputState();
            }
            form.addEventListener('submit', function () {
                window.__skipScopedGenerationTabReset = true;
                applyCurrentTabSessionId();
            });
        }

        var generationScopedPreviewConfigs = [
            {
                tabPaneId: 'image',
                formId: 'image-form',
                hiddenInputId: 'image_model_tab_session_id',
                storageKey: 'aiprintgenImageModelTabSessionId',
                prefix: 'image3d',
                inputIds: ['image_prompt_input'],
                promptInputIds: []
            },
            {
                tabPaneId: 'image-gen',
                formId: 'advanced-image-form',
                hiddenInputId: 'advanced_image_tab_session_id',
                storageKey: 'aiprintgenAdvancedImageTabSessionId',
                prefix: 'ultragen',
                inputIds: ['advanced_image_reference', 'advanced_image_reference_2', 'advanced_image_reference_3', 'advanced_image_reference_4'],
                promptInputIds: ['advanced_image_prompt', 'prompt'],
                detailsSelector: 'details',
                detailsOpenOnReset: true
            },
            {
                tabPaneId: 'three-image',
                formId: 'three-image-form',
                hiddenInputId: 'multiview_tab_session_id',
                storageKey: 'aiprintgenMultiviewTabSessionId',
                prefix: 'multiview',
                inputIds: ['image_prompt_1_input', 'image_prompt_2_input', 'image_prompt_3_input', 'image_prompt_4_input'],
                promptInputIds: []
            }
        ];

        function getGenerationScopedPreviewConfigByPaneId(paneId) {
            var normalizedPaneId = String(paneId || '').replace(/^#/, '');
            for (var index = 0; index < generationScopedPreviewConfigs.length; index += 1) {
                if (generationScopedPreviewConfigs[index].tabPaneId === normalizedPaneId) {
                    return generationScopedPreviewConfigs[index];
                }
            }
            return null;
        }

        generationScopedPreviewConfigs.forEach(setupFormScopedServerPreviews);
        sanitizeGenerationResultUrl();

        // Counters read each field's server-provided limit so reserved image
        // instructions fit without shortening the user's description.
        Array.prototype.forEach.call(
            document.querySelectorAll('textarea[data-prompt-limit]'),
            function(field) {
                var counter = document.querySelector(
                    '[data-prompt-counter-for="' + field.id + '"]'
                );
                if (!counter) {
                    return;
                }
                var limit = parseInt(field.getAttribute('maxlength'), 10);
                if (!limit) {
                    return;
                }
                var render = function() {
                    var used = (field.value || '').length;
                    counter.textContent = used + ' / ' + limit;
                    // .text-muted стоит в бутстраповских утилитах ПОСЛЕ
                    // .text-danger, поэтому одного добавления класса мало —
                    // приглушённый цвет перебил бы красный.
                    counter.classList.toggle('text-danger', used >= limit);
                    counter.classList.toggle('text-muted', used < limit);
                };
                field.addEventListener('input', render);
                render();
            }
        );

        var generatedImageTo3dTabSessionInput = document.getElementById('generated_image_to_3d_tab_session_id');
        var generatedImageTo3dForm = document.getElementById('generated-image-to-3d-form');
        if (generatedImageTo3dForm && generatedImageTo3dTabSessionInput) {
            var applyGeneratedImageTo3dTabSessionId = function() {
                generatedImageTo3dTabSessionInput.value = getOrCreateClientTabSessionId(
                    'aiprintgenImageModelTabSessionId',
                    'image3d'
                );
            };
            applyGeneratedImageTo3dTabSessionId();
            generatedImageTo3dForm.addEventListener('submit', function() {
                window.__skipScopedGenerationTabReset = true;
                // A generated-2D handoff is a new explicit 3D intent. Give it
                // a fresh scope before staging the image; the destination
                // form then keeps that scope stable until its paid submit is
                // either registered or safely rejected as a replay.
                generatedImageTo3dTabSessionInput.value = rotateImageModelSubmitScope();
            });
        }

        // A four-view result carries one handoff form per delivered variant
        // (plus the legacy single-set form), and each needs the tab session id.
        var generatedMultiviewTo3dForms = [].slice.call(
            document.querySelectorAll('#generated-multiview-to-3d-form, .generated-multiview-to-3d-form')
        );
        generatedMultiviewTo3dForms.forEach(function(form) {
            var tabSessionInput = form.querySelector(
                '#generated_multiview_to_3d_tab_session_id, .generated-multiview-to-3d-tab-session'
            );
            if (!tabSessionInput) {
                return;
            }
            var applyGeneratedMultiviewTo3dTabSessionId = function() {
                tabSessionInput.value = getOrCreateClientTabSessionId(
                    'aiprintgenMultiviewTabSessionId',
                    'multiview'
                );
            };
            applyGeneratedMultiviewTo3dTabSessionId();
            form.addEventListener('submit', function() {
                window.__skipScopedGenerationTabReset = true;
                applyGeneratedMultiviewTo3dTabSessionId();
            });
        });

        if (window.jQuery) {
            window.jQuery('#modelGenerationTabs a[data-toggle="tab"], #modelGenerationTabsPro a[data-toggle="tab"]').on('show.bs.tab', function(event) {
                var activePane = document.querySelector('#modelGenerationTabContent > .tab-pane.active');
                event.target._previousGenerationTabHref = activePane ? '#' + activePane.id : '';
                if (!isGenerationTaskActive()) {
                    // Both rows control one pane set; Bootstrap only clears
                    // active links inside its own row. Clear the other row at
                    // switch start, before asynchronous fade events can race.
                    var ownRow = window.jQuery(event.target).closest('.nav');
                    window.jQuery('#modelGenerationTabs a[data-toggle="tab"], #modelGenerationTabsPro a[data-toggle="tab"]')
                        .not(ownRow.find('a[data-toggle="tab"]'))
                        .removeClass('active').attr('aria-selected', 'false');
                    return;
                }
                event.preventDefault();
                event.stopImmediatePropagation();
                activateGenerationInteractionLock();
                return false;
            });

            window.jQuery('#modelGenerationTabs a[data-toggle="tab"], #modelGenerationTabsPro a[data-toggle="tab"]').on('shown.bs.tab', function(event) {
                var previousTabHref = event.target._previousGenerationTabHref || '';
                var previousConfig = getGenerationScopedPreviewConfigByPaneId(previousTabHref);
                var nextTabHref = String(event.target.getAttribute('href') || '');
                if (window.AIprintgenPhotoRefinement && window.AIprintgenPhotoRefinement.preservesTransition(previousTabHref, nextTabHref)) {
                    clearGenerationOutputState();
                    return;
                }
                if (previousConfig) {
                    rotateScopedGenerationTabState(previousConfig);
                    return;
                }
                clearGenerationOutputState();
            });
        }

        window.__skipScopedGenerationTabReset = false;
        function preserveScopedGenerationStateForNavigation() {
            window.__skipScopedGenerationTabReset = true;
            generationNavigationAllowed = true;
        }
        window.addEventListener('beforeunload', function(event) {
            if (!isGenerationTaskActive()
                    || generationNavigationAllowed
                    || generationContinuesWithoutTab) {
                return;
            }
            event.preventDefault();
            event.returnValue = '';
            return '';
        });
        window.addEventListener('pagehide', function() {
            if (generationNavigationAllowed || window.__skipScopedGenerationTabReset || isGenerationTaskActive()) {
                return;
            }
            var activeTabLink = document.querySelector('#modelGenerationTabs .nav-link.active');
            var activeConfig = getGenerationScopedPreviewConfigByPaneId(activeTabLink ? activeTabLink.getAttribute('href') : '');
            // A reload must retain this photo tab's staged-input ownership.
            // Clearing the file here also erases it before the draft saver
            // sees pagehide. New tabs already have independent sessionStorage;
            // choosing another photo/finishing a task still rotates the scope.
            if (activeConfig && activeConfig.formId === 'image-form') {
                return;
            }
            if (activeConfig) {
                rotateScopedGenerationTabState(activeConfig);
            }
        });

        function initSingleFileDropzone(dropzone) {
            if (!dropzone) {
                return;
            }
            var inputId = dropzone.getAttribute('data-dropzone-for');
            var input = inputId ? document.getElementById(inputId) : null;
            var filenameEl = dropzone.querySelector('[data-dropzone-filename]');
            var previewContainer = inputId ? document.querySelector('[data-upload-preview-container="' + inputId + '"]') : null;
            var previewImage = previewContainer ? previewContainer.querySelector('[data-upload-preview-image]') : null;
            var serverPreviewRetryCount = 0;
            var serverPreviewRetryTimer = null;
            if (!input || !filenameEl) {
                return;
            }
            if (!input.dataset.baseRequired) {
                input.dataset.baseRequired = input.required ? '1' : '0';
            }
            var baseRequired = input.dataset.baseRequired === '1';

            function getEmptyText() {
                return filenameEl.getAttribute('data-empty-text') || '';
            }

            function getServerPreviewUrl() {
                return previewContainer ? String(previewContainer.getAttribute('data-server-preview-url') || '') : '';
            }

            function getServerPreviewName() {
                return previewContainer ? String(previewContainer.getAttribute('data-server-preview-name') || '') : '';
            }

            function clearPreview() {
                if (serverPreviewRetryTimer) {
                    clearTimeout(serverPreviewRetryTimer);
                    serverPreviewRetryTimer = null;
                }
                if (previewImage) {
                    previewImage.removeAttribute('src');
                }
                if (previewContainer) {
                    previewContainer.style.display = 'none';
                }
            }

            function getPreviewDisplayMode() {
                if (!previewContainer) {
                    return 'block';
                }
                return previewContainer.classList.contains('file-dropzone-inline-preview') ? 'flex' : 'block';
            }

            function restoreServerPreview() {
                var serverPreviewUrl = getServerPreviewUrl();
                if (!previewContainer || !previewImage || !serverPreviewUrl) {
                    clearPreview();
                    return false;
                }
                previewImage.src = serverPreviewUrl;
                previewContainer.style.display = getPreviewDisplayMode();
                return true;
            }

            function retryServerPreview() {
                var serverPreviewUrl = getServerPreviewUrl();
                // A selected local file is handled by FileReader below. Never
                // let a delayed retry overwrite that newer preview.
                if (!previewImage || !previewContainer || !serverPreviewUrl ||
                        (input.files && input.files.length)) {
                    return;
                }
                if (serverPreviewRetryCount >= 2) {
                    // Old result pages can outlive their cleaned temporary
                    // input. Hide the unavailable tile instead of leaving the
                    // browser's broken-image text ("Preview") on screen.
                    clearPreview();
                    return;
                }
                serverPreviewRetryCount += 1;
                serverPreviewRetryTimer = setTimeout(function () {
                    serverPreviewRetryTimer = null;
                    if (input.files && input.files.length) {
                        return;
                    }
                    try {
                        var retryUrl = new URL(serverPreviewUrl, window.location.href);
                        retryUrl.searchParams.set('_preview_retry', String(Date.now()));
                        previewImage.src = retryUrl.href;
                    } catch (error) {
                        previewImage.src = serverPreviewUrl +
                            (serverPreviewUrl.indexOf('?') === -1 ? '?' : '&') +
                            '_preview_retry=' + Date.now();
                    }
                    previewContainer.style.display = getPreviewDisplayMode();
                }, 300 * serverPreviewRetryCount);
            }

            if (previewImage) {
                previewImage.addEventListener('load', function () {
                    serverPreviewRetryCount = 0;
                });
                previewImage.addEventListener('error', retryServerPreview);
            }

            function updatePreview(file) {
                if (!previewContainer || !previewImage) {
                    return;
                }
                if (!file || !file.type || file.type.indexOf('image/') !== 0) {
                    restoreServerPreview();
                    return;
                }
                var reader = new FileReader();
                reader.onload = function(event) {
                    serverPreviewRetryCount = 0;
                    previewImage.src = event.target.result;
                    previewContainer.style.display = getPreviewDisplayMode();
                };
                reader.readAsDataURL(file);
            }

            function updateDropzoneState() {
                var hasSelectedFile = !!(input.files && input.files.length);
                var removedFieldName = input.getAttribute('data-upload-removed-field');
                var removedField = removedFieldName && input.form
                    ? input.form.elements.namedItem(removedFieldName)
                    : null;
                var hasServerPreview = !!(getServerPreviewUrl() || getServerPreviewName());
                var hasVisualFile = hasSelectedFile || hasServerPreview;
                input.required = baseRequired && !hasVisualFile;
                dropzone.classList.toggle('has-file', hasVisualFile);
                if (hasSelectedFile) {
                    if (removedField) {
                        removedField.value = '';
                    }
                    filenameEl.textContent = input.files[0].name;
                } else {
                    filenameEl.textContent = getServerPreviewName() || getEmptyText();
                }
                if (hasSelectedFile) {
                    updatePreview(input.files[0]);
                } else {
                    restoreServerPreview();
                }
            }

            // Возвращает true, только если файл действительно лёг в поле —
            // маршрутизатор вставки ниже гасит событие ровно в этом случае.
            function assignDroppedFile(file) {
                if (!file || input.disabled) {
                    return false;
                }
                var acceptedTypes = ['image/png', 'image/jpeg', 'image/webp'];
                var fileName = String(file.name || '').toLowerCase();
                var looksValid = acceptedTypes.indexOf(file.type) >= 0 || /\.(png|jpe?g|webp)$/.test(fileName);
                if (!looksValid) {
                    return false;
                }
                if (typeof DataTransfer === 'undefined') {
                    return false;
                }
                var transfer = new DataTransfer();
                transfer.items.add(file);
                input.files = transfer.files;
                input.dispatchEvent(new Event('change', { bubbles: true }));
                return true;
            }

            dropzone.addEventListener('click', function (event) {
                if (input.disabled) {
                    return;
                }
                if (event.target === input) {
                    return;
                }
                input.click();
            });

            dropzone.addEventListener('keydown', function (event) {
                if (input.disabled) {
                    return;
                }
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    input.click();
                }
            });

            ['dragenter', 'dragover'].forEach(function (eventName) {
                dropzone.addEventListener(eventName, function (event) {
                    if (input.disabled) {
                        return;
                    }
                    event.preventDefault();
                    dropzone.classList.add('is-dragover');
                });
            });

            ['dragleave', 'dragend', 'drop'].forEach(function (eventName) {
                dropzone.addEventListener(eventName, function (event) {
                    if (input.disabled) {
                        return;
                    }
                    event.preventDefault();
                    dropzone.classList.remove('is-dragover');
                });
            });

            dropzone.addEventListener('drop', function (event) {
                if (input.disabled) {
                    return;
                }
                var droppedFiles = event.dataTransfer && event.dataTransfer.files;
                if (!droppedFiles || !droppedFiles.length) {
                    return;
                }
                assignDroppedFile(droppedFiles[0]);
            });

            // Ctrl+V по зоне НЕ обрабатывается здесь. Свой обработчик paste
            // на каждой зоне клал картинку к себе, гасил событие — и всё равно
            // отдавал его всплытием документному обработчику ниже, который
            // видел зону уже заполненной и лил ту же картинку в следующую
            // пустую. Один Ctrl+V попадал сразу в два слота (и затирал файл,
            // только что выбранный через диалог, — фокус после диалога
            // остаётся на зоне). Адресат вставки выбирается в ОДНОМ месте —
            // в документном обработчике, который знает и про фокус, и про то,
            // какие слоты пусты.
            dropzone._assignDroppedFile = assignDroppedFile;

            // Inject a single "X" remove-button into the preview tile so users
            // can clear the picked image without re-opening the file dialog.
            // Wired here (not in template) so every dropzone — single image,
            // advanced-image references, multi-view slots — gets it for free.
            if (previewContainer && !previewContainer.querySelector('.upload-preview-remove-btn')) {
                var removeBtn = document.createElement('button');
                removeBtn.type = 'button';
                removeBtn.className = 'upload-preview-remove-btn';
                removeBtn.setAttribute('aria-label', "\u0423\u0431\u0440\u0430\u0442\u044c \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0443");
                removeBtn.title = "\u0423\u0431\u0440\u0430\u0442\u044c \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0443";
                removeBtn.innerHTML = '<i class="fas fa-times" aria-hidden="true"></i>';
                removeBtn.addEventListener('click', function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    if (input.disabled) {
                        return;
                    }
                    clearServerPreviewForInput(inputId);
                    // Dispatch change so any downstream listeners (filename
                    // label, form-validity, etc.) recompute their state.
                    input.dispatchEvent(new Event('change', { bubbles: true }));
                });
                // Stop click on the button from bubbling to dropzone's click
                // handler (which would re-open the file dialog).
                removeBtn.addEventListener('mousedown', function (event) {
                    event.stopPropagation();
                });
                previewContainer.appendChild(removeBtn);
            }

            // "Paste" button: the ONLY clipboard-image path that works on mobile.
            // Phones have no Ctrl+V, and the `paste` event above only fires from a
            // focused editable field (the dropzone isn't one) — so we add an
            // explicit button that, on tap (the required user gesture), reads the
            // image off the clipboard via the async Clipboard API and feeds it
            // into the same assignDroppedFile() pipeline as a picked/dropped file.
            // Feature-detected: browsers without navigator.clipboard.read (e.g.
            // Firefox Android, some in-app webviews) simply don't get the button
            // and fall back to the file picker. On iOS the OS shows its own
            // "Paste" confirmation — expected, can't be suppressed.
            if (navigator.clipboard && typeof navigator.clipboard.read === 'function'
                    && typeof window.File === 'function'
                    && !dropzone.querySelector('.file-dropzone__paste-btn')) {
                var pasteBtn = document.createElement('button');
                pasteBtn.type = 'button';
                pasteBtn.className = 'file-dropzone__paste-btn';
                pasteBtn.innerHTML = '<i class="fas fa-paste" aria-hidden="true"></i><span>'
                    + "\u0412\u0441\u0442\u0430\u0432\u0438\u0442\u044c" + '</span>';

                var pasteMsg = document.createElement('div');
                pasteMsg.className = 'file-dropzone__paste-msg';
                var pasteMsgTimer = null;
                var showPasteMsg = function (text) {
                    pasteMsg.textContent = text;
                    if (pasteMsgTimer) { clearTimeout(pasteMsgTimer); }
                    pasteMsgTimer = setTimeout(function () { pasteMsg.textContent = ''; }, 6000);
                };

                var PASTE_ACCEPTED = ['image/png', 'image/jpeg', 'image/webp'];
                var pasteImageFromClipboard = function () {
                    if (input.disabled) { return; }
                    navigator.clipboard.read().then(function (clipItems) {
                        for (var i = 0; i < clipItems.length; i++) {
                            var item = clipItems[i];
                            var imgType = null;
                            for (var t = 0; t < item.types.length; t++) {
                                if (item.types[t].indexOf('image/') === 0) { imgType = item.types[t]; break; }
                            }
                            if (!imgType) { continue; }
                            if (PASTE_ACCEPTED.indexOf(imgType) < 0) {
                                showPasteMsg("\u0424\u043e\u0440\u043c\u0430\u0442 \u043d\u0435 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044f (\u043d\u0443\u0436\u0435\u043d PNG, JPEG \u0438\u043b\u0438 WebP)");
                                return;
                            }
                            item.getType(imgType).then(function (blob) {
                                var ext = (String(blob.type).split('/')[1] || 'png');
                                assignDroppedFile(new File([blob], 'pasted-image.' + ext, { type: blob.type }));
                            });
                            return;
                        }
                        // No image item on the clipboard (only text, etc.).
                        showPasteMsg("\u0412 \u0431\u0443\u0444\u0435\u0440\u0435 \u043d\u0435\u0442 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f: \u0441\u043a\u043e\u043f\u0438\u0440\u0443\u0439\u0442\u0435 \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0443 (\u041a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435), \u0430 \u043d\u0435 \u0444\u0430\u0439\u043b");
                    }).catch(function (error) {
                        // Distinguish "browser blocked clipboard access" from
                        // "clipboard has no image data" — users who copied a FILE
                        // in the OS file manager (no image pixels on the clipboard)
                        // or declined the permission prompt saw the same generic
                        // message and reported the button as broken.
                        var denied = error && (error.name === 'NotAllowedError' || error.name === 'SecurityError');
                        showPasteMsg(denied
                            ? "\u0411\u0440\u0430\u0443\u0437\u0435\u0440 \u0437\u0430\u043f\u0440\u0435\u0442\u0438\u043b \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u0431\u0443\u0444\u0435\u0440\u0443: \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u0435 \u0432 \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0435 \u0443 \u0430\u0434\u0440\u0435\u0441\u043d\u043e\u0439 \u0441\u0442\u0440\u043e\u043a\u0438 \u0438\u043b\u0438 \u043d\u0430\u0436\u043c\u0438\u0442\u0435 Ctrl+V"
                            : "\u0412 \u0431\u0443\u0444\u0435\u0440\u0435 \u043d\u0435\u0442 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f: \u0441\u043a\u043e\u043f\u0438\u0440\u0443\u0439\u0442\u0435 \u043a\u0430\u0440\u0442\u0438\u043d\u043a\u0443 (\u041a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435), \u0430 \u043d\u0435 \u0444\u0430\u0439\u043b");
                    });
                };

                pasteBtn.addEventListener('click', function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    pasteImageFromClipboard();
                });
                // Keep the press from bubbling to the dropzone's click handler
                // (which would open the file dialog instead of pasting).
                pasteBtn.addEventListener('mousedown', function (event) { event.stopPropagation(); });
                // Same for keyboard activation: the dropzone's own keydown
                // handler turns Enter/Space into a file-dialog open, so stop the
                // button's Enter/Space from bubbling up to it (the button still
                // gets its native click).
                pasteBtn.addEventListener('keydown', function (event) {
                    if (event.key === 'Enter' || event.key === ' ') { event.stopPropagation(); }
                });

                var hintEl = dropzone.querySelector('.file-dropzone__hint');
                if (hintEl && hintEl.parentNode) {
                    hintEl.parentNode.insertBefore(pasteBtn, hintEl.nextSibling);
                    pasteBtn.parentNode.insertBefore(pasteMsg, pasteBtn.nextSibling);
                } else {
                    dropzone.appendChild(pasteBtn);
                    dropzone.appendChild(pasteMsg);
                }
            }

            input.addEventListener('change', updateDropzoneState);
            updateDropzoneState();
        }

        function extractImageFromClipboard(clipboardData) {
            if (!clipboardData) return null;
            // 1) DataTransferItemList (Chrome/Firefox/Edge): looks for any
            //    `image/*` item and converts it to a File via getAsFile().
            var items = clipboardData.items;
            if (items) {
                for (var i = 0; i < items.length; i++) {
                    if (items[i] && items[i].kind === 'file' && items[i].type && items[i].type.indexOf('image/') === 0) {
                        var f = items[i].getAsFile();
                        if (f) return f;
                    }
                }
            }
            // 2) Older fallback: files array (Safari occasionally only
            //    populates this when an image is on the system clipboard).
            var files = clipboardData.files;
            if (files && files.length) {
                for (var j = 0; j < files.length; j++) {
                    if (files[j].type && files[j].type.indexOf('image/') === 0) {
                        return files[j];
                    }
                }
            }
            return null;
        }

        function dropzoneInput(dropzone) {
            var inputId = dropzone ? dropzone.getAttribute('data-dropzone-for') : null;
            return inputId ? document.getElementById(inputId) : null;
        }

        // Слот с картинкой, восстановленной сервером (после неудачной попытки
        // или повтора), на экране занят, хотя в input файла нет. Считать его
        // пустым значило отправить Ctrl+V поверх него, а слот, который
        // пользователь реально заполняет, оставить пустым.
        function dropzoneHasSavedPreview(inputEl) {
            var preview = document.querySelector('[data-upload-preview-container="' + inputEl.id + '"]');
            if (!preview || preview.getAttribute('data-server-preview-placeholder') === '1') {
                return false;
            }
            return !!String(preview.getAttribute('data-server-preview-url')
                || preview.getAttribute('data-server-preview-name') || '').trim();
        }

        function dropzoneIsEmpty(inputEl) {
            return (!inputEl.files || !inputEl.files.length) && !dropzoneHasSavedPreview(inputEl);
        }

        // Зона, в которой пользователь сейчас стоит: событие paste приходит в
        // сфокусированный элемент, но после файлового диалога фокус может
        // висеть и на скрытом input внутри зоны.
        function focusedDropzone(event) {
            var candidates = [event.target, document.activeElement];
            for (var i = 0; i < candidates.length; i++) {
                var node = candidates[i];
                if (node && typeof node.closest === 'function') {
                    var zone = node.closest('.file-dropzone[data-dropzone-for]');
                    if (zone) return zone;
                }
            }
            return null;
        }

        // Куда положить картинку из буфера. Ровно ОДИН адресат:
        //   1. зона под фокусом, если она пустая — пользователь выбрал её сам;
        //   2. иначе первая пустая зона активной вкладки — так подряд идущие
        //      Ctrl+V заполняют слоты мультивью и вторую ссылку 2D-генерации;
        //   3. иначе зона под фокусом (осознанная замена картинки);
        //   4. иначе первая доступная зона вкладки.
        // Пункт 1 стоит выше пункта 2 намеренно: если пустых слотов несколько,
        // выигрывает тот, что выбрал пользователь, а не тот, что первый в DOM.
        function pasteDestination(focusedZone) {
            var focusedInput = dropzoneInput(focusedZone);
            var focusedEnabled = focusedInput && !focusedInput.disabled ? focusedZone : null;
            if (focusedEnabled && dropzoneIsEmpty(focusedInput)) {
                return focusedEnabled;
            }
            var activePane = document.querySelector('.tab-pane.show.active');
            var dropzones = (activePane || document).querySelectorAll('.file-dropzone[data-dropzone-for]');
            var empty = null, anyEnabled = null;
            for (var i = 0; i < dropzones.length; i++) {
                var dz = dropzones[i];
                var inputEl = dropzoneInput(dz);
                if (!inputEl || inputEl.disabled) continue;
                if (!anyEnabled) anyEnabled = dz;
                if (dropzoneIsEmpty(inputEl)) {
                    empty = dz;
                    break;
                }
            }
            return empty || focusedEnabled || anyEnabled;
        }

        // Единственный обработчик Ctrl+V на странице: у зон своего нет, иначе
        // одна картинка ложилась бы дважды (см. комментарий у
        // dropzone._assignDroppedFile).
        document.addEventListener('paste', function (event) {
            // Кто-то выше по цепочке уже забрал вставку (например общий
            // static/js/image_upload_interactions.js на вкладках CAD и
            // ложемента) — второй раз ту же картинку не раскладываем.
            if (event.defaultPrevented) return;
            var target = event.target;
            // If the user is pasting into a real text input/textarea we leave
            // them alone — they probably want text, not an image.
            if (target && (target.tagName === 'INPUT' && target.type === 'text' || target.tagName === 'TEXTAREA')) {
                return;
            }
            var file = extractImageFromClipboard(event.clipboardData);
            if (!file) return;
            var dest = pasteDestination(focusedDropzone(event));
            if (dest && typeof dest._assignDroppedFile === 'function'
                    && dest._assignDroppedFile(file)) {
                event.preventDefault();
            }
        });

        Array.prototype.forEach.call(document.querySelectorAll('.file-dropzone[data-dropzone-for]'), initSingleFileDropzone);
        if (window.AIprintgenPhotoRefinement) {
            window.AIprintgenPhotoRefinement.init({
                isBusy: isGenerationTaskActive,
                showLock: activateGenerationInteractionLock,
                clearInput: clearServerPreviewForInput,
                beginEdit: function () {
                    // A new editing draft must not restore reference slot 2
                    // from a previous server-side generation on submission.
                    var scope = createClientTabSessionId('image2d');
                    sessionStorage.setItem('aiprintgenAdvancedImageTabSessionId', scope);
                    document.getElementById('advanced_image_tab_session_id').value = scope;
                    document.getElementById('advanced-image-form').setAttribute('data-server-tab-session-id', '');
                }
            });
        }
        function initStandaloneImagePreview(inputId) {
            var input = document.getElementById(inputId);
            var previewContainer = document.querySelector('[data-upload-preview-container="' + inputId + '"]');
            var previewImage = previewContainer ? previewContainer.querySelector('[data-upload-preview-image]') : null;
            if (!input || !previewContainer || !previewImage) {
                return;
            }
            if (!input.dataset.baseRequired) {
                input.dataset.baseRequired = input.required ? '1' : '0';
            }
            var baseRequired = input.dataset.baseRequired === '1';

            function getServerPreviewUrl() {
                return String(previewContainer.getAttribute('data-server-preview-url') || '');
            }

            function getPreviewDisplayMode() {
                return previewContainer.classList.contains('inline-file-input-with-preview__preview') ? 'flex' : 'block';
            }

            function clearPreview() {
                previewImage.removeAttribute('src');
                previewContainer.style.display = 'none';
            }

            function restoreServerPreview() {
                var serverPreviewUrl = getServerPreviewUrl();
                if (!serverPreviewUrl) {
                    clearPreview();
                    return false;
                }
                previewImage.src = serverPreviewUrl;
                previewContainer.style.display = getPreviewDisplayMode();
                return true;
            }

            function updatePreview() {
                var hasFile = !!(input.files && input.files.length);
                if (!hasFile) {
                    input.required = baseRequired && !restoreServerPreview();
                    return;
                }
                var file = input.files[0];
                if (!file || !file.type || file.type.indexOf('image/') !== 0) {
                    input.required = baseRequired && !restoreServerPreview();
                    return;
                }
                input.required = false;
                var reader = new FileReader();
                reader.onload = function(event) {
                    previewImage.src = event.target.result;
                    previewContainer.style.display = getPreviewDisplayMode();
                };
                reader.readAsDataURL(file);
            }

            input.addEventListener('change', updatePreview);
            updatePreview();
        }

        ['image_prompt_1_input', 'image_prompt_2_input', 'image_prompt_3_input', 'image_prompt_4_input'].forEach(initStandaloneImagePreview);
        var shareBtn = document.getElementById('share-btn');
        if (shareBtn) {
            shareBtn.addEventListener('click', function() {
                fetch("/share_model", { method: "POST" })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        var shareUrlInput = document.getElementById('share-url');
                        shareUrlInput.value = data.share_url;
                        var shareMessage = document.getElementById('share-message');
                        if (shareMessage) {
                            shareMessage.style.display = 'block';
                        }
                        if (navigator.clipboard && navigator.clipboard.writeText) {
                            navigator.clipboard.writeText(data.share_url).then(function () { if (window.AiprintgenProduct) window.AiprintgenProduct.shareCopied(data.share_id, 'link', (window.aiprintgenAnalyticsContext || {}).result_type || 'mesh'); }).catch(function() {
                                shareUrlInput.select();
                                document.execCommand('copy');
                            });
                        } else {
                            shareUrlInput.select();
                            document.execCommand('copy');
                        }
                    } else { alert("Ошибка при шаринге модели:" + " " + data.error); }
                });
            });
        }
        var printBtn = document.getElementById('print-btn');
        if (printBtn) {
            var printDefaultHtml = '<i class="fas fa-print"></i> Заказать печать';
            var printLoadingHtml = '<i class="fas fa-print"></i> Сохраняем запрос…';
            var printSentHtml = '<i class="fas fa-check"></i> Отправлено';
            printBtn.addEventListener('click', function() {
                var collectContact = window.collectRequestContact || function () {
                    return Promise.reject(new Error("missing_contact_modal"));
                };

                collectContact(window.appUserEmail)
                .then(function(contact) {
                    printBtn.disabled = true;
                    printBtn.innerHTML = printLoadingHtml;
                    return window.sendPartnerRequest('/request_print', contact);
                })
                .then(data => {
                    if (data.success) {
                        document.getElementById('print-message').style.display = 'block';
                        printBtn.innerHTML = printSentHtml;
                    } else {
                        printBtn.disabled = false;
                        printBtn.innerHTML = printDefaultHtml;
                        alert(data.error || 'Произошла ошибка');
                    }
                })
                .catch(function(error) {
                    if (error && error.message === 'cancelled') {
                        return;
                    }
                    printBtn.disabled = false;
                    printBtn.innerHTML = printDefaultHtml;
                    alert('Произошла ошибка');
                });
            });
        }
        
        // --- ПРОГРЕСС-БАРЫ ---
        const creditsTemplates = {
            generic: "\u0423 \u0432\u0430\u0441 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e {credits} \u043a\u0440\u0435\u0434\u0438\u0442(\u043e\u0432).",
            today: "\u0421\u0435\u0433\u043e\u0434\u043d\u044f \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e {credits} \u043a\u0440\u0435\u0434\u0438\u0442(\u043e\u0432).",
            month: "\u0412 \u044d\u0442\u043e\u043c \u043c\u0435\u0441\u044f\u0446\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e {credits} \u043a\u0440\u0435\u0434\u0438\u0442(\u043e\u0432).",
        };
        const creditDisplayMode = "generic";
        function updateCreditsDisplay(remainingCredits, options) {
            const updateOptions = options || {};
            if (remainingCredits === undefined || remainingCredits === null) {
                return;
            }
            if (window.AiprintgenCredits) {
                return window.AiprintgenCredits.setBalance(remainingCredits, {
                    accountKey: updateOptions.accountKey,
                    expectedRevision: updateOptions.expectedRevision,
                    persist: updateOptions.persistCache !== false,
                    synchronizedAt: updateOptions.synchronizedAt
                });
            }
            const creditsTextEl = document.getElementById('credits-remaining-text');
            if (creditsTextEl) {
                const creditsTemplate = creditsTemplates[creditDisplayMode] || creditsTemplates.generic;
                creditsTextEl.textContent = creditsTemplate.replace('{credits}', String(remainingCredits));
            }
            return true;
        }

        function buildNoCacheUrl(path) {
            const separator = path.indexOf('?') === -1 ? '?' : '&';
            return path + separator + '_ts=' + Date.now();
        }

        // Generation finished while the user was away on another tab/app: fire a
        // local notification (via the already-registered SW) so they don't have to
        // sit and watch the page. Only when the tab is hidden AND notifications are
        // granted — otherwise navigate as before. Navigation is deferred until the
        // notification is shown so the page unload doesn't kill the SW promise.
        // "Generation done" notifications are now SERVER-SENT (a per-minute GCF cron
        // web-pushes the moment the Tripo task finishes) so they reach mobile / closed
        // tabs, which a browser-local notification never could. On completion the page
        // just navigates to the result as before; the subscribe UI (waiting-screen
        // opt-in + sidebar bell) is what feeds the server the push subscription.
        function notifyGenDoneThenGo(redirectUrl, failed) {
            if (generationWaitHidden) {
                // The user sent this wait to the background: announce the
                // outcome in the task tray instead of leaving the page they
                // are working on. The server already saved the result.
                try { if (waitHiddenKey) window.sessionStorage.removeItem(waitHiddenKey); } catch (_waitHiddenError) {}
                if (window.AiprintgenGenerationSurvey) window.AiprintgenGenerationSurvey.stop();
                if (window.aiprintgenTaskTray && window.aiprintgenTaskTray.refresh) window.aiprintgenTaskTray.refresh();
                return;
            }
            function openResult() {
                preserveScopedGenerationStateForNavigation();
                window.location.href = buildNoCacheUrl(redirectUrl || '/');
            }
            var survey = window.AiprintgenGenerationSurvey;
            if (survey && !failed) survey.finish(openResult);
            else {
                if (survey) survey.stop();
                openResult();
            }
        }

        function syncCreditsBalance(attemptsLeft, options) {
            const syncOptions = options || {};
            const refreshPromise = window.AiprintgenCredits
                ? window.AiprintgenCredits.refresh({
                    force: Boolean(syncOptions.force),
                    minIntervalMs: syncOptions.minIntervalMs || 0
                })
                : Promise.resolve(false);
            refreshPromise
            .finally(function() {
                if (attemptsLeft > 1) {
                    setTimeout(function() {
                        syncCreditsBalance(attemptsLeft - 1, syncOptions);
                    }, 1200);
                }
            });
        }

        var mainSpinnerNode = document.getElementById('main-spinner');
        if (mainSpinnerNode && mainSpinnerNode.style.display !== 'none') {
            // On mobile the form occupies most of the viewport; the spinner
            // sits below it and is invisible without scrolling. Bring it into
            // view so the user knows generation is running.
            mainSpinnerNode.scrollIntoView({ behavior: 'smooth', block: 'center' });

            // This tab is now watching an in-flight gen — remember it so a
            // later bare-"/" hit in this same tab reconnects (credit-loss).
            if (typeof window.markTabGenActive === 'function') {
                window.markTabGenActive(new URLSearchParams(window.location.search).get('gen_id'));
            }

            let progressPollStopped = false;
            let progressPollTimeoutId = null;
            let progressPollInFlight = false;
            // Final-processing watch: once the task hits 100% the server-side
            // delivery pipeline can run for minutes at peak (and the very poll
            // that triggers it gets cut by the edge proxy at ~50s, surfacing as
            // a failed request). After this long at 100% we show the
            // "high load, model will arrive in My Models" notice instead of
            // letting the user conclude the generation died.
            let finalProcessingSince = 0;
            const finalProcessingNoticeAfterMs = 45000;
            var waitingForOptionalVariants = false;
            const basreliefPublicationCopy = {
                title: "\u041c\u043e\u0434\u0435\u043b\u044c \u0433\u043e\u0442\u043e\u0432\u0430 \u2014 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u043c \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b",
                wait: "\u041e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 \u0440\u0435\u043b\u044c\u0435\u0444 \u0433\u043e\u0442\u043e\u0432. \u0414\u043e\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u043c \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u043c\u0435\u0442\u043e\u0434\u044b; \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443 \u043c\u043e\u0436\u043d\u043e \u0437\u0430\u043a\u0440\u044b\u0442\u044c.",
                publish: "\u0413\u0435\u043e\u043c\u0435\u0442\u0440\u0438\u044f \u0433\u043e\u0442\u043e\u0432\u0430. \u0421\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u043c \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b \u0432 \u00ab\u041c\u043e\u0438 \u043c\u043e\u0434\u0435\u043b\u0438\u00bb; \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443 \u043c\u043e\u0436\u043d\u043e \u0437\u0430\u043a\u0440\u044b\u0442\u044c."
            };
            const basreliefGenerationCopy = {
                title: (document.getElementById('generation-lock-title') || {}).textContent || '',
                body: (document.getElementById('generation-lock-body') || {}).textContent || ''
            };

            function showBasreliefPublicationStage(stage, progress) {
                var titleNode = document.getElementById('generation-lock-title');
                var bodyNode = document.getElementById('generation-lock-body');
                var normalizedStage = String(stage || '').toLowerCase();
                var numericProgress = Number(progress);
                // Hi3D reports its provider and geometry stages through the
                // same field as final publication.  The result is only ready
                // to save after the durable 96% publication band begins.
                var isPublication = normalizedStage.indexOf('optional') !== -1
                    || (Number.isFinite(numericProgress) && numericProgress >= 96);
                if (!isPublication) {
                    if (titleNode) { titleNode.textContent = basreliefGenerationCopy.title; }
                    if (bodyNode) { bodyNode.textContent = basreliefGenerationCopy.body; }
                    return;
                }
                if (titleNode) {
                    titleNode.textContent = basreliefPublicationCopy.title;
                }
                if (bodyNode) {
                    bodyNode.textContent = normalizedStage.indexOf('optional') !== -1
                        ? basreliefPublicationCopy.wait : basreliefPublicationCopy.publish;
                }
            }
            
            const progressPollIntervalMs = 10000;

            function stopProgressPolling() {
                progressPollStopped = true;
                if (progressPollTimeoutId) {
                    clearTimeout(progressPollTimeoutId);
                    progressPollTimeoutId = null;
                }
            }
            window.stopMainGenerationPolling = stopProgressPolling;

            function scheduleProgressPoll(delayMs) {
                if (progressPollStopped) {
                    return;
                }
                progressPollTimeoutId = setTimeout(runProgressPoll, delayMs);
            }

            function runProgressPoll() {
                if (progressPollStopped || progressPollInFlight) {
                    scheduleProgressPoll(progressPollIntervalMs);
                    return;
                }
                progressPollInFlight = true;
                // Pass the tab's gen_id so /progress sees this tab's task even
                // when another tab has overwritten session["task"].
                var pollGenId = new URLSearchParams(window.location.search).get('gen_id');
                var progressUrl = pollGenId ? ('/progress?gen_id=' + encodeURIComponent(pollGenId)) : '/progress';
                var creditsRevisionAtPollStart = window.AiprintgenCredits
                    ? window.AiprintgenCredits.getRevision() : undefined;
                $.getJSON(progressUrl, function(data) {
                    if (progressPollStopped) {
                        return;
                    }
                    updateCreditsDisplay(data.remaining_credits, {
                        accountKey: data.account_key,
                        expectedRevision: creditsRevisionAtPollStart,
                        synchronizedAt: Number(data.credits_balance_read_ts || 0) * 1000
                    });
                    updateGenerationLockCreditStatus(data.refund_pending);
                    if (data.degraded && window.AiprintgenHighLoad) {
                        // Backend went degraded mid-generation — surface the
                        // banner live without waiting for a page reload.
                        window.AiprintgenHighLoad.raise();
                    }
                    // A negative progress value is terminal even for legacy or
                    // partially degraded responses that omitted `reload`.
                    // Stop before navigating so the stale tab cannot enqueue
                    // another provider poll during the transition.
                    if(data.local_result_ready || data.reload || data.completed || Number(data.progress) < 0){
                        stopProgressPolling();
                        if (typeof window.clearTabGenActive === 'function') { window.clearTabGenActive(); }
                        notifyGenDoneThenGo(data.redirect_url || '/',
                            Number(data.progress) < 0 || Boolean(data.error) ||
                            ['failed', 'banned', 'expired', 'cancelled'].indexOf(data.terminal_status) !== -1);
                    } else if (data.progress >= 0){
                        $("#progress").html(`<i class="fas fa-spinner fa-spin"></i> ${data.progress}%`);
                        updateGenerationLockProgress(data.progress);
                        showBasreliefPublicationStage(data.publication_stage, data.progress);
                        // Ожидание Медальона и Чистого рельефа объясняет сама
                        // модалка. Общая плашка «сейчас высокая нагрузка»
                        // поверх неё и неверна, и противоречит ей.
                        waitingForOptionalVariants = String(
                            data.publication_stage || ''
                        ).toLowerCase().indexOf('optional') !== -1;
                        if (waitingForOptionalVariants) { $("#progress-notice").hide(); }
                        if (data.progress >= 100 || data.processing) {
                            if (!finalProcessingSince) { finalProcessingSince = Date.now(); }
                        } else {
                            finalProcessingSince = 0;
                            $("#progress-notice").hide();
                        }
                    }
                }).always(function() {
                    progressPollInFlight = false;
                    // The claiming poll itself can die at the proxy cutoff while
                    // delivery keeps running server-side — so the notice check
                    // lives here, where both outcomes (processing:true and a
                    // dropped request after 100%) pass through.
                    if (!progressPollStopped && !waitingForOptionalVariants
                            && finalProcessingSince
                            && Date.now() - finalProcessingSince > finalProcessingNoticeAfterMs) {
                        $("#progress-notice").show();
                    }
                    if (!progressPollStopped) {
                        scheduleProgressPoll(progressPollIntervalMs);
                    }
                });
            }

            // Verify the durable state immediately.  Waiting a full polling
            // interval left stale links displaying a misleading 0% lock even
            // when the server already knew the task was terminal.
            scheduleProgressPoll(0);
        }

        var rigSpinnerNode = document.getElementById('rig-spinner');
        if (rigSpinnerNode && rigSpinnerNode.style.display !== 'none') {
            // Rig animation is a second-stage job on the same gen_id — keep the
            // same-tab reconnect pointer alive while it runs.
            if (typeof window.markTabGenActive === 'function') {
                window.markTabGenActive(new URLSearchParams(window.location.search).get('gen_id'));
            }
            let rigPollStopped = false;
            let rigPollTimeoutId = null;
            let rigPollInFlight = false;
            const rigPollIntervalMs = 10000;

            function stopRigPolling() {
                rigPollStopped = true;
                if (rigPollTimeoutId) {
                    clearTimeout(rigPollTimeoutId);
                    rigPollTimeoutId = null;
                }
            }
            window.stopRigGenerationPolling = stopRigPolling;

            function scheduleRigPoll(delayMs) {
                if (rigPollStopped) {
                    return;
                }
                rigPollTimeoutId = setTimeout(runRigPoll, delayMs);
            }

            function runRigPoll() {
                if (rigPollStopped || rigPollInFlight) {
                    scheduleRigPoll(rigPollIntervalMs);
                    return;
                }
                rigPollInFlight = true;
                // Pass this tab's gen_id so /rig_progress sees this tab's rig
                // task even when another tab has stomped session["rig_animation_task"].
                var rigPollGenId = new URLSearchParams(window.location.search).get('gen_id');
                var rigPollUrl = rigPollGenId ? ('/rig_progress?gen_id=' + encodeURIComponent(rigPollGenId)) : '/rig_progress';
                var creditsRevisionAtRigPollStart = window.AiprintgenCredits
                    ? window.AiprintgenCredits.getRevision() : undefined;
                $.getJSON(rigPollUrl, function(data) {
                    if (rigPollStopped) {
                        return;
                    }
                    updateCreditsDisplay(data.remaining_credits, {
                        accountKey: data.account_key,
                        expectedRevision: creditsRevisionAtRigPollStart,
                        synchronizedAt: Number(data.credits_balance_read_ts || 0) * 1000
                    });
                    if(data.reload || data.completed){
                        stopRigPolling();
                        if (typeof window.clearTabGenActive === 'function') { window.clearTabGenActive(); }
                        notifyGenDoneThenGo(data.redirect_url || '/', Number(data.progress) < 0 || Boolean(data.error));
                    } else if (data.progress >= 0){
                        $("#progress4").html(`<i class="fas fa-spinner fa-spin"></i> Генерируем риг-анимацию для вашей 3D модели... ${data.progress}%`);
                        updateGenerationLockProgress(data.progress);
                    }
                }).always(function() {
                    rigPollInFlight = false;
                    if (!rigPollStopped) {
                        scheduleRigPoll(rigPollIntervalMs);
                    }
                });
            }

            scheduleRigPoll(rigPollIntervalMs);
        }
    });
</script>



                    
                </div>
            </main>

            <!-- Ссылка на Telegram в правом нижнем углу -->
            <div class="telegram-container">
                <a href="https://t.me/aiprintgen" target="_blank" class="telegram-link">
                    <img src="/static/images/tg.png" alt="Telegram Icon" width="20px">
