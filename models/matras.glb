                if (!toolJob) { return nativeFetch(input, options); }
                return nativeFetch(input, options).then(function(response) {
                    if (response.status === 202 && response.headers.get('X-Tool-Job-Ticket') === '1') {
                        return waitToolJob(response, options.signal);
                    }
                    return response;
                });
            }

