          title: "\u041b\u0438\u0442\u043e\u0444\u0430\u043d\u0438\u044f \u0438\u0437 \u0444\u043e\u0442\u043e",
          text: "\u041f\u043b\u043e\u0441\u043a\u0430\u044f \u0438\u043b\u0438 \u0438\u0437\u043e\u0433\u043d\u0443\u0442\u0430\u044f \u043b\u0438\u0442\u043e\u0444\u0430\u043d\u0438\u044f \u0434\u043b\u044f 3D-\u043f\u0435\u0447\u0430\u0442\u0438. 1 \u043a\u0440\u0435\u0434\u0438\u0442 \u043d\u0430 \u043b\u044e\u0431\u043e\u043c \u0442\u0430\u0440\u0438\u0444\u0435.",
          cta: "\u0421\u043e\u0437\u0434\u0430\u0442\u044c \u043b\u0438\u0442\u043e\u0444\u0430\u043d\u0438\u044e",
          href: "/lithophane-generator" + '?from=gen_slider_lithophane', target: '_blank' },
        { key: '2dref', img: "/static/images/2d_ref.webp",
          badge: "\u041f\u043e\u043b\u0435\u0437\u043d\u044b\u0439 \u0441\u043e\u0432\u0435\u0442",
          title: "\u041d\u0443\u0436\u043d\u043e \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 2D-\u0440\u0435\u0444\u0435\u0440\u0435\u043d\u0441?",
          text: "\u0412\u043e \u0432\u043a\u043b\u0430\u0434\u043a\u0435 \u041a\u0430\u0440\u0442\u0438\u043d\u043a\u0430 \u0434\u043b\u044f 3D \u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d \u0433\u0435\u043d\u0435\u0440\u0430\u0442\u043e\u0440 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0439: \u043e\u043f\u0438\u0448\u0438\u0442\u0435 \u0438\u0434\u0435\u044e \u0442\u0435\u043a\u0441\u0442\u043e\u043c \u0438 \u0443\u0442\u043e\u0447\u043d\u044f\u0439\u0442\u0435 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043f\u0440\u043e\u043c\u043f\u0442\u0430." },
