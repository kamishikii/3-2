<span class="plan-lock-coin" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="10.5" fill="#F4C542" stroke="#B7860B" stroke-width="1.5"/><circle cx="12" cy="12" r="6.5" fill="none" stroke="#B7860B" stroke-width="1.5"/></svg></span>
<span class="plan-lock-tip" role="tooltip">Доступно на платных тарифах</span>
        </label>
        
        
        <label class="generation-mode-card is-plan-locked" for="generation-mode-multiview-balanced" tabindex="0">
            <input type="radio" id="generation-mode-multiview-balanced" name="generation_mode" value="balanced"  disabled data-plan-locked autocomplete="off">
            <span><strong>Баланс</strong><small>Проработка формы и пропорций</small><small class="generation-mode-price" data-generation-mode-price="balanced"></small></span>
            
<span class="plan-lock-coin" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="10.5" fill="#F4C542" stroke="#B7860B" stroke-width="1.5"/><circle cx="12" cy="12" r="6.5" fill="none" stroke="#B7860B" stroke-width="1.5"/></svg></span>
<span class="plan-lock-tip" role="tooltip">Доступно на платных тарифах</span>
        </label>
        
        
        <label class="generation-mode-card is-plan-locked" for="generation-mode-multiview-precise" tabindex="0">
            <input type="radio" id="generation-mode-multiview-precise" name="generation_mode" value="precise"  disabled data-plan-locked autocomplete="off">
            <span><strong>Точность</strong><small>Усиленная проработка сложных форм</small><small class="generation-mode-price" data-generation-mode-price="precise"></small></span>
            
<span class="plan-lock-coin" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="10.5" fill="#F4C542" stroke="#B7860B" stroke-width="1.5"/><circle cx="12" cy="12" r="6.5" fill="none" stroke="#B7860B" stroke-width="1.5"/></svg></span>
<span class="plan-lock-tip" role="tooltip">Доступно на платных тарифах</span>
        </label>
        
    </div>
    <div class="generation-texture-control">
        <label for="generation-texture-multiview"><input type="checkbox" name="generation_texture" id="generation-texture-multiview" checked disabled autocomplete="off" aria-describedby="generation-texture-hint-multiview"> <span data-generation-texture-label data-included-label="Текстура" data-optional-label="Добавить текстуру · +1 кредит">Текстура</span></label>
        <small class="form-text text-muted" id="generation-texture-hint-multiview" data-generation-texture-hint>Текстура включена в стоимость</small>
    </div>
    <small class="form-text text-muted" data-generation-front-hint hidden>Загрузите вид спереди и ещё хотя бы один ракурс (всего 2–4 изображения).</small>
</fieldset>


<!-- Toggle button for settings -->
<button type="button" class="generation-settings-toggle" onclick="toggleSettingsPanel(this)" aria-expanded="false" aria-controls="generation-settings-multiview">
    <span class="toggle-arrow">▶</span>
    <span>Настройки генерации</span>
</button>

<div class="generation-settings-panel" id="generation-settings-multiview">
    <div class="form-group d-none">
        <div class="custom-control custom-checkbox">
            <input type="checkbox" class="custom-control-input" id="detailed_textures_multiview" name="detailed_textures">
            <label class="custom-control-label" for="detailed_textures_multiview">Детальные текстуры</label>
        </div>
    </div>

    <div class="form-group">
        <div class="custom-control custom-checkbox">
            <input type="checkbox" class="custom-control-input fast-lowpoly-check" id="fast_lowpoly_multiview" name="fast_lowpoly">
            <label class="custom-control-label" for="fast_lowpoly_multiview">Low-poly</label>
        </div>
    </div>

    
    
    <fieldset class="form-group lowpoly-mode-options" hidden>
        <legend>Режим low-poly</legend>
        
        <div class="lowpoly-mode-grid">
            
            
            <label class="lowpoly-mode-card" for="lowpoly_mode_standard_multiview">
                <input type="radio" id="lowpoly_mode_standard_multiview" name="lowpoly_mode" value="standard" checked disabled>
                <span><strong>Обычный</strong>
                    <small>Около 10 мин</small>
                    <small>Без доплаты</small>
                    
                </span>
                
            </label>
            
            
            <label class="lowpoly-mode-card is-plan-locked" for="lowpoly_mode_fast_multiview" tabindex="0">
                <input type="radio" id="lowpoly_mode_fast_multiview" name="lowpoly_mode" value="fast"  disabled data-plan-locked>
                <span><strong>Быстрый</strong>
                    <small>Около 1 мин</small>
                    <small>+1 кредит за модель</small>
                    <small>Фиксировано: 8 000 полигонов</small>
                </span>
                
<span class="plan-lock-coin" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="10.5" fill="#F4C542" stroke="#B7860B" stroke-width="1.5"/><circle cx="12" cy="12" r="6.5" fill="none" stroke="#B7860B" stroke-width="1.5"/></svg></span>
<span class="plan-lock-tip" role="tooltip">Доступно на платных тарифах</span>
            </label>
            
            
            <label class="lowpoly-mode-card is-plan-locked" for="lowpoly_mode_quality_multiview" tabindex="0">
                <input type="radio" id="lowpoly_mode_quality_multiview" name="lowpoly_mode" value="quality"  disabled data-plan-locked>
                <span><strong>Качество</strong>
                    <small>Около 3 мин</small>
                    <small>+3 кредита за модель</small>
                    
                </span>
                
<span class="plan-lock-coin" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="10.5" fill="#F4C542" stroke="#B7860B" stroke-width="1.5"/><circle cx="12" cy="12" r="6.5" fill="none" stroke="#B7860B" stroke-width="1.5"/></svg></span>
<span class="plan-lock-tip" role="tooltip">Доступно на платных тарифах</span>
            </label>
            
        </div>
        <small class="form-text text-muted">Для low-poly нужны все четыре ракурса: спереди, сзади, слева и справа.</small>
    </fieldset>
    

    <div class="form-group lowpoly-texture-settings" hidden>
        <label for="lowpoly_texture_resolution_multiview">Разрешение текстур</label>
        <select class="form-control" id="lowpoly_texture_resolution_multiview" name="lowpoly_texture_resolution" disabled>
            <option value="1024">1K</option>
            <option value="2048" selected>2K</option>
            <option value="4096">4K</option>
        </select>
    </div>

    <div class="form-group">
        <div class="custom-control custom-checkbox">
            <input type="checkbox" class="custom-control-input three-variants-check" id="generate_three_variants_multiview" name="generate_three_variants">
            <label class="custom-control-label" for="generate_three_variants_multiview" data-variant-price-template="Сгенерировать 3 варианта ({credits})">Сгенерировать 3 варианта (6 кредитов)</label>
        </div>
    </div>

    
    

    <div class="form-group">
        <label class="ag-microlabel" for="purpose_multiview" style="margin-bottom: 0.4rem;">Оптимизировать для</label>
        <select class="form-control generation-purpose-select" id="purpose_multiview" name="purpose">
            <option value="3d_print" selected>3D-печать</option>
            <option value="vr_ar">VR/AR</option>
            <option value="gamedev">GameDev</option>
            <option value="cnc">ЧПУ</option>
            <option value="other">Другое</option>
        </select>
    </div>
    <script>
    (function () {
        // Persist the purpose choice like the other generation settings and
        // keep all three tab panels in sync. Default is 3d_print.
        var sel = document.getElementById('purpose_multiview');
        if (!sel) { return; }
        try {
            var saved = window.localStorage.getItem('aiprintgen.generation_purpose');
            // Пункт «—» убран: он значил то же, что «Другое».
            if (saved === '') { saved = 'other'; }
            if (saved !== null) { sel.value = saved; }
        } catch (e) {}
        sel.addEventListener('change', function () {
            try { window.localStorage.setItem('aiprintgen.generation_purpose', sel.value); } catch (e) {}
            document.querySelectorAll('.generation-purpose-select').forEach(function (other) {
                if (other !== sel) { other.value = sel.value; }
            });
        });
    })();
    </script>

    <div class="form-group mb-0 polygon-settings" hidden>
        <label for="poly_count_slider_multiview">Количество полигонов:</label>
        <div class="range-number-control">
            <input type="range" class="custom-range flex-grow-1 poly-slider" id="poly_count_slider_multiview" min="0" max="2000000" value="0" step="500" disabled>
            
            <input type="text" inputmode="numeric" class="form-control form-control-sm poly-input range-number-input" id="poly_count_input_multiview" name="poly_count" disabled min="0" max="2000000" value="Авто" placeholder="Авто" aria-label="Количество полигонов">
        </div>
    </div>
</div>

<script>
    // The ordinary model has no local compression target. Keep a separate
    // Low-poly choice so old ordinary targets cannot leak into this mode.
    function syncLowPolyTarget(panel) {
        panel = panel.closest('div[id$="-gen-settings"]') || panel;
        const lowPoly = panel.querySelector('.fast-lowpoly-check');
        const input = panel.querySelector('.poly-input');
        const slider = panel.querySelector('.poly-slider');
        if (!input || !slider) { return; }
        const form = panel.closest('form');
        const generationMode = form && form.querySelector('[name="generation_mode"]:checked:not(:disabled)');
        const alternative = generationMode ? generationMode.value === 'detail' : form && form.querySelector('[name="unfiltered_mode"]:checked') && !form.querySelector('[name="max_quality"]:checked');
        const lowPolyEnabled = Boolean(lowPoly && lowPoly.checked && !lowPoly.disabled);
        const selectedMode = panel.querySelector('[name="lowpoly_mode"]:checked');
        const fastMode = lowPolyEnabled && selectedMode && selectedMode.value === 'fast';
        // «Баланс» / «Точность» take a custom face limit (1K–2M, Auto = 0), like the old Tripo form.
        const tripoOption = Boolean(generationMode && (generationMode.value === 'balanced' || generationMode.value === 'precise'));
        const mode = alternative ? 'alternative' : tripoOption ? 'tripo' : lowPolyEnabled ? (fastMode ? 'lowpoly-fast' : 'lowpoly') : 'ordinary';
        const previousMode = input.dataset.targetMode;
        const value = parseInt(input.value, 10);
        if (previousMode === 'lowpoly') {
            panel.dataset.lowPolyTarget = String(Number.isFinite(value) && value > 0 ? Math.max(5000, Math.min(20000, value)) : 20000);
        } else if (previousMode === 'alternative') {
            panel.dataset.alternativePolyTarget = String(Number.isFinite(value) && value > 0 ? Math.max(100000, Math.min(2000000, value)) : 0);
        } else if (previousMode === 'tripo') {
            panel.dataset.tripoPolyTarget = String(Number.isFinite(value) && value > 0 ? Math.max(1000, Math.min(2000000, value)) : 0);
        }
        const enabled = mode !== 'ordinary';
        input.dataset.targetMode = mode;
        input.closest('.polygon-settings').hidden = !enabled || fastMode;
        input.disabled = slider.disabled = !enabled;
        input.min = slider.min = lowPolyEnabled ? '5000' : '0';
        input.max = slider.max = lowPolyEnabled ? '20000' : '2000000';
        slider.step = alternative ? '100000' : tripoOption ? '1000' : '500';
        const target = fastMode ? '8000' : mode === 'lowpoly' ? (panel.dataset.lowPolyTarget || '20000') : alternative ? (panel.dataset.alternativePolyTarget || '0') : tripoOption ? (panel.dataset.tripoPolyTarget || '0') : '0';
        slider.value = target;
        input.value = (alternative || tripoOption) && target === '0' ? "Авто" : target;
        input.setAttribute('data-auto', target === '0' ? 'true' : 'false');
    }

    // Global functions for settings persistence
    // Save settings to localStorage
    function saveSettings(panelId, isOpen, detailedTextures, polyCount) {
        try {
            // Create storage key based on panel ID
            const storageKey = 'genSettings_' + panelId;
            
            // Create settings object
            const settingsPanel = document.getElementById(panelId);
            if (settingsPanel) syncLowPolyTarget(settingsPanel);
            const settings = {
                isOpen: isOpen,
                detailedTextures: detailedTextures,
                polyCount: polyCount,
                lowPolyTarget: settingsPanel ? settingsPanel.dataset.lowPolyTarget : "20000",
                alternativePolyTarget: settingsPanel ? settingsPanel.dataset.alternativePolyTarget : "0"
            };
            
            // Save to localStorage
            localStorage.setItem(storageKey, JSON.stringify(settings));
        } catch (e) {
            console.error('Error saving settings:', e);
        }
    }
    
    // Load settings from localStorage
    function loadSettings(panelId) {
        try {
            // Create storage key based on panel ID
            const storageKey = 'genSettings_' + panelId;
            
            // Get settings from localStorage
            const settingsJson = localStorage.getItem(storageKey);
            
            if (settingsJson) {
                return JSON.parse(settingsJson);
            }
        } catch (e) {
            console.error('Error loading settings:', e);
        }
        
        // Return default settings if nothing found or error
        return {
            isOpen: false,
            detailedTextures: false,
            polyCount: "Авто"
        };
    }
    
    // Global function to toggle settings panel
    function toggleSettingsPanel(toggleElement) {
        // Find the panel that follows this toggle
        const settingsPanel = toggleElement.nextElementSibling;
        const toggleArrow = toggleElement.querySelector('.toggle-arrow');
        
        if (settingsPanel && toggleArrow) {
            const isOpen = settingsPanel.style.display === 'none' || settingsPanel.style.display === '';
            
            if (isOpen) {
                settingsPanel.style.display = 'block';
                toggleArrow.textContent = '▼';
            } else {
                settingsPanel.style.display = 'none';
                toggleArrow.textContent = '▶';
            }
            
            toggleElement.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            // Save panel state
            const parentContainer = toggleElement.closest('div[id$="-gen-settings"]');
            if (parentContainer) {
                const panelId = parentContainer.id;
                
                // Find settings elements
                const detailedTexturesCheckbox = parentContainer.querySelector('input[id^="detailed_textures_"]');
                const polyInput = parentContainer.querySelector('input.poly-input');
                
                // Get current values
                const detailedTextures = detailedTexturesCheckbox ? detailedTexturesCheckbox.checked : false;
                const polyCount = polyInput ? polyInput.value : "Авто";
                
                // Save settings
                saveSettings(panelId, isOpen, detailedTextures, polyCount);
            }
        }
    }
    
    document.addEventListener('DOMContentLoaded', function() {
        // Определяем глобальные функции обновления
        
        // Обновление текстового поля на основании значения слайдера
        window.updatePolyDisplay = function(slider, input) {
            if (parseInt(slider.value) === 0) {
                // Отображаем "Авто" вместо 0
                const autoText = "Авто";
                input.value = autoText;
                input.setAttribute('data-auto', 'true');
            } else {
                input.value = slider.value;
                input.setAttribute('data-auto', 'false');
            }
        };
        
        // Обновление слайдера на основании текстового значения
        window.updatePolySlider = function(input, slider, skipValidation) {
            const autoText = "Авто";
            if (input.dataset.targetMode === 'lowpoly') {
                let target = parseInt(input.value, 10);
                target = Number.isFinite(target) ? Math.max(5000, Math.min(20000, target)) : 20000;
                slider.value = String(target);
                input.setAttribute('data-auto', 'false');
                if (!skipValidation) input.value = String(target);
                return;
            }
            
            // Если текст "Авто" или пустая строка - устанавливаем 0
            if (input.value === autoText || input.value === '' || input.value === '0') {
                slider.value = 0;
                input.value = autoText;
                input.setAttribute('data-auto', 'true');
                return;
            }
            
            // Пытаемся преобразовать в число
            let numValue = parseInt(input.value);
            
            // Если не число или отрицательное, устанавливаем "Авто"
            if (isNaN(numValue) || numValue < 0) {
                slider.value = 0;
                input.value = autoText;
                input.setAttribute('data-auto', 'true');
                return;
            }
            
            // Проверка минимального и максимального значения только если не пропускаем валидацию
            if (!skipValidation) {
                // Ограничение максимального значения
                if (numValue > 2000000) {
                    numValue = 2000000;
                    input.value = numValue;
                }

                // Проверка на минимальное значение > 0 и < 500
                const minimum = input.dataset.targetMode === 'alternative' ? 100000 : input.dataset.targetMode === 'tripo' ? 1000 : 500;
                if (numValue > 0 && numValue < minimum) {
                    numValue = minimum;
                    input.value = numValue;
                }
            }
            
            // Устанавливаем значение слайдера
            slider.value = numValue;
            input.setAttribute('data-auto', 'false');
        };
        
        // Save settings function for each panel
        window.saveGenerationSettings = function(panelId, detailedTexturesCheckbox, polyInput) {
            // Get current values
            const detailedTextures = detailedTexturesCheckbox ? detailedTexturesCheckbox.checked : false;
            const polyCount = polyInput ? polyInput.value : "Авто";
            
            // Get panel state
            const panel = document.getElementById(panelId);
            const settingsPanel = panel ? panel.querySelector('.generation-settings-panel') : null;
            const isOpen = settingsPanel ? (settingsPanel.style.display === 'block') : false;
            
            // Save settings
            saveSettings(panelId, isOpen, detailedTextures, polyCount);
        };
        
        // Находим все контейнеры настроек генерации
        const allPanels = document.querySelectorAll('div[id$="-gen-settings"]');
        
        allPanels.forEach(function(panel) {
            if (panel.dataset.polygonSettingsInitialized) return;
            panel.dataset.polygonSettingsInitialized = 'true';
            // Получаем уникальный ID для создания уникальных ID элементов
            const uniqueId = panel.id.replace('-gen-settings', '');
            const panelId = panel.id;
            
            // Находим элементы управления
            const detailedTextures = panel.querySelector('input[id="detailed_textures_' + uniqueId + '"]');
            const polySlider = panel.querySelector('input[id="poly_count_slider_' + uniqueId + '"]');
            const polyInput = panel.querySelector('input[id="poly_count_input_' + uniqueId + '"]');
            
            // Обновляем ID для уникальности
            if (detailedTextures) {
                detailedTextures.id = 'detailed_textures_' + uniqueId;
                const detailedTexturesLabel = panel.querySelector('label[for="detailed_textures"]');
                if (detailedTexturesLabel) {
                    detailedTexturesLabel.setAttribute('for', detailedTextures.id);
                }
            }
            
            if (polySlider) {
                polySlider.id = 'poly_count_slider_' + uniqueId;
                const polySliderLabel = panel.querySelector('label[for="poly_count_slider"]');
                if (polySliderLabel) {
                    polySliderLabel.setAttribute('for', polySlider.id);
                }
            }
            
            if (polyInput) {
                polyInput.id = 'poly_count_input_' + uniqueId;
            }
            
            // Load saved settings
            try {
                const savedSettings = loadSettings(panelId);
                const savedAlternativeTarget = parseInt(savedSettings.alternativePolyTarget ?? savedSettings.polyCount, 10);
                panel.dataset.alternativePolyTarget = String(Number.isFinite(savedAlternativeTarget) && savedAlternativeTarget > 0 ? Math.max(100000, Math.min(2000000, savedAlternativeTarget)) : 0);
                const savedTarget = parseInt(savedSettings.lowPolyTarget, 10);
                panel.dataset.lowPolyTarget = String(Number.isFinite(savedTarget) ? Math.max(5000, Math.min(20000, savedTarget)) : 20000);
                
                // Apply saved state to panel
                const settingsPanel = panel.querySelector('.generation-settings-panel');
                const toggleElement = panel.querySelector('.generation-settings-toggle');
                const toggleArrow = toggleElement ? toggleElement.querySelector('.toggle-arrow') : null;
                
                if (toggleElement) { toggleElement.setAttribute('aria-expanded', savedSettings.isOpen ? 'true' : 'false'); }
                if (settingsPanel && savedSettings.isOpen) {
                    settingsPanel.style.display = 'block';
                    if (toggleArrow) {
                        toggleArrow.textContent = '▼';
                    }
                }
                
                // Apply saved detailed textures
                if (detailedTextures && savedSettings.detailedTextures !== undefined) {
                    detailedTextures.checked = savedSettings.detailedTextures;
                }
                
                // Apply saved polygon count
                if (polySlider && polyInput && savedSettings.polyCount) {
                    const autoText = "Авто";
                    
                    if (savedSettings.polyCount === autoText) {
                        polySlider.value = 0;
                        polyInput.value = autoText;
                        polyInput.setAttribute('data-auto', 'true');
                    } else {
                        // Try to parse as number
                        const numValue = parseInt(savedSettings.polyCount);
                        if (!isNaN(numValue) && numValue > 0) {
                            polySlider.value = numValue;
                            polyInput.value = numValue;
                            polyInput.setAttribute('data-auto', 'false');
                        } else {
                            // If not a valid number, use default
                            polySlider.value = 0;
                            polyInput.value = autoText;
                            polyInput.setAttribute('data-auto', 'true');
                        }
                    }
                }
            } catch (e) {
                console.error('Error applying saved settings:', e);
            }
            
            // Настраиваем синхронизацию слайдера и поля ввода
            if (polySlider && polyInput) {
                // Инициализируем значением из слайдера
                updatePolyDisplay(polySlider, polyInput);
                
                // Добавляем обработчики событий для слайдера
                polySlider.addEventListener('input', function() {
                    updatePolyDisplay(this, polyInput);
                });
                
                polySlider.addEventListener('change', function() {
                    // Save settings when slider value changes and user releases it
                    window.saveGenerationSettings(panelId, detailedTextures, polyInput);
                });
                
                // Добавляем обработчики для поля ввода
                
                // 1. Разрешаем только цифровой ввод, но с проверкой на "Авто"
                polyInput.addEventListener('keypress', function(e) {
                    const autoText = "Авто";
                    // Если текущее значение "Авто" и нажата любая клавиша - очищаем поле
                    if (this.value === autoText) {
                        this.value = '';
                        return;
                    }
                    
                    // Разрешаем только цифры
                    const char = String.fromCharCode(e.which);
                    if (!/[0-9]/.test(char)) {
                        e.preventDefault();
                    }
                });
                
                // 2. Обрабатываем изменение значения без валидации
                polyInput.addEventListener('input', function() {
                    // Пропускаем строгую валидацию при вводе
                    updatePolySlider(this, polySlider, true);
                });
                
                // 3. Обработка фокуса 
                polyInput.addEventListener('focus', function() {
                    const autoText = "Авто";
                    if (this.value === autoText) {
                        this.value = '';
                    }
                });
                
                // 4. Валидация при потере фокуса
                polyInput.addEventListener('blur', function() {
                    const autoText = "Авто";
                    if (this.value === '') {
                        this.value = autoText;
                    }
                    // Полная валидация при потере фокуса
                    updatePolySlider(this, polySlider, false);
                    if (this.dataset.targetMode !== 'alternative' && this.dataset.targetMode !== 'tripo') updatePolyDisplay(polySlider, this);
                    
                    // Save settings when input loses focus
                    window.saveGenerationSettings(panelId, detailedTextures, this);
                });
                
                // 5. Предотвращаем отправку формы клавишей Enter
                polyInput.addEventListener('keydown', function(event) {
                    if (event.key === 'Enter') {
                        event.preventDefault();
                        this.blur();
                        return false;
                    }
                });
                
                // 6. Синхронизируем значения перед отправкой формы
                const parentForm = panel.closest('form');
                if (parentForm) {
                    parentForm.addEventListener('reset', function() {
                        panel.dataset.lowPolyTarget = '20000';
                        panel.dataset.alternativePolyTarget = '0';
                        panel.dataset.tripoPolyTarget = '0';
                        polyInput.dataset.targetMode = 'ordinary';
                        setTimeout(function() { syncLowPolyTarget(panel); }, 0);
                    });
                    window.addEventListener('pageshow', function() { syncLowPolyTarget(panel); });
                    parentForm.addEventListener('submit', function() {
                        syncLowPolyTarget(panel);
                        // Сохраняем состояние чекбокса перед отправкой формы
                        if (detailedTextures) {
                            window.saveGenerationSettings(panelId, detailedTextures, polyInput);
                        }
                        
                        // Полная валидация перед отправкой
                        updatePolySlider(polyInput, polySlider, false);
                        // Если значение "Авто", ставим 0 для отправки
                        if (polyInput.getAttribute('data-auto') === 'true') {
                            polyInput.value = 0;
                        } else if (polyInput.dataset.targetMode !== 'alternative' && polyInput.dataset.targetMode !== 'tripo') {
                            polyInput.value = polySlider.value;
                        }
                    });
                }
            }
            
            // Add event listener for detailed textures checkbox
            if (detailedTextures) {
                detailedTextures.addEventListener('change', function() {
                    // Save settings when checkbox changes
                    window.saveGenerationSettings(panelId, this, polyInput);
                });
            }
        });

        // --- Mutual exclusivity for the experimental options ---
        // Low-poly and "3 variants" cannot segment. Each variant carries
        // its own mode surcharge. Preserve the selected polygon target.
        document.querySelectorAll('.generation-settings-panel').forEach(function(panel) {
            if (panel.dataset.exclusivityInitialized) return;
            panel.dataset.exclusivityInitialized = 'true';
            var lowPoly = panel.querySelector('input[name="fast_lowpoly"]');
            var threeVariants = panel.querySelector('input[name="generate_three_variants"]');
            var segment = panel.querySelector('input[name="segment_model"]');

            function refreshExclusivity() {
                var lowPolyEnabled = lowPoly && lowPoly.checked && !lowPoly.disabled;
                var modes = panel.querySelector('.lowpoly-mode-options');
                if (modes) {
                    if (lowPolyEnabled && panel.dataset.lowPolyEnabled !== 'true') {
                        modes.querySelector('[value="standard"]').checked = true;
                    }
                    modes.hidden = !lowPolyEnabled;
                    modes.querySelectorAll('input').forEach(function (input) { input.disabled = !lowPolyEnabled || input.hasAttribute('data-plan-locked'); });
                }
                panel.dataset.lowPolyEnabled = String(Boolean(lowPolyEnabled));
                syncLowPolyTarget(panel);
                var textureSettings = panel.querySelector('.lowpoly-texture-settings');
                if (textureSettings) {
                    var selectedMode = panel.querySelector('[name="lowpoly_mode"]:checked');
                    var textureChoiceEnabled = lowPolyEnabled && (!selectedMode || selectedMode.value === 'standard');
                    textureSettings.hidden = !textureChoiceEnabled;
                    textureSettings.querySelector('select').disabled = !textureChoiceEnabled;
                }
                var segBlocked = (lowPoly && (lowPoly.checked || lowPoly.disabled)) || (threeVariants && threeVariants.checked);
                if (segment) {
                    if (segBlocked) { segment.checked = false; segment.disabled = true; }
                    else { segment.disabled = false; }
                    var segGroup = segment.closest('.form-group');
                    if (segGroup) { segGroup.style.opacity = segBlocked ? '0.5' : ''; }
                }
            }

            [lowPoly, threeVariants, segment].forEach(function(cb) {
                if (cb) { cb.addEventListener('change', refreshExclusivity); }
            });
            panel.querySelectorAll('[name="lowpoly_mode"]').forEach(function (radio) {
                radio.addEventListener('change', refreshExclusivity);
            });
            var form = panel.closest('form');
            if (form) form.addEventListener('reset', function () { setTimeout(refreshExclusivity, 0); });
            refreshExclusivity();
        });
    });
</script> </div>
                    
                    
                    
                    <button type="button" class="btn btn-primary btn-block js-register-first-cta">
